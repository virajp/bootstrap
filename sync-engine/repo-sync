#!/usr/bin/env bash

# repo-sync shim: the function `repo_sync` for an old consumer task. Meant to be
# *sourced*, not executed:
#
#   source "${SYNC_ENGINE_CLONE}/sync-engine/repo-sync"
#   repo_sync [--dry-run | --check]
#
# An old `setup/configs/sync` task and the forwarding file
# `tools/repo-sync/.config/mise/tasks/_scripts/repo-sync` source this file from
# the clone. `repo_sync` runs the Go engine as `sync-engine repo`, with the same
# arguments and the same environment. The exit code of the engine is the return
# code of `repo_sync`.
#
# The engine: SYNC_ENGINE_BIN, a local build, else the release that VERSION
# next to this file names. VERSION has one line, MAJOR.MINOR.PATCH.
#
# Contract: docs/design/repo-sync.md

# The folder of this file, when it is sourced. `--check` runs without
# SYNC_ENGINE_CLONE, so the pin comes from this folder.
_RS_SHIM_DIR=${BASH_SOURCE[0]%/*}

repo_sync() {
  local version
  if [[ -n ${SYNC_ENGINE_BIN:-} ]]; then
    if [[ ! -f ${SYNC_ENGINE_BIN} || ! -x ${SYNC_ENGINE_BIN} ]]; then
      printf '%s\n' "repo-sync: SYNC_ENGINE_BIN ${SYNC_ENGINE_BIN} is not an executable file - nothing synced" >&2
      return 2
    fi
    "${SYNC_ENGINE_BIN}" repo "$@"
    return
  fi
  version=''
  IFS= read -r version 2> /dev/null < "${_RS_SHIM_DIR}/VERSION" || true
  if [[ ! ${version} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf '%s\n' "repo-sync: sync-engine/VERSION of the clone is not MAJOR.MINOR.PATCH ('${version}') - nothing synced" >&2
    return 5
  fi
  if ! mise install "github:virajp/bootstrap@${version}"; then
    printf '%s\n' "repo-sync: cannot install the sync engine ${version} (github:virajp/bootstrap) - nothing synced" >&2
    return 5
  fi
  mise x "github:virajp/bootstrap@${version}" -- sync-engine repo "$@"
}
