#!/usr/bin/env bash

# repo-sync — copy the shared files of the selected tools from the private
# `bootstrap` repo into this repo. Meant to be *sourced* by a mise task, not
# executed:
#
#   source "${SYNC_ENGINE_CLONE}/sync-engine/repo-sync"
#   repo_sync [--dry-run | --check]
#
# Flags:
#   --dry-run  show each change and write no file
#   --check    examine only the rules of the values file that need no clone
#
# The engine starts gomplate, jq and yq through the wrappers of `common`, from
# `/`, so no mise config of a repo selects them, and no task needs a `#MISE`
# line for them: this works before a first sync and in a shell without
# MISE_ENV=dev.
# The calling task provides pre-commit with `#MISE tools.pre-commit="latest"`,
# and this script calls it without `mise x --`.
#
# Environment:
#   SYNC_ENGINE_CLONE  the clone copy that `setup:configs` gives; this file
#                     is loaded from it. repo_sync reads no URL and makes no
#                     clone. `--check` does not read it
#   REPO_SYNC_VALUES  the values file
#                     (default $MISE_PROJECT_ROOT/.config/bootstrap.toml)
#   SYNC_ENGINE_VERBOSE      1: print each per-file line in its log format, not
#                            the list of the changes
#   REPO_SYNC_NO_AUTOUPDATE  1: skip `pre-commit autoupdate`, so the hook
#                     revisions stay as the tools.toml files have them and no
#                     network is needed (for tests)
#   MISE_PROJECT_ROOT, TMPDIR  the repository root and the temporary files
#
# Contract: docs/design/repo-sync.md

# The shared libraries, from the folder of this file.
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/common"
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/write"
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/merge"
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/select"
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/manifest"
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/values"
# shellcheck source=/dev/null
source "${BASH_SOURCE[0]%/*}/mise"
_SE_PREFIX='repo-sync'

# The repo side of the clone: the folder of the tools and the file of the packs,
# relative to the clone. No other line of this file names them.
_RS_TOOLS_DIR=repo/tools
_RS_PACKS_FILE=repo/packs.toml

# The manifests of the clone, read once by `_rs_mise_index`.
_RS_MANIFESTS='' _RS_MANIFESTS_DIR=''
# The regular files of the tool folders of the clone, as `./<tool>/<path>`
# lines, listed once by `_rs_mise_index` for `_rs_target_ok`.
_RS_TOOL_FILES=''

# Print the repo's members, one per line as `<name> <folder> <type>` with a
# tab between them: the git submodules first, then the other `[member.<name>]`
# tables of <values>. A submodule without a table has the `repo_name` of its
# own values file as its name, else its path with each `/` changed to `_`. A
# name has only letters, digits, `-` and `_`, and two members never have the
# same name. A table has an optional `folder` (the default is the name) and
# an optional `type`, `submodule` or `folder`; without `type`, the folder
# decides it. A folder member must exist, and no member is the repo itself
# (`.`). Returns 2, after a message, when a member breaks one of these rules.
_rs_members() {
  local values=$1 name=$2 path rows key folder type found submodules='' tab=$'\t'
  if [[ -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    # shellcheck disable=SC2016
    submodules=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || submodules=''
  fi
  rows=$(_se_gomplate -c "v=${values}" \
  -i '<% if has .v "member" %><% range $k, $x := .v.member %><% $k %>	<% if has $x "folder" %><% $x.folder %><% else %><% $k %><% end %>	<% if has $x "type" %><% $x.type %><% end %>
<% end %><% end %>') || return 2
  while IFS="$tab" read -r key folder type; do
    [[ -n $key ]] || continue
    folder=${folder%/}
    if [[ $folder == "." || -z $folder ]]; then
      _se_log "$name: [member.${key}] in $(_se_path "$values") has the folder of the repo itself - a member is a submodule or a folder below the root"
      return 2
    fi
    case $type in
      '' | submodule | folder) ;;
      *)
        _se_log "$name: [member.${key}] in $(_se_path "$values") has the type '${type}' - use submodule or folder"
        return 2
        ;;
    esac
    if grep -qxF -- "$folder" <<< "$submodules"; then
      if [[ $type == folder ]]; then
        _se_log "$name: [member.${key}] in $(_se_path "$values") has type folder, but ${folder} is a submodule"
        return 2
      fi
    elif [[ $type == submodule ]]; then
      _se_log "$name: [member.${key}] in $(_se_path "$values") has type submodule, but ${folder} is not in .gitmodules"
      return 2
    elif [[ ! -d ${MISE_PROJECT_ROOT}/${folder} ]]; then
      _se_log "$name: [member.${key}] in $(_se_path "$values") is not a submodule or a folder of the repo"
      return 2
    fi
  done <<< "$rows"
  # The submodules, each with the name of its table, else the `repo_name` of
  # its own values file, else its path with each `/` changed to `_`.
  local out='' sub_values
  while IFS= read -r path; do
    [[ -n $path ]] || continue
    found=''
    while IFS="$tab" read -r key folder type; do
      [[ -n $key && ${folder%/} == "$path" ]] && found=$key
    done <<< "$rows"
    sub_values="${MISE_PROJECT_ROOT}/${path}/.config/bootstrap.toml"
    if [[ -z $found && -f $sub_values ]]; then
      found=$(_se_gomplate -c "v=${sub_values}" -i '<% if has .v "repo_name" %><% .v.repo_name %><% end %>') || found=''
    fi
    [[ -n $found ]] || found=${path//\//_}
    out+="${found}${tab}${path}${tab}submodule"$'\n'
  done <<< "$submodules"
  # Then the folder members.
  while IFS="$tab" read -r key folder type; do
    [[ -n $key ]] || continue
    folder=${folder%/}
    grep -qxF -- "$folder" <<< "$submodules" && continue
    out+="${key}${tab}${folder}${tab}folder"$'\n'
  done <<< "$rows"
  # A name is a flag (`--<name>`) and a part of a shell variable of the tasks.
  local seen=''
  while IFS="$tab" read -r key folder type; do
    [[ -n $key ]] || continue
    if [[ ! $key =~ ^[A-Za-z0-9_-]+$ ]]; then
      _se_log "$name: the member ${folder} has the name '${key}' - a member name has only letters, digits, - and _; use a [member.<name>] table with such a name in $(_se_path "$values")"
      return 2
    fi
    if grep -qxF -- "$key" <<< "$seen"; then
      _se_log "$name: two members have the name '${key}' - write a [member.<name>] table with another name for one of them in $(_se_path "$values")"
      return 2
    fi
    seen+="${key}"$'\n'
  done <<< "$out"
  printf '%s' "$out"
}

# Print the items of the list <key> in the TOML file <file>, one per line;
# nothing when the key is absent.
_rs_list() {
  local file=$1 key=$2
  _se_gomplate -c "v=${file}" -i "<% if has .v \"${key}\" %><% range (index .v \"${key}\") %><% . %>
<% end %><% end %>"
}

# The fixed pack that every repo gets.
_RS_BASE_PACK=base

# Print the `[tools.<name>]` and `[packs.<name>]` entries of <values> as
# `tools|packs <name> <env,...|->` lines (`-`: no `env`). Returns 2, after a
# message, for the old list format, an `env` that is not a list, or a pack entry
# with another key than `env`. Each other key of a `[tools.*]` entry is a value.
_rs_values_sel() {
  local values=$1 out kind table name key
  out=$(_se_gomplate -c "v=${values}" -i '<% range $t := coll.Slice "tools" "packs" %><% if has $.v $t %><% $x := index $.v $t %><% if not (test.IsKind "map" $x) %>list <% $t %>
<% else %><% range $k, $e := $x %><% if not (test.IsKind "map" $e) %>bad <% $t %> <% $k %> -
<% else %><% if eq $t "packs" %><% range $ek, $ev := $e %><% if ne $ek "env" %>bad <% $t %> <% $k %> <% $ek %>
<% end %><% end %><% end %><% if has $e "env" %><% if not (test.IsKind "slice" $e.env) %>bad <% $t %> <% $k %> env
<% else %><% $t %> <% $k %> <% join $e.env "," %>
<% end %><% else %><% $t %> <% $k %> -
<% end %><% end %><% end %><% end %><% end %><% end %>') || {

    _se_log "cannot read $(_se_path "$values")"
    return 2
  }
  while read -r kind table name key; do
    if [[ $kind == list ]]; then
      name=security
      [[ $table == tools ]] && name=node
      _se_log "$table in $(_se_path "$values") is a list, the old format - write one table for each entry, for example [$table.$name] env = [\"dev\"]; the pack $_RS_BASE_PACK is always added"
      return 2
    fi
    [[ $kind == bad ]] || continue
    if [[ $key == - ]]; then
      key='must be a table'
    elif [[ $key == env ]]; then
      key='env must be a list, for example env = ["dev"]'
    else
      key="'$key' is not a key of a pack entry; the only key of a pack entry is env, a list"
    fi
    _se_log "[$table.$name] in $(_se_path "$values"): $key"
    return 2
  done <<< "$out"
  printf '%s\n' "$out"
}

# The fields of the manifest `$t` as `<field> <value>` lines, for gomplate.
# A caller binds `$t` and replaces `@P@` with the prefix of each line.
_RS_MANIFEST_TEMPLATE='<% range $t.default_envs %>@P@default_env <% . %>
<% end %><% range $t.depends %>@P@depends <% . %>
<% end %><% range $t.extensions %>@P@extension <% . %>
<% end %><% if has $t "seed" %>@P@old seed
<% end %><% if has $t "seed_requires" %>@P@old seed_requires
<% end %><% if has $t "files" %><% if test.IsKind "map" $t.files %><% range $f, $e := $t.files %><% if test.IsKind "map" $e %>@P@files <% $f %> - -
<% range $k, $v := $e %>@P@files <% $f %> <% $k %> <% $v | data.ToJSON %>
<% if has (coll.Slice "requires" "requires_found") $k %><% $ok := test.IsKind "slice" $v %><% if $ok %><% if not $v %><% $ok = false %><% end %><% range $v %><% if not (test.IsKind "string" .) %><% $ok = false %><% end %><% end %><% end %><% if $ok %><% range $v %>@P@files_item <% $f %> <% $k %> <% . %>
<% end %><% else %>@P@bad [files."<% $f %>"] <% $k %> must be a non-empty list of <% if eq $k "requires" %>paths<% else %>file names<% end %>
<% end %><% end %><% end %><% else %>@P@bad [files."<% $f %>"] must be a table
<% end %><% end %><% else %>@P@bad [files] must be a table of [files."<target>"] tables
<% end %><% end %><% if and (has $t "mise") (has $t.mise "tools") %><% range $k, $v := $t.mise.tools %>@P@mise <% $k %><% if and (test.IsKind "map" $v) (has $v "envs") %> <% join $v.envs "," %><% else %> -<% end %><% if and (test.IsKind "map" $v) (has $v "depends") %><% if test.IsKind "string" $v.depends %> <% $v.depends %><% else %><% range $v.depends %> <% . %><% end %><% end %><% end %>
<% if test.IsKind "map" $v %><% if has $v "requires_found" %><% $l := $v.requires_found %><% $ok := test.IsKind "slice" $l %><% if $ok %><% if not $l %><% $ok = false %><% end %><% range $l %><% if not (test.IsKind "string" .) %><% $ok = false %><% end %><% end %><% end %><% if $ok %><% range $l %>@P@mise_found <% $k %> <% . %>
<% end %><% else %>@P@bad requires_found of mise tool <% $k %> must be a non-empty list of file names
<% end %><% end %><% if has $v "requires" %>@P@old requires <% $k %> <% $v.requires %>
<% end %><% if has $v "files" %>@P@old files <% $k %>
<% end %><% end %><% end %><% end %><% if has $t "mise_env" %><% range $en, $b := $t.mise_env %><% if and (test.IsKind "map" $b) (has $b "tools") %><% if test.IsKind "map" $b.tools %><% range $k, $v := $b.tools %><% if test.IsKind "map" $v %><% range coll.Slice "requires_found" "requires" "files" %><% if has $v . %>@P@mise_env_key <% . %> <% $k %> <% $en %>
<% end %><% end %><% end %><% end %><% end %><% end %><% end %><% end %>@P@root_only <% $t.root_only %>
'

# Print the manifest of <tool> in the clone <dir> as `<field> <value>` lines:
# `default_env`, `depends`, `extension`,
# `files <target> - -` (one for each `[files]` table, before its other lines),
# `files <target> <key> <json-value>` (one for each key of the table),
# `files_item <target> requires|requires_found <item>` (in the order of the
# list, and the `requires` items come first),
# `mise <mise-tool> <envs,...|-> [<mise-depends>...]`,
# `mise_found <mise-tool> <name>`,
# `old seed|seed_requires`,
# `old requires|files <mise-tool> [<value>]` (an old key),
# `mise_env_key <key> <mise-tool> <env>` (a key that is valid only in
# `[mise.tools]`),
# `bad <message>` (a problem of a shape), and one `root_only true|false`.
# `_rs_mise_index` reads each manifest of <dir> in one call, so this only
# selects the lines of <tool>. A tool that it did not read is read alone.
_rs_manifest() {
  local dir=$1 tool=$2
  if [[ $dir == "$_RS_MANIFESTS_DIR" && $_RS_MANIFESTS == *$'\n'"$tool "* ]]; then
    awk -v t="$tool" '$1 == t { sub(/^[^ ]* /, ""); print }' <<< "$_RS_MANIFESTS"
    return 0
  fi
  _se_gomplate -c "t=${dir}/${_RS_TOOLS_DIR}/${tool}/tools.toml" -i "<% \$t := .t %>${_RS_MANIFEST_TEMPLATE//@P@/}"
}

# Set _RS_MISE_DEFS to the ` <mise-tool>=<tool> ` words of every tool in the
# clone <dir>, selected or not: the mise `depends` of an entry find their tool
# here. Returns 2, after a message, when two tools define the same mise tool,
# when the default_envs of a tool, selected or not, has no dev, for a problem of
# `_rs_manifest_rules` in a tool, selected or not, for a tool folder with both
# <p> and <p>.tmpl,
# or for a tool folder named zz-repo or that sorts after it in byte order:
# mise loads the folders of conf.d/ in name order and a later one wins, so the
# repo's own conf.d/zz-repo/ must load last and no tool may write there.
# It also sets _RS_MANIFESTS to the manifest of each tool, as
# `<tool> <field> <value>` lines from one gomplate call, for `_rs_manifest`.
_rs_mise_index() {
  local dir=$1 manifest tool name names path late tools='' args=() rc=0
  late=$(cd "$dir/$_RS_TOOLS_DIR" && printf '%s\n' */ | sed 's#/$##' | LC_ALL=C awk '$0 >= "zz-repo" { print; exit }') || {
    _se_log "cannot list the tool folders of the clone"
    return 2
  }
  if [[ -n $late ]]; then
    _se_log "tool folder $_RS_TOOLS_DIR/$late sorts after zz-repo or is named zz-repo - rename it, because conf.d/zz-repo/ must load last"
    return 2
  fi
  for manifest in "$dir"/"$_RS_TOOLS_DIR"/*/tools.toml; do
    tool=${manifest%/tools.toml}
    tool=${tool##*/}
    tools+="$tool "
    args+=(-c "tool_${tool}=${manifest}")
  done
  _RS_MANIFESTS_DIR='' _RS_MANIFESTS=$'\n'
  _RS_MANIFESTS+=$(REPO_SYNC_TOOLS=$tools _se_gomplate "${args[@]}" \
    -i "<% range (env.Getenv \"REPO_SYNC_TOOLS\" | strings.TrimSpace | strings.Split \" \") %><% \$n := . %><% \$t := index \$ (printf \"tool_%s\" .) %>${_RS_MANIFEST_TEMPLATE//@P@/<% \$n %> }<% end %>" 2> /dev/null) || {
    # Read each file alone, to name the one that fails.
    for tool in $tools; do
      if ! _rs_manifest "$dir" "$tool" > /dev/null 2>&1; then
        _se_log "cannot read $_RS_TOOLS_DIR/$tool/tools.toml"
        return 2
      fi
    done
    _se_log "cannot read the tools.toml files of the clone"
    return 2
  }
  _RS_MANIFESTS+=$'\n'
  _RS_MANIFESTS_DIR=$dir
  _RS_MISE_DEFS=' '
  _RS_TOOL_FILES=$(cd "$dir/$_RS_TOOLS_DIR" && find . -type f) || {
    _se_log "cannot list the files of the tool folders of the clone"
    return 2
  }
  _RS_TOOL_FILES=$'\n'$_RS_TOOL_FILES$'\n'
  for tool in $tools; do
    names=$(_rs_manifest "$dir" "$tool")
    # Each tool must be in dev, selected or not, so this repo's own test
    # finds a tool without dev before a consumer selects it.
    if [[ $'\n'$names$'\n' != *$'\n'"default_env dev"$'\n'* ]]; then
      _se_log "default_envs of $_RS_TOOLS_DIR/$tool/tools.toml has no dev - each tool must be in dev, for example default_envs = [\"dev\", \"ci\"]"
      return 2
    fi
    for name in $(printf '%s\n' "$names" | awk '$1 == "mise" { print $2 }'); do
      if [[ $_RS_MISE_DEFS == *" $name="* ]]; then
        _se_log "mise tool '$name' is defined in $_RS_TOOLS_DIR/$tool and in another tool - keep one"
        return 2
      fi
      _RS_MISE_DEFS+="$name=$tool "
    done
    _rs_manifest_rules "$dir" "$tool" "$names" || rc=2
  done
  while IFS= read -r path; do
    [[ -n $path && -f ${path%.tmpl} ]] || continue
    path=${path#"$dir"/"$_RS_TOOLS_DIR"/}
    path=${path%.tmpl}
    _se_log "$_RS_TOOLS_DIR/${path%%/*}: ${path#*/} and ${path#*/}.tmpl both exist - keep one"
    rc=2
  done < <(find "$dir/$_RS_TOOLS_DIR" -type f -name '*.tmpl')
  return "$rc"
}

# Examine the manifest lines <names> of `_rs_manifest` for <tool> in the clone
# <dir>: the old keys, the `[files]` tables and `requires_found` of a mise
# entry. An old key gets one message for each tools.toml. Returns 2, after a
# message for each problem.
_rs_manifest_rules() {
  local dir=$1 tool=$2 names=$3 rc=0 field value a b c seen=' '
  local target='' mode='' format='' has_remove=0 has_items=0
  while read -r field value; do
    read -r a b c <<< "$value"
    case $field in
      bad)
        _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: $value"
        rc=2
        ;;
      old)
        [[ $seen != *" $a "* ]] || continue
        seen+="$a "
        rc=2
        case $a in
          seed)
            _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: seed is not supported; use [files.\"<target>\"] with mode = \"seed\""
            ;;
          seed_requires)
            _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [seed_requires] is not supported; use requires in [files.\"<target>\"]"
            ;;
          files)
            _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: files in [mise.tools.$b] is not supported; use requires_found in [files.\"<target>\"]"
            ;;
          requires)
            _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: requires of mise tool $b is the old key - write requires_found = [\"$c\"]"
            ;;
        esac
        ;;
      mise_env_key)
        _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: $a of mise tool $b in [mise_env.$c.tools] is valid only in [mise.tools]"
        rc=2
        ;;
      mise_found)
        if [[ -z $b || $b == */* ]]; then
          _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: requires_found of mise tool $a: '$b' must be a file name, with no /"
          rc=2
        fi
        ;;
      files)
        if [[ $b == - ]]; then
          if [[ -n $target ]]; then
            _se_files_check_mode "$_RS_TOOLS_DIR/$tool/tools.toml" "$target" "$mode" "$format" "$has_remove" "$has_items" || rc=2
          fi
          target=$a mode='' format='' has_remove=0 has_items=0
          _rs_target_ok "$tool" "$a" || rc=2
          continue
        fi
        if ! _se_files_key_ok "$b"; then
          _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [files.\"$a\"] $b is not a key of a file - the keys are mode, requires, requires_found, format, remove and remove_items"
          rc=2
          continue
        fi
        case $b in
          mode)
            case $c in
              '"generated"' | '"seed"' | '"merge"')
                mode=${c//\"/}
                ;;
              *)
                _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [files.\"$a\"] mode must be \"generated\", \"seed\" or \"merge\""
                rc=2
                ;;
            esac
            ;;
          format)
            case $c in
              '"text"' | '"json"' | '"yaml"' | '"toml"')
                format=${c//\"/}
                ;;
              *)
                _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [files.\"$a\"] format must be \"text\", \"json\", \"yaml\" or \"toml\""
                rc=2
                ;;
            esac
            ;;
          remove)
            has_remove=1
            _se_files_check_shape "$_RS_TOOLS_DIR/$tool/tools.toml" "$a" "$b" "$c" || rc=2
            ;;
          remove_items)
            has_items=1
            _se_files_check_shape "$_RS_TOOLS_DIR/$tool/tools.toml" "$a" "$b" "$c" || rc=2
            ;;
        esac
        ;;
      files_item)
        if [[ $b == requires ]]; then
          case $c in
            '' | /* | .. | ../* | */../* | */..)
              _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [files.\"$a\"] requires: '$c' must be a path relative to the repository root, with no .. part"
              rc=2
              ;;
          esac
        elif [[ -z $c || $c == */* ]]; then
          _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [files.\"$a\"] requires_found: '$c' must be a file name, with no /"
          rc=2
        fi
        ;;
    esac
  done <<< "$names"
  if [[ -n $target ]]; then
    _se_files_check_mode "$_RS_TOOLS_DIR/$tool/tools.toml" "$target" "$mode" "$format" "$has_remove" "$has_items" || rc=2
  fi
  return "$rc"
}

# 0 when a file of the folder of <tool> produces <target>: <target> or
# <target>.tmpl is the same string as a path of _RS_TOOL_FILES. Thus a case
# variant fails on each file system, and a path through a symlink fails,
# because find does not follow one. Else 2, after a message. `tools.toml` is
# not a file that the sync copies, and a target has no `.tmpl`.
_rs_target_ok() {
  local tool=$1 target=$2
  case $target in
    tools.toml | */tools.toml | *.tmpl) ;;
    *)
      [[ $_RS_TOOL_FILES != *$'\n'"./$tool/$target"$'\n'* && $_RS_TOOL_FILES != *$'\n'"./$tool/$target.tmpl"$'\n'* ]] || return 0
      ;;
  esac
  _se_log "$_RS_TOOLS_DIR/$tool/tools.toml: [files.\"$target\"] names a target that no file of the tool produces"
  return 2
}

# Print the tool that defines the mise tool <name>, or nothing.
_rs_mise_owner() {
  local def=${_RS_MISE_DEFS#* "$1="}
  [[ $def != "$_RS_MISE_DEFS" ]] && printf '%s' "${def%% *}"
}

# Examine the `env` of each entry of the values lines <sel> of
# `_rs_values_sel` for <values>, against _RS_ENVS of `_rs_envs`. An `env` of
# the values file names only environments of this repo, and always dev: each
# tool must be in dev. Returns 2, after a message, at the first problem.
_rs_env_rules() {
  local values=$1 sel=$2 kind name envs env
  # An `env` of the values file names only environments of this repo, and
  # always dev: each tool must be in dev.
  local has_dev
  while read -r kind name envs; do
    [[ -n $kind && $envs != - ]] || continue
    if [[ -z $envs ]]; then
      _se_log "env of [$kind.$name] in $(_se_path "$values") is empty - name an environment, or remove env to use default_envs"
      return 2
    fi
    has_dev=0
    [[ ,$envs, == *,dev,* ]] && has_dev=1
    # Split on commas only, so an item with a space fails the name check.
    envs+=,
    while [[ -n $envs ]]; do
      env=${envs%%,*} envs=${envs#*,}
      if ! _se_mise_env_name repo "$env"; then
        _se_log "env of [$kind.$name] in $(_se_path "$values"): '$env' is not one of ${_SE_MISE_ENV_NAMES// /, }"
        return 2
      fi
      if [[ $_RS_ENVS != *" $env "* ]]; then
        _se_log "env '$env' of [$kind.$name] in $(_se_path "$values") is not in environments:${_RS_ENVS% }"
        return 2
      fi
    done
    if ((!has_dev)); then
      _se_log "env of [$kind.$name] in $(_se_path "$values") has no dev - each tool must be in dev, for example env = [\"dev\", \"ci\"]"
      return 2
    fi
  done <<< "$sel"
  return 0
}

# The deps callback of `_rs_resolve`: print the dependencies of the tool <tool>,
# its `depends` and the tool that defines each mise `depends`. It reads `dir` of
# `_rs_resolve`. Returns 3 for a tool that is not in bootstrap, and 2 for a
# manifest that it cannot read or a mise `depends` that no tool defines, after a
# message.
_rs_walk_deps() {
  local tool=$1 manifest field value entry name owner
  if [[ ! -f $dir/$_RS_TOOLS_DIR/$tool/tools.toml ]]; then
    _se_log "tool '$tool' is not in bootstrap"
    return 3
  fi
  manifest=$(_rs_manifest "$dir" "$tool") || {
    _se_log "cannot read $_RS_TOOLS_DIR/$tool/tools.toml"
    return 2
  }
  while read -r field value; do
    case $field in
      depends)
        printf '%s\n' "$value"
        ;;
      mise)
        read -r entry _ value <<< "$value"
        for name in $value; do
          owner=$(_rs_mise_owner "$name") || owner=''
          if [[ -z $owner ]]; then
            _se_log "mise tool '$entry' of $_RS_TOOLS_DIR/$tool depends on '$name', which no tool defines"
            return 2
          fi
          [[ $owner == "$tool" ]] || printf '%s\n' "$owner"
        done
        ;;
    esac
  done <<< "$manifest"
  return 0
}

# The done callback of `_rs_resolve`: add the fields of the tool <tool> to the
# results. It reads `dir` and `in_submodule` of
# `_rs_resolve`. Returns 2, after a message, for a bad `default_envs` or a
# root-only tool in a submodule.
_rs_walk_done() {
  local tool=$1 manifest field value target key item
  manifest=$(_rs_manifest "$dir" "$tool") || {
    _se_log "cannot read $_RS_TOOLS_DIR/$tool/tools.toml"
    return 2
  }
  while read -r field value; do
    case $field in
      default_env)
        if ! _se_mise_env_name repo "$value"; then
          _se_log "default_envs of $_RS_TOOLS_DIR/$tool/tools.toml: '$value' is not one of ${_SE_MISE_ENV_NAMES// /, }"
          return 2
        fi
        _RS_DEFAULT_ENVS+="$tool:$value "
        ;;
      extension)
        _RS_EXTENSIONS+="$value"$'\n'
        ;;
      files)
        read -r target key item <<< "$value"
        case $key in
          mode)
            item=${item//\"/}
            _RS_FILE_MODES+="$tool/$target=$item "
            [[ $item == generated ]] || _RS_SPARE+="$target"$'\n'
            ;;
          format)
            _RS_FILE_FORMATS+="$tool/$target=${item//\"/} "
            ;;
          remove | remove_items)
            _RS_FILE_MERGE+="$tool/$target"$'\t'"$key"$'\t'"$item"$'\n'
            ;;
        esac
        ;;
      files_item)
        read -r target key item <<< "$value"
        _RS_FILE_CONDS+="$tool/$target"$'\t'"$key"$'\t'"$item"$'\n'
        ;;
      mise)
        _RS_MISE_ENTRIES+="$tool $value"$'\n'
        ;;
      mise_found)
        read -r target item <<< "$value"
        _RS_MISE_FOUND+="$target"$'\t'"$item"$'\n'
        ;;
      root_only)
        if [[ $value == true && -n $in_submodule ]]; then
          _se_log "tool '$tool' is for the root repository only - remove it from the tools of this submodule"
          return 2
        fi
        ;;
    esac
  done <<< "$manifest"
}

# Resolve the tools and packs of <values> against the clone <dir>, packs
# expanded and dependencies included, into _RS_TOOLS (space separated, a
# dependency before the tool that needs it), _RS_SEL (the
# `<tool> <env,...|-> <source>` lines of `_se_selected`), _RS_DEPS
# (`<tool> <dependency>...` lines), _RS_DEFAULT_ENVS (` <tool>:<env> ` words),
# _RS_EXTENSIONS (one per line, sorted, unique), the data of the
# `[files]` tables (_RS_FILE_MODES and _RS_FILE_FORMATS,
# ` <tool>/<target>=<value> ` words;
# _RS_FILE_CONDS,
# `<tool>/<target><tab>requires|requires_found<tab><item>` lines;
# _RS_FILE_MERGE, `<tool>/<target><tab>remove|remove_items<tab><json>` lines;
# _RS_SPARE, the seeds and the merge targets, one per line),
# _RS_MISE_ENTRIES (`<tool> <mise-tool> <envs,...|-> [<mise-depends>...]`
# lines) and _RS_MISE_FOUND (`<mise-tool><tab><name>` lines). A mise
# `depends` adds the tool that defines it. Returns 2 or 3,
# after a message, on any problem.
_rs_resolve() {
  local dir=$1 values=$2 sel pending in_submodule name envs
  sel=$(_rs_values_sel "$values") || return 2
  _rs_env_rules "$values" "$sel" || return 2
  _RS_SEL=$(_se_selected "$dir/$_RS_PACKS_FILE" "$dir/$_RS_TOOLS_DIR" "$_RS_BASE_PACK" "$sel" "$_RS_PACKS_FILE") || return
  in_submodule=$(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) || in_submodule=''
  # In a submodule, a root_only tool of a pack is skipped: the pack base adds
  # vscode to each repository. A [tools.*] entry of it still stops the sync.
  if [[ -n $in_submodule ]]; then
    local kept='' src
    while read -r name envs src; do
      [[ -n $name ]] || continue
      if [[ $src != tools.* ]] && _rs_manifest "$dir" "$name" 2> /dev/null | grep -qx 'root_only true'; then
        continue
      fi
      kept+="$name $envs $src"$'\n'
    done <<< "$_RS_SEL"
    _RS_SEL=${kept%$'\n'}
  fi

  _RS_EXTENSIONS='' _RS_MISE_ENTRIES='' _RS_MISE_FOUND=''
  _RS_FILE_MODES=' ' _RS_FILE_FORMATS=' ' _RS_FILE_CONDS='' _RS_FILE_MERGE='' _RS_SPARE=''
  _RS_DEPS='' _RS_DEFAULT_ENVS=' '
  # Depth-first, so each dependency lands before the tool that named it.
  pending=$(printf '%s\n' "$_RS_SEL" | awk '{ print $1 }' | tr '\n' ' ')
  _se_walk _rs_walk_deps _rs_walk_done "$pending" || return
  _RS_TOOLS=$_SE_WALK_VISITED
  _RS_DEPS=$_SE_WALK_DEPS
  _RS_EXTENSIONS=$(printf '%s' "$_RS_EXTENSIONS" | sort -u)
}

# Print the VS Code extensions of the tools of <values>, packs expanded and
# dependencies included, one per line. Like `_rs_resolve`, a mise `depends`
# adds the tool that defines it. Nothing is checked: a problem in a member's
# values file is for that member's own sync to report.
_rs_tool_extensions() {
  local dir=$1 values=$2 pending tool field value seen=' ' entry name owner sel
  sel=$(_rs_values_sel "$values" 2> /dev/null) || sel=''
  pending=$(_se_selected "$dir/$_RS_PACKS_FILE" "$dir/$_RS_TOOLS_DIR" "$_RS_BASE_PACK" "$sel" "$_RS_PACKS_FILE" 2> /dev/null | awk '{ print $1 }' | tr '\n' ' ') || pending=''
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $seen != *" $tool "* && -f $dir/$_RS_TOOLS_DIR/$tool/tools.toml ]] || continue
    seen+="$tool "
    while read -r field value; do
      case $field in
        extension)
          printf '%s\n' "$value"
          ;;
        depends)
          pending+=" $value "
          ;;
        mise)
          read -r entry _ value <<< "$value"
          for name in $value; do
            owner=$(_rs_mise_owner "$name") || owner=''
            [[ -n $owner ]] && pending+=" $owner "
          done
          ;;
      esac
    done < <(_rs_manifest "$dir" "$tool" 2> /dev/null)
  done
}

# Add to _RS_EXTENSIONS the `extensions` list of <values>. In the root
# repository, also add the extensions of each git submodule: the tools of its
# `.config/bootstrap.toml` and its own `extensions` list. VS Code opens the
# root only, so the root recommends the extensions of the whole tree.
_rs_extensions() {
  local dir=$1 values=$2 sub subvalues extra
  extra=$(_rs_list "$values" extensions) || extra=''
  if [[ -z $(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) && -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    while IFS= read -r sub; do
      subvalues="${MISE_PROJECT_ROOT}/${sub}/.config/bootstrap.toml"
      [[ -f $subvalues ]] || subvalues="${MISE_PROJECT_ROOT}/${sub}/.config/repo-config.toml"
      [[ -n $sub && -f $subvalues ]] || continue
      extra+=$'\n'$(_rs_tool_extensions "$dir" "$subvalues")
      extra+=$'\n'$(_rs_list "$subvalues" extensions 2> /dev/null) || true
    done < <(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null)
  fi
  _RS_EXTENSIONS=$(printf '%s\n%s\n' "$_RS_EXTENSIONS" "$extra" | grep -v '^$' | sort -u) || _RS_EXTENSIONS=''
}

# A branch that exists here or on origin; the same test as `branch_exists` in
# `checks`, which a first sync does not have yet.
_rs_branch_exists() {
  git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$1" ||
    git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Set _RS_SKIP to the ` git/<path> ` words of the merge tasks of the other
# branch model. Returns 2, after a message, when neither branch exists.
_rs_merge_model() {
  local tasks=git/.config/mise/tasks/code/merge
  local main=0 develop=0
  _rs_branch_exists main && main=1
  _rs_branch_exists develop && develop=1
  if ((main && develop)); then
    _RS_SKIP=" $tasks/_default "
  elif ((main || develop)); then
    _RS_SKIP=" $tasks/develop $tasks/main "
  else
    _se_log "the repo has neither 'main' nor 'develop' - create one, then sync again"
    return 2
  fi
}

# Validate `direct_commit` of the `[branch.*]` tables of <values>, a boolean
# for `[branch.main]` and `[branch.develop]` only, also when it is false. The
# branch must exist, and with both branches, main can be true only when
# develop is true too. Sets _RS_HOOK_DROP to the ` <branch> ` words whose
# `--branch` pair leaves the no-commit-to-branch hook (`_rs_context`): each
# branch with `direct_commit = true`, and main or develop when it does not
# exist. Returns 2, after a message for each problem.
_rs_direct_commit() {
  local values=$1 out name value show rc=0 main=0 develop=0 tab=$'\t'
  show=$(_se_path "$values")
  _RS_HOOK_DROP=' '
  out=$(_se_gomplate -c "v=${values}" -i '<% if and (has .v "branch") (test.IsKind "map" .v.branch) %><% range $k, $b := .v.branch %><% if and (test.IsKind "map" $b) (has $b "direct_commit") %><% $k %>	<% if test.IsKind "bool" $b.direct_commit %><% $b.direct_commit %><% else %>bad<% end %>
<% end %><% end %><% end %>') || {
    _se_log "cannot read [branch] of $show"
    return 2
  }
  _rs_branch_exists main && main=1
  _rs_branch_exists develop && develop=1
  while IFS="$tab" read -r name value; do
    [[ -n $name ]] || continue
    if [[ $name != main && $name != develop ]]; then
      _se_log "[branch.${name}] in $show: direct_commit is a key of [branch.main] and [branch.develop] only"
      rc=2
    elif [[ $value == bad ]]; then
      _se_log "[branch.${name}] in $show: direct_commit must be true or false"
      rc=2
    elif ! _rs_branch_exists "$name"; then
      _se_log "[branch.${name}] in $show has direct_commit, but the branch '${name}' does not exist - create it, or remove the key"
      rc=2
    elif [[ $value == true ]]; then
      _RS_HOOK_DROP+="$name "
    fi
  done <<< "$out"
  if ((main && develop)) && [[ $_RS_HOOK_DROP == *" main "* && $_RS_HOOK_DROP != *" develop "* ]]; then
    _se_log "[branch.main] in $show has direct_commit = true, but [branch.develop] does not - with main and develop, set direct_commit = true for develop too, or remove it from main"
    rc=2
  fi
  ((main)) || _RS_HOOK_DROP+="main "
  ((develop)) || _RS_HOOK_DROP+="develop "
  return "$rc"
}

# Examine `.config/fnox.toml` of this repo, when it exists: a repository does
# not use the fnox `default` profile. The top-level `[secrets]` table is that
# profile, so the file must not have it, also empty. The file must have 1 or
# more `[profiles.<name>]` tables, and no `[profiles.default]`. Returns 2,
# after a message for each problem.
_rs_fnox_profiles() {
  local values=$1 file="${MISE_PROJECT_ROOT}/.config/fnox.toml" out kind name repo rc=0
  [[ -f $file ]] || return 0
  repo=$(_se_gomplate -c "v=${values}" -i '<% if has .v "repo_name" %><% .v.repo_name %><% end %>') || repo=''
  [[ -n $repo ]] || repo='<repo_name>'
  out=$(_se_gomplate -c "f=${file}" -i '<% if has .f "secrets" %>secrets
<% end %><% if has .f "profiles" %><% if test.IsKind "map" .f.profiles %><% range $k, $p := .f.profiles %>profile <% $k %>
<% end %><% else %>bad
<% end %><% end %>') || {
    _se_log "cannot read .config/fnox.toml"
    return 2
  }
  local count=0
  while read -r kind name; do
    case $kind in
      secrets)
        _se_log ".config/fnox.toml has a top-level [secrets] table, the fnox default profile - move each secret to [profiles.${repo}.secrets], then delete the table (M25 of docs/sync/migrate.md)"
        rc=2
        ;;
      bad)
        _se_log "profiles in .config/fnox.toml must be [profiles.<name>] tables (M25 of docs/sync/migrate.md)"
        rc=2
        ;;
      profile)
        if [[ $name == default ]]; then
          _se_log "[profiles.default] in .config/fnox.toml: a repository does not use the fnox default profile - rename it, for example to [profiles.${repo}] (M25 of docs/sync/migrate.md)"
          rc=2
        else
          ((count += 1))
        fi
        ;;
    esac
  done <<< "$out"
  if ((count == 0)); then
    _se_log ".config/fnox.toml has no named profile - add [profiles.${repo}.secrets]; a repository does not use the fnox default profile (M25 of docs/sync/migrate.md)"
    rc=2
  fi
  return "$rc"
}

# 0 when the path <path> of this repo is a seed or a merge target of a tool of
# this run (a selected tool or a dependency, also through a mise `depends`).
# `_rs_remove` skips such a path; `_se_unblock` refuses to remove it and fails
# that file. The stale rule does not read this list, so it can remove a listed
# path with the header that this run did not handle.
_rs_spared() { [[ $'\n'$_RS_SPARE$'\n' == *$'\n'"$1"$'\n'* ]]; }

# Remove the file <path> of <tool> from this repo, if it exists.
_rs_remove() {
  local tool=$1 path=$2 dry_run=$3 dest show
  _rs_spared "$path" && return 0
  dest="${MISE_PROJECT_ROOT}/${path}"
  show=$(_se_path "$dest")
  [[ -e $dest ]] || return 0
  if ((dry_run)); then
    _se_outcome removed "$show" '' "would remove $show"
    return 0
  fi
  rm -f -- "$dest" || {
    _se_outcome failed "$show" 'cannot remove' "cannot remove $show"
    return 1
  }
  _se_outcome removed "$show" '' "removed    $show"
}

# Print the mode of the target <tool>/<target>: generated without a `mode` key.
_rs_file_mode() {
  local mode=${_RS_FILE_MODES#* "$1="}
  if [[ $mode == "$_RS_FILE_MODES" ]]; then
    printf 'generated'
  else
    printf '%s' "${mode%% *}"
  fi
}

# Print the `format` key of the target <tool>/<target>, or nothing.
_rs_file_format() {
  local format=${_RS_FILE_FORMATS#* "$1="}
  [[ $format == "$_RS_FILE_FORMATS" ]] || printf '%s' "${format%% *}"
}

# Set _RS_REQ_SKIP to the `<tool>/<target>=<file>` lines of the targets with an
# entry of _RS_FILE_CONDS that this repo does not have: a `requires` path that
# does not exist, or a `requires_found` name that `_rs_has_file` does not find.
# <file> is the first such entry, in the order of the lists.
_rs_file_skips() {
  local key kind item
  _RS_REQ_SKIP=$'\n'
  while IFS=$'\t' read -r key kind item; do
    [[ -n $key && $_RS_REQ_SKIP != *$'\n'"$key="* ]] || continue
    if [[ $kind == requires ]]; then
      [[ ! -e ${MISE_PROJECT_ROOT}/${item} ]] || continue
    else
      ! _rs_has_file "$item" || continue
    fi
    _RS_REQ_SKIP+="$key=$item"$'\n'
  done <<< "$_RS_FILE_CONDS"
}

# Do not write the target of the file <path> of <tool>: an entry of its
# `requires` or `requires_found` is not there. A seed that exists stays, as with
# no condition. A seed or a merge target stays as it is. A generated target is
# only logged: it gets no manifest row, so the stale rule removes a listed copy
# with the bootstrap header.
_rs_skip_required() {
  local tool=$1 path=$2 out=${2%.tmpl} requires dest show
  requires=${_RS_REQ_SKIP#*$'\n'"$tool/$out="}
  requires=${requires%%$'\n'*}
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_se_path "$dest")
  case $(_rs_file_mode "$tool/$out") in
    seed)
      _RS_HANDLED+="$out"$'\n'
      if _se_seed_kept "$dest"; then
        _se_outcome kept "$show" '' "kept seed  $show"
      else
        _se_outcome skipped "$show" '' "skip seed  $show (no $requires)"
      fi
      return 0
      ;;
    merge)
      _RS_HANDLED+="$out"$'\n'
      _se_outcome skipped "$show" '' "skip merge $show (no $requires)"
      return 0
      ;;
  esac
  _se_outcome skipped "$show" '' "skip file  $show (no $requires)"
}

# Set _RS_ENVS to the ` <env> ` words of `environments` in <values>, in the
# order of _SE_MISE_ENV_NAMES. Without the key, only dev. Returns 2, after a
# message, for a name other than dev or ci, or no dev.
_rs_envs() {
  local values=$1 list name
  list=$(_rs_list "$values" environments) || {
    _se_log "cannot read $(_se_path "$values")"
    return 2
  }
  if [[ -z ${list//[$'\n ']/} ]]; then
    _se_log "$(_se_path "$values") lists no environments - using dev only; add environments = [\"dev\", ...]"
    list=dev
  fi
  for name in $list; do
    [[ $name == dev || $name == ci ]] && continue
    _se_log "environment '$name' in $(_se_path "$values") is not one of dev, ci"
    return 2
  done
  list=" $(printf '%s ' $list)"
  if [[ $list != *" dev "* ]]; then
    _se_log "environments in $(_se_path "$values") must include dev"
    return 2
  fi
  _RS_ENVS=' '
  for name in $_SE_MISE_ENV_NAMES; do
    [[ $list == *" $name "* ]] && _RS_ENVS+="$name "
  done
  return 0
}

# Succeed when this repo has a file named <name>, at the root or down to 4
# folders below it, that git tracks or does not ignore. A git submodule is
# not searched: it has its own sync.
_rs_has_file() {
  local name=$1 found
  # A `*` of a pathspec also matches a `/`, so awk limits the depth. awk reads
  # to the end: an early exit can fail git with SIGPIPE.
  found=$(git -C "$MISE_PROJECT_ROOT" ls-files --cached --others --exclude-standard -- \
    "$name" "*/$name" 2> /dev/null \
    | awk -v n="$name" -F/ '!f && $NF == n && NF <= 5 { print; f = 1 }') || found=''
  [[ -n $found ]]
}

# The template that examines the keys of `[overrides]` of the values file (`.o`)
# that `sync-engine/mise` does not read. It prints one `<problem> <path> <arg>`
# line, tab separated, for each problem:
#   table    a key of [overrides] that must be a table and is not
#   key      a key of [overrides] other than mise, mise_env and gitignore
#   gikey    a key of [overrides.gitignore] other than add and remove
#   gilist   an add or a remove that is not a list of one-line strings
#   giempty  an empty line in add or remove
# It also prints an `add <path> <line>` or a `remove <path> <line>` line for
# each line of [overrides.gitignore], without the spaces at the start and the
# end. <path> is overrides.gitignore.<list>.
_RS_GITIGNORE_TEMPLATE='<% if and (has .o "overrides") (test.IsKind "map" .o.overrides) -%>
<% range $k, $x := .o.overrides -%>
<% if not (has (coll.Slice "mise" "mise_env" "gitignore") $k) %>key	overrides.<% $k %>	-
<% else if eq $k "gitignore" -%>
<% if not (test.IsKind "map" $x) %>table	overrides.<% $k %>	-
<% else -%>
<% range $gk, $gv := $x -%>
<% if not (has (coll.Slice "add" "remove") $gk) %>gikey	overrides.<% $k %>.<% $gk %>	-
<% else if not (test.IsKind "slice" $gv) %>gilist	overrides.<% $k %>.<% $gk %>	-
<% else -%>
<% range $gv -%>
<% if not (test.IsKind "string" .) %>gilist	overrides.<% $k %>.<% $gk %>	-
<% else if or (strings.Contains "\n" .) (strings.Contains "\t" .) %>gilist	overrides.<% $k %>.<% $gk %>	-
<% else if not (strings.TrimSpace .) %>giempty	overrides.<% $k %>.<% $gk %>	-
<% else %><% $gk %>	overrides.<% $k %>.<% $gk %>	<% strings.TrimSpace . %>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>'

# Examine `[overrides]` of <values> against the tools.toml of each selected
# tool in the clone <dir>: `sync-engine/mise` examines the `mise` and `mise_env`
# keys. Each line of `remove` of `[overrides.gitignore]` must be a line of the
# shipped file, and no line can be in `add` and in `remove`. Sets _RS_GI_ADD and
# _RS_GI_REMOVE to the `gitignore<tab><line>` lines of `add` and `remove`, and
# _RS_VALUES_NOTE to the values file for the override comments. Returns 2, after
# a message for each problem, also when the old `.config/repo-sync/gitignore`
# exists. With a third argument `local`, for `repo_sync --check`, it reads no
# clone: <dir> is not used, no tool is selected, and it skips the problems that
# need the tools or the shipped files. When `_rs_envs` failed, _RS_ENVS is empty.
_rs_overrides() {
  local dir=$1 values=$2 only_local=0 out problem path arg rc=0 show
  [[ ${3:-} == local ]] && only_local=1
  show=$(_se_path "$values")
  _RS_GI_ADD='' _RS_GI_REMOVE='' _RS_VALUES_NOTE=${values#"$MISE_PROJECT_ROOT"/}
  if [[ -f ${MISE_PROJECT_ROOT}/.config/repo-sync/gitignore ]]; then
    _se_log ".config/repo-sync/gitignore is no longer used - move its lines to add of [overrides.gitignore] in $show, then delete it (M18 of docs/sync/migrate.md)"
    rc=2
  fi
  out=$(_se_gomplate -c "o=${values}" -i "$_RS_GITIGNORE_TEMPLATE") || {
    _se_log "cannot read [overrides] of $show"
    return 2
  }
  while IFS=$'\t' read -r problem path arg; do
    case $problem in
      table)
        _se_log "$path in $show must be a table"
        ;;
      key)
        if [[ $path == overrides.graphifyignore ]]; then
          _se_log "$path in $show is no longer used: bootstrap does not ship .graphifyignore - remove the table (M24 of docs/sync/migrate.md)"
        else
          _se_log "$path in $show: the only keys of [overrides] are mise, mise_env and gitignore"
        fi
        ;;
      gikey)
        _se_log "$path in $show: the only keys of [${path%.*}] are add and remove"
        ;;
      gilist)
        _se_log "$path in $show must be a list of one-line strings, for example [\"/build/\"]"
        ;;
      giempty)
        _se_log "$path in $show has an empty line"
        ;;
      add | remove)
        # <path> is overrides.<ignore>.<list>.
        path=${path#overrides.}
        path=${path%.*}
        if [[ $problem == add ]]; then
          _RS_GI_ADD+="$path"$'\t'"$arg"$'\n'
        else
          _RS_GI_REMOVE+="$path"$'\t'"$arg"$'\n'
        fi
        continue
        ;;
      *)
        continue
        ;;
    esac
    rc=2
  done <<< "$out"
  _se_mise_overrides repo "$values" "$dir/$_RS_TOOLS_DIR" "$_RS_TOOLS_DIR" "${_RS_TOOLS:-}" "${_RS_ENVS:-}" "${3:-}" || rc=2
  local ignore line shipped
  while IFS=$'\t' read -r ignore line; do
    [[ -n $line ]] || continue
    shipped=$_RS_TOOLS_DIR/git/.gitignore
    if [[ $'\n'$_RS_GI_ADD == *$'\n'"$ignore"$'\t'"$line"$'\n'* ]]; then
      _se_log "overrides.$ignore in $show: '$line' is in add and in remove - keep one"
      rc=2
    elif ((only_local)); then
      continue
    elif ! RS_LINE=$line awk '{ gsub(/^[ \t]+|[ \t]+$/, "") } $0 == ENVIRON["RS_LINE"] { found = 1 } END { exit !found }' "$dir/$shipped" 2> /dev/null; then
      _se_log "overrides.$ignore.remove in $show: '$line' is not a line of the shipped .$ignore ($shipped)"
      rc=2
    fi
  done <<< "$_RS_GI_REMOVE"
  return "$rc"
}

# Print the extra dev aliases of <tool>, as `<name>=<command>` lines. `setup-all`
# and `setup-<submodule>` exist only in a repo with git submodules. They depend on
# this repo, not on tools.toml, so the `mise` tool, which has the `setup` alias,
# gets them here.
_rs_dev_aliases() {
  local tool=$1 subs sub aliases
  [[ $tool == mise && -f ${MISE_PROJECT_ROOT}/.gitmodules ]] || return 0
  subs=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || subs=''
  [[ -n $subs ]] || return 0
  aliases='setup-all=mise run setup --all'
  for sub in $subs; do
    aliases+=$'\n'"setup-${sub}=mise run setup --${sub}"
  done
  printf '%s\n' "$aliases"
}

# Merge the values of the selected tools with `_se_values`, and write them as
# one JSON object, tool name to values, to _RS_VALUES_FILE in the clone <dir>.
# The user values are each `[tools.<name>]` table of <values> without `env`. The
# base and dependency tools are the tools that the pack base adds (source
# `default` of _RS_SEL) and each dependency of _RS_DEPS. Returns the code of
# `_se_values`, after its messages.
_rs_tool_values() {
  local dir=$1 values=$2 user keep out
  user=$(_se_gomplate -c "v=${values}" -i '<% $u := dict %><% if has .v "tools" %><% range $k, $e := .v.tools %><% $u = coll.Merge (dict $k (coll.Omit "env" $e)) $u %><% end %><% end %><% $u | data.ToJSON %>') || {
    _se_log "cannot read [tools] of $(_se_path "$values")"
    return 2
  }
  keep=$(
    awk '$3 == "default" { print $1 }' <<< "$_RS_SEL"
    awk '{ for (i = 2; i <= NF; i++) print $i }' <<< "$_RS_DEPS"
  ) || keep=''
  out=$(_se_values "$_RS_TOOLS" "$keep" "$dir/$_RS_TOOLS_DIR" "$user" "$_RS_TOOLS_DIR" "$(_se_path "$values")") || return
  _RS_VALUES_FILE="$dir/.repo-sync-values.json"
  printf '%s\n' "$out" | _se_jq -R -n 'reduce (inputs | split("\t")) as $l ({}; .[$l[1]] = ($l[2] | fromjson))' > "$_RS_VALUES_FILE" || {
    _se_log "cannot write the values of the tools"
    return 2
  }
}

# Write the template context to <out>: the values of <values>, with
# `members`, `submodules`, `tools`, `extensions`, `sync_engine`, `precommit` and
# `all` (_RS_VALUES_FILE of `_rs_tool_values`) merged in first, so a key of the
# same name in the values file cannot replace them. The keys `all` and `config`
# of the values file do not go in: a table of that name would merge key by key.
# <dir> is the clone.
_rs_context() {
  local dir=$1 values=$2 out=$3 rows members folders types tool
  rows=$(_rs_members "$values" "template context") || return 2
  members=$(cut -f1 <<< "$rows")
  folders=$(cut -f2 <<< "$rows")
  types=$(cut -f3 <<< "$rows")
  # The git submodules alone: `members` also has the folder members.
  local submodules=''
  if [[ -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    submodules=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || submodules=''
  fi
  # One context per tool manifest, `tool_<name>`, for the `[[precommit]]`
  # entries; `repo_precommit` for the repo's own entries.
  local args=(-c "v=${values}" -c "all_values=${_RS_VALUES_FILE}?type=application/json")
  for tool in $_RS_TOOLS; do
    args+=(-c "tool_${tool}=${dir}/${_RS_TOOLS_DIR}/${tool}/tools.toml")
  done
  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/pre-commit.yaml"
  local has_own=''
  if [[ -f $own ]]; then
    args+=(-c "repo_precommit=${own}")
    has_own=1
  fi
  # The no-commit-to-branch hook loses each `--branch <b>` pair of a branch
  # in _RS_HOOK_DROP (`_rs_direct_commit`). Only that pair form changes. A
  # hook that had a pair and has none left goes, also with other args: without
  # `--branch`, the hook protects main and master. An entry with no hook left
  # goes too.
  REPO_SYNC_SYNC_ENGINE=${dir}/sync-engine REPO_SYNC_HOOK_DROP=$_RS_HOOK_DROP REPO_SYNC_OWN_PRECOMMIT=$has_own REPO_SYNC_MEMBERS=$members REPO_SYNC_MEMBER_FOLDERS=$folders REPO_SYNC_MEMBER_TYPES=$types REPO_SYNC_SUBMODULES=$submodules REPO_SYNC_TOOLS=$(printf '%s\n' $_RS_TOOLS) REPO_SYNC_EXTENSIONS=$_RS_EXTENSIONS \
    _se_gomplate "${args[@]}" -o "$out" \
    -i '<% $ctx := dict %><% range (coll.Slice "members" "submodules" "tools" "extensions") %><% $l := coll.Slice %><% range (env.Getenv (printf "REPO_SYNC_%s" (strings.ToUpper .)) | strings.Split "\n") %><% if . %><% $l = coll.Append . $l %><% end %><% end %><% $ctx = coll.Merge $ctx (dict . $l) %><% end %><% $mf := dict %><% $mt := dict %><% $fl := env.Getenv "REPO_SYNC_MEMBER_FOLDERS" | strings.Split "\n" %><% $tl := env.Getenv "REPO_SYNC_MEMBER_TYPES" | strings.Split "\n" %><% range $i, $n := $ctx.members %><% $mf = coll.Merge (dict $n (index $fl $i)) $mf %><% $mt = coll.Merge (dict $n (index $tl $i)) $mt %><% end %><% $ctx = coll.Merge $ctx (dict "member_folders" $mf "member_types" $mt "sync_engine" (env.Getenv "REPO_SYNC_SYNC_ENGINE")) %><% $pc := coll.Slice %><% range $ctx.tools %><% $t := index $ (printf "tool_%s" .) %><% if has $t "precommit" %><% range $t.precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% end %><% if env.Getenv "REPO_SYNC_OWN_PRECOMMIT" %><% range $.repo_precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% $drop := strings.Split " " (strings.TrimSpace (env.Getenv "REPO_SYNC_HOOK_DROP")) -%>
<% $npc := coll.Slice -%>
<% range $e := $pc -%>
<% $ne := $e %><% $keep := true -%>
<% if and (test.IsKind "map" $e) (has $e "hooks") (test.IsKind "slice" (index $e "hooks")) -%>
<% $hs := coll.Slice %><% $chg := false -%>
<% range $h := index $e "hooks" -%>
<% $nh := $h %><% $hk := true -%>
<% if and (test.IsKind "map" $h) (has $h "id") (eq (printf "%v" (index $h "id")) "no-commit-to-branch") (has $h "args") (test.IsKind "slice" (index $h "args")) -%>
<% $in := index $h "args" %><% $n := len $in %><% $a := coll.Slice %><% $had := false %><% $left := false %><% $skip := false -%>
<% range $i, $x := $in -%>
<% if $skip %><% $skip = false -%>
<% else if and (eq (printf "%v" $x) "--branch") (lt (math.Add $i 1) $n) -%>
<% $had = true %><% $skip = true %><% $b := index $in (math.Add $i 1) -%>
<% if not (has $drop (printf "%v" $b)) %><% $left = true %><% $a = coll.Append $b (coll.Append $x $a) %><% end -%>
<% else %><% $a = coll.Append $x $a %><% end -%>
<% end -%>
<% if $had -%>
<% if not $left %><% $hk = false %><% $chg = true -%>
<% else if ne (len $a) $n %><% $nh = coll.Merge (dict "args" $a) $h %><% $chg = true %><% end -%>
<% end -%>
<% end -%>
<% if $hk %><% $hs = coll.Append $nh $hs %><% end -%>
<% end -%>
<% if $chg %><% if $hs %><% $ne = coll.Merge (dict "hooks" $hs) $e %><% else %><% $keep = false %><% end %><% end -%>
<% end -%>
<% if $keep %><% $npc = coll.Append $ne $npc %><% end -%>
<% end -%>
<% $ctx = coll.Merge $ctx (dict "precommit" $npc "all" .all_values) %><% coll.Merge $ctx (coll.Omit "all" "config" .v) | data.ToJSON %>' >&2
}

# Write <folder>/<tool>.json for each selected tool with a `.tmpl` file: the
# shared context of the file <shared> plus `config`, the values of that tool.
# <dir> is the clone. Returns 1, after a message, when a file cannot be written.
_rs_tool_contexts() {
  local dir=$1 shared=$2 folder=$3 tool tools='' rows json
  for tool in $_RS_TOOLS; do
    [[ -z $(find "$dir/$_RS_TOOLS_DIR/$tool" -name '*.tmpl' -type f -print -quit) ]] || tools+="$tool "
  done
  [[ -n $tools ]] || return 0
  rows=$(_se_jq -r --arg tools "$tools" '. as $c | $tools | split(" ")[] | select(. != "") | "\(.)\t\($c + {config: $c.all[.]} | tojson)"' "$shared") || {
    _se_log "cannot build the context of the tools"
    return 1
  }
  while IFS=$'\t' read -r tool json; do
    printf '%s\n' "$json" > "$folder/$tool.json" || {
      _se_log "cannot write the context of $tool"
      return 1
    }
  done <<< "$rows"
}

# Sync the file <path> of <tool> from the clone in <dir>, first step: render
# the file into a temp file, and merge a merge target with the live target.
# Leaves the destination untouched when it is a seed that exists, or on any
# failure. Else it adds `<tool><tab><path><tab><temp file>` to
# _RS_PENDING and sets _RS_DEFERRED, and `_rs_file_finish` does the rest after
# `_rs_format`.
_rs_file() {
  local dir=$1 tool=$2 path=$3 dry_run=$4 ctx=$5
  local src="${dir}/${_RS_TOOLS_DIR}/${tool}/${path}" out=${path%.tmpl}
  local dest destdir tmp show rc=0 env mode format target_format
  _RS_DEFERRED=''
  mode=$(_rs_file_mode "$tool/$out")
  format=$(_rs_file_format "$tool/$out")
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_se_path "$dest")
  # A mise file of an environment that this repo does not use. It gets no
  # manifest row, so the stale rule removes a listed copy with the header. A
  # seed stays.
  if [[ $out == .config/mise/conf.d/*/mise.*.toml ]]; then
    env=${out##*/mise.}
    env=${env%.toml}
    if [[ $_RS_ENVS != *" $env "* ]]; then
      [[ $mode == generated ]] || _RS_HANDLED+="$out"$'\n'
      _se_outcome skipped "$show" '' "skip env   $show"
      return 0
    fi
  fi

  if [[ $mode == seed ]] && _se_seed_kept "$dest"; then
    _RS_HANDLED+="$out"$'\n'
    _se_outcome kept "$show" '' "kept seed  $show"
    return 0
  fi

  # A merge target below a symlinked folder: the repo side follows no symlink,
  # and that folder can point outside this repo. It comes before `_se_unblock`,
  # `mkdir` and the temp file, so nothing is written through the link. The walk
  # goes from the repo root down, and does not test the root itself.
  if [[ $mode == merge ]]; then
    local folder=$MISE_PROJECT_ROOT rest=$out
    while [[ $rest == */* ]]; do
      folder+="/${rest%%/*}"
      rest=${rest#*/}
      if [[ -L $folder ]]; then
        _se_outcome failed "$show" "the folder $(_se_path "$folder") is a symlink - kept it as it is" "$show: the folder $(_se_path "$folder") is a symlink - kept it as it is"
        [[ -e $dest ]] && _se_outcome failed "$show" 'kept existing' "kept existing $show"
        return 2
      fi
    done
  fi

  # A synced file can become a folder in a later layout, for example
  # code/format -> code/format/_default. Remove the old synced file that is in
  # the way. A file without the header is the repo's, and a seed and a merge
  # target stay, so the sync stops there.
  _se_unblock "$(dirname -- "$dest")" "$MISE_PROJECT_ROOT" "$dry_run" "$_RS_SPARE" "$show" || return 1

  if ((dry_run)); then
    destdir=${TMPDIR:-/tmp}
  else
    destdir=$(dirname -- "$dest")
    mkdir -p -- "$destdir" || {
      _se_outcome failed "$show" "cannot create $(_se_path "$destdir")" "cannot create $(_se_path "$destdir")"
      return 1
    }
  fi
  # Temp file in the destination directory so the final mv is atomic.
  _se_tmp "$destdir" > /dev/null || {
    _se_outcome failed "$show" "cannot create a temp file in $(_se_path "$destdir")" "cannot create a temp file in $(_se_path "$destdir")"
    return 1
  }
  tmp=$_SE_TMP

  if [[ $path == *.tmpl ]]; then
    if [[ -z $ctx ]]; then
      rc=2
      _se_outcome failed "$show" 'cannot write the target'
    elif ! _se_gomplate -c ".=${ctx}?type=application/json" -f "$src" -o "$tmp" >&2; then
      _se_outcome failed "$show" 'gomplate failed to render the template' "$_RS_TOOLS_DIR/$tool/$path: gomplate failed to render the template"
      rc=2
    fi
  else
    cp -- "$src" "$tmp" || {
      rc=1
      _se_outcome failed "$show" 'cannot write the target'
    }
  fi
  # The hook revisions: each one becomes the newest tag, chosen by
  # `pre-commit autoupdate` itself. The `rev` in a tools.toml is a real tag, so
  # an older repo-sync without this step still writes a config that runs. A later autoupdate in
  # this repo then picks the same tags, so it and the sync never undo each
  # other. It needs the network; on a failure the existing file stays.
  # REPO_SYNC_NO_AUTOUPDATE=1 skips it, for the tests.
  if ((rc == 0)) && [[ $out == .config/pre-commit-config.yaml ]]; then
    if [[ ${REPO_SYNC_NO_AUTOUPDATE:-} == 1 ]]; then
      _se_log "$_RS_TOOLS_DIR/$tool/$path: REPO_SYNC_NO_AUTOUPDATE=1 - pre-commit autoupdate skipped"
    elif ! command -v pre-commit > /dev/null 2>&1; then
      _se_outcome failed "$show" 'pre-commit is not available to resolve the hook revisions' "$_RS_TOOLS_DIR/$tool/$path: pre-commit is not available to resolve the hook revisions"
      rc=5
    elif ! (cd "$MISE_PROJECT_ROOT" && pre-commit autoupdate --config "$tmp" > /dev/null 2>&1); then
      _se_outcome failed "$show" 'pre-commit autoupdate failed - examine the network and the hook repositories' "$_RS_TOOLS_DIR/$tool/$path: pre-commit autoupdate failed - examine the network and the hook repositories"
      rc=5
    fi
  fi

  # A JSON, YAML or TOML target must parse, before dprint can change it.
  if ((rc == 0)); then
    # The JSONC rule is not for a merge target: its format is its `format` key,
    # else its extension.
    if [[ $mode == merge ]]; then
      target_format=$(_se_format "$out" /dev/null "$format")
    else
      target_format=$(_se_format "$out" "$tmp" "$format")
    fi
    _se_parse_check "$tmp" "$target_format" "$show" || rc=$?
  fi

  # A merge target that is a symlink, also a dangling one: the merge reads the
  # live target, and a symlink can point outside this repo. The link stays.
  if ((rc == 0)) && [[ $mode == merge && -L $dest ]]; then
    _se_outcome failed "$show" 'is a symlink - kept it as it is' "$show is a symlink - kept it as it is"
    rc=2
  fi

  # A merge target: merge with the live target, before dprint. The merge source
  # is read as it is: the sync strips nothing.
  if ((rc == 0)) && [[ $mode == merge ]]; then
    local key kind json remove='[]' remove_items='[]'
    while IFS=$'\t' read -r key kind json; do
      [[ $key == "$tool/$out" ]] || continue
      if [[ $kind == remove ]]; then
        remove=$json
      else
        remove_items=$json
      fi
    done <<< "$_RS_FILE_MERGE"
    _se_merge "$tmp" "$dest" "$target_format" "$remove" "$remove_items" "$tmp" "$show" || rc=$?
  fi

  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _se_outcome failed "$show" 'kept existing' "kept existing $show"
    return "$rc"
  fi

  # A rendered template or a generated mise config goes through this repo's
  # formatter before the compare. Otherwise the format hook changes the
  # render, and the next sync writes it back: a loop. A plain file needs no
  # step, because dprint formats its source in bootstrap. A merge target is
  # formatted too: it holds the keys of the app. The file goes to the
  # stage, at its path in this repo, and `_rs_format` formats the stage in one
  # dprint call.
  if [[ ($path == *.tmpl || $mode == merge || $_RS_GENERATED == *" $tool/$path "*) && -n $_RS_STAGE ]]; then
    mkdir -p -- "$(dirname -- "$_RS_STAGE/$out")" && cp -- "$tmp" "$_RS_STAGE/$out" || true
  fi
  _RS_PENDING+="$tool"$'\t'"$path"$'\t'"$tmp"$'\n'
  _RS_DEFERRED=1
}

# Format the files of the stage in one dprint call. The stage has a copy of
# the dprint config of this repo at the same path, so the plugins and the
# excludes select the same files as in this repo. Without dprint, or if
# dprint fails for a file, the raw render of that file stays.
_rs_format() {
  [[ -n $_RS_STAGE ]] || return 0
  local files name
  files=$(cd "$_RS_STAGE" && find . -type f | sed 's#^\./##' | grep -vxE '\.?dprint\.jsonc?|\.config/dprint\.jsonc?') || files=''
  [[ -n $files ]] || return 0
  (cd "$MISE_PROJECT_ROOT" && mise x -- bash -c 'cd "$1" && dprint fmt --no-gitignore --allow-no-files --stdin-files' _ "$_RS_STAGE" <<< "$files") > /dev/null 2>&1 || true
}

# Sync the file <path> of <tool>, second step: take the formatted copy from the
# stage, apply the overrides, and compare and write the temp file <tmp> of
# `_rs_file`.
_rs_file_finish() {
  local dir=$1 tool=$2 path=$3 dry_run=$4 tmp=$5
  local src="${dir}/${_RS_TOOLS_DIR}/${tool}/${path}" out=${path%.tmpl}
  local dest show rc=0
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_se_path "$dest")
  if [[ -n $_RS_STAGE && -f $_RS_STAGE/$out ]]; then
    cp -- "$_RS_STAGE/$out" "$tmp" || true
  fi

  # [overrides.gitignore]: comment out each line of `remove`, then add the
  # lines of `add` at the end, so they win.
  if ((rc == 0)) && [[ $path == .gitignore && -n $_RS_GI_REMOVE$_RS_GI_ADD ]]; then
    local gi_add gi_remove
    gi_add=$(printf '%s' "$_RS_GI_ADD" | sed -n "s/^${path#.}"$'\t'"//p")
    gi_remove=$(printf '%s' "$_RS_GI_REMOVE" | sed -n "s/^${path#.}"$'\t'"//p")
    if [[ -n $gi_add$gi_remove ]]; then
      {
        RS_REMOVE=$gi_remove RS_NOTE="# override: removed by $_RS_VALUES_NOTE" awk '
          BEGIN { n = split(ENVIRON["RS_REMOVE"], r, "\n"); for (i = 1; i <= n; i++) if (r[i] != "") rm[r[i]] = 1 }
          { t = $0; gsub(/^[ \t]+|[ \t]+$/, "", t) }
          t in rm { print "# " t "  " ENVIRON["RS_NOTE"]; next }
          { print }
        ' "$tmp" &&
          if [[ -n $gi_add ]]; then
            printf '\n# ==== Overrides from %s ====\n%s\n' "$_RS_VALUES_NOTE" "$gi_add"
          fi
      } > "$tmp.gi" && mv -f -- "$tmp.gi" "$tmp" || {
        rc=1
        _se_outcome failed "$show" 'cannot write the target'
      }
    fi
  fi
  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _se_outcome failed "$show" 'kept existing' "kept existing $show"
    return "$rc"
  fi

  # The file takes the mode of its source in bootstrap, also when it exists:
  # a template task is executable because its `.tmpl` is. mktemp creates 0600.
  # An existing merge target keeps its own mode: the app owns it.
  local mode
  if [[ -e $dest && $(_rs_file_mode "$tool/$out") == merge ]]; then
    mode=$(_se_mode "$dest")
  else
    mode=$(_se_mode "$src")
  fi
  _se_finish "$mode" "$tmp" "$dest" "$show" "$dry_run" "$(_rs_file_mode "$tool/$out")" || return
  _RS_HANDLED+="$out"$'\n'
  if [[ $(_rs_file_mode "$tool/$out") == generated ]]; then
    _RS_ROWS+="$tool"$'\t'"$out"$'\n'
  fi
}

# Warn about `core_tools` of <values>, a key that is no longer used.
_rs_core_tools() {
  local values=$1 old_core
  old_core=$(_rs_list "$values" core_tools) || old_core=''
  if [[ -n ${old_core//[$'\n ']/} ]]; then
    _se_log "core_tools in $(_se_path "$values") is no longer used - delete it; the env of each [tools.*] entry, else default_envs, decides its environments"
  fi
  return 0
}

# Run each check of `repo_sync --check` on <values>, in the order of the
# sync, and print each message. A check whose input failed is skipped: its
# cause is already reported. Returns the highest code, or 0 after a line that
# says the file is valid.
_rs_check() {
  local values=$1 rc=0 r sel='' sel_ok=1 envs_ok=1
  _RS_ENVS='' _RS_TOOLS=''
  _rs_envs "$values" || {
    r=$? envs_ok=0
    ((r <= rc)) || rc=$r
  }
  sel=$(_rs_values_sel "$values") || {
    r=$? sel_ok=0
    ((r <= rc)) || rc=$r
  }
  if ((envs_ok && sel_ok)); then
    _rs_env_rules "$values" "$sel" || {
      r=$?
      ((r <= rc)) || rc=$r
    }
  fi
  _rs_merge_model || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_core_tools "$values"
  _rs_overrides '' "$values" local || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_direct_commit "$values" || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_fnox_profiles "$values" || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  _rs_members "$values" "${values#"$MISE_PROJECT_ROOT"/}" > /dev/null || {
    r=$?
    ((r <= rc)) || rc=$r
  }
  ((rc == 0)) && _se_log "$(_se_path "$values"): valid (local rules)"
  return "$rc"
}

# repo_sync [--dry-run | --check]
#
# Copy the clone of `SYNC_ENGINE_CLONE` once, resolve the tools of the values
# file, then sync every file of every tool. Returns the most severe failure code, or 0.
# With --check, examine only the rules that need no clone (`_rs_check`).
repo_sync() {
  local dry_run=0 check=0
  while (($#)); do
    case $1 in
      --dry-run)
        dry_run=1
        shift
        ;;
      --check)
        check=1
        shift
        ;;
      *)
        _se_log "usage: repo_sync [--dry-run | --check]"
        return 2
        ;;
    esac
  done
  if ((dry_run && check)); then
    _se_log "usage: repo_sync [--dry-run | --check]"
    return 2
  fi

  local values=${REPO_SYNC_VALUES:-${MISE_PROJECT_ROOT:-$PWD}/.config/bootstrap.toml}
  # `.config/repo-config.toml` is the old name, from before this repository
  # was renamed to bootstrap.
  local old_values="${MISE_PROJECT_ROOT:-$PWD}/.config/repo-config.toml"
  if [[ -z ${REPO_SYNC_VALUES:-} && ! -f $values && -f $old_values ]]; then
    _se_log "$(_se_path "$old_values") is the old name of the values file - rename it to .config/bootstrap.toml"
    values=$old_values
  fi
  if [[ ! -f $values ]]; then
    _se_log "values file $(_se_path "$values") not found - it lists the tools to sync"
    return 2
  fi
  if ! command -v mise > /dev/null 2>&1; then
    _se_log "mise is not available - install it from https://mise.run"
    return 2
  fi
  # The tool wrappers run from `/`, so each path that they get is absolute.
  [[ $values == /* ]] || values="$PWD/$values"
  if ((check)); then
    _rs_check "$values" || return
    return 0
  fi

  if [[ -z ${SYNC_ENGINE_CLONE:-} ]]; then
    _se_log "SYNC_ENGINE_CLONE is not set - run mise run setup:configs, which clones bootstrap"
    return 2
  fi
  local dir rev
  dir=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync.XXXXXX") || {
    _se_log "cannot create a temp directory"
    return 1
  }
  _SE_TMPS+=("$dir")
  # A clone that `setup:configs` already made, so that this code and the
  # files come from the same commit. A private copy, because the sync writes
  # the generated mise config into its clone.
  if [[ ! -e $SYNC_ENGINE_CLONE/.git ]] || ! cp -R -- "$SYNC_ENGINE_CLONE/." "$dir"; then
    _se_log "cannot use the clone $SYNC_ENGINE_CLONE - nothing synced; existing files were left untouched"
    return 5
  fi
  rev=$(git -C "$dir" rev-parse --short HEAD)
  _se_outcome_start "$dry_run"
  if _se_verbose; then
    _se_log "using bootstrap at ${rev}"
  fi
  # The full id, for `bootstrap_commit` after a sync without a failure.
  local commit
  commit=$(git -C "$dir" rev-parse HEAD) || commit=''

  # The formatter for rendered templates; empty when dprint is not available.
  _RS_DPRINT=''
  mise x -- which dprint > /dev/null 2>&1 && _RS_DPRINT=1

  local rc=0
  { _rs_envs "$values" && _rs_mise_index "$dir" && _rs_resolve "$dir" "$values" && _rs_extensions "$dir" "$values"; } || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  if _se_verbose; then
    _se_log "tools:${_RS_TOOLS% }"
    _se_log "environments:${_RS_ENVS% }"
  else
    _se_info "bootstrap ${rev} · $(_se_count_words "$_RS_TOOLS") tools · environments:${_RS_ENVS% }"
  fi
  _rs_merge_model || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  _rs_file_skips

  _rs_core_tools "$values"

  # The mise config of each tool, generated into the clone before the file
  # loop. A tool that fails keeps its existing files and counts as failed.
  local tool written worst=0 failed=()
  _RS_GENERATED=' '
  # The rows of the manifest, and the paths that the stale rule must not remove:
  # the files of the selected tools and their dependencies that this run writes
  # or keeps, and the merge tasks of the other model, which `_rs_remove` handles.
  local skipped
  _RS_ROWS='' _RS_HANDLED=''
  for skipped in $_RS_SKIP; do
    _RS_HANDLED+="${skipped#*/}"$'\n'
  done
  { _se_mise_envs repo "$_RS_ENVS" "$_RS_SEL" "$_RS_DEFAULT_ENVS" "$_RS_DEPS" "$_RS_MISE_ENTRIES" "$_RS_MISE_FOUND" "$_RS_TOOLS_DIR" _rs_has_file && _rs_overrides "$dir" "$values" && _rs_direct_commit "$values" && _rs_fnox_profiles "$values" && _rs_tool_values "$dir" "$values"; } || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  for tool in $_RS_TOOLS; do
    rc=0
    _se_mise_render repo "$dir/$_RS_TOOLS_DIR" "$_RS_TOOLS_DIR" "$tool" "$values" "$dir/$_RS_TOOLS_DIR/$tool/.config/mise/conf.d" "$(_rs_dev_aliases "$tool")" "$_RS_VALUES_FILE" || rc=$?
    for written in $_SE_MISE_WRITTEN; do
      _RS_GENERATED+="$tool/.config/mise/conf.d/$written "
    done
    if ((rc != 0)); then
      failed+=("$_RS_TOOLS_DIR/$tool/tools.toml [mise]")
      ((rc > worst)) && worst=$rc
    fi
  done

  # The context is built once, and only when a template needs it, then one
  # file for each tool with a template. An empty path tells `_rs_file` that it
  # could not be built, so each template fails and every plain file still syncs.
  local ctx='' ctx_dir=''
  if [[ -n $(find "$dir/$_RS_TOOLS_DIR" -name '*.tmpl' -type f -print -quit) ]]; then
    ctx=$(mktemp "${TMPDIR:-/tmp}/repo-sync-ctx.XXXXXX") || {
      rm -rf -- "$dir"
      return 1
    }
    _SE_TMPS+=("$ctx")
    ctx_dir=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync-ctx.XXXXXX") || {
      rm -rf -- "$dir"
      return 1
    }
    _SE_TMPS+=("$ctx_dir")
    { _rs_context "$dir" "$values" "$ctx" && _rs_tool_contexts "$dir" "$ctx" "$ctx_dir"; } || {
      _se_log "cannot build the template context"
      ctx=''
    }
  fi

  # The stage of `_rs_format`, with a copy of the dprint config of this repo.
  _RS_STAGE='' _RS_PENDING=''
  local name
  if [[ -n $_RS_DPRINT ]] && _RS_STAGE=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync-stage.XXXXXX"); then
    _SE_TMPS+=("$_RS_STAGE")
    for name in dprint.json dprint.jsonc .dprint.json .dprint.jsonc .config/dprint.json .config/dprint.jsonc; do
      if [[ -f $MISE_PROJECT_ROOT/$name ]]; then
        mkdir -p -- "$(dirname -- "$_RS_STAGE/$name")" && cp -- "$MISE_PROJECT_ROOT/$name" "$_RS_STAGE/$name"
      fi
    done
  else
    _RS_STAGE=''
  fi

  local path ok=0 total=0 tmp
  for tool in $_RS_TOOLS; do
    while IFS= read -r path; do
      [[ -n $path ]] || continue
      ((total += 1))
      rc=0 _RS_DEFERRED=''
      if [[ $_RS_SKIP == *" $tool/$path "* ]]; then
        _rs_remove "$tool" "$path" "$dry_run" || rc=$?
      elif [[ $_RS_REQ_SKIP == *$'\n'"$tool/${path%.tmpl}="* ]]; then
        _rs_skip_required "$tool" "$path" || rc=$?
      else
        _rs_file "$dir" "$tool" "$path" "$dry_run" "${ctx:+$ctx_dir/$tool.json}" || rc=$?
      fi
      if ((rc != 0)); then
        _se_outcome failed "$(_se_path "${MISE_PROJECT_ROOT}/${path%.tmpl}")" 'cannot write the target'
        failed+=("$_RS_TOOLS_DIR/$tool/$path")
        ((rc > worst)) && worst=$rc
      elif [[ -z $_RS_DEFERRED ]]; then
        ((ok += 1))
      fi
    done < <(cd "$dir/$_RS_TOOLS_DIR/$tool" && find . -type f ! -name tools.toml | sed 's#^\./##' | sort)
  done

  _rs_format
  while IFS=$'\t' read -r tool path tmp; do
    [[ -n $tool ]] || continue
    rc=0
    _rs_file_finish "$dir" "$tool" "$path" "$dry_run" "$tmp" || rc=$?
    if ((rc == 0)); then
      ((ok += 1))
    else
      _se_outcome failed "$(_se_path "${MISE_PROJECT_ROOT}/${path%.tmpl}")" 'cannot write the target'
      failed+=("$_RS_TOOLS_DIR/$tool/$path")
      ((rc > worst)) && worst=$rc
    fi
  done <<< "$_RS_PENDING"
  [[ -n $_RS_STAGE ]] && rm -rf -- "$_RS_STAGE"
  rm -rf -- "$dir"

  # Only a sync without a failure removes stale files and writes the manifest,
  # so a failure here leaves the old manifest for the next clean run.
  if ((${#failed[@]} == 0)); then
    local manifest="${MISE_PROJECT_ROOT}/.config/repo-generated.tsv" old_rows step=.config/repo-generated.tsv
    rc=0
    old_rows=$(_se_manifest_read repo "$manifest" "$MISE_PROJECT_ROOT") || rc=$?
    if ((rc == 0)); then
      step="stale files"
      _se_manifest_stale repo "$old_rows" "$_RS_HANDLED" "$MISE_PROJECT_ROOT" "$dry_run" || rc=$?
    fi
    if ((rc == 0)); then
      step=.config/repo-generated.tsv
      _se_manifest_write "$manifest" "$_RS_ROWS" "$dry_run" || rc=$?
    fi
    if ((rc != 0)); then
      failed+=("$step")
      ((rc > worst)) && worst=$rc
    fi
  fi

  if ((${#failed[@]} == 0)); then
    # Only a sync without a failure records its commit: then each file is
    # at that commit, and an agent can compare it with main of bootstrap.
    if [[ -n $commit ]]; then
      _se_record_commit "$values" bootstrap_commit "$commit" "$dry_run" "# The bootstrap commit of the last sync. repo-sync writes it." || {
        _se_summary 1
        return 1
      }
    fi
    if _se_verbose; then
      _se_log "done: $ok/$total files in sync"
    fi
    _se_summary 0
    return 0
  fi
  _se_log "FAILED: ${failed[*]}"
  if _se_verbose; then
    _se_log "$ok/$total files in sync; existing copies of the rest were left untouched"
  fi
  _se_summary "$worst"
  return "$worst"
}
