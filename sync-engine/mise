# Synced from bootstrap: sync-engine/mise. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
# shellcheck shell=bash

# mise — the mise config generator of the sync engine, one library for each
# side. A front-end sources it after `common`. The first parameter of each
# function is the side, `repo` or `macos`; any other value is a usage error,
# code 2. A <tools-dir> is the absolute folder of the tools, and a <shown> is
# that folder in a message and a header, for example repo/tools.
#
#   _se_mise_envs <side> <envs> <sel> <default-envs> <deps> <entries> <found> <shown> <has-file>
#     The environments of each tool and of each mise tool (see below). The macos
#     side has no environments: it only clears the results.
#   _se_mise_overrides <side> <values> <tools-dir> <shown> <tools> <envs> [local]
#     Examine the `mise` and `mise_env` keys of `[overrides]` of <values>, before
#     any write. `local` needs no tools: it skips the check of each path.
#   _se_mise_render <side> <tools-dir> <shown> <tool> <values> <conf.d> <aliases> <all-values>
#     Generate the mise config of <tool> into <conf.d>/<tool>/, and name each
#     file in _SE_MISE_WRITTEN as `<tool>/<name>` words. A failure returns 2 for
#     this tool and writes nothing more: the caller goes on with the other tools.
#   _se_mise_own_config <side> <values> <conf.d> <tools> <all-values>
#     Generate the `[mise.*]` tables of <values> into <conf.d>/zz-macos/mise.toml.
#     Only for the side macos.
#
# <all-values> is a JSON file, tool name to the merged values of `sync-engine/values`.
# Empty: no values. <aliases> holds `<name>=<command>` lines for `[shell_alias]` of
# dev; the macos side ignores it.
#
# The sections of `[mise.*]`:
#   * `tools`, `tool_alias` and `plugins` follow each entry. `settings`, `env`,
#     `tool_config`, `task_config`, `task_templates`, `doctor`, `deps` and `oci`
#     go to each environment of the tool. The others of the dev-only list of
#     _SE_MISE_TEMPLATE, also `bootstrap` and `dotfiles`, go to dev only, when the
#     tool is in dev. Any other section stops the mise config of that tool.
#   * `[mise_env.<env>]` is added to that environment as it is, when the tool is
#     in it.
#   * Side repo: one `mise.<env>.toml` for each selected environment with content.
#     Side macos: one `mise.toml`, with every valid section. A `[mise_env.*]`
#     table, and `envs` or `requires_found` in a `[mise.tools]` entry, stop the
#     mise config of that tool.
#
# The environments (side repo): a tool of <sel> gets its `env`, else its
# `default_envs`, and each dependency gets each environment of each tool that
# needs it. <envs> limits every result. Each mise tool gets the environments of
# its tool, unless a name of its `requires_found` is not found. The `envs` of a
# mise tool (default dev) lists the environments that it allows; a tool in another
# one stops the sync.
#
# The overrides: `[overrides.mise.<path>]` and `[overrides.mise_env.<env>.<path>]`
# replace the defaults of the tools. The path after `overrides.` is the path in a
# tools.toml, without the tool name: each selected tool with a value at that path
# gets the override. `[overrides.mise_env.<env>]` is for that environment only, and
# it wins over `[overrides.mise]`. A table merges key by key; any other value
# replaces the default. A path that no selected tool has, and the `envs`, the
# `depends`, the `requires`, the `requires_found` and the `files` of a mise tool,
# stop the sync. Each overridden line gets an `# override: <values file>` comment.
# On the side macos, `[overrides.mise_env]` stops the run. Each other key of
# `[overrides]` is for the front-end.
#
# The render: a tools.toml that holds `<%` is rendered with gomplate into a temp
# copy, and the generator reads the copy. The context has .config (the values of
# the tool), .all (the values of every selected tool) and .env (HOME, USER). A key
# that is missing reaches `required` as a nil; any other use of it fails the render.
# The overrides of the values file are not rendered.

_SE_MISE_MACOS_VALUES=macos.toml

# The environment names that a tools.toml can use in `default_envs` and `envs`, in
# their order. bootstrap is only for dev and ci. `environments` of the values file
# limits them.
_SE_MISE_ENV_NAMES='dev ci'
_se_mise_env_name() {
  _se_mise_side "$1" || return
  [[ -n $2 && $2 != *[[:space:]]* && " $_SE_MISE_ENV_NAMES " == *" $2 "* ]]
}

# 0 for a known side. Returns 2, after a message, for any other.
_se_mise_side() {
  case $1 in
    repo | macos) return 0 ;;
  esac
  _se_log "sync-engine/mise: the side must be repo or macos, not '$1'"
  return 2
}

# The temp files of the render and the generator, removed by the exit trap of
# `common`.
_SE_MISE_WORK=''
_se_mise_work() {
  _se_mise_side "$1" || return
  [[ -n $_SE_MISE_WORK && -d $_SE_MISE_WORK ]] && return 0
  local base=${TMPDIR:-/tmp}
  _SE_MISE_WORK=$(mktemp -d "${base%/}/sync-engine-mise.XXXXXX") || {
    _se_log "cannot create a temp directory"
    return 1
  }
  _SE_TMPS+=("$_SE_MISE_WORK")
}

# Set _SE_MISE_SELECTED to <envs>, _SE_MISE_TOOL_ENVS to the ` <tool>:<env> ` words
# and _SE_MISE_ENVS to the ` <mise-tool>:<env> ` words of the selected environments.
# <sel> holds the `<tool> <env,...|-> <source>` lines of `_se_selected`,
# <default-envs> the ` <tool>:<env> ` words, <deps> the `<tool> <dependency>...`
# lines, <entries> the `<tool> <mise-tool> <envs,...|-> [<mise-depends>...]` lines
# and <found> the `<mise-tool><tab><name>` lines. <has-file> is the function that
# finds a name of `requires_found`. A tool that runs in CI needs its dependencies
# there too. Returns 2, after a message, for an unknown name in `envs`, or for a
# tool in an environment that one of its mise tools does not allow in its `envs`.
_se_mise_envs() {
  local side=$1 selected=$2 sel=$3 default_envs=$4 all_deps=$5 entries=$6 all_found=$7 shown=$8 has_file=$9
  _se_mise_side "$side" || return
  _SE_MISE_SELECTED='' _SE_MISE_TOOL_ENVS=' ' _SE_MISE_ENVS=' '
  [[ $side == repo ]] || return 0
  _SE_MISE_SELECTED=$selected
  local tool envs src deps dep entry allowed from env name changed=1
  # ` <tool>:<env>=<source> `: why the tool is in the environment, for the
  # message of a mise tool that does not allow it.
  local reasons=' '
  while read -r tool envs src; do
    [[ -n $tool ]] || continue
    if [[ $envs == - ]]; then
      envs=''
      for env in $default_envs; do
        [[ $env == "$tool":* ]] && envs+="${env#*:},"
      done
      src=default
    fi
    for env in ${envs//,/ }; do
      [[ $selected == *" $env "* && $_SE_MISE_TOOL_ENVS != *" $tool:$env "* ]] || continue
      _SE_MISE_TOOL_ENVS+="$tool:$env "
      reasons+="$tool:$env=$src "
    done
  done <<< "$sel"
  while ((changed)); do
    changed=0
    while read -r tool deps; do
      [[ -n $tool ]] || continue
      for env in $selected; do
        [[ $_SE_MISE_TOOL_ENVS == *" $tool:$env "* ]] || continue
        for dep in $deps; do
          if [[ $_SE_MISE_TOOL_ENVS != *" $dep:$env "* ]]; then
            _SE_MISE_TOOL_ENVS+="$dep:$env "
            reasons+="$dep:$env=$tool "
            changed=1
          fi
        done
      done
    done <<< "$all_deps"
  done
  local found item present
  while read -r tool entry allowed _; do
    [[ -n $entry ]] || continue
    [[ $allowed == - ]] && allowed=dev
    present=1
    while IFS=$'\t' read -r found item; do
      [[ $found == "$entry" ]] || continue
      "$has_file" "$item" || present=0
    done <<< "$all_found"
    for name in ${allowed//,/ }; do
      if ! _se_mise_env_name "$side" "$name"; then
        _se_log "envs of mise tool '$entry' in $shown/$tool/tools.toml: '$name' is not one of ${_SE_MISE_ENV_NAMES// /, }"
        return 2
      fi
    done
    for env in $selected; do
      [[ $_SE_MISE_TOOL_ENVS == *" $tool:$env "* ]] || continue
      if [[ ,$allowed, != *",$env,"* ]]; then
        from=${reasons#* "$tool:$env="}
        from=${from%% *}
        case $from in
          default)
            _se_log "$shown/$tool/tools.toml: default_envs has '$env', but its mise tool '$entry' allows only ${allowed//,/, }"
            ;;
          tools.* | packs.*)
            _se_log "env '$env' of [$from] in the values file: mise tool '$entry' of $shown/$tool allows only ${allowed//,/, }"
            ;;
          *)
            _se_log "$shown/$from needs $shown/$tool in '$env', but its mise tool '$entry' allows only ${allowed//,/, }"
            ;;
        esac
        return 2
      fi
      ((present)) || continue
      [[ $_SE_MISE_ENVS == *" $entry:$env "* ]] || _SE_MISE_ENVS+="$entry:$env "
    done
  done <<< "$entries"
  return 0
}

# The templates that the override check and the mise template share.
# `se_leaves` prints the key path of each value of the table .v that is not a
# table, as a JSON list after the path .p, one per line. `se_has` prints 1 when
# the table .v has a value at the path .p that is not a table.
_SE_MISE_DEFINES='<% define "se_leaves" %><% range $k, $x := .v %><% $p := coll.Append $k $.p %><% if test.IsKind "map" $x %><% template "se_leaves" (dict "p" $p "v" $x) %><% else %><% $p | data.ToJSON %>
<% end %><% end %><% end -%>
<% define "se_has" %><% $v := .v %><% $ok := true %><% range .p %><% if not (test.IsKind "map" $v) %><% $ok = false %><% else if not (has $v .) %><% $ok = false %><% else %><% $v = index $v . %><% end %><% end %><% if and $ok (not (test.IsKind "map" $v)) %>1<% end %><% end -%>
'

# The template that examines the `mise` and `mise_env` keys of `[overrides]` of the
# values file (`.o`) against the tools.toml of each selected tool (`.tool_<name>`,
# the names in SYNC_ENGINE_MISE_TOOLS). It prints one `<problem> <path> <arg>` line,
# tab separated, for each problem:
#   table    a key of [overrides] that must be a table and is not
#   noenv    [overrides.mise_env] on the side macos
#   envname  an environment of [overrides.mise_env] that is not dev or ci
#   env      an environment that is not in SYNC_ENGINE_MISE_ENVS
#   lock     an `envs`, a `depends`, a `requires`, a `requires_found` or a
#            `files` of a mise tool
#   none     a value that no selected tool has; <arg> is the path in tools.toml
_SE_MISE_OVERRIDES_TEMPLATE="$_SE_MISE_DEFINES"'<% if has .o "overrides" -%>
<% $ov := .o.overrides -%>
<% $side := env.Getenv "SYNC_ENGINE_MISE_SIDE" -%>
<% $envs := env.Getenv "SYNC_ENGINE_MISE_ENVS" -%>
<% $tools := strings.Split " " (env.Getenv "SYNC_ENGINE_MISE_TOOLS") -%>
<% if not (test.IsKind "map" $ov) %>table	overrides	-
<% else -%>
<% $ov = coll.Pick "mise" "mise_env" $ov -%>
<% range $k, $x := $ov -%>
<% if and (eq $side "macos") (eq $k "mise_env") %>noenv	overrides.mise_env	-
<% else if not (test.IsKind "map" $x) %>table	overrides.<% $k %>	-
<% else if eq $k "mise_env" -%>
<% range $e, $y := $x -%>
<% if not (has (coll.Slice "dev" "ci") $e) %>envname	overrides.mise_env.<% $e %>	<% $e %>
<% else if not (strings.Contains (printf " %s " $e) $envs) %>env	overrides.mise_env.<% $e %>	<% $e %>
<% else if not (test.IsKind "map" $y) %>table	overrides.mise_env.<% $e %>	-
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% range strings.Split "\n" (tmpl.Exec "se_leaves" (dict "p" (coll.Slice) "v" $ov)) -%>
<% if . -%>
<% $p := data.JSONArray . -%>
<% $k := index $p 0 -%>
<% $rest := coll.Slice -%>
<% $only := "" -%>
<% if and (eq $k "mise") (gt (len $p) 1) %><% $rest = slice $p 1 -%>
<% else if and (eq $k "mise_env") (gt (len $p) 2) (has (coll.Slice "dev" "ci") (index $p 1)) (strings.Contains (printf " %s " (index $p 1)) $envs) %><% $rest = slice $p 2 %><% $only = index $p 1 %><% end -%>
<% if $rest -%>
<% if and (gt (len $rest) 2) (eq (index $rest 0) "tools") (has (coll.Slice "envs" "depends" "requires" "requires_found" "files") (index $rest 2)) -%>
lock	overrides.<% join $p "." %>	-
<% else -%>
<% $found := false -%>
<% range $tools -%>
<% if . -%>
<% $t := index $ (printf "tool_%s" .) -%>
<% if tmpl.Exec "se_has" (dict "v" (index $t "mise") "p" $rest) %><% $found = true %><% end -%>
<% if has $t "mise_env" -%>
<% range $e, $y := $t.mise_env -%>
<% if and (strings.Contains (printf " %s " $e) $envs) (or (not $only) (eq $only $e)) (tmpl.Exec "se_has" (dict "v" $y "p" $rest)) %><% $found = true %><% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% if not $found -%>
none	overrides.<% join $p "." %>	<% if $only %>mise_env.<% $only %>.<% join $rest "." %> or <% end %>mise.<% join $rest "." %>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>'

# Examine the `mise` and `mise_env` keys of `[overrides]` of <values> against the
# tools.toml of each tool of <tools> in <tools-dir>. Each value must replace a value
# that a selected tool has, at the same path below `[mise]` or `[mise_env.<env>]`.
# The `envs`, the `depends`, the `requires`, the `requires_found` and the `files` of
# a mise tool decide the tools and the environments, so they cannot be overridden.
# Returns 2, after a message for each problem. With a last argument `local`, for
# `repo_sync --check`, it needs no tools, and it skips `none`. When <envs> is empty,
# the caller already reported the cause, and it also skips `env` and `envname`.
_se_mise_overrides() {
  local side=$1 values=$2 tools_dir=$3 shown=$4 tools=$5 envs=$6 only_local=0 out tool problem path arg rc=0 show
  _se_mise_side "$side" || return
  [[ ${7:-} == local ]] && only_local=1
  ((only_local)) && tools=''
  show=$(_se_path "$values")
  local args=(-c "o=${values}")
  for tool in $tools; do
    args+=(-c "tool_${tool}=${tools_dir}/${tool}/tools.toml")
  done
  out=$(SYNC_ENGINE_MISE_SIDE=$side SYNC_ENGINE_MISE_ENVS=$envs SYNC_ENGINE_MISE_TOOLS=$tools _se_gomplate "${args[@]}" -i "$_SE_MISE_OVERRIDES_TEMPLATE") || {
    _se_log "cannot read [overrides] of $show"
    return 2
  }
  local lock_hint=' - use env of [tools.<tool>]'
  [[ $side == repo ]] || lock_hint=''
  while IFS=$'\t' read -r problem path arg; do
    case $problem in
      table)
        _se_log "$path in $show must be a table"
        ;;
      noenv)
        _se_log "$path in $show: the macos side has no environments - use [overrides.mise.<path>]"
        ;;
      envname | env)
        # Without environments, the caller already reported the cause.
        [[ -n ${envs// /} ]] || continue
        if [[ $problem == envname ]]; then
          _se_log "$path in $show: '$arg' is not one of ${_SE_MISE_ENV_NAMES// /, }"
        else
          _se_log "$path in $show: '$arg' is not in environments:${envs% }"
        fi
        ;;
      lock)
        _se_log "$path in $show: the envs, the depends, the requires, the requires_found and the files of a mise tool cannot be overridden$lock_hint"
        ;;
      none)
        ((only_local)) && continue
        _se_log "$path in $show: no selected tool has $arg - the path after overrides. is the path in $shown/<tool>/tools.toml"
        ;;
      *)
        continue
        ;;
    esac
    rc=2
  done <<< "$out"
  return "$rc"
}

# The template that builds one output from the `[mise]` and `[mise_env]` tables of
# a tools.toml (`.t`), as TOML. On the side repo, the output is the environment
# SYNC_ENGINE_MISE_ENV. An entry is in it when ` <name>:<env> ` is in
# SYNC_ENGINE_MISE_ENVS. The other sections, and `[mise_env.<env>]`, are in it only
# when SYNC_ENGINE_MISE_IN is 1 (the tool is in the environment); the dev-only
# sections only in dev. On the side macos, the one output has each entry and each
# section, and `[mise_env]`, `envs` and `requires_found` stop the render. A section
# that it does not know stops the render. SYNC_ENGINE_MISE_DEV_ALIASES adds
# `<name>=<command>` lines to `[shell_alias]` of dev.
# Before that, each value of the `mise` and `mise_env` keys of `[overrides]` of the
# values file (`.o`) replaces the value at its path in `[mise]` and in
# `[mise_env.<env>]`, where the tool has it. A value of `[overrides.mise_env.<env>]`
# goes to `[mise_env.<env>]`, so it wins over `[overrides.mise]`. After the TOML, a
# `#@override <path>` line names each output path that an override changed.
# SYNC_ENGINE_MISE_OWN is the own config of a values file: no `.o`, no overrides.
_SE_MISE_TEMPLATE="$_SE_MISE_DEFINES"'<% $m := dict %><% if has .t "mise" %><% $m = .t.mise %><% end -%>
<% $macos := eq (env.Getenv "SYNC_ENGINE_MISE_SIDE") "macos" -%>
<% if and $macos (has .t "mise_env") %><% test.Fail "[mise_env.*] is not valid on the macos side, which has no environments" %><% end -%>
<% $env := env.Getenv "SYNC_ENGINE_MISE_ENV" -%>
<% $me := dict %><% if and (has .t "mise_env") (has .t.mise_env $env) %><% $me = index .t.mise_env $env %><% end -%>
<% $marks := coll.Slice -%>
<% if and (not (env.Getenv "SYNC_ENGINE_MISE_OWN")) (has .o "overrides") (test.IsKind "map" .o.overrides) -%>
<% $ov := coll.Pick "mise" "mise_env" .o.overrides -%>
<% range strings.Split "\n" (tmpl.Exec "se_leaves" (dict "p" (coll.Slice) "v" $ov)) -%>
<% if . -%>
<% $p := data.JSONArray . -%>
<% $k := index $p 0 -%>
<% $rest := coll.Slice -%>
<% if and (eq $k "mise") (gt (len $p) 1) %><% $rest = slice $p 1 -%>
<% else if and (eq $k "mise_env") (gt (len $p) 2) (eq (index $p 1) $env) %><% $rest = slice $p 2 %><% end -%>
<% if $rest -%>
<% $v := $ov %><% range $p %><% $v = index $v . %><% end -%>
<% $n := $v %><% range math.Seq (math.Sub (len $rest) 1) 0 %><% $n = dict (index $rest .) $n %><% end -%>
<% $inm := tmpl.Exec "se_has" (dict "v" $m "p" $rest) -%>
<% $ine := tmpl.Exec "se_has" (dict "v" $me "p" $rest) -%>
<% if and $inm (eq $k "mise") %><% $m = coll.Merge $n $m %><% end -%>
<% if or $ine (and $inm (eq $k "mise_env")) %><% $me = coll.Merge $n $me %><% end -%>
<% if or $inm $ine %><% $marks = coll.Append (join $rest ".") $marks %><% end -%>
<% end -%>
<% end -%>
<% end -%>
<% end -%>
<% $envw := env.Getenv "SYNC_ENGINE_MISE_ENVS" -%>
<% $entry := coll.Slice "tools" "tool_alias" "plugins" -%>
<% $folder := coll.Slice "settings" "env" "tool_config" "task_config" "task_templates" "doctor" "deps" "oci" -%>
<% $devonly := coll.Slice "vars" "secrets" "redactions" "shell_alias" "hooks" "watch_files" "daemons" "daemon_groups" "daemons_settings" "daemon_providers" "tasks" "bootstrap" "dotfiles" -%>
<% $in := or $macos (eq (env.Getenv "SYNC_ENGINE_MISE_IN") "1") -%>
<% $out := dict -%>
<% range $s, $body := $m -%>
<% if has $entry $s -%>
<% $a := dict -%>
<% range $k, $v := $body -%>
<% if and (eq $s "tools") (test.IsKind "map" $v) -%>
<% if $macos -%>
<% range coll.Slice "envs" "requires_found" %><% if has $v . %><% test.Fail (printf "%s of mise tool %s is not valid on the macos side, which has no environments and no requires_found" . $k) %><% end %><% end -%>
<% end -%>
<% $v = coll.Omit "envs" "requires_found" $v -%>
<% end -%>
<% if or $macos (strings.Contains (printf " %s:%s " $k $env) $envw) %><% $a = coll.Merge (dict $k $v) $a %><% end -%>
<% end -%>
<% if $a %><% $out = coll.Merge (dict $s $a) $out %><% end -%>
<% else if has $folder $s -%>
<% if $in %><% $out = coll.Merge (dict $s $body) $out %><% end -%>
<% else if has $devonly $s -%>
<% if and $in (or $macos (eq $env "dev")) %><% $out = coll.Merge (dict $s $body) $out %><% end -%>
<% else -%>
<% test.Fail (printf "[mise.%s] is not supported in a tools.toml" $s) -%>
<% end -%>
<% end -%>
<% range $s, $body := $me -%>
<% if not (or (has $entry $s) (has $folder $s) (has $devonly $s)) %><% test.Fail (printf "[mise_env.%s.%s] is not supported in a tools.toml" $env $s) %><% end -%>
<% if $in -%>
<% if has $out $s %><% $body = coll.Merge $body (index $out $s) %><% end -%>
<% $out = coll.Merge (dict $s $body) $out -%>
<% end -%>
<% end -%>
<% $extra := env.Getenv "SYNC_ENGINE_MISE_DEV_ALIASES" -%>
<% if and $in (eq $env "dev") $extra -%>
<% $al := dict %><% if has $out "shell_alias" %><% $al = index $out "shell_alias" %><% end -%>
<% range (strings.Split "\n" $extra) %><% if . %><% $kv := strings.SplitN "=" 2 . %><% $al = coll.Merge (dict (index $kv 0) (index $kv 1)) $al %><% end %><% end -%>
<% $out = coll.Merge (dict "shell_alias" $al) $out -%>
<% end -%>
<% if $out %><% $out | data.ToTOML %><% end -%>
<% range $marks %>#@override <% . %>
<% end -%>'

# Set _SE_MISE_READ to the file that the generator reads for <file>: <file> itself,
# or a temp copy, rendered with gomplate, when it holds `<%`. <shown> names <file>
# in a message, and <name> names the temp files. The jq <filter> builds the context
# from the JSON file <all> (empty: no values), with $t, the name, and $tools; .env
# is added to it. The context file goes after the render. Returns 2, after a
# message, for a render that fails or a copy that is not valid TOML.
_se_mise_read() {
  local side=$1 file=$2 shown=$3 name=$4 all=$5 filter=$6 tools=${7:-} ctx copy err msg
  _se_mise_side "$side" || return
  _SE_MISE_READ=$file
  grep -qF -- '<%' "$file" || return 0
  ctx="$_SE_MISE_WORK/$name.ctx.json" copy="$_SE_MISE_WORK/$name.toml" err="$_SE_MISE_WORK/$name.err"
  # shellcheck disable=SC2016
  {
    if [[ -n $all ]]; then cat -- "$all"; else printf '{}\n'; fi
  } | _se_jq --arg t "$name" --arg tools "$tools" --arg home "${HOME:-}" --arg user "${USER:-}" \
    "$filter"' + {env: {HOME: $home, USER: $user}}' > "$ctx" || {
    _se_log "$shown: cannot build the context of the render"
    return 2
  }
  # `--missing-key default`: `required` must see a key that is missing. The check
  # of `<no value>` below keeps any other use of such a key an error.
  if ! _se_gomplate --missing-key default -c ".=${ctx}?type=application/json" -f "$file" -o "$copy" 2> "$err"; then
    msg=$(sed -n 's/.*error calling [A-Za-z.]*: //p' "$err" | sed 's/"}$//')
    [[ -n $msg ]] || msg=$(sed -n 's/.*"err":"//p' "$err" | sed 's/"}$//')
    [[ -n $msg ]] || msg=$(tr '\n' ' ' < "$err")
    rm -f -- "$ctx"
    _se_log "$shown: cannot render: $msg"
    return 2
  fi
  rm -f -- "$ctx"
  if grep -qF -- '<no value>' "$copy"; then
    _se_log "$shown: cannot render: an expression has no value - a key is missing"
    return 2
  fi
  if ! msg=$(_se_yq -p toml -o json '.' "$copy" 2>&1 > /dev/null); then
    _se_log "$shown: not valid TOML after render: ${msg%%$'\n'*}"
    return 2
  fi
  _SE_MISE_READ=$copy
}

# Build one output of the file <src> into _SE_MISE_OUT, with `[overrides]` of
# <values> applied (empty: the own config, no overrides). Each line that an override
# changed gets the comment <note>. Sets _SE_MISE_FULL to 1 when the output has
# content, else to ''. Returns 2, after a message that names <shown>, when the config
# cannot be generated.
_se_mise_generate() {
  local side=$1 src=$2 values=$3 env=$4 in=$5 aliases=$6 note=$7 shown=$8 err="$_SE_MISE_WORK/generate.err"
  _se_mise_side "$side" || return
  local args=(-c "t=${src}") own=1
  if [[ -n $values ]]; then
    args+=(-c "o=${values}")
    own=''
  fi
  _SE_MISE_OUT="$_SE_MISE_WORK/generate.toml" _SE_MISE_FULL=''
  # gomplate writes no file for an empty output, so the previous one must go.
  rm -f -- "$_SE_MISE_OUT"
  if ! SYNC_ENGINE_MISE_SIDE=$side SYNC_ENGINE_MISE_OWN=$own SYNC_ENGINE_MISE_ENV=$env SYNC_ENGINE_MISE_ENVS=${_SE_MISE_ENVS:-} SYNC_ENGINE_MISE_IN=$in SYNC_ENGINE_MISE_DEV_ALIASES=$aliases \
    _se_gomplate "${args[@]}" -i "$_SE_MISE_TEMPLATE" -o "$_SE_MISE_OUT" 2> "$err"; then
    _se_log "$shown: cannot generate the mise config: $(sed -n 's/.*error calling Fail: template generation failed: //p' "$err" | sed 's/"}$//')"
    return 2
  fi
  [[ -e $_SE_MISE_OUT ]] || return 0
  # The `#@override <path>` lines name the overridden keys. Mark each of
  # them in the TOML, then drop those lines. <path> is the table header and
  # the key, joined with dots and without quotes.
  awk -v note="$note" '
    FNR == NR { if (index($0, "#@override ") == 1) mark[substr($0, 12)] = 1; next }
    index($0, "#@override ") == 1 { next }
    /^[ \t]*\[/ { head = $0; gsub(/^[ \t]*\[+|\]+[ \t]*$|"/, "", head) }
    !/^[ \t]*\[/ && / = / {
      key = $0; sub(/ = .*/, "", key); gsub(/^[ \t]+|"/, "", key)
      if ((head == "" ? key : head "." key) in mark) $0 = $0 "  " note
    }
    { print }
  ' "$_SE_MISE_OUT" "$_SE_MISE_OUT" > "$_SE_MISE_OUT.marked" && mv -f -- "$_SE_MISE_OUT.marked" "$_SE_MISE_OUT" || return 1
  [[ -s $_SE_MISE_OUT && -n $(tr -d ' \n' < "$_SE_MISE_OUT") ]] || return 0
  _SE_MISE_FULL=1
}

# Write _SE_MISE_OUT to <folder>/<name>, below the header that names <source>, and
# add `<folder name>/<name>` to _SE_MISE_WRITTEN.
_se_mise_put() {
  local side=$1 source=$2 folder=$3 name=$4 line1
  _se_mise_side "$side" || return
  # shellcheck disable=SC2059
  printf -v line1 "$_SE_HEADER_LINE1" "$source"
  mkdir -p -- "$folder" &&
    { printf '# %s\n# %s\n\n' "$line1" "$_SE_HEADER_LINE2" && cat -- "$_SE_MISE_OUT"; } > "$folder/$name" &&
    chmod 644 "$folder/$name" || return 1
  _SE_MISE_WRITTEN+="${folder##*/}/$name "
}

# See the top of this file. Each line that an override changed gets an
# `# override: <values>` comment. Returns 2, after a message, when the config cannot
# be generated; the existing files of the tool are then kept.
_se_mise_render() {
  local side=$1 tools_dir=$2 shown=$3 tool=$4 values=$5 confd=$6 aliases=$7 all=${8:-}
  _se_mise_side "$side" || return
  _SE_MISE_WRITTEN=''
  _se_mise_work "$side" || return
  local file="$shown/$tool/tools.toml" src
  # shellcheck disable=SC2016
  _se_mise_read "$side" "$tools_dir/$tool/tools.toml" "$file" "$tool" "$all" '{config: (.[$t] // {}), all: .}' || return
  src=$_SE_MISE_READ
  local env name in note out="$confd/$tool"
  if [[ $side == macos ]]; then
    note="# override: $_SE_MISE_MACOS_VALUES"
    _se_mise_generate macos "$src" "$values" '' 1 '' "$note" "$file" || return
    [[ -z $_SE_MISE_FULL ]] || _se_mise_put "$side" "$file" "$out" mise.toml || return
    return 0
  fi
  note="# override: ${values#"$MISE_PROJECT_ROOT"/}"
  for env in $_SE_MISE_SELECTED; do
    name=mise.${env}.toml
    in=0
    [[ $_SE_MISE_TOOL_ENVS == *" $tool:$env "* ]] && in=1
    _se_mise_generate repo "$src" "$values" "$env" "$in" "$aliases" "$note" "$file" || return
    [[ -n $_SE_MISE_FULL ]] || continue
    if [[ -e $out/$name ]]; then
      _se_log "$shown/$tool ships .config/mise/conf.d/$tool/$name and also generates it from [mise] - remove one"
      return 2
    fi
    _se_mise_put "$side" "$file" "$out" "$name" || return
  done
}

# See the top of this file. `.all` has the values of the tools of <tools>. No
# `[mise]` table: no file. Returns 2, after a message, when the config cannot be
# generated.
_se_mise_own_config() {
  local side=$1 values=$2 confd=$3 tools=$4 all=${5:-} has
  _se_mise_side "$side" || return
  if [[ $side != macos ]]; then
    _se_log "sync-engine/mise: the own config is only for the side macos"
    return 2
  fi
  _SE_MISE_WRITTEN=''
  has=$(_se_gomplate -c "v=${values}" -i '<% if has .v "mise" %>1<% end %>') || {
    _se_log "cannot read $(_se_path "$values")"
    return 2
  }
  [[ -n $has ]] || return 0
  _se_mise_work "$side" || return
  local source="$_SE_MISE_MACOS_VALUES [mise]"
  # shellcheck disable=SC2086
  tools=$(printf '%s ' $tools)
  # shellcheck disable=SC2016
  _se_mise_read "$side" "$values" "$_SE_MISE_MACOS_VALUES" zz-macos "$all" '{all: with_entries(select(.key as $k | $tools | split(" ") | index($k)))}' "$tools" || return
  _se_mise_generate macos "$_SE_MISE_READ" '' '' 1 '' '' "$_SE_MISE_MACOS_VALUES" || return
  [[ -z $_SE_MISE_FULL ]] || _se_mise_put "$side" "$source" "$confd/zz-macos" mise.toml
}
