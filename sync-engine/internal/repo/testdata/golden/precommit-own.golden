--- .config/pre-commit-config.yaml (current)
+++ .config/pre-commit-config.yaml (bootstrap)
@@ -1 +1,112 @@
-x
+---
+# Synced from bootstrap: repo/tools/pre-commit/.config/pre-commit-config.yaml.tmpl. Do not edit this file.
+# The next sync replaces it, and a manual change is lost.
+# The pre-commit config. repo_sync renders it from the `[[precommit]]` entries
+# of the selected tools, then the entries of `.config/repo-sync/pre-commit.yaml`.
+#
+# pre-commit does not find a config under `.config/`. `setup:precommit` installs
+# the hooks with the path, so `git commit` needs no flag. `pre-commit run` needs
+# `--config .config/pre-commit-config.yaml`.
+
+# 3.2.0 is the first version with the `pre-commit` and `pre-push` stage names.
+minimum_pre_commit_version: "3.2.0"
+
+# `commit-msg` is for the conventional-commits hook. A hook type that is not
+# installed never runs.
+default_install_hook_types:
+  - pre-commit
+  - commit-msg
+
+default_stages: [ pre-commit ]
+
+# No hook reads these paths: the `exclude` values of this tool, the selected
+# tools and `[tools.pre-commit]` of `.config/bootstrap.toml`, merged.
+exclude: "(^|/)\\.config/mise/locks/"
+repos:
+  - repo: local
+    hooks:
+      - id: git-config
+        name: "Forbidden local git-config"
+        description: "Prevents a local .git/config from overriding global user and signing settings."
+        entry: "mise x -- mise run code:git-config --fix"
+        language: "system"
+        pass_filenames: false
+        always_run: true
+  - repo: https://github.com/pre-commit/pre-commit-hooks
+    rev: v6.0.0
+    hooks:
+      - id: no-commit-to-branch
+        name: "Refuse a direct commit to a protected branch"
+        description: "These branches take merges only. git runs pre-merge-commit for a merge, so merges are not affected."
+        args: [ "--branch", "main" ]
+  - repo: https://github.com/qoomon/git-conventional-commits
+    rev: v2.9.0
+    hooks:
+      - id: conventional-commits
+        name: "Conventional Commits"
+        args: [ "--config", ".config/git-conventional-commits.yaml" ]
+        stages: [ "commit-msg" ]
+  - repo: https://github.com/pre-commit/pre-commit-hooks
+    rev: v6.0.0
+    hooks:
+      - id: check-added-large-files
+        name: "Check for added large files (>1MB)"
+        args: [ "--maxkb=1024" ]
+      - id: check-case-conflict
+        name: "Check for case-conflicting filenames"
+      - id: check-illegal-windows-names
+        name: "Check for filenames Windows cannot check out"
+      - id: check-executables-have-shebangs
+        name: "Check that executables have shebangs"
+      - id: check-shebang-scripts-are-executable
+        name: "Check that scripts with shebangs are executable"
+      - id: check-merge-conflict
+        name: "Check for merge conflict markers"
+      - id: check-symlinks
+        name: "Check for broken symlinks"
+      - id: destroyed-symlinks
+        name: "Check for destroyed symlinks"
+      - id: check-json
+        name: "Check JSON syntax"
+        exclude: "(^|/)tsconfig[^/]*\\.json$|(^|/)\\.vscode/"
+      - id: check-toml
+        name: "Check TOML syntax"
+      - id: check-yaml
+        name: "Check YAML syntax"
+        args: [ "--allow-multiple-documents" ]
+      - id: detect-private-key
+        name: "Check for committed private keys"
+      - id: end-of-file-fixer
+        name: "Ensure files end with a newline"
+      - id: trailing-whitespace
+        name: "Remove trailing whitespace"
+      - id: mixed-line-ending
+        name: "Normalise line endings to LF"
+        args: [ "--fix=lf" ]
+  - repo: local
+    hooks:
+      - id: format
+        name: "Format (mise run code:format)"
+        description: "The repo's formatters, run over the files being committed."
+        entry: "mise x -- mise run code:format --fix"
+        language: "system"
+        pass_filenames: true
+        require_serial: true
+  - repo: local
+    hooks:
+      - id: lint
+        name: "Lint (mise run code:lint)"
+        description: "The repo's linters, run over the files being committed."
+        entry: "mise x -- mise run code:lint --fix"
+        language: "system"
+        pass_filenames: true
+        require_serial: true
+  - repo: local
+    hooks:
+      - id: sec
+        name: "Secrets (mise run code:sec --staged)"
+        description: "The secret scan, over what is staged rather than over the tree."
+        entry: "mise x -- mise run code:sec --staged"
+        language: "system"
+        pass_filenames: false
+        always_run: true
