{
  "format": "yaml",
  "show": "~/.config/merger/m.yaml",
  "src": "scalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - drop\n  - b\nkind:\n  - 1\n",
  "live": "a: 1\n---\nb: 2\n",
  "remove": "[[\"gone\"]]",
  "remove_items": "[{\"path\":[\"list\"],\"items\":[\"drop\"]}]",
  "rc": 2,
  "stderr": "x: ~/.config/merger/m.yaml has more than one YAML document - kept it as it is\n",
  "out": null
}
