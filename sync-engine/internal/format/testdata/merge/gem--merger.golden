  "remove": "[]",
  "remove_items": "[]",
  "rc": 0,
  "stderr": "",
  "out": "# top comment\nkeep: app # after keep\nscalar: app\nnested:\n  # own line\n  set: 0\nlist:\n  - x\n  - drop\n  - drop\nkind:\n  was: table\n:verbose: false\n:backtrace: true\nupdate: --no-document\ninstall: --no-document\n"
}
