  "src": "# Merged by bootstrap: macos/tools/superfile/Library/Application Support/superfile/config.toml\n# Only these keys are enforced; superfile owns every other key. All keys:\n# https://superfile.dev/configure/superfile-config/\n\n# A partial config is valid: superfile uses its default for a missing key.\nignore_missing_fields = true\n\ncase_sensitive_sort = true\n# \"\" for builtin chroma, \"bat\" for bat.\ncode_previewer = \"bat\"\ndefault_open_file_preview = false\n# (0: Name, 1: Size, 2: Date Modified, 3: Type, 4: Natural).\ndefault_sort_type = 4\n# true: SI decimal units of 1000 (kB, MB, GB).\nfile_size_use_si = true\nsidebar_sections = [ \"pinned\", \"disks\", \"home\" ]\ntransparent_background = true\n# Requires: zoxide\nzoxide_support = true\n",
