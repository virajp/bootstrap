{
  "format": "toml",
  "show": "~/.config/merger/m.toml",
  "src": "scalar = \"src\"\n\n[nested]\nset = 1\nlist = [\"x\", \"y\"]\n",
  "live": "# my config\ntheme = \"monokai\" # theme\nsidebar_sections = [\"home\", \"x\"]\nzoxide_support = false\nfile_size_use_si = false\n\n[plugins]\nenabled = [\"a\"]\n",
  "remove": "[[\"gone\"]]",
  "remove_items": "[{\"path\":[\"notlist\"],\"items\":[\"s\"]}]",
  "rc": 0,
  "stderr": "",
  "out": "# my config\ntheme = \"monokai\"  # theme\nsidebar_sections = [\"home\", \"x\"]\nzoxide_support = false\nfile_size_use_si = false\nscalar = \"src\"\n\n[plugins]\nenabled = [\"a\"]\n\n[nested]\nset = 1\nlist = [\"x\", \"y\"]\n"
}
