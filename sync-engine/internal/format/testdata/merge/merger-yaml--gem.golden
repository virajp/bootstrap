{
  "format": "yaml",
  "show": "~/.config/merger/m.yaml",
  "src": "scalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - drop\n  - b\nkind:\n  - 1\n",
  "live": "# my gemrc\n:verbose: true # loud\n:backtrace: false\ngem: --no-document\nupdate: --user-install\n:sources:\n  - https://rubygems.org/\n",
  "remove": "[[\"gone\"]]",
  "remove_items": "[{\"path\":[\"list\"],\"items\":[\"drop\"]}]",
  "rc": 0,
  "stderr": "",
  "out": "# my gemrc\n:verbose: true # loud\n:backtrace: false\ngem: --no-document\nupdate: --user-install\n:sources:\n  - https://rubygems.org/\nscalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - b\nkind:\n  - 1\n"
}
