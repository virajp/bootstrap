{
  "format": "json",
  "show": "~/x.json",
  "src": "{\"a\":{\"b\":[\"x\",\"y\",\"drop\"]},\"c\":[[\"drop\"],\"k\"]}",
  "live": "[1]\n",
  "remove": "[[\"a\",\"b\",\"0\"],[\"c\"]]",
  "remove_items": "[{\"path\":[\"a\",\"b\"],\"items\":[\"drop\",\"x\"]},{\"path\":[\"c\"],\"items\":[[\"drop\"]]}]",
  "rc": 2,
  "stderr": "x: ~/x.json holds a list, not a table - kept it as it is\n",
  "out": null
}
