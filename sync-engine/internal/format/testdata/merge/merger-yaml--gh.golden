{
  "format": "yaml",
  "show": "~/.config/merger/m.yaml",
  "src": "scalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - drop\n  - b\nkind:\n  - 1\n",
  "live": "# gh config\nversion: \"1\"\ngit_protocol: https # old\neditor: nano\naliases:\n  co: pr checkout\n  mine: pr list --author @me\nhttp_unix_socket:\nbrowser:\n",
  "remove": "[[\"gone\"]]",
  "remove_items": "[{\"path\":[\"list\"],\"items\":[\"drop\"]}]",
  "rc": 0,
  "stderr": "",
  "out": "# gh config\nversion: \"1\"\ngit_protocol: https # old\neditor: nano\naliases:\n  co: pr checkout\n  mine: pr list --author @me\nhttp_unix_socket:\nbrowser:\nscalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - b\nkind:\n  - 1\n"
}
