{
  "format": "toml",
  "show": "~/.config/merger/m.toml",
  "src": "scalar = \"src\"\n\n[nested]\nset = 1\nlist = [\"x\", \"y\"]\n",
  "live": "# head comment\nkeep = \"app\" # after keep\nscalar = \"app\"\nnotlist = \"s\"\ngone = 1\n\n# own line\n[nested]\nset = 0\nlist = [\"x\"]\n",
  "remove": "[[\"gone\"]]",
  "remove_items": "[{\"path\":[\"notlist\"],\"items\":[\"s\"]}]",
  "rc": 0,
  "stderr": "",
  "out": "# head comment\nkeep = \"app\"  # after keep\nscalar = \"src\"\nnotlist = \"s\"\n\n# own line\n[nested]\nset = 1\nlist = [\"x\", \"y\"]\n"
}
