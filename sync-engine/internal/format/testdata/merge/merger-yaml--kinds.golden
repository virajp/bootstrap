{
  "format": "yaml",
  "show": "~/.config/merger/m.yaml",
  "src": "scalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - drop\n  - b\nkind:\n  - 1\n",
  "live": "scalar:\n  - 1\nnested: 3\nlist: x\nkind: 5\nversion:\n  a: 1\n",
  "remove": "[[\"gone\"]]",
  "remove_items": "[{\"path\":[\"list\"],\"items\":[\"drop\"]}]",
  "rc": 0,
  "stderr": "",
  "out": "version:\n  a: 1\nscalar: src\nnested:\n  set: 1\nlist:\n  - x\n  - b\nkind:\n  - 1\n"
}
