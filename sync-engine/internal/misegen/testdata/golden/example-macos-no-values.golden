== out/conf.d/mise/mise.toml 644
# Synced from bootstrap: macos/tools/mise/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[shell_alias]
  cancelPrintJobs = "sudo cancel -a -x"
  listServices = "launchctl list | grep -v '^-' | sort -n | grep -v 'com.apple'"
  osx-upgrade = "mise run upgrade:macos:upgrade"
  updateall = "mise run updateall"

[tools]
  [tools.ruby]
    version = "latest"
  [tools.usage]
    version = "latest"
== out/conf.d/network/mise.toml 644
# Synced from bootstrap: macos/tools/network/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.packages]
    "brew:doggo" = "latest"
    "brew:gping" = "latest"
    "brew:httping" = "latest"
    "brew:ipcalc" = "latest"
    "brew:prettyping" = "latest"

[shell_alias]
  dig = "doggo"
  dns = "scutil --dns"
  flushdns = "dscacheutil -flushcache"
  gateway = "mise run ips:gateway"
  hping = "httping --ts -GBbXsSYaWZvv"
  ii = "mise run ips:ii"
  ipInfo0 = "ipconfig getpacket en0"
  ips = "mise run ips:ips"
  ipv4 = "mise run ips:ipv4"
  ipv6 = "mise run ips:ipv6"
  openports = "sudo lsof -i -P | grep LISTEN"
  ping = "prettyping -i 2 --nolegend"
  remoteip = "mise run ips:remoteip"
  routes = "netstat -nr -f inet"
== out/conf.d/node/mise.toml 644
# Synced from bootstrap: macos/tools/node/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[env]
  NODE_ENV = "development"
  [env._]
    [env._.path]
      path = "node_modules/.bin"
      tools = true

[settings]
  [settings.node]
    compile = false
  [settings.npm]
    package_manager = "aube"

[tools]
  [tools.node]
    version = "lts"
== out/conf.d/python/mise.toml 644
# Synced from bootstrap: macos/tools/python/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[env]
  UV_NO_CACHE = true
  UV_NO_MANAGED_PYTHON = true
  UV_PYTHON_DOWNLOADS = "never"

[settings]
  [settings.pipx]
    uvx = true
  [settings.python]
    compile = false

[tools]
  [tools.python]
    version = "3.14"
  [tools.uv]
    depends = ["python"]
    version = "latest"
