== out/conf.d/bash/mise.toml 644
# Synced from bootstrap: macos/tools/bash/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.packages]
    "brew:bash" = "latest"

[dotfiles]
  [dotfiles."/etc/shells/brew-bash"]
    line = "/opt/homebrew/bin/bash"
== out/conf.d/cli/mise.toml 644
# Synced from bootstrap: macos/tools/cli/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.packages]
    "brew:bat" = "latest"
    "brew:ca-certificates" = "latest"
    "brew:coreutils" = "latest"
    "brew:curl" = "latest"
    "brew:eza" = "latest"
    "brew:fzf" = "latest"
    "brew:jq" = "latest"
    "brew:ripgrep" = "latest"
    "brew:zoxide" = "latest"

[env]
  CLOUD_PATH = "${HOME}/Library/Mobile Documents/com~apple~CloudDocs"
  PROJECTS_DIR = "@HOME@/Projects"

[shell_alias]
  bat = "bat --tabs 2"
  cd = "z"
  cdcd = "cd '$CLOUD_PATH'"
  cdgh = "cd \"$PROJECTS_DIR/github.com\""
  cleanupDS = "mise run cleanupDS"
  cleanupDS-Projects = "mise run cleanupDS \"$PROJECTS_DIR\""
  cls = "clear"
  findPid = "lsof -t -c"
  finder = "open -a Finder ./"
  la = "ls -a"
  ld = "ls --only-dirs"
  lf = "ls --only-files"
  lg = "ls --git-ignore"
  listStartupItems = "mise run func:listStartupItems"
  ll = "ls"
  ls = "eza --icons --color=always --group-directories-first --classify=always --long --grid --all --modified --git --header --width=1 --links"
  plist = "plutil -p"
  td = "eza --tree --color=always --only-dirs --group-directories-first --sort name --long --header --icons --classify=always --modified --git --width=1"
  tg = "eza --tree --color=always --all --group-directories-first --sort name --long --header --icons --classify=always --modified --git --width=1 --git-ignore"
  tl = "eza --tree --color=always --all --group-directories-first --sort name --long --header --icons --classify=always --modified --git --width=1"
