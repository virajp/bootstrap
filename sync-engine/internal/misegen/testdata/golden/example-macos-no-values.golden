== out/conf.d/git/mise.toml 644
# Synced from bootstrap: macos/tools/git/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.packages]
    "brew:git" = "latest"
    "brew:lazygit" = "latest"

[shell_alias]
  diff = "diff-so-fancy"
  gc = "git commit -a -m"
  gp = "git push --verbose"
  gpull = "git pull --all --verbose --progress"
  gs = "git status -sb"

[tools]
  [tools.worktrunk]
    version = "latest"
== out/conf.d/homebrew/mise.toml 644
# Synced from bootstrap: macos/tools/homebrew/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[env]
  HOMEBREW_BUNDLE_FILE = "${HOME}/.config/brewfile"
  HOMEBREW_CASK_OPTS = "--appdir=~/Applications"
  HOMEBREW_CLEANUP_MAX_AGE_DAYS = "7"
  HOMEBREW_CLEANUP_PERIODIC_FULL_DAYS = "7"
  HOMEBREW_CURL_RETRIES = "2"
  HOMEBREW_DISPLAY_INSTALL_TIMES = "true"
  HOMEBREW_FAIL_LOG_LINES = "100"
  HOMEBREW_FORCE_BREWED_CURL = "true"
  HOMEBREW_FORCE_BREWED_GIT = "true"
  HOMEBREW_NO_ANALYTICS = "true"
  HOMEBREW_NO_ENV_HINTS = "1"

[shell_alias]
  brew = "fnox -c $HOME/.config/fnox/config.toml exec -P brew -- brew"
