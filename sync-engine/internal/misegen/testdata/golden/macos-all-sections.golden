pre: rc=0
overrides: rc=0
render mtest: rc=0
  mtest/mise.toml
--- files
== out/conf.d/mtest/mise.toml 644
# Synced from bootstrap: macos/tools/mtest/tools.toml. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

[bootstrap]
  [bootstrap.packages]
    brew = "a"

[env]
  X = "a"

[shell_alias]
  ll = "ls -l"

[tools]
  fd = "latest"

--- end
