# Synced from bootstrap: repo/tools/node/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[env]
  [env._]
    [env._.path]
      path = "node_modules/.bin"
      tools = true

[settings]
  [settings.node]
    compile = false
  [settings.npm]
    package_manager = "aube"

[tools]
  [tools.node]
    version = "lts"
