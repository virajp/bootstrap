== clone/repo/tools/python/.config/mise/conf.d/python/mise.dev.toml 644
# Synced from bootstrap: repo/tools/python/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[env]
  UV_NO_CACHE = true
  UV_NO_MANAGED_PYTHON = true
  UV_PYTHON_DOWNLOADS = "never"

[settings]
  [settings.pipx]
    uvx = true
  [settings.python]
    compile = false
    uv_venv_auto = "create|source"

[tools]
  [tools.python]
    version = "3.14"
  [tools.uv]
    depends = ["python"]
    version = "latest"
== clone/repo/tools/pre-commit/.config/mise/conf.d/pre-commit/mise.dev.toml 644
# Synced from bootstrap: repo/tools/pre-commit/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[env]
  PRE_COMMIT_HOME = "$HOME/.cache/pre-commit"

[shell_alias]
  precommit = "mise run code:precommit"

[tools]
  [tools.pre-commit]
    depends = ["python", "uv"]
    version = "latest"
