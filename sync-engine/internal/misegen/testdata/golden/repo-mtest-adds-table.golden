== clone/repo/tools/mise/.config/mise/conf.d/mise/mise.dev.toml 644
# Synced from bootstrap: repo/tools/mise/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[settings]
  os = "macos"

[shell_alias]
  precommit = "mise run code:precommit"
  setup = "mise run setup"
  worktrees = "mise run code:worktrees"

[tasks]
  [tasks.init]
    description = "Initialize mise tasks"
    dir = "{{exec(command='git rev-parse --show-toplevel')}}"
    hide = true
    run = "find .config/mise/tasks/ -name '*' -type f -exec chmod 755 {} \\;"

[tools]
  [tools.jq]
    version = "latest"
  [tools.yq]
    version = "latest"
