== clone/repo/tools/kotlin/.config/mise/conf.d/kotlin/mise.dev.toml 644
# Synced from bootstrap: repo/tools/kotlin/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[tools]
  [tools."github:detekt/detekt"]
    asset_pattern = "detekt-cli-*.zip"
    version = "latest"
  [tools."http:kotlin-lsp"]
    version = "latest"
    version_list_url = "https://api.github.com/repos/Kotlin/kotlin-lsp/releases/latest"
    version_regex = "kotlin-lsp/v(\\d+\\.\\d+\\.\\d+)"
    [tools."http:kotlin-lsp".platforms]
      [tools."http:kotlin-lsp".platforms.macos-arm64]
