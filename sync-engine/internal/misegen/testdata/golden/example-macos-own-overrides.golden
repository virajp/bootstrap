== out/conf.d/network/mise.toml 644
# Synced from bootstrap: macos/tools/network/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.packages]
    "brew:doggo" = "latest"
    "brew:gping" = "latest"
    "brew:httping" = "latest"
    "brew:ipcalc" = "latest"
    "brew:prettyping" = "latest"

[shell_alias]
  dig = "doggo"
  dns = "scutil --dns"
  flushdns = "dscacheutil -flushcache"
  gateway = "mise run ips:gateway"
  hping = "httping --ts -GBbXsSYaWZvv"
  ii = "mise run ips:ii"
  ipInfo0 = "ipconfig getpacket en0"
  ips = "mise run ips:ips"
  ipv4 = "mise run ips:ipv4"
  ipv6 = "mise run ips:ipv6"
  openports = "sudo lsof -i -P | grep LISTEN"
  ping = "prettyping -i 2 --nolegend"
  remoteip = "mise run ips:remoteip"
  routes = "netstat -nr -f inet"
