== out/conf.d/orbstack/mise.toml 644
# Synced from bootstrap: macos/tools/orbstack/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.packages]
    "brew-cask:orbstack" = "latest"

[env]
  BUILDKIT_PROGRESS = "auto"
  COMPOSE_DOCKER_CLI_BUILD = "1"
  DOCKER_BUILDKIT = "1"
  DOCKER_DEFAULT_PLATFORM = "linux/amd64"
  DOCKER_HIDE_LEGACY_COMMANDS = "1"
  HELM_EXPERIMENTAL_OCI = "1"

[shell_alias]
  dclean = "docker system prune --all --volumes --force"
  dlist = "docker image list"
  dprune = "docker system prune --volumes --force"
  dpull = "docker image pull --platform='linux/amd64'"
  drun = "docker run --platform='linux/amd64' --rm --interactive --tty"
  k = "kubectl"
  kc-local = "kubectl config use-context orbstack"
  kgc = "kubectl config current-context"
  kubectx = "kubectl config get-contexts"
