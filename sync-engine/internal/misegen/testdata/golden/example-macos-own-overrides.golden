== out/conf.d/macos-defaults/mise.toml 644
# Synced from bootstrap: macos/tools/macos-defaults/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

[bootstrap]
  [bootstrap.hooks]
    [bootstrap.hooks.post-defaults]
      run = "# defaults values are not templated, and $HOME must not be hardcoded\ndefaults write com.apple.finder NewWindowTargetPath -string \"file://$HOME/\"\nchflags nohidden ~/Library\nkillall cfprefsd || true\nkillall Finder || true\nkillall Dock || true\nkillall SystemUIServer || true\nkillall ControlCenter || true\n"
  [bootstrap.macos]
    [bootstrap.macos.defaults]
      [bootstrap.macos.defaults.NSGlobalDomain]
        AppleInterfaceStyle = "Dark"
        AppleMiniaturizeOnDoubleClick = false
        AppleShowAllExtensions = true
        NSAutomaticCapitalizationEnabled = false
        NSQuitAlwaysKeepsWindows = true
        "com.apple.mouse.tapBehavior" = 1
        "com.apple.trackpad.forceClick" = false
      [bootstrap.macos.defaults."com.apple.AppleMultitouchTrackpad"]
        Clicking = true
        TrackpadThreeFingerTapGesture = 0
      [bootstrap.macos.defaults."com.apple.WindowManager"]
        AppWindowGroupingBehavior = true
        ClickedWallpaperRevealsDesktop = 2
        EnableTiledWindowMargins = false
        EnableTilingByEdgeDrag = false
        EnableTopTilingByEdgeDrag = false
        HideDesktop = true
      [bootstrap.macos.defaults."com.apple.appleinterface"]
        videoStreamingOptimizeOnBattery = true
      [bootstrap.macos.defaults."com.apple.desktopservices"]
        DSDontWriteNetworkStores = true
        DSDontWriteUSBStores = true
      [bootstrap.macos.defaults."com.apple.dock"]
        autohide = true
        expose-group-apps = true
        largesize = 71
        magnification = true
        minimize-to-application = true
        mru-spaces = false
