#!/usr/bin/env bash

# common — the log, the file mode, the clean-up, the header detection, the
# record of the commit and the tool wrappers of the sync engine. A front-end
# sources it, and it sets the clean-up traps when sourced.
#
# It gives _SE_PREFIX, _se_log, _se_mode, _se_path, _SE_TMPS, _se_cleanup,
# _SE_HEADER_RE, _se_has_header, _SE_HEADER_LINE1, _SE_HEADER_LINE2,
# _se_record_commit, _se_gomplate, _se_jq and _se_yq.
#
# Contract: docs/design/sync-engine.md

# The name at the start of each message. A front-end sets it.
_SE_PREFIX='sync-engine'

_se_log() { printf '%s\n' "$_SE_PREFIX: $*" >&2; }

# Print the permission bits of <path>, for example 755.
_se_mode() { stat -c %a -- "$1" 2> /dev/null || stat -f %Lp -- "$1"; }

# Show <path> relative to the current directory when it is under it.
_se_path() { [[ $1 == "$PWD"/* ]] && printf '%s' "${1#"$PWD"/}" || printf '%s' "$1"; }

# Temp files and directories still on disk; removed if the task exits early.
_SE_TMPS=()
_se_cleanup() {
  ((${#_SE_TMPS[@]})) && rm -rf -- "${_SE_TMPS[@]}"
  return 0
}
trap _se_cleanup EXIT
trap '_se_cleanup; exit 130' INT
trap '_se_cleanup; exit 143' TERM

# A line that marks a file of the sync: a comment that starts with a header
# text, so a file that only mentions a text does not count. The markers are the
# ones of the synced files: `#`, `//` and `<!--`. The old texts are for older
# copies: `repo-config` is the old name of bootstrap, and `Generated by
# macos-setup` is the header of the old Mac sync.
_SE_HEADER_RE='^[[:space:]]*(#|//|<!--)[[:space:]]*(Synced from (bootstrap|repo-config): |Generated by macos-setup)'

# 0 when <file> is a regular file with a header line in its first 3 lines. A
# `<!--` alone on a line opens a comment for the next line, as in Markdown, so
# sed joins the two lines.
_se_has_header() {
  [[ -f $1 ]] && head -n 3 -- "$1" |
    LC_ALL=C sed -e '/^[[:space:]]*<!--[[:space:]]*$/{' -e N -e 's/\n/ /' -e '}' |
    grep -qE -- "$_SE_HEADER_RE"
}

# The header of a synced file, as printf formats. The %s of line 1 is the path
# in bootstrap. A front-end adds its comment marker.
_SE_HEADER_LINE1='Synced from bootstrap: %s. Do not edit this file.'
_SE_HEADER_LINE2='The next sync replaces it, and a manual change is lost.'

# Set the top-level <key> of the TOML <file> to <commit>, the commit of this
# sync. A line that has the key before the first table is replaced. Else the key
# and its <comment> go after the header comments, when a blank line ends them,
# or else on the first line: a comment just above a key belongs to that key.
# Each other line stays as it is. Through a symlink, the real file is written,
# so the link stays. A <file> that is not there is created with <header> and the
# key; without <header>, that is an error. An empty <comment> adds no comment
# line. With <dry_run> 1, only print the change.
_se_record_commit() {
  local file=$1 key=$2 commit=$3 dry_run=$4 comment=$5 header=${6:-}
  local show real link hops=0 tmp line mode=644 ok=1
  show=$(_se_path "$file")
  line="${key} = \"${commit}\""
  real=$file
  while [[ -L $real ]]; do
    ((hops += 1))
    if ((hops > 40)); then
      _se_log "cannot write $show"
      return 1
    fi
    link=$(readlink -- "$real") || link=''
    case $link in
      '')
        _se_log "cannot write $show"
        return 1
        ;;
      /*) real=$link ;;
      *) real=$(dirname -- "$real")/$link ;;
    esac
  done
  if [[ ! -f $real && -z $header ]]; then
    _se_log "cannot write $show"
    return 1
  fi
  # Before the first table only: a key in a table is a different key.
  # An `exit` in a rule also runs END, so END gives the result.
  if [[ -f $real ]] && awk -v line="$line" '/^[ \t]*\[/ { exit } $0 == line { found = 1; exit } END { exit !found }' "$real"; then
    return 0
  fi
  if ((dry_run)); then
    _se_log "would set ${key} ${commit} in $show"
    return 0
  fi
  tmp=$(mktemp "${real}.XXXXXX") || {
    _se_log "cannot write $show"
    return 1
  }
  _SE_TMPS+=("$tmp")
  if [[ -f $real ]]; then
    mode=$(_se_mode "$real")
    awk -v line="$line" -v key="$key" -v comment="$comment" '
      # The first pass finds the key, and the line to insert before: after the
      # first blank line that ends the header comments, else the first line.
      FNR == NR {
        if (/^[ \t]*\[/) tables = 1
        if (!tables && $0 ~ ("^" key "[ \t]*=")) has = 1
        if (FNR == 1) { header = /^[ \t]*#/; at = 1 }
        if (header && !found && /^[ \t]*$/) { at = FNR + 1; found = 1 }
        if (header && !found && !/^[ \t]*#/) header = 0
        next
      }
      has && !done && $0 ~ ("^" key "[ \t]*=") { print line; done = 1; next }
      !has && !done && FNR == at {
        if (comment != "") print comment
        print line
        done = 1
      }
      { print }
      END {
        if (!done) {
          if (comment != "") print comment
          print line
        }
      }
    ' "$real" "$real" > "$tmp" || ok=0
  else
    {
      printf '%s\n\n' "$header"
      [[ -z $comment ]] || printf '%s\n' "$comment"
      printf '%s\n' "$line"
    } > "$tmp" || ok=0
  fi
  if ((ok == 0)) || ! chmod "$mode" "$tmp" || ! mv -f -- "$tmp" "$real"; then
    rm -f -- "$tmp"
    _se_log "cannot write $show"
    return 1
  fi
  _se_log "set ${key} ${commit} in $show"
}

# Run <tool> with <args> through mise, from `/`, so no mise config of the current
# folder selects its version. An installed tool runs with no network. mise
# resolves `@latest` from its list of versions: `mise x <tool>@latest` fetches
# that list when none is cached, and it installs a newer version of the list,
# and with MISE_OFFLINE=1 `@latest` finds no versions. So an installed tool runs
# by its name alone, which is the newest installed version, and only a tool that
# is not installed uses `@latest`.
_se_tool() (
  tool=$1
  shift
  cd / || exit 1
  if [[ -n $(MISE_OFFLINE=1 mise ls --installed "$tool" 2> /dev/null < /dev/null) ]]; then
    MISE_OFFLINE=1 mise x "$tool" -- "$tool" "$@"
  else
    mise x "$tool@latest" -- "$tool" "$@"
  fi
)

# gomplate with the template delimiters of bootstrap, then jq and yq. Each path
# that a caller gives them is absolute, because they run from `/`.
_se_gomplate() { _se_tool gomplate --left-delim '<%' --right-delim '%>' "$@"; }
_se_jq() { _se_tool jq "$@"; }
_se_yq() { _se_tool yq "$@"; }
