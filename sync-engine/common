#!/usr/bin/env bash

# common — the log, the file mode, the clean-up, the header detection, the
# record of the commit and the tool wrappers of the sync engine. A front-end
# sources it, and it sets the clean-up traps when sourced.
#
# It gives _SE_PREFIX, _se_log, _se_mode, _se_path, _se_verbose, _se_style,
# _se_outcome_start, _se_info, _se_outcome, _se_summary, _se_count_words,
# _SE_TMPS, _se_cleanup,
# _SE_HEADER_RE, _se_has_header, _SE_HEADER_LINE1, _SE_HEADER_LINE2,
# _se_record_commit, _se_gomplate, _se_jq and _se_yq.
#
# Contract: docs/design/sync-engine.md

# The name at the start of each message. A front-end sets it.
_SE_PREFIX='sync-engine'

_se_log() { printf '%s\n' "$_SE_PREFIX: $*" >&2; }

# Print the permission bits of <path>, for example 755.
_se_mode() { stat -c %a -- "$1" 2> /dev/null || stat -f %Lp -- "$1"; }

# Show <path> relative to the current directory when it is under it.
_se_path() { [[ $1 == "$PWD"/* ]] && printf '%s' "${1#"$PWD"/}" || printf '%s' "$1"; }

# 0 when the variable SYNC_ENGINE_VERBOSE is 1: each per-file line prints in its
# log format, and no list line prints.
_se_verbose() { [[ ${SYNC_ENGINE_VERBOSE:-} == 1 ]]; }

# 0 when the output on stderr has glyphs and colors. The same rule as
# `style_enabled` of `helpers`, which the engine does not call: the local copy
# can be stale, and the Mac side does not have it.
_se_style() {
  if [[ -n ${FORCE_COLOR:-} && ${FORCE_COLOR} != 0 ]]; then
    return 0
  fi
  if [[ -n ${NO_COLOR:-} ]]; then
    return 1
  fi
  [[ -t 2 && ${TERM:-dumb} != dumb ]]
}

_SE_YELLOW=$'\033[0;33m'
_SE_GREEN=$'\033[0;32m'
_SE_BLUE=$'\033[0;34m'
_SE_RED=$'\033[0;31m'
_SE_DIM=$'\033[2m'
_SE_RESET=$'\033[0m'

# Start the counts of a run. <dry-run> 1 gives the words of a dry run.
_se_outcome_start() {
  _SE_DRY_RUN=$1
  _SE_N_CHANGED=0 _SE_N_NEW=0 _SE_N_SEEDED=0 _SE_N_REMOVED=0
  _SE_N_UNCHANGED=0 _SE_N_KEPT=0 _SE_N_SKIPPED=0 _SE_N_FAILED=0
  _SE_SEEN=$'\n'
  _SE_LISTED=''
}
_se_outcome_start 0

# Print an info line.
_se_info() {
  if _se_style; then
    printf 'ℹ️ %s\n' "$*" >&2
  else
    printf '[INFO] %s\n' "$*" >&2
  fi
}

# Print the list line of <kind>, when the list has that kind.
_se_list_line() {
  local kind=$1 path=$2 text=$3 color glyph word width=9
  case $kind in
    changed) color=$_SE_YELLOW glyph='✎' word=changed ;;
    new) color=$_SE_GREEN glyph='✚' word=new ;;
    seeded) color=$_SE_BLUE glyph='❋' word=seeded ;;
    removed) color=$_SE_RED glyph='✖' word=removed ;;
    failed) color=$_SE_RED glyph='✗' word=failed ;;
    *) return 0 ;;
  esac
  if [[ $kind != failed && $_SE_DRY_RUN == 1 ]]; then
    width=12
    case $kind in
      changed) word='would change' ;;
      new) word='would add' ;;
      seeded) word='would seed' ;;
      removed) word='would remove' ;;
    esac
  fi
  if ! _se_style; then
    if [[ $kind == failed ]]; then
      printf '%s %s: %s\n' "$word" "$path" "$text" >&2
    else
      printf '%s %s\n' "$word" "$path" >&2
    fi
    return 0
  fi
  if [[ -z $_SE_LISTED ]]; then
    _SE_LISTED=1
    printf '\n' >&2
  fi
  if [[ $kind == failed ]]; then
    printf '  %s%s %s %s: %s%s\n' "$color" "$glyph" "$word" "$path" "$text" "$_SE_RESET" >&2
  else
    printf '  %s%s %-*s %s%s\n' "$color" "$glyph" "$width" "$word" "$path" "$_SE_RESET" >&2
  fi
}

# Report one target: count <kind> and print its line. The kinds are changed,
# new, seeded, removed, unchanged, kept, skipped and failed. <text> is the
# reason of a failed target, and it does not repeat <path>. <line> is the log
# line that prints with verbose; without it, verbose prints nothing. A target
# counts once as failed and once as removed: a later report of it prints only
# its <line>.
_se_outcome() {
  local kind=$1 path=$2 text=${3:-} line=${4:-} seen=0
  case $kind in
    failed | removed)
      if [[ $_SE_SEEN == *$'\n'"$kind $path"$'\n'* ]]; then
        seen=1
      else
        _SE_SEEN+="$kind $path"$'\n'
      fi
      ;;
  esac
  if ((seen == 0)); then
    case $kind in
      changed) _SE_N_CHANGED=$((_SE_N_CHANGED + 1)) ;;
      new) _SE_N_NEW=$((_SE_N_NEW + 1)) ;;
      seeded) _SE_N_SEEDED=$((_SE_N_SEEDED + 1)) ;;
      removed) _SE_N_REMOVED=$((_SE_N_REMOVED + 1)) ;;
      unchanged) _SE_N_UNCHANGED=$((_SE_N_UNCHANGED + 1)) ;;
      kept) _SE_N_KEPT=$((_SE_N_KEPT + 1)) ;;
      skipped) _SE_N_SKIPPED=$((_SE_N_SKIPPED + 1)) ;;
      failed) _SE_N_FAILED=$((_SE_N_FAILED + 1)) ;;
    esac
  fi
  if _se_verbose; then
    [[ -z $line ]] || _se_log "$line"
  elif ((seen == 0)); then
    _se_list_line "$kind" "$path" "$text"
  fi
  return 0
}

# Print one row of the table. <style> is 1 or 0. A row with a zero count is dim.
_se_table_row() {
  local style=$1 color=$2 glyph=$3 label=$4 count=$5 off=''
  if ((style == 0)); then
    printf '| %-13s | %5s |\n' "$label" "$count" >&2
    return 0
  fi
  if ((count == 0)); then
    color=$_SE_DIM
  fi
  [[ -z $color ]] || off=$_SE_RESET
  printf '  │ %s%s %-11s%s │ %s%5s%s │\n' "$color" "$glyph" "$label" "$off" "$color" "$count" "$off" >&2
}

# Print the table of the counts and the last line of a run that ended with <rc>.
_se_summary() {
  local rc=$1 style=0
  local top='+---------------+-------+' middle='+---------------+-------+' bottom='+---------------+-------+'
  local n=$((_SE_N_CHANGED + _SE_N_NEW + _SE_N_SEEDED + _SE_N_REMOVED))
  local total=$((n + _SE_N_UNCHANGED + _SE_N_KEPT + _SE_N_SKIPPED + _SE_N_FAILED))
  local files=files text
  if _se_style; then
    style=1
    top='  ┌───────────────┬───────┐'
    middle='  ├───────────────┼───────┤'
    bottom='  └───────────────┴───────┘'
    printf '\n' >&2
  fi
  printf '%s\n' "$top" >&2
  _se_table_row "$style" "$_SE_YELLOW" '✎' Changed "$_SE_N_CHANGED"
  _se_table_row "$style" "$_SE_GREEN" '✚' New "$_SE_N_NEW"
  _se_table_row "$style" "$_SE_BLUE" '❋' Seeded "$_SE_N_SEEDED"
  _se_table_row "$style" "$_SE_RED" '✖' Removed "$_SE_N_REMOVED"
  _se_table_row "$style" '' '=' Unchanged "$_SE_N_UNCHANGED"
  _se_table_row "$style" '' '◦' 'Kept seeds' "$_SE_N_KEPT"
  _se_table_row "$style" '' '⊘' Skipped "$_SE_N_SKIPPED"
  _se_table_row "$style" "$_SE_RED" '✗' Failed "$_SE_N_FAILED"
  printf '%s\n' "$middle" >&2
  if ((style)); then
    printf '  │ %-13s │ %5s │\n' Total "$total" >&2
  else
    printf '| %-13s | %5s |\n' Total "$total" >&2
  fi
  printf '%s\n' "$bottom" >&2

  if ((rc != 0)); then
    text="The sync failed with code $rc"
    if ((_SE_N_FAILED == 1)); then
      text+=": 1 file failed"
    elif ((_SE_N_FAILED > 1)); then
      text+=": $_SE_N_FAILED files failed"
    fi
    if ((style)); then
      printf '%s❌ %s%s\n' "$_SE_RED" "$text" "$_SE_RESET" >&2
    else
      printf '[ERROR] %s\n' "$text" >&2
    fi
    return 0
  fi
  if ((n == 1)); then
    files='file'
  fi
  if [[ $_SE_DRY_RUN == 1 ]]; then
    if ((n == 0)); then
      text='Dry run: no file would change'
    else
      text="Dry run: $n $files would change"
    fi
  elif ((n == 0)); then
    text='Synced: no file changed'
  else
    text="Synced: $n $files changed"
  fi
  if ((style)); then
    printf '✅ %s\n' "$text" >&2
  else
    printf '[OK] %s\n' "$text" >&2
  fi
}

# Print the number of words of <list>.
_se_count_words() {
  local word n=0
  for word in $1; do
    n=$((n + 1))
  done
  printf '%s' "$n"
}

# Temp files and directories still on disk; removed if the task exits early.
_SE_TMPS=()
_se_cleanup() {
  ((${#_SE_TMPS[@]})) && rm -rf -- "${_SE_TMPS[@]}"
  return 0
}
trap _se_cleanup EXIT
trap '_se_cleanup; exit 130' INT
trap '_se_cleanup; exit 143' TERM

# A line that marks a file of the sync: a comment that starts with a header
# text, so a file that only mentions a text does not count. The markers are the
# ones of the synced files: `#`, `//` and `<!--`. The old texts are for older
# copies: `repo-config` is the old name of bootstrap, and `Generated by
# macos-setup` is the header of the old Mac sync.
_SE_HEADER_RE='^[[:space:]]*(#|//|<!--)[[:space:]]*(Synced from (bootstrap|repo-config): |Generated by macos-setup)'

# 0 when <file> is a regular file with a header line in its first 3 lines. A
# `<!--` alone on a line opens a comment for the next line, as in Markdown, so
# sed joins the two lines.
_se_has_header() {
  [[ -f $1 ]] && head -n 3 -- "$1" |
    LC_ALL=C sed -e '/^[[:space:]]*<!--[[:space:]]*$/{' -e N -e 's/\n/ /' -e '}' |
    grep -qE -- "$_SE_HEADER_RE"
}

# The header of a synced file, as printf formats. The %s of line 1 is the path
# in bootstrap. A front-end adds its comment marker.
_SE_HEADER_LINE1='Synced from bootstrap: %s. Do not edit this file.'
_SE_HEADER_LINE2='The next sync replaces it, and a manual change is lost.'

# Set the top-level <key> of the TOML <file> to <commit>, the commit of this
# sync. A line that has the key before the first table is replaced. Else the key
# and its <comment> go after the header comments, when a blank line ends them,
# or else on the first line: a comment just above a key belongs to that key.
# Each other line stays as it is. Through a symlink, the real file is written,
# so the link stays. A <file> that is not there is created with <header> and the
# key; without <header>, that is an error. An empty <comment> adds no comment
# line. With <dry_run> 1, only print the change.
_se_record_commit() {
  local file=$1 key=$2 commit=$3 dry_run=$4 comment=$5 header=${6:-}
  local show real link hops=0 tmp line mode=644 ok=1
  show=$(_se_path "$file")
  line="${key} = \"${commit}\""
  real=$file
  while [[ -L $real ]]; do
    ((hops += 1))
    if ((hops > 40)); then
      _se_log "cannot write $show"
      return 1
    fi
    link=$(readlink -- "$real") || link=''
    case $link in
      '')
        _se_log "cannot write $show"
        return 1
        ;;
      /*) real=$link ;;
      *) real=$(dirname -- "$real")/$link ;;
    esac
  done
  if [[ ! -f $real && -z $header ]]; then
    _se_log "cannot write $show"
    return 1
  fi
  # Before the first table only: a key in a table is a different key.
  # An `exit` in a rule also runs END, so END gives the result.
  if [[ -f $real ]] && awk -v line="$line" '/^[ \t]*\[/ { exit } $0 == line { found = 1; exit } END { exit !found }' "$real"; then
    return 0
  fi
  if ((dry_run)); then
    if _se_verbose; then
      _se_log "would set ${key} ${commit} in $show"
    else
      _se_info "Would set ${key} to ${commit:0:7}"
    fi
    return 0
  fi
  tmp=$(mktemp "${real}.XXXXXX") || {
    _se_log "cannot write $show"
    return 1
  }
  _SE_TMPS+=("$tmp")
  if [[ -f $real ]]; then
    mode=$(_se_mode "$real")
    awk -v line="$line" -v key="$key" -v comment="$comment" '
      # The first pass finds the key, and the line to insert before: after the
      # first blank line that ends the header comments, else the first line.
      FNR == NR {
        if (/^[ \t]*\[/) tables = 1
        if (!tables && $0 ~ ("^" key "[ \t]*=")) has = 1
        if (FNR == 1) { header = /^[ \t]*#/; at = 1 }
        if (header && !found && /^[ \t]*$/) { at = FNR + 1; found = 1 }
        if (header && !found && !/^[ \t]*#/) header = 0
        next
      }
      has && !done && $0 ~ ("^" key "[ \t]*=") { print line; done = 1; next }
      !has && !done && FNR == at {
        if (comment != "") print comment
        print line
        done = 1
      }
      { print }
      END {
        if (!done) {
          if (comment != "") print comment
          print line
        }
      }
    ' "$real" "$real" > "$tmp" || ok=0
  else
    {
      printf '%s\n\n' "$header"
      [[ -z $comment ]] || printf '%s\n' "$comment"
      printf '%s\n' "$line"
    } > "$tmp" || ok=0
  fi
  if ((ok == 0)) || ! chmod "$mode" "$tmp" || ! mv -f -- "$tmp" "$real"; then
    rm -f -- "$tmp"
    _se_log "cannot write $show"
    return 1
  fi
  if _se_verbose; then
    _se_log "set ${key} ${commit} in $show"
  else
    _se_info "Set ${key} to ${commit:0:7}"
  fi
}

# Run <tool> with <args> through mise, from `/`, so no mise config of the current
# folder selects its version. An installed tool runs with no network. mise
# resolves `@latest` from its list of versions: `mise x <tool>@latest` fetches
# that list when none is cached, and it installs a newer version of the list,
# and with MISE_OFFLINE=1 `@latest` finds no versions. So an installed tool runs
# by its name alone, which is the newest installed version, and only a tool that
# is not installed uses `@latest`.
_se_tool() (
  tool=$1
  shift
  cd / || exit 1
  if [[ -n $(MISE_OFFLINE=1 mise ls --installed "$tool" 2> /dev/null < /dev/null) ]]; then
    MISE_OFFLINE=1 mise x "$tool" -- "$tool" "$@"
  else
    mise x "$tool@latest" -- "$tool" "$@"
  fi
)

# gomplate with the template delimiters of bootstrap, then jq and yq. Each path
# that a caller gives them is absolute, because they run from `/`.
_se_gomplate() { _se_tool gomplate --left-delim '<%' --right-delim '%>' "$@"; }
_se_jq() { _se_tool jq "$@"; }
_se_yq() { _se_tool yq "$@"; }
