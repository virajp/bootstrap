#!/usr/bin/env bash

# write — the write of one target of the sync engine: the format, the parse
# check, the temp file, the seed gate, the unblock of a folder path, and the
# compare, the mode, the dry-run diff and the rename. A front-end sources it
# after `common`.
#
# It gives _se_format, _se_parse_check, _SE_TMP, _se_tmp, _se_seed_kept,
# _se_unblock, _se_finish, and the checks of a `[files]` table of a tools.toml:
# _se_files_key_ok, _se_files_check_shape and _se_files_check_mode.
#
# Contract: docs/design/sync-engine.md

# Print the format of the target <target>, whose content is in <file>: json,
# yaml, toml or text. A given <format> wins. Else the extension of <target>
# without `.tmpl` decides it. A `.json` file with a line that starts with `//`
# after spaces is JSONC (the header of a JSON file is a comment), which jq cannot
# read, so its format is text.
_se_format() {
  local target=${1%.tmpl} file=$2 format=${3:-}
  if [[ -n $format ]]; then
    printf '%s\n' "$format"
    return 0
  fi
  case $target in
    *.json)
      if grep -qE '^[[:space:]]*//' -- "$file"; then
        printf 'text\n'
      else
        printf 'json\n'
      fi
      ;;
    *.yaml | *.yml) printf 'yaml\n' ;;
    *.toml) printf 'toml\n' ;;
    *) printf 'text\n' ;;
  esac
}

# Examine <file> as <format>. <show> names the target in the message. On success
# it prints nothing. Returns 2, after a message and the output of the tool, when
# the file does not parse. An empty or whitespace-only JSON file does not parse.
_se_parse_check() {
  local file=$1 format=$2 show=$3 err='' ok=1
  case $format in
    json)
      if [[ -z $(tr -d '[:space:]' < "$file") ]]; then
        ok=0
      else
        err=$(_se_jq empty "$file" 2>&1) || ok=0
      fi
      ;;
    yaml | toml)
      err=$(_se_yq -p "$format" -o json '.' "$file" 2>&1) || ok=0
      ;;
  esac
  ((ok == 0)) || return 0
  _se_outcome failed "$show" "the result does not parse as $format - the current file stays" "$show: the result does not parse as $format - the current file stays"
  [[ -z $err ]] || printf '%s\n' "$err" | sed 's/^/  /' >&2
  return 2
}

# Create a temp file in <dir>, to remove if the task exits early, and print its
# path. It also sets _SE_TMP to the path: a call in `$(...)` is a subshell, whose
# change to _SE_TMPS is lost, so a caller uses `_se_tmp <dir> > /dev/null`, then
# _SE_TMP.
_se_tmp() {
  _SE_TMP=$(mktemp "${1%/}/.sync-engine.XXXXXX") || return 1
  _SE_TMPS+=("$_SE_TMP")
  printf '%s\n' "$_SE_TMP"
}

# 0 when the seed <dest> exists: it stays as it is. The caller reports
# `kept seed`.
_se_seed_kept() { [[ -e $1 ]]; }

# Remove each synced file (with the header) that is at the place of a folder in
# <dir> or above it, up to <root>. <spare> lists the paths, relative to <root>,
# one per line, that the sync must not remove: the seeds and the merge targets.
# <target> names the file that needs the folder, as a failure reports it.
# Returns 1, after a message, when such a file is the repo's own or is in
# <spare>.
_se_unblock() {
  local dir=$1 root=$2 dry_run=$3 spare=$4 target=$5 show
  while [[ $dir == "$root"/* ]]; do
    if [[ -f $dir && ! -L $dir ]]; then
      show=$(_se_path "$dir")
      if ! _se_has_header "$dir" || [[ $'\n'$spare$'\n' == *$'\n'"${dir#"$root"/}"$'\n'* ]]; then
        _se_outcome failed "$target" "$show is a file of this repo, but the sync needs a folder there - move it" "$show is a file of this repo, but the sync needs a folder there - move it"
        return 1
      fi
      if ((dry_run)); then
        _se_outcome removed "$show" '' "would remove $show (a folder replaces it)"
      else
        rm -f -- "$dir" || {
          _se_outcome failed "$target" 'cannot write the target'
          return 1
        }
        _se_outcome removed "$show" '' "removed    $show (a folder replaces it)"
      fi
      return 0
    fi
    dir=$(dirname -- "$dir")
  done
}

# Compare the temp file <tmp> with <dest>, then write it with <mode>, or with
# <dry_run> 1 print the change. <show> names <dest> in each message. <file_mode>
# is the mode of the `[files]` table: a written `seed` reports as seeded.
_se_finish() {
  local mode=$1 tmp=$2 dest=$3 show=$4 dry_run=$5 file_mode=${6:-} kind=changed
  if [[ $file_mode == seed ]]; then
    kind=seeded
  elif [[ ! -e $dest && ! -L $dest ]]; then
    kind=new
  fi
  if [[ -f $dest ]] && cmp -s -- "$tmp" "$dest"; then
    rm -f -- "$tmp"
    if [[ $(_se_mode "$dest") == "$mode" ]]; then
      _se_outcome unchanged "$show" '' "unchanged  $show"
    elif ((dry_run)); then
      _se_outcome changed "$show" '' "would chmod $mode $show"
    else
      chmod "$mode" "$dest" || {
        _se_outcome failed "$show" 'cannot chmod' "cannot chmod $show"
        return 1
      }
      _se_outcome changed "$show" '' "chmod $mode  $show"
    fi
    return 0
  fi

  if ((dry_run)); then
    _se_outcome "$kind" "$show" '' "would update $show"
    if [[ -f $dest ]]; then
      diff -u --label "$show (current)" --label "$show (bootstrap)" -- "$dest" "$tmp" >&2 || true
    fi
    rm -f -- "$tmp"
    return 0
  fi

  chmod "$mode" "$tmp"
  mv -f -- "$tmp" "$dest" || {
    rm -f -- "$tmp"
    _se_outcome failed "$show" 'cannot write' "cannot write $show"
    return 1
  }
  _se_outcome "$kind" "$show" '' "updated    $show"
}

# 0 when <key> is a key of a `[files."<target>"]` table.
_se_files_key_ok() {
  case $1 in
    mode | requires | requires_found | format | remove | remove_items) return 0 ;;
  esac
  return 1
}

# Examine the JSON value <json> of the key <key>, `remove` or `remove_items`, of
# the `[files."<target>"]` table of the tools.toml <manifest>, the path that the
# message names. Returns 2, after a message, for a bad shape: `remove` is a list
# of non-empty lists of strings, and `remove_items` a list of tables, each with
# exactly `path`, a non-empty list of strings, and `items`, a list.
_se_files_check_shape() {
  local manifest=$1 target=$2 key=$3 json=$4 filter text
  if [[ $key == remove ]]; then
    filter='type == "array" and all(.[]; type == "array" and length > 0 and all(.[]; type == "string"))'
    text='remove must be a list of key paths, each a non-empty list of strings'
  else
    filter='def path_ok: type == "array" and length > 0 and all(.[]; type == "string");
      type == "array" and all(.[]; type == "object" and length == 2 and (.path | path_ok) and (.items | type == "array"))'
    text='remove_items must be a list of tables, each with exactly path (a non-empty list of strings) and items (a list)'
  fi
  _se_jq -ne --argjson v "$json" "\$v | $filter" > /dev/null 2>&1 && return 0
  _se_log "$manifest: [files.\"$target\"] $text"
  return 2
}

# Examine the mode <mode> (empty: generated) of the `[files."<target>"]` table
# of the tools.toml <manifest>, the path that the message names, with the key
# `format` <format> (can be empty), and whether the table has `remove`
# <has_remove> and `remove_items` <has_items> (1 or 0).
# Returns 2, after a message for each problem. The format of a merge target is
# its `format` key, else its extension.
_se_files_check_mode() {
  local manifest=$1 target=$2 mode=$3 format=$4 has_remove=$5 has_items=$6 rc=0
  local prefix="$manifest: [files.\"$target\"]"
  if [[ $mode == merge ]]; then
    case $(_se_format "$target" /dev/null "$format") in
      json | yaml | toml) ;;
      *)
        _se_log "$prefix mode = \"merge\" needs a json, yaml or toml target"
        rc=2
        ;;
    esac
    return "$rc"
  fi
  if ((has_remove)); then
    _se_log "$prefix remove works only with mode = \"merge\""
    rc=2
  fi
  if ((has_items)); then
    _se_log "$prefix remove_items works only with mode = \"merge\""
    rc=2
  fi
  return "$rc"
}
