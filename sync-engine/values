# Synced from bootstrap: sync-engine/values. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
# shellcheck shell=bash

# values — the values merge of the sync engine, one library for each front-end.
# A front-end sources it after `common`.
#
#   _se_values <selected> <keep> <tools-root> <user-json> <shown-root> <shown-values>
#     <selected>      the selected tool names, separated by white space.
#     <keep>          the base and dependency tool names, the same way.
#     <tools-root>    the absolute folder of the tools of the clone.
#     <user-json>     the user values, one JSON object: tool name to table.
#     <shown-root>    the folder of the tools in a message, for example repo/tools.
#     <shown-values>  the values file in a message.
#
# It prints one `ctx<TAB><tool><TAB><json>` line for each selected tool, where
# <json> is the merged values of that tool, and returns 0. Else it prints no such
# line, logs each message, and returns the highest code: 2 for a bad table or a
# conflict, 3 for a contribution to a tool that <tools-root> does not have.
#
# The merge order is `[defaults]` of the tool, then `[contributes.<tool>]` of each
# selected tool in tool-name order, then the user values. A later layer wins a
# scalar, and tables merge key by key. A list of a contribution appends its new
# items, and two contributions that set one key to different values are an error.
# A user value replaces the merged one, except for a base or dependency tool: there
# a list appends its new items, and a value of another type is an error. A
# contribution to a tool of <tools-root> that is not selected is ignored.

# The inputs of the merge, one JSON document: the tool names, the base and
# dependency tools, the tools of the root, and the keys of the values of each
# tools.toml.
_SE_VALUES_INPUTS_TPL='<% $m := dict %><% range $i, $n := (env.Getenv "SE_VALUES_TOOLS" | strings.Split " ") %><% $m = coll.Merge (dict $n (coll.Pick "defaults" "questions" "contributes" (index $ (printf "m_%d" $i)))) $m %><% end %><% dict "names" (env.Getenv "SE_VALUES_TOOLS" | strings.Split " ") "keep" (env.Getenv "SE_VALUES_KEEP" | strings.Split " ") "root" (env.Getenv "SE_VALUES_ROOT" | strings.Split " ") "m" $m | data.ToJSON %>'

# The merge of the values (jq). The input is two documents: the inputs above and
# the user values. It prints `ctx<TAB><tool><TAB><json>` lines, or `bad2<TAB><message>`
# and `bad3<TAB><message>` lines. The merge reads no bad table, so a bad table does
# not hide a conflict of the other tables.
_SE_VALUES_JQ='
# A later layer: tables merge deeply, any other value replaces.
def replace_merge($a; $b):
  if ($a | type) == "object" and ($b | type) == "object" then
    reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = replace_merge($a[$k]; $b[$k]))
  else $b end;
# The items of $b that are not yet in $a, appended in order.
def append_new($a; $b): reduce $b[] as $x ($a; if any(.[]; . == $x) then . else . + [$x] end);
# The contributions over [defaults]: tables merge, lists append, else $b wins.
def contribution_merge($a; $b):
  if ($a | type) == "object" and ($b | type) == "object" then
    reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = contribution_merge($a[$k]; $b[$k]))
  elif ($a | type) == "array" and ($b | type) == "array" then append_new($a; $b)
  else $b end;
# Two contributions: as contribution_merge, but two different values that are
# not both tables or both lists are an error with their path.
def contributors_merge($a; $b; $p):
  if $a == null then $b
  elif ($a | type) == "object" and ($b | type) == "object" then
    reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = contributors_merge($a[$k]; $b[$k]; $p + [$k]))
  elif ($a | type) == "array" and ($b | type) == "array" then append_new($a; $b)
  elif $a == $b then $a
  else error({path: $p}) end;
# The user values of a base or dependency tool: as contribution_merge, but a
# value whose type differs from the merged one is an error with its path and
# both types.
def keep_merge($a; $b; $p):
  if $a == null then $b
  elif ($a | type) == "object" and ($b | type) == "object" then
    reduce ($b | keys_unsorted[]) as $k ($a; .[$k] = keep_merge($a[$k]; $b[$k]; $p + [$k]))
  elif ($a | type) == "array" and ($b | type) == "array" then append_new($a; $b)
  elif ($a | type) != ($b | type) then error({path: $p, a: ($a | type), b: ($b | type)})
  else $b end;
# A jq type as the TOML word for it.
def type_word: {"object": "table", "array": "list"}[.] // .;
# The user values: keep_merge for a base or dependency tool ($keep), else
# replace_merge. <src> names the layer in an error.
def user_merge($keep; $a; $b; $src):
  if $keep then (try keep_merge($a; $b; []) catch error(. + {src: $src}))
  else replace_merge($a; $b) end;
# The messages of the tables of the manifest of the tool $t, which is the input.
def shape_messages($t):
  "\($shown)/\($t)/tools.toml: " as $at
  | (if has("defaults") and (.defaults | type) != "object" then "\($at)[defaults] must be a table" else empty end),
    (if has("questions") then
      if (.questions | type) != "object" then "\($at)[questions] must be a table of [questions.<key>] tables"
      else
        .questions | to_entries[] | .key as $q | .value as $e
        | if ($e | type) != "object" then "\($at)[questions.\($q)] must be a table"
          else
            ($e | keys_unsorted[] | select(. != "question" and . != "detect" and . != "example")
              | "\($at)[questions.\($q)] \(.) is not a key of a question - the keys are question, detect and example"),
            (if ($e | has("question") | not) then "\($at)[questions.\($q)] needs a question string"
             elif ($e.question | type) != "string" then "\($at)[questions.\($q)] question must be a string"
             else empty end),
            (if ($e | has("detect")) and ($e.detect | type) != "string"
             then "\($at)[questions.\($q)] detect must be a string (a shell command)"
             else empty end)
          end
      end
    else empty end),
    (if has("contributes") then
      if (.contributes | type) != "object" then "\($at)[contributes] must be a table of [contributes.<tool>] tables"
      else
        .contributes | to_entries[] | select((.value | type) != "object")
        | "\($at)[contributes.\(.key)] must be a table"
      end
    else empty end);
.[0] as $in
| .[1] as $user
| $in.names as $names
| [$names[] as $n | $in.m[$n] | shape_messages($n)] as $shape
| ($in.m | map_values(
    .defaults |= (if type == "object" then . else {} end)
    | .contributes |= (if type == "object" then with_entries(select((.value | type) == "object")) else {} end)
  )) as $m
| [$names[] as $t
    | $m[$t].contributes
    | keys_unsorted[]
    | . as $o
    | select($in.root | any(.[]; . == $o) | not)
    | "\($shown)/\($t)/tools.toml: [contributes.\($o)] names a tool that bootstrap does not have"
  ] as $unknown
| [$names[] as $n
    | [$names[] | select($m[.].contributes | has($n))] as $from
    | try {
        n: $n,
        v: (reduce $from[] as $t ({};
          . as $acc
          | try contributors_merge($acc; $m[$t].contributes[$n]; [])
            catch error({path: .path, tool: $t})))
      }
      catch (. as $e
        | ([$from[] | select(. < $e.tool)
            | select(($m[.].contributes[$n] | try getpath($e.path) catch null) != null)][0]) as $first
        | {n: $n, bad: "\($shown)/\($first)/tools.toml and \($shown)/\($e.tool)/tools.toml set [contributes.\($n)] \($e.path | map(tostring) | join(".")) to different values - remove one, or set it in [tools.\($n)] of \($values)"})
  ] as $contributions
| [($contributions[] | select(has("bad") | not)) as $x
    | ($in.keep | any(.[]; . == $x.n)) as $keep
    | try {
        n: $x.n,
        v: (contribution_merge($m[$x.n].defaults; $x.v)
          | user_merge($keep; .; $user[$x.n] // {}; "[tools.\($x.n)] of \($values)"))
      }
      catch {n: $x.n, bad: "\(.src) sets \(.path | map(tostring) | join(".")) to a \(.b | type_word), but it is a \(.a | type_word) in the base or dependency tool \($x.n) - write a \(.a | type_word) there (a list adds its items)"}
  ] as $merged
| [$contributions[], $merged[] | select(has("bad")) | .bad] as $bad
| ($shape[] | "bad2\t\(.)"),
  ($unknown[] | "bad3\t\(.)"),
  ($bad[] | "bad2\t\(.)"),
  (if $shape != [] or $unknown != [] or $bad != [] then empty else
    $merged[] | "ctx\t\(.n)\t\(.v | tojson)"
  end)
'

# See the top of this file.
_se_values() {
  local selected=$1 keep=$2 root=$3 user=$4 shown=$5 values=$6
  local names keep_words root_tools='' manifest tool args=() i=0 input out kind line rc=0 tab=$'\t'
  # shellcheck disable=SC2086
  names=$(printf '%s\n' $selected | LC_ALL=C sort -u | tr '\n' ' ')
  names=${names% }
  # shellcheck disable=SC2086
  keep_words=$(printf '%s\n' $keep | tr '\n' ' ')
  keep_words=${keep_words% }
  [[ -n $names ]] || return 0
  for manifest in "$root"/*/tools.toml; do
    [[ -f $manifest ]] || continue
    tool=${manifest%/tools.toml}
    root_tools+="${tool##*/} "
  done
  for tool in $names; do
    args+=(-c "m_${i}=${root}/${tool}/tools.toml")
    i=$((i + 1))
  done
  input=$(SE_VALUES_TOOLS=$names SE_VALUES_KEEP=$keep_words SE_VALUES_ROOT=${root_tools% } \
    _se_gomplate "${args[@]}" -i "$_SE_VALUES_INPUTS_TPL") || {
    _se_log "cannot read the tools.toml files of the selected tools"
    return 2
  }
  out=$(printf '%s\n%s\n' "$input" "$user" | _se_jq -r -s --arg shown "$shown" --arg values "$values" "$_SE_VALUES_JQ") || {
    _se_log "cannot merge the values of the tools"
    return 2
  }
  while IFS="$tab" read -r kind line; do
    case $kind in
      bad2)
        _se_log "$line"
        ((rc >= 2)) || rc=2
        ;;
      bad3)
        _se_log "$line"
        rc=3
        ;;
    esac
  done <<< "$out"
  ((rc == 0)) || return "$rc"
  printf '%s\n' "$out"
}
