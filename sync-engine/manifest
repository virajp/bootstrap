# shellcheck shell=bash

# manifest — the manifest of the generated files and the stale rule of the sync
# engine. A front-end sources it after `common`.
#
#   _se_manifest_read <link-mode> <file> [<root>]
#     Print each valid row of <file>; a missing file prints nothing. In `repo`
#     mode, <file> is below <root>.
#   _se_manifest_stale <link-mode> <old-rows> <handled> <root> <dry-run>
#     Apply the stale rule to <old-rows>. <link-mode> is `repo` or `macos`.
#   _se_manifest_write <file> <rows> <dry-run>
#     Write <file> with <rows>, when its content changes.
#
# Contract: docs/design/sync-engine.md

# The first line of a manifest. A reader skips each `#` line.
_SE_MANIFEST_FIRST_LINE='# Written by bootstrap. Do not edit this file.'

# 0 when <path> is not a clean path below the root: empty, absolute, with an empty
# segment, a `.` or `..` segment, or a `.git` segment in any case.
_se_manifest_bad_path() {
  case "/$1/" in
    *//* | */./* | */../* | */[.][gG][iI][tT]/*) return 0 ;;
  esac
  return 1
}

# Print each row of <file> that is not empty and is not a `#` line. A row without
# a TAB, with an empty tool or with a bad path is not printed, and it gets a log
# line. In `repo` mode the file is committed, so it must be a regular file with
# no symlink between <root> and it: else nothing is printed and it returns 2.
# Returns 2 for another <link-mode>.
_se_manifest_read() {
  local link_mode=$1 file=$2 root=${3:-} line tool path n=0 tab=$'\t'
  case $link_mode in
    repo)
      root=${root%/}
      if _se_manifest_linked "$root" "${file#"$root"/}"; then
        _se_log "$(_se_path "$file"): the manifest is a link or is below a linked folder - not read"
        return 2
      fi
      if [[ -e $file && ! -f $file ]]; then
        _se_log "$(_se_path "$file"): the manifest is not a regular file - not read"
        return 2
      fi
      ;;
    macos) ;;
    *)
      _se_log "usage: _se_manifest_read repo|macos <file> [<root>]"
      return 2
      ;;
  esac
  [[ -e $file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    ((n += 1))
    [[ -n $line && $line != \#* ]] || continue
    tool=${line%%"$tab"*}
    path=${line#*"$tab"}
    if [[ $line != *"$tab"* || -z $tool ]] || _se_manifest_bad_path "$path"; then
      _se_log "$(_se_path "$file"): line $n is not <tool><TAB><path> - skipped"
      continue
    fi
    printf '%s\n' "$line"
  done < "$file"
}

# 0 when the path <path> below <root> is a symlink, or a folder between <root>
# and the file is a symlink. <root> itself is not tested.
_se_manifest_linked() {
  local folder=$1 rest=$2
  while [[ $rest == */* ]]; do
    folder+="/${rest%%/*}"
    rest=${rest#*/}
    [[ ! -L $folder ]] || return 0
  done
  [[ -L $folder/$rest ]]
}

# 0 when a folder between <root> and the file <path> below it has its own `.git`:
# the file is in another repository, a git submodule or a nested clone, with its
# own manifest.
_se_manifest_foreign() {
  local folder=$1 rest=$2
  while [[ $rest == */* ]]; do
    folder+="/${rest%%/*}"
    rest=${rest#*/}
    [[ ! -e $folder/.git ]] || return 0
  done
  return 1
}

# 0 when the file <target> is the same file as a path of <handled> below <root>:
# another spelling of that path on a file system that ignores case.
_se_manifest_same() {
  local target=$1 handled=$2 root=$3 path
  while IFS= read -r path; do
    [[ -z $path || ! $target -ef $root/$path ]] || return 0
  done <<< "$handled"
  return 1
}

# Set _SE_MANIFEST_REAL to the real path of the absolute <path>: each symlink,
# of the file or of a parent folder, is followed, also when its source is
# missing.
# No `readlink -f` on macOS. Returns 1 on a symlink loop.
_se_manifest_real() {
  local p=$1 hops=${2:-0} dir base link
  ((hops > 64)) && return 1
  while [[ $p == */ && $p != / ]]; do p=${p%/}; done
  if [[ -z $p || $p == / ]]; then
    _SE_MANIFEST_REAL=/
    return 0
  fi
  dir=${p%/*} base=${p##*/}
  [[ -n $dir ]] || dir=/
  _se_manifest_real "$dir" $((hops + 1)) || return 1
  dir=$_SE_MANIFEST_REAL
  case $base in
    . | '')
      _SE_MANIFEST_REAL=$dir
      return 0
      ;;
    ..)
      _SE_MANIFEST_REAL=${dir%/*}
      [[ -n $_SE_MANIFEST_REAL ]] || _SE_MANIFEST_REAL=/
      return 0
      ;;
  esac
  [[ $dir == / ]] && p=/$base || p=$dir/$base
  if [[ -L $p ]]; then
    link=$(readlink -- "$p") || return 1
    [[ $link == /* ]] || link=$dir/$link
    _se_manifest_real "$link" $((hops + 1))
    return
  fi
  _SE_MANIFEST_REAL=$p
}

# Remove each empty parent folder of the file <path> below <root>, from the file
# up. Stop at <root>, at a symlinked folder or at a folder that is not empty.
_se_manifest_prune() {
  local root=$1 dir="$1/$2"
  dir=${dir%/*}
  while [[ $dir == "$root"/* ]]; do
    [[ ! -L $dir ]] || return 0
    rmdir -- "$dir" 2> /dev/null || return 0
    dir=${dir%/*}
  done
}

# The stale rule. <old-rows> holds one row on each line, and <handled> one path
# on each line: every path that this run handled. Each old row whose path is not
# in <handled> is a candidate. A file that is not there, that has no header, or
# that is the same file as a handled path stays with no log line. Returns 2 for another <link-mode>, and 1 after a
# failed removal; the other rows still run.
_se_manifest_stale() {
  local link_mode=$1 rows=$2 handled=$3 root=${4%/} dry_run=$5
  local row path target show rc=0 tab=$'\t'
  case $link_mode in
    repo | macos) ;;
    *)
      _se_log "usage: _se_manifest_stale repo|macos <old-rows> <handled> <root> <dry-run>"
      return 2
      ;;
  esac
  while IFS= read -r row; do
    [[ -n $row ]] || continue
    path=${row#*"$tab"}
    [[ $'\n'$handled$'\n' != *$'\n'"$path"$'\n'* ]] || continue
    target="$root/$path"
    if [[ $link_mode == repo ]]; then
      if _se_manifest_linked "$root" "$path"; then
        if _se_verbose; then
          _se_log "kept $path (link)"
        fi
        continue
      fi
      if _se_manifest_foreign "$root" "$path"; then
        if _se_verbose; then
          _se_log "kept $path (another repository)"
        fi
        continue
      fi
    else
      _se_manifest_real "$target" || continue
      target=$_SE_MANIFEST_REAL
    fi
    _se_has_header "$target" || continue
    if _se_manifest_same "$target" "$handled" "$root"; then
      continue
    fi
    show=$(_se_path "$root/$path")
    if ((dry_run)); then
      _se_outcome removed "$show" '' "would remove $show"
      continue
    fi
    if rm -f -- "$target"; then
      _se_outcome removed "$show" '' "removed    $show"
      _se_manifest_prune "$root" "$path"
    else
      _se_outcome failed "$show" 'cannot remove' "cannot remove $show"
      rc=1
    fi
  done <<< "$rows"
  return "$rc"
}

# Write <file>: the first line, then <rows> sorted, with LF line endings and one
# LF at the end. A <file> with the same content stays as it is.
_se_manifest_write() {
  local file=$1 rows=$2 dry_run=$3 show folder tmp sorted content kind=changed
  show=$(_se_path "$file")
  [[ -e $file ]] || kind=new
  sorted=$(printf '%s\n' "$rows" | LC_ALL=C sed '/^$/d' | LC_ALL=C sort -u) || {
    _se_log "cannot write $show"
    return 1
  }
  content=$_SE_MANIFEST_FIRST_LINE
  [[ -z $sorted ]] || content+=$'\n'$sorted
  if [[ -f $file ]] && printf '%s\n' "$content" | cmp -s -- - "$file"; then
    return 0
  fi
  if ((dry_run)); then
    _se_outcome "$kind" "$show" '' "would write $show"
    return 0
  fi
  folder=$(dirname -- "$file")
  mkdir -p -- "$folder" && tmp=$(mktemp "${folder}/.sync-engine.XXXXXX") || {
    _se_log "cannot write $show"
    return 1
  }
  _SE_TMPS+=("$tmp")
  if ! printf '%s\n' "$content" > "$tmp" || ! chmod 644 "$tmp" || ! mv -f -- "$tmp" "$file"; then
    rm -f -- "$tmp"
    _se_log "cannot write $show"
    return 1
  fi
  _se_outcome "$kind" "$show" '' "wrote      $show"
}
