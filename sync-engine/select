#!/usr/bin/env bash

# select — the selection of the sync engine: the pack expansion and the
# depth-first walk of the depends of each tool. A front-end sources it after
# `common`, and it gives the rules of its own side through the callbacks of the
# walk.
#
# It gives _se_pack, _se_pack_loop, _se_pack_check, _se_selected, _se_walk,
# _SE_WALK_VISITED and _SE_WALK_DEPS.
#
# Contract: docs/design/packs.md

# Print the tools of the pack <name> as `<tool> <env,...|-> <source>` lines: its
# `default = true` members in file order, a `pack:<x>` member expanded in turn
# with the same <envs> and <src>. The `[pack.*]` lines are in <packs>, as
# `_se_selected` reads them, and a nested pack is valid after `_se_pack_check`.
# Returns 3 for an unknown pack, after a message.
_se_pack() {
  local packs=$1 name=$2 envs=$3 src=$4 kind pack item
  if [[ $packs != *$'\n'"pack $name"$'\n'* ]]; then
    _se_log "pack '$name' is not in bootstrap"
    return 3
  fi
  while read -r kind pack item; do
    [[ $kind == order && $pack == "$name" ]] || continue
    [[ $packs == *$'\n'"member $name $item true"$'\n'* ]] || continue
    if [[ $item == pack:* ]]; then
      _se_pack "$packs" "${item#pack:}" "$envs" "$src" || return
    else
      printf '%s %s %s\n' "$item" "$envs" "$src"
    fi
  done <<< "$packs"
}

# Stop on a loop through the pack <name>, over each `pack:<x>` member with any
# `default`. <chain> is the ` <pack> ` words of the packs that include this one.
# Returns 2 for a loop, after a message.
_se_pack_loop() {
  local packs=$1 name=$2 chain=$3 shown=$4 kind pack key rest loop word
  if [[ $chain == *" $name "* ]]; then
    loop=$name
    for word in ${chain#* "$name" }; do
      loop+=" -> $word"
    done
    _se_log "$shown: a pack loop: $loop -> $name"
    return 2
  fi
  chain+="$name "
  while read -r kind pack key rest; do
    [[ $kind == member && $pack == "$name" && $key == pack:* ]] || continue
    _se_pack_loop "$packs" "${key#pack:}" "$chain" "$shown" || return
  done <<< "$packs"
}

# Examine every `[pack.*]` table of <packs>, expanded or not, so a problem shows
# before a consumer selects that pack. Returns 2 or 3, after a message.
_se_pack_check() {
  local packs=$1 tools_dir=$2 shown=$3 kind pack key val
  while read -r kind pack key val; do
    [[ $kind == badvalue ]] || continue
    case $key:$val in
      depends:slice | required:slice | tools:slice | default:slice)
        _se_log "$shown: [pack.$pack] $key is the old format - write each member as <tool> = { default = true } or <tool> = {}"
        ;;
      *)
        _se_log "$shown: [pack.$pack] $key must be a table, { default = true } or {}"
        ;;
    esac
    return 2
  done <<< "$packs"
  while read -r kind pack key val; do
    if [[ $kind == member && $key == p:* ]]; then
      _se_log "$shown: [pack.$pack] \"$key\" is the old form - write \"pack:${key#p:}\" = { default = true }"
      return 2
    fi
  done <<< "$packs"
  while read -r kind pack key val; do
    [[ $kind == member ]] || continue
    case $val in
      "bad:key "*)
        _se_log "$shown: [pack.$pack] $key has the entry key '${val#bad:key }' - the only entry key is default"
        return 2
        ;;
      "bad:default "*)
        _se_log "$shown: [pack.$pack] $key: default must be true or false, not ${val#bad:default }"
        return 2
        ;;
    esac
  done <<< "$packs"
  while read -r kind pack key val; do
    if [[ $kind == member && $packs != *$'\n'"order $pack $key"$'\n'* ]]; then
      _se_log "$shown: [pack.$pack] $key must be on one line"
      return 2
    fi
  done <<< "$packs"
  while read -r kind pack key val; do
    if [[ $kind == pack && -d $tools_dir/$pack ]]; then
      _se_log "$shown: pack '$pack' is also a tool folder - rename one"
      return 2
    fi
  done <<< "$packs"
  while read -r kind pack key val; do
    [[ $kind == member ]] || continue
    if [[ $key == pack:* ]]; then
      if [[ $packs != *$'\n'"pack ${key#pack:}"$'\n'* ]]; then
        _se_log "pack '${key#pack:}' is not in bootstrap (named in pack $pack)"
        return 3
      fi
    elif [[ ! -d $tools_dir/$key ]]; then
      _se_log "tool '$key' is not in bootstrap (named in pack $pack)"
      return 3
    fi
  done <<< "$packs"
  while read -r kind pack key val; do
    [[ $kind == pack ]] || continue
    _se_pack_loop "$packs" "$pack" ' ' "$shown" || return
  done <<< "$packs"
}

# Print the selection for the lines <sel> (`tools|packs <name> <env,...|->`) as
# `<tool> <env,...|-> <source>` lines: the pack <base>, each pack of <sel>, then
# each tool of <sel>. <source> is `default` for the pack <base>, else the values
# table, for example `packs.security`. <packs-file> is the file of the packs,
# <tools-dir> the folder of the tools, and <shown> the name of the packs file in
# a message. Each key of `[pack.<name>]` is a member:
# `<tool> = { default = true }` or `<tool> = {}`, and `"pack:<x>"` for a nested
# pack. gomplate gives the shape,
# as `pack <name>`, `member <pack> <key> <true|false|bad:...>` and
# `badvalue <pack> <key> <kind>` lines. gomplate sorts the keys, so an awk scan
# gives the file order, as `order <pack> <key>` lines of the one-line members.
# Returns 2 or 3, after a message, on a problem of the packs file or of a pack.
_se_selected() {
  local file=$1 tools_dir=$2 base=$3 sel=$4 shown=$5 packs kind name envs template
  packs=$'\n'
  if [[ -f $file ]]; then
    template='<%- if has .p "pack" -%>
<%- range $k, $p := .p.pack -%>
pack <% $k %>
<% range $key, $v := $p -%>
<%- if eq (test.Kind $v) "map" -%>
<%- $st := "false" -%>
<%- if has $v "default" -%>
<%- $d := index $v "default" -%>
<%- if eq (test.Kind $d) "bool" -%>
<%- $st = conv.ToString $d -%>
<%- else -%>
<%- $st = print "bad:default " (test.Kind $d) -%>
<%- end -%>
<%- end -%>
<%- range $e, $ev := $v -%>
<%- if ne $e "default" -%>
<%- $st = print "bad:key " $e -%>
<%- end -%>
<%- end -%>
member <% $k %> <% $key %> <% $st %>
<% else -%>
badvalue <% $k %> <% $key %> <% test.Kind $v %>
<% end -%>
<%- end -%>
<%- end -%>
<%- end -%>'
    packs+=$(_se_gomplate -c "p=${file}" -i "$template") || {
      _se_log "cannot read $shown"
      return 2
    }
    packs+=$'\n'
    packs+=$(awk '
      function bare(text) {
        gsub(/["'\'']/, "", text)
        return text
      }
      /^[ \t]*\[/ {
        name = ""
        if ($0 ~ /^[ \t]*\[pack\.[^].]+\][ \t]*(#.*)?$/) {
          name = $0
          sub(/^[ \t]*\[pack\./, "", name)
          sub(/\].*$/, "", name)
          name = bare(name)
        }
        next
      }
      name != "" && /^[ \t]*[^#= \t][^=]*=[ \t]*\{.*\}[ \t]*(#.*)?$/ {
        key = $0
        sub(/^[ \t]*/, "", key)
        sub(/[ \t]*=.*$/, "", key)
        print "order", name, bare(key)
      }
    ' "$file") || {
      _se_log "cannot read $shown"
      return 2
    }
    packs+=$'\n'
  fi
  _se_pack_check "$packs" "$tools_dir" "$shown" || return
  _se_pack "$packs" "$base" - default || return
  while read -r kind name envs; do
    [[ $kind == packs ]] || continue
    _se_pack "$packs" "$name" "$envs" "packs.$name" || return
  done <<< "$sel"
  while read -r kind name envs; do
    [[ $kind == tools ]] && printf '%s %s %s\n' "$name" "$envs" "tools.$name"
  done <<< "$sel"
  return 0
}

# Walk the tools <start-tools> (space separated) depth-first, so each dependency
# finishes before the tool that named it. A stack of words rather than recursion:
# bash 3.2 has no local arrays worth passing around.
#   <deps-callback> <tool>  prints the dependency names of <tool>, or returns 2
#                           or 3 after its message. It runs in a subshell, each
#                           time that the walk reaches <tool>.
#   <done-callback> <tool>  runs when the walk finishes <tool>, and can return 2
#                           after its message.
# Sets _SE_WALK_VISITED to the finished tools as ` <tool> ` words, in visit order,
# and _SE_WALK_DEPS to the `<tool> <dependency>...` lines of the tools that have
# dependencies. Returns the first code that is not 0.
_se_walk() {
  local deps_cb=$1 done_cb=$2 pending="$3 " tool all deps word row visiting=' ' rc
  _SE_WALK_VISITED=' ' _SE_WALK_DEPS=''
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $_SE_WALK_VISITED != *" $tool "* ]] || continue
    rc=0
    all=$("$deps_cb" "$tool") || rc=$?
    ((rc == 0)) || return "$rc"
    deps='' row=''
    for word in $all; do
      row+=" $word"
      [[ $_SE_WALK_VISITED == *" $word "* ]] || deps+="$word "
    done
    if [[ -n $deps && $visiting != *" $tool "* ]]; then
      # Come back to this tool after its dependencies.
      visiting+="$tool "
      pending="$deps$tool $pending"
      continue
    fi
    [[ -z $row ]] || _SE_WALK_DEPS+="$tool$row"$'\n'
    "$done_cb" "$tool" || return
    _SE_WALK_VISITED+="$tool "
  done
}
