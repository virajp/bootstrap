#!/usr/bin/env bash

#MISE description="Scan the repo's dependencies for known vulnerabilities"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="skip the scan: the pre-commit gate's mode"
#USAGE arg "[files]" var=#true help="accepted for the gate's sake; the scanner does not narrow to it"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# grype's part of `code:sec`, run by that dispatcher with its flags and files.
# It reads every manifest and lockfile it recognises in the repo itself rather
# than a resolved dependency tree, so it needs no package manager, language
# runtime or lockfile install to say something true.
#
# The package manager's own advisory check is `setup:deps:audit`, a different
# task on purpose: that one reports during setup, this one fails before a
# commit.
#
# Under `--staged` — the pre-commit gate — the scan is skipped outright: a
# vulnerable transitive dependency is not news a commit can act on, and paying
# for the whole scan on every commit is how a gate gets turned off.

if [ "${usage_staged:-false}" = "true" ]; then
  exit 0
fi

VULN_CONFIG="${MISE_PROJECT_ROOT}/.config/grype.yaml"

if command -v grype >/dev/null 2>&1; then
  print_wait "Scanning dependencies for known vulnerabilities ... "
  if [ -f "${VULN_CONFIG}" ]; then
    grype "dir:${MISE_PROJECT_ROOT}" --config "${VULN_CONFIG}" --fail-on medium
  else
    grype "dir:${MISE_PROJECT_ROOT}" --fail-on medium
  fi
  print_ok
else
  print_warn "grype is not on PATH — skipping the vulnerability scan."
fi
