#!/usr/bin/env bash

#MISE description="Lint the repo's files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="files to lint (default: the whole repo)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# A dispatcher. Each selected linter supplies its own `code:lint:<tool>` task,
# and this runs every one of them with the same flags and files; with no linter
# selected it prints "no tool" and exits 0.
#
# This task is also the repo's linting HOOK: the pre-commit gate calls
# `code:lint --fix <files>`, which is why it takes an optional file list — the
# hook passes the staged files, a person passes nothing and gets the whole tree.

args=()
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
eval "args+=(${usage_files:-})"

run_tool_tasks code:lint ${args[@]+"${args[@]}"}
