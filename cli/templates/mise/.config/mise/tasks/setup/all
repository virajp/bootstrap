#!/usr/bin/env bash

#MISE description="Set up or upgrade everything this repo needs on your machine"
#MISE depends=["init"]

#USAGE flag "--all" help="Also set up every member project"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

if [ -z "${MISE_ENV:-}" ]; then
  print_error "MISE_ENV is unset. Run: MISE_ENV=dev mise run setup:all"
  exit 1
fi

# The entry point a human runs — on clone, and to re-sync a machine afterwards.
# Aliased as `setup` in `[shell_alias]`.
#
# This file is the ORCHESTRATOR and names no tool. Every step is a task by
# name; a step a tool supplies runs only when that task exists, so a repo
# without the tool still sets up end to end. Keep it that way — a tool named
# here is a tool every repo inherits whether or not it chose it.
#
# **Keep it idempotent: re-running must converge, never error.** It is the
# re-sync command as much as the first-run one, so a step that only works on a
# clean machine is a step that breaks the second run.

print_header "Setting up the toolchain ..."
mise run setup:mise

print_header "Setting up secrets ..."
run_task_if_present setup:secrets

print_header "Setting up dependencies ..."
mise run setup:deps:all

print_header "Setting up commit hooks ..."
run_task_if_present setup:precommit

print_header "Setting up AI tooling ..."
run_task_if_present setup:ai

# Members are set up only on request: the common case is working in one project,
# and recursing by default turns every setup into the slowest one. Each member
# runs its OWN task library through `mise run --cd`, so a polyglot repo gets one
# library per project rather than one library that knows every language.
#
# The member list comes from `_scripts/helpers`' `members`, which answers for
# either linkage — the repo's submodules, or the `MEMBERS` list in
# `.config/mise/conf.d/_base/mise.toml` — so this loop covers both and
# `code:worktrees` walks the same members this does. A repo that wants a member
# set up on its OWN flag rather than on `--all` adds one `mise run --cd <path>`
# per id beside the loop, guarded by that id's flag.

if [[ "${usage_all:-false}" == "true" ]]; then
  while read -r member; do
    [ -n "$member" ] || continue
    print_header "Setting up ${member} ..."
    mise run --cd "${MISE_PROJECT_ROOT}/${member}" setup:all
  done < <(members)
fi

print_header "Setup complete!"
