#!/usr/bin/env bash

#MISE description="Security scan the repo"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="scan only what is staged, and skip the dependency scan"
#USAGE arg "[files]" var=#true help="accepted for the gate's sake; neither scanner narrows to it"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Two scans, and both read the repo itself rather than a resolved dependency
# tree — which is what makes them a default the way `code:format` is
# one, and not a slot the way `code:lint` is. Neither needs a package manager,
# a language runtime or a lockfile to say something true.
#
#   secrets       every commit git holds, against the built-in rule set
#   vulnerable    every manifest and lockfile the scanner recognises
#
# The package manager's own advisory check is `setup:deps:audit`, a different
# task on purpose: that one reports during setup, this one fails before a
# commit. A repo that wants different scanners replaces this file.
#
# **This is also the repo's secret-scanning HOOK, which is what `--staged` is
# for.** The pre-commit gate calls `code:sec --staged` rather than a scanner
# binary, so the scanner and its config are configured once, here. In that mode
# the scan is the staged diff and nothing else, and the dependency scan is
# skipped outright: a vulnerable transitive dependency is not news a commit can
# act on, and paying for the whole scan on every commit is how a gate gets
# turned off.

SECRETS_CONFIG="${MISE_PROJECT_ROOT}/.config/gitleaks.toml"
VULN_CONFIG="${MISE_PROJECT_ROOT}/.config/grype.yaml"

if [ "${usage_staged:-false}" = "true" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    print_wait "Scanning the staged changes for secrets ... "
    if [ -f "${SECRETS_CONFIG}" ]; then
      gitleaks git --staged --config "${SECRETS_CONFIG}" --redact=100
    else
      gitleaks git --staged --redact=100
    fi
    print_ok
  else
    print_warn "gitleaks is not on PATH — skipping the staged secret scan."
  fi
  exit 0
fi

if command -v gitleaks >/dev/null 2>&1; then
  print_wait "Scanning for committed secrets ... "
  # The repo's git history, not the directory: a file git ignores can never be
  # committed, so a local `.env` or build output is not this scan's business. A
  # file list is accepted but not used — the narrowed scan is `--staged`.
  #
  # History never forgets, so a secret that was removed and rotated still fails
  # here. `--verbose` prints each finding's Fingerprint, and gitleaks skips every
  # fingerprint listed in `.gitleaksignore` at the repo root.
  secrets_args=(git . --redact=100 --verbose)
  if [ -f "${SECRETS_CONFIG}" ]; then
    secrets_args+=(--config "${SECRETS_CONFIG}")
  fi
  secrets_status=0
  gitleaks "${secrets_args[@]}" || secrets_status=$?
  if [ "${secrets_status}" -ne 0 ]; then
    print_error "ERROR"
    print_yellow "If a secret above was removed and rotated, add the Fingerprint gitleaks"
    print_yellow "printed for it to .gitleaksignore at the repo root, then run this again."
    exit "${secrets_status}"
  fi
  print_ok
else
  print_warn "gitleaks is not on PATH — skipping the secret scan."
fi

if command -v grype >/dev/null 2>&1; then
  print_wait "Scanning dependencies for known vulnerabilities ... "
  if [ -f "${VULN_CONFIG}" ]; then
    grype "dir:${MISE_PROJECT_ROOT}" --config "${VULN_CONFIG}" --fail-on medium
  else
    grype "dir:${MISE_PROJECT_ROOT}" --fail-on medium
  fi
  print_ok
else
  print_warn "grype is not on PATH — skipping the vulnerability scan."
fi
