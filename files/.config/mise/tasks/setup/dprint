#!/usr/bin/env bash

#MISE description="Upgrade dprint plugins"
#MISE hide=true
#MISE tools.dprint="latest"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Updating dprint plugins ..."

if [[ ! -f "${HOME}/.config/dprint/dprint.jsonc" ]]; then
  print_error "dprint configuration not found at ~/.config/dprint/dprint.jsonc"
  exit 1
fi

dprint config update --global
