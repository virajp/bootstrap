{
  // The global config holds the plugins and the rules. This file only adds the
  // paths that this repository excludes. dprint merges the two excludes.
  "extends": "~/.config/dprint/dprint.jsonc",
  "excludes": [
    // The member order of the packs is the sync order, and the TOML plugin
    // sorts keys.
    "repo/packs.toml",
  ],
}
