#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/mise/tasks/updateall-configs. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Render the selected Mac tools of bootstrap into $HOME, then run mise bootstrap"

#USAGE flag "--dry-run" help="show the changes without writing them"
#USAGE flag "--no-bootstrap" help="skip every mise bootstrap step"
#USAGE flag "--verbose" help="list each file, also an unchanged one"

set -euo pipefail

# `bootstrap mac sync` fetches the bootstrap clone into ~/.cache/bootstrap/,
# examines its version and syncs the Mac from MACOS_SETUP_REPO_PATH.
# BOOTSTRAP_BIN, a local build, replaces the bootstrap of mise.

# styled: 0 when the output on stderr shows glyphs. The rule of style_enabled
# of helpers.
styled() {
  if [[ -n ${FORCE_COLOR:-} && ${FORCE_COLOR} != 0 ]]; then
    return 0
  fi
  [[ -z ${NO_COLOR:-} && -t 2 && ${TERM:-dumb} != dumb ]]
}
# An info line and an error line: a glyph when styled, else [INFO] or [ERROR].
log() {
  if styled; then
    printf '· %s\n' "$*" >&2
  else
    printf '[INFO] %s\n' "$*" >&2
  fi
}
log_error() {
  if styled; then
    printf '✗ %s\n' "$*" >&2
  else
    printf '[ERROR] %s\n' "$*" >&2
  fi
}

usage() {
  cat << 'USAGE'
usage: mise run updateall:configs [--dry-run] [--no-bootstrap] [--verbose]

  --dry-run       show the changes without writing them
  --no-bootstrap  skip every mise bootstrap step
  --verbose       list each file, also an unchanged one
  -h, --help      show this help

exit codes: 0 done, 1 other failure, 2 usage or config error, 3 a tool
that bootstrap does not have, 4 the init stage changed (open a new
terminal, then run mise run updateall:configs), 5 the clone or fetch failed
USAGE
}

# The flags come from "$@", never from mise's usage_* variables, so the task
# works the same under `mise run` and under `bash`. `for` expands its list once,
# so each pass can move its argument to the end of "$@". The task consumes
# --verbose: it exports BOOTSTRAP_VERBOSE=1 and does not pass the flag on.
for arg in "$@"; do
  shift
  case ${arg} in
    --dry-run | --no-bootstrap) ;;
    --verbose)
      export BOOTSTRAP_VERBOSE=1
      continue
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log_error "unknown flag '${arg}'"
      usage >&2
      exit 2
      ;;
  esac
  set -- "$@" "${arg}"
done

if [[ -n ${_UPDATEALL_CONFIGS_RUNNING:-} ]]; then
  log_error "updateall:configs is already running in this process tree: a nested run is refused"
  exit 2
fi
export _UPDATEALL_CONFIGS_RUNNING=1

# A git hook exports these, and the clone of bootstrap must not follow them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# The cache of the old Mac sync. Its list of generated files moves to the new
# cache, when that cache has no list, so the stale rule removes the old files.
# The old folder then goes, but not while the old Mac sync holds its lock: a
# later run removes it. A failure here is not an error of the sync, and a list
# that cannot move keeps the old folder.
legacy_cleanup() {
  local cache=${BOOTSTRAP_CACHE:-${XDG_CACHE_HOME:-${HOME}/.cache}/bootstrap}
  local old=${XDG_CACHE_HOME:-${HOME}/.cache}/macos-setup
  local manifest=${cache}/macos-generated.tsv
  local pid
  [[ -e ${old} ]] || return 0
  mkdir -p -- "${cache}"
  if [[ ! -e ${manifest} && -f ${old}/generated.txt ]]; then
    if ! mv -- "${old}/generated.txt" "${manifest}"; then
      log_error "cannot move ${old}/generated.txt to ${manifest}: keeping ${old}"
      return 0
    fi
  fi
  pid=$(cat -- "${old}/lock/pid" 2> /dev/null) || pid=''
  if [[ -n ${pid} ]] && kill -0 "${pid}" 2> /dev/null; then
    log "the old Mac sync runs (pid ${pid}): keeping ${old}"
    return 0
  fi
  rm -rf -- "${old}" 2> /dev/null || true
}
legacy_cleanup

# The exit code of bootstrap is the exit code of this task, exit 4 (the stop
# after a changed init stage) too.
rc=0
"${BOOTSTRAP_BIN:-bootstrap}" mac sync "$@" || rc=$?
exit "${rc}"
