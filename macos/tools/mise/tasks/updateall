#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/mise/tasks/updateall. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Upgrade all tools managed in the system"
#MISE depends=["global:init"]
#MISE hide=true
#MISE dir="~"

#USAGE flag "-f --force" help="Run the weekly steps (macOS settings, power profile) even if they ran less than a week ago"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

# Weekly steps run when the stamp is missing or over a week old. The stamp
# lives in /tmp on purpose: macOS clears it on reboot, and a macOS update (which
# resets these settings) always reboots, so the first updateall after an update
# re-applies them regardless of the week.
readonly WEEKLY_STAMP="/tmp/mise-updateall-weekly.stamp"
readonly ONE_WEEK_SECONDS=$((7 * 24 * 60 * 60))
run_weekly="true"
if [[ "${usage_force:-false}" == "true" ]]; then
  rm -f "${WEEKLY_STAMP}"
elif [[ -f "${WEEKLY_STAMP}" ]]; then
  elapsed=$(($(date +%s) - $(date -r "${WEEKLY_STAMP}" +%s)))
  if ((elapsed < ONE_WEEK_SECONDS)); then
    run_weekly="false"
    print_header "Skipping weekly steps — last run $((elapsed / 3600))h ago; use --force to override."
  fi
fi

# Kill keyboxd (gpg) to ensure that stale keys are refreshed
# gpgconf --kill all || true

# Upgrade mise first to ensure we have the latest features and fixes. mise
# manages its own formula ([bootstrap.packages]).
print_header "Upgrading MISE ..."
mise self-update --yes

# Render the Mac tools into $HOME (the `mise bootstrap` steps follow
# below). Exit 4: the init stage (the shells, homebrew, mise) changed, so the
# rest needs a new terminal.
print_subheader "Rendering the Mac tools ..."
configs_rc=0
mise run updateall:configs -- --no-bootstrap || configs_rc=$?
if ((configs_rc == 4)); then
  print_warn "open a new terminal, then run: mise run updateall"
  exit 4
elif ((configs_rc != 0)); then
  print_error "updateall:configs failed (exit ${configs_rc})"
  exit "${configs_rc}"
fi

# Install & upgrade mise
print_subheader "Install MISE tools ..."
mise install --yes --include-task-tools --jobs 10

print_subheader "Upgrading mise tools ..."
mise upgrade --yes --jobs 10

# Prune all unused versions of tools
print_subheader "Pruning unused versions of tools ..."
mise prune --yes

# Update the plugins of the global dprint config (the dprint tool). The next
# sync keeps the new versions.
if [[ -f "${HOME}/.config/dprint/dprint.jsonc" ]] && mise x -- which dprint > /dev/null 2>&1; then
  print_subheader "Updating dprint plugins ..."
  mise x -- dprint config update --yes --config "${HOME}/.config/dprint/dprint.jsonc"
fi

# Upgrade Homebrew and all installed packages (the homebrew tool), with the
# GitHub token of fnox's brew profile when fnox is there
if ! task_exists upgrade:brew; then
  print_warn "Skipping upgrade:brew: no such task (its tool is not selected)"
elif command -v fnox > /dev/null 2>&1; then
  fnox -c "$HOME/.config/fnox/config.toml" exec --profile brew -- mise run upgrade:brew
else
  print_warn "fnox is not on PATH: running upgrade:brew without its GitHub token"
  mise run upgrade:brew
fi

print_subheader "Installing rest using mise ..."
mise bootstrap --skip macos-defaults,packages --yes

# Reshim mise to ensure all tools are available
print_subheader "Reshimming mise ..."
mise reshim

# Run mise doctor
print_subheader "Running mise doctor ..."
mise doctor --quiet --silent > /dev/null

run_task_if_exists upgrade:npm

run_task_if_exists upgrade:ai

# Weekly, and last on purpose: this prompts for sudo (pmset/nvram) and restarts
# Finder, Dock and ControlCenter, so everything above it is already done by
# then. `files` re-checks /etc/pam.d/sudo_local (Touch ID for sudo), `defaults`
# the macOS settings, `task` the pmset/nvram power profile.
if [[ "${run_weekly}" == "true" ]]; then
  # Apply macOS system settings
  print_header "Applying macOS system settings ..."
  mise bootstrap --only macos-defaults,defaults --yes

  mise run upgrade:power

  # Update the weekly stamp to indicate that the weekly steps have been run
  touch "${WEEKLY_STAMP}"
fi

# Upgrade macOS
mise run upgrade:macos:download

# Clean up unnecessary .DS_Store files from the projects folder
run_task_if_exists cleanupDS "${PROJECTS_DIR}"

# Start tailscale daemon
run_task_if_exists tailscale:daemon

print_header "Setup complete!"
