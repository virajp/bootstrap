# Synced from bootstrap: macos/tools/mise/.config/zsh/01b-mise.zsh.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
<% $pd := index .all "cli" | required "mise: select the cli tool, which holds projects_dir" %><% $pd = index $pd "projects_dir" | required "mise: set projects_dir in [tools.cli] of macos.toml" | regexp.Replace "^~" .env.HOME -%>
# mise activate
# Setting up mise trusted paths
export MISE_TRUSTED_CONFIG_PATHS="$HOME/.config/mise:<% $pd %>/github.com:<% $pd %>/gitlab.com"
# MISE_ENV must be set as "dev"
export MISE_ENV="dev"
# Must run after `brew shellenv` and the PATH exports
if [[ -x "${HOME}/.local/bin/mise" ]]; then
  # echo "Activating mise ... "
  if [[ -o interactive ]]; then
    # Interactive shell
    eval "$("${HOME}/.local/bin/mise" activate zsh)"
  else
    # Non-interactive shell
    eval "$("${HOME}/.local/bin/mise" activate zsh --shims)"
  fi
fi
