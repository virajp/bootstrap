#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/network/tasks/ips-ips. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE hide=true
#MISE dir="~"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

print_header "Getting all IP addresses ..."
ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | sort | awk '{ sub(/inet6? (addr:)? ?/, ""); print }'
