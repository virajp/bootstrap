<%- $projects := index .all.cli "projects_dir" | required "cli: set projects_dir in [tools.cli] of macos.toml" -%>
<%- if strings.HasPrefix "~" $projects -%><%- $projects = print .env.HOME (strings.TrimPrefix "~" $projects) -%><%- end -%>
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: Cloudflare (Workers deploy for the site — via CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN secrets)",
      "**Repository visibility**: PUBLIC — virajp/claude-plugins (github.com) — any push here is publishing",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: CI secrets referenced by name only: CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, GITHUB_TOKEN — values not gathered",
      "**Default / protected branches**: main (default), develop and main protected via active rulesets `protected-branches` and `release-tags`",
      "**CI/CD deploy targets**: Cloudflare Workers (site, via `wrangler deploy` on `site-v*` tags); npm publish (installer CLI, via `release.yml` on `installer-v*` tags) — both gated by GitHub Actions workflows in this repo",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: This repo (virajp/claude-plugins) and its origin remote (github.com:virajp/claude-plugins.git) only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: docs/memory/decisions/2026-09-06-secrets-store-is-runtime-not-development.md (filename-flagged, contents not read) — treat as confidential; share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development — maintaining the virajp-plugins Claude Code plugin marketplace (vwf, stackgen), its installer CLI, and its documentation site",
      "**Trusted repo**: ${HOME}/Projects/github.com/virajp/claude-plugins (working directory) and its origin remote github.com:virajp/claude-plugins.git — PUBLIC, so only this repo's own work belongs in commits/pushes here; confidential material (secrets, sensitive data) is never cleared into it by visibility alone",
      "**Org-specific CLIs**: None configured — `mise` (225× in-project, 349× in shell history) is a general-purpose toolchain/task runner, not org-specific",
      "routine under virajp/ prefix: none — repo is solo-authored, no org-wide prefix identified"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(gh release create:*) in virajp/claude-plugins — publishing a GitHub Release is an irreversible public action explicitly gated behind user confirmation per CLAUDE.md/release skill",
      "Bash(git push --tags) or direct tag pushes to `installer-v*`/`site-v*`/`*-v*` in this repo — release skill requires asking before p:i:release, p:plugins:release, p:site:release"
    ]
  },
  "cleanupPeriodDays": 30,
  "disableArtifact": false,
  "effortLevel": "medium",
  "env": {
    "AI_PLUGINS_USAGE_DIR": "${HOME}/.claude/usage",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5-1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_INSTALL_METHOD": "other",
    "CONTEXT7_RUNNER": "fnox exec -P context7 -- pnpm dlx",
    "DISABLE_AUTOUPDATER": "1",
    "MISE_ENV": "dev",
    "MISE_TRUSTED_CONFIG_PATHS": "<% .env.HOME %>/.config/mise:<% $projects %>"
  },
  "forceLoginMethod": "claudeai",
  "includeCoAuthoredBy": true,
  "model": "opus[1m]",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "STE100",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Skill",
      "WebFetch",
      "Bash(pnpm:*)",
      "Bash(mise:*)",
      "Bash(git:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Bash(* sudo *)",
      "Bash(sudo *)",
      "Bash(* su *)",
      "Bash(su *)",
      "Bash(* ssh *)",
      "Bash(ssh *)",
      "Bash(* firebase *)",
      "Bash(firebase *)",
      "Bash(* gcloud *)",
      "Bash(gcloud *)",
      "Bash(doppler *)",
      "Bash(* doppler *)"
    ]
  },
  "respectGitignore": true,
  "skillOverrides": {
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:doc-coauthoring": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off",
    "google-workspace": "off"
  },
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "terminalProgressBarEnabled": true,
  "tui": "fullscreen"
}
