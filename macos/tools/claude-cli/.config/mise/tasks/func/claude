#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/claude-cli/.config/mise/tasks/func/claude. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Start Claude Code (Remote Control), session named after the current folder"
#MISE hide=true
#MISE dir="{{cwd}}"

#USAGE arg "<name>" default="" help="Optional name to append to the session"
#USAGE flag "-n --new" help="Start a new session instead of resuming"
#USAGE flag "-m --model <model>" help="Specify the model to use for the Claude session" {
#USAGE   choices "fable[1m]" "haiku[1m]" "opus[1m]" "sonnet[1m]"
#USAGE }

#
# Usage: mise run func:claude [--model <model>] [name] [claude args...]

set -euo pipefail

# Claude Code is the claude tool's, which is opt-in
if ! command -v claude > /dev/null 2>&1; then
  echo "Claude Code is not installed or not in PATH."
  exit 1
fi

# Determine if a new session should be started based on the usage flag
new_session=false
if [[ "${usage_new:-false}" == "true" ]]; then
  new_session=true
fi

# Initialize the session name based on the current folder and optional name suffix
session="$(basename "$PWD")"
if [[ -n "${usage_name:-}" ]]; then
  session+="-$usage_name"
fi

# Initialize the arguments array with the session name
args=(--name "$session")

# Add the resume flag if not starting a new session
if [[ "$new_session" != "true" ]]; then
  args+=(--resume "$session")
fi

# Add the model flag if specified
if [[ -n "${usage_model:-}" ]]; then
  args+=(--model "$usage_model")
fi

# Add the dangerously skip permissions flag to the arguments array
args+=(--remote-control)
args+=(--dangerously-skip-permissions)
args+=(--allow-dangerously-skip-permissions)

# echo "${args[@]}"
exec claude "${args[@]}"
