#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/claude-cli/tasks/upgrade-ai. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Setup / Upgrade AI tools"
#MISE hide=true
#MISE dir="~"
#MISE tools={jq = "latest"}

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

print_header "Upgrading AI tools ..."

print_subheader "Adding marketplaces ..."
if ! claude plugins marketplace list --json | jq -e '.[] | select(.name == "claude-plugins-official")' > /dev/null; then
  claude plugins marketplace add anthropics/claude-plugins-official
fi
if ! claude plugins marketplace list --json | jq -e '.[] | select(.name == "virajp-plugins")' > /dev/null; then
  claude plugins marketplace add virajp/claude-plugins
fi

print_subheader "Upgrading marketplaces ..."
claude plugins marketplace update

print_subheader "Upgrading plugins ..."
while IFS= read -r plugin; do
  claude plugin update "${plugin}" --yes
done < <(claude plugins list --json | jq -r '.[] | select(.scope == "user") | .id')

print_subheader "Prune plugins ..."
claude plugin autoremove --scope user --yes
