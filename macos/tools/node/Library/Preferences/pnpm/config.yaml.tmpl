# Synced from bootstrap: macos/tools/node/Library/Preferences/pnpm/config.yaml.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
# Global pnpm configuration (pnpm v11+).
# Path resolved via: pnpm config get globalconfig
# Settings reference: https://pnpm.io/settings

minimumReleaseAge: 600 # 600 = 10h cooldown
<%- if index .config "pnpm_release_age_exclude" %>

# Exempt specific versions from the cooldown when an urgent fix is needed:
minimumReleaseAgeExclude:
<%- range .config.pnpm_release_age_exclude %>
  - <% printf "%q" . %>
<%- end %>
<%- end %>
