#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/node/tasks/upgrade-npm. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Upgrade npm"
#MISE hide=true
#MISE dir="~"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

# Check if npm is installed before attempting to update
type npm > /dev/null 2>&1 || exit 0

# Configure NPM global settings
print_header "Configuring npmrc ..."
npm config --global set fund=false

# Upgrade global npm packages
print_subheader "Upgrading global npm packages ..."
npm upgrade --global
