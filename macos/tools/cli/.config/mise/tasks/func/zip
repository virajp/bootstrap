#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/cli/.config/mise/tasks/func/zip. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE hide=true

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

# Display progress message with colored output
print_header "Zipping $1 to $1.zip ..."

# Create recursive zip archive
zip --recurse-paths "$1.zip" "$1"

print_success "Backup completed: $1.zip"
