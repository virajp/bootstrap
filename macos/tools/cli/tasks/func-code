#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/cli/tasks/func-code. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Open VSCode"
#MISE hide=true

#USAGE arg "<folder>" default="." help="Folder to open in VSCode"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

if command -v code &> /dev/null; then
  code "$MISE_ORIGINAL_CWD/${usage_folder:-.}"
else
  echo "VSCode is not installed or not in PATH."
  exit 1
fi
