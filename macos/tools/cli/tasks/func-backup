#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/cli/tasks/func-backup. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE hide=true

#USAGE arg "<folder>" help="Folder to backup" required

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

# Generate timestamp for unique filename
STAMP=$(date "+%Y%m%d-%H%M%S")

# Get absolute path and extract components
FOLDER="$MISE_ORIGINAL_CWD/${usage_folder:?}"
FULLPATH=$(cd "$FOLDER" && pwd -P)
BASENAME=${FULLPATH##*/} # Extract filename/dirname
PARENT=${FULLPATH%/*}    # Extract parent directory

# Construct timestamped backup filename
FILENAME="$PARENT/$BASENAME-$STAMP.zip"

# Display progress message with colored output
print_header "Backing up from $FULLPATH to $FILENAME ..."

# Create recursive zip archive
zip --recurse-paths "$FILENAME" "$FULLPATH" -x "*/.git/*" -x "*/node_modules/*"

print_success "Backup completed: $FILENAME"
