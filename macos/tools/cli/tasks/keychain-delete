#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/cli/tasks/keychain-delete. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Delete a generic password from the login keychain (exact service + account match)"
#MISE raw=true
#USAGE flag "--service <service>" required=#true help="Keychain item service (exact match)"
#USAGE flag "--account <account>" required=#true help="Keychain item account (exact match)"

set -euo pipefail

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

service="${usage_service:-}"
account="${usage_account:-}"

[[ -n "$service" ]] || die "--service must not be empty"
[[ -n "$account" ]] || die "--account must not be empty"
[[ "$(uname -s)" == "Darwin" ]] || die "macOS only"
command -v security > /dev/null 2>&1 || die "'security' CLI not found"
[[ -t 0 ]] || die "interactive terminal required (stdin is not a TTY)"

# Resolve the login keychain path (output is a quoted, indented path).
keychain="$(security login-keychain | sed -E 's/^[[:space:]]*"(.*)"[[:space:]]*$/\1/')"
[[ -f "$keychain" ]] || die "login keychain not found: $keychain"

# Look up the item's attributes only. Without -g/-w the secret is never read,
# so this does not trigger a keychain access prompt.
set +e
info="$(security find-generic-password -s "$service" -a "$account" "$keychain" 2>&1)"
rc=$?
set -e

if ((rc == 44)); then
  printf 'No generic password in login keychain for service="%s" account="%s"\n' "$service" "$account" >&2
  exit 1
elif ((rc != 0)); then
  die "security find-generic-password failed (exit $rc): $info"
fi

# Extract one attribute from `security` output, e.g.
#   "acct"<blob>="foo"
#   0x00000007 <blob>="label"
#   "cdat"<timedate>=0x3230...  "20240115093012Z\000"
attr() {
  local line val
  line="$(grep -m1 -E "^[[:space:]]*\"?$1\"?[[:space:]]*<" <<<"$info")" || return 0
  val="${line#*=}"
  [[ "$val" == "<NULL>" ]] && return 0
  [[ "$val" == 0x* ]] && val="${val#* }" # hex dump followed by printable form
  val="${val#"${val%%[![:space:]]*}"}"   # trim leading whitespace
  val="${val#\"}"
  val="${val%\"}"
  val="${val%\\000}"
  printf '%s' "$val"
}

fmt_date() {
  local d="$1"
  if [[ "$d" =~ ^[0-9]{14}Z$ ]]; then
    printf '%s-%s-%s %s:%s:%s UTC' "${d:0:4}" "${d:4:2}" "${d:6:2}" "${d:8:2}" "${d:10:2}" "${d:12:2}"
  else
    printf '%s' "$d"
  fi
}

row() {
  [[ -n "$2" ]] && printf '  %-9s %s\n' "$1" "$2"
  return 0
}

echo "Found keychain item:"
row "Keychain" "$keychain"
row "Class" "generic password"
row "Label" "$(attr 0x00000007)"
row "Service" "$(attr svce)"
row "Account" "$(attr acct)"
row "Kind" "$(attr desc)"
row "Comment" "$(attr icmt)"
row "Creator" "$(attr crtr)"
row "Created" "$(fmt_date "$(attr cdat)")"
row "Modified" "$(fmt_date "$(attr mdat)")"
echo

read -r -p "Delete this item? [y/N] " reply
case "$reply" in
  [yY] | [yY][eE][sS]) ;;
  *)
    echo "Aborted. Nothing deleted."
    exit 0
    ;;
esac

security delete-generic-password -s "$service" -a "$account" "$keychain" > /dev/null
echo "Deleted."
