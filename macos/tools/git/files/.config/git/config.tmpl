# Synced from bootstrap: macos/tools/git/files/.config/git/config.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
# Personal identity (name, email, signing key) lives in .config/git/identity,
# rendered from the git tool's values in [tools.git] of macos.toml.
[include]
	path = ~/.config/git/identity

[core]
	autocrlf = input
	editor = <% index .config "core_editor" | required "git: set core_editor in [tools.git] of macos.toml" %>
	excludesfile = ~/.config/git/ignore
	filemode = false
	# Caches untracked-file listings per directory in .git/index, keyed on
	# directory mtime. Safe on APFS; unreliable on filesystems that don't
	# bump directory mtime (some NFS/SMB mounts).
	untrackedCache = true

[push]
	default = current

[pull]
	rebase = false

[status]
	submoduleSummary = 9999

[color]
	ui = true

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[bash]
	showInformativeStatus = false
	showDirtyState = true
	showUntrackedFiles = true

[credential]
	helper = osxkeychain

[http]
	postBuffer = 524288000
	cookiefile = ~/.gitcookies

[advice]
	addIgnoredFile = false

[alias]
	lg1 = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold white)— %an%C(reset)%C(bold yellow)%d%C(reset)' --abbrev-commit --date=relative
	lg2 = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(bold white)— %an%C(reset)' --abbrev-commit
	lg3 = log --graph --decorate --pretty=oneline --abbrev-commit
	lo3a = log --graph --decorate --pretty=oneline --abbrev-commit --all
	lga = log --stat --abbrev-commit
	lg = !git lg2
	ign = ls-files -o -i --exclude-standard
	dw = diff --word-diff
	dt = difftool
	s = status --short --branch --ignore-submodules=all --renames
	c = checkout
	b = branch
	rb = rebase
	p = push --verbose

[commit]
	template = ~/.stCommitMsg
	gpgsign = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[init]
	defaultBranch = develop

[gpg]
	format = ssh

[gpg "ssh"]
<%- with index .config "gpg" %><% with index . "ssh" %><% with index . "program" %>
	program = <% . %>
<%- end %><% end %><% end %>
	allowedSignersFile = ~/.config/git/allowed_signers

[tag]
	forceSignAnnotated = true
