# Synced from bootstrap: macos/tools/git/files/.config/git/gitlab.config.tmpl. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
[user]
	name = "<% index .config "name" | required "git: set name in [tools.git] of macos.toml" %>"
	signingkey = "<% index .config "signing_key" | required "git: set signing_key in [tools.git] of macos.toml" %>"
<%- with index .config "email_gitlab" %>
	email = "<% . %>"
<%- end %>
