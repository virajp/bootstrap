# Synced from bootstrap: macos/tools/git/files/.config/git/identity.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
# Git identity, included from config. A template: rendered by setup-sync from
# the git tool's values in [tools.git] of macos.toml.
<% $pd := index .all "cli" | required "git: select the cli tool, which holds projects_dir" %><% $pd = index $pd "projects_dir" | required "git: set projects_dir in [tools.cli] of macos.toml" | regexp.Replace "^~" .env.HOME -%>
[user]
	name = <% index .config "name" | required "git: set name in [tools.git] of macos.toml" %>
	signingkey = <% index .config "signing_key" | required "git: set signing_key in [tools.git] of macos.toml" %>
	email = <% index .config "email_github" | required "git: set email_github in [tools.git] of macos.toml" %>

# Identity for GitHub
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.config/git/github.config

[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.config/git/github.config

[includeIf "gitdir:<% $pd %>/github.com/"]
	path = ~/.config/git/github.config

# Identity for GitLab
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
	path = ~/.config/git/gitlab.config

[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
	path = ~/.config/git/gitlab.config

[includeIf "gitdir:<% $pd %>/gitlab.com/"]
	path = ~/.config/git/gitlab.config
