# Synced from bootstrap: macos/tools/ssh/files/.ssh/config.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
<%- with index .config "includes" %>

# Included files that other tools contribute (for example OrbStack's 'orb'
# SSH host for Linux machines). An Include only works at the top of
# ssh_config, before any Host blocks.
<%- range . %>
Include <% . | regexp.Replace "^~" $.env.HOME %>
<%- end %>
<%- end %>

# Machine-local hosts (LAN boxes, per-host auth overrides). Untracked on purpose:
# this file is public. Missing file is fine — ssh ignores an unmatched Include.
Include ~/.ssh/config.local

Host *
  Include ~/.ssh/config.identity
  StrictHostKeyChecking accept-new
  CheckHostIP yes
  TCPKeepAlive yes
  AddKeysToAgent yes
  UseKeychain yes
  PasswordAuthentication no
  PreferredAuthentications publickey,password
  Protocol 2
  ServerAliveInterval 30
  ServerAliveCountMax 4
<%- with index .config "identity_agent" %>
  IdentityAgent "<% . | regexp.Replace "^~" $.env.HOME %>"
<%- end %>
