#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/pstree/.config/mise/tasks/func/myps. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="List processes for the current user, optionally filtered"
#MISE hide=true
#MISE dir="~"

#USAGE arg "[process]" default="" help="Filter processes by name or PID"

set -euo pipefail
source "${HOME}/.config/mise/tasks/_scripts/helpers"

filter="${usage_process:-}"
args=(-g 2 -l 7)

if [[ -z "$filter" ]]; then
  print_header "Listing processes for user $USER ..."
  exec pstree "${args[@]}" -u "$USER"
fi

print_header "Listing processes for user $USER filtered by $filter ..."

# Our own ancestry (this script, mise, the shell...) so it never matches itself
self=" "
pid=$$
while [[ "$pid" -gt 1 ]]; do
  self+="$pid "
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done

pids=()
if [[ "$filter" =~ ^[0-9]+$ ]]; then
  ps -p "$filter" > /dev/null 2>&1 && pids+=("$filter")
else
  # pgrep matches the process name (not argv) and never reports itself
  while read -r p; do
    [[ "$self" == *" $p "* ]] || pids+=("$p")
  done < <(pgrep -U "$USER" -- "$filter" || true)
fi

if [[ ${#pids[@]} -eq 0 ]]; then
  echo "No processes found matching '$filter'"
  exit 1
fi

for p in "${pids[@]}"; do
  args+=(-p "$p")
done

pstree "${args[@]}"
