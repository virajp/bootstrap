{
  // Synced from bootstrap: macos/tools/dprint/files/.config/dprint/dprint.jsonc. Do not edit this file.
  // The next sync writes it again, and each change in this file is lost.
  // dprint configuration file
  // ref: https://dprint.dev/config/
  // The global config formats the base formats only: TOML, JSON, Markdown,
  // YAML and shell. A repository gets the blocks of its tools in its own
  // shared dprint.jsonc.
  "excludes": [
    "**/*-lock.yaml",
    "**/*.svg",
    "brag-output/",
    "**/package-lock.json",
  ],
  "newLineKind": "lf",
  "toml": {
    "indentTables": "never",
    "indentEntries": "never",
    "sortKeys": true,
    "sortArrays": false,
    "sortInlineTables": true,
    "array.preferSingleLine": true,
    "array.spaceSurroundingBrackets": true,
    "inlineTable.spaceSurroundingBraces": true,
    "comment.forceLeadingSpace": false,
  },
  "json": {
    "trailingCommas": "jsonc",
    "jsonTrailingCommaFiles": ["*.jsonc", ".vscode/settings.json"],
    "preferSingleLine": false,
  },
  "markdown": {
    "tags": {
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "shell": "sh",
    },
    "textWrap": "maintainAndWrap",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
  },
  "yaml": {
    "formatComments": true,
    "bracketSpacing": true,
    "proseWrap": "always",
  },
  "shuck": {
    // mise task scripts have no file extension, so the shuck plugin does not
    // match them by default. Templates (*.tmpl) are not valid shell.
    "associations": [
      "**/.config/mise/tasks/**",
      "!**/*.tmpl",
    ],
    "indentWidth": 2,
    "useTabs": false,
    "binaryNextLine": true,
    "switchCaseIndent": true,
    "spaceRedirects": true,
  },
  "plugins": [
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.2",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/shuck@0.2.2",
  ],
}
