{
  // Synced from bootstrap: macos/tools/dprint/.config/dprint/dprint.jsonc. Do not edit this file.
  // The next sync replaces it, and a manual change is lost.
  // dprint configuration file
  // ref: https://dprint.dev/config/
  // Responsible to format:
  // - Dockerfiles
  // - Markup files (HTML, Astro, Svelte, Vue)
  // - TOML files
  // - JSON files (*.json, *.jsonc) but ignore `package.json`
  "dockerfile": {},
  "excludes": [
    "**/*-lock.yaml",
    "**/*.svg",
    "brag-output/",
    "**/package-lock.json",
  ],
  "markup": {
    "formatComments": true,
    "scriptIndent": true,
    "html.scriptIndent": true,
    "vue.scriptIndent": true,
    "svelte.scriptIndent": true,
    "astro.scriptIndent": true,
    "styleIndent": true,
    "html.styleIndent": true,
    "vue.styleIndent": true,
    "svelte.styleIndent": true,
    "astro.styleIndent": true,
    "maxAttrsPerLine": 1,
    "html.normal.selfClosing": true,
    "html.void.selfClosing": true,
    "component.selfClosing": true,
    "svg.selfClosing": true,
    "vBindStyle": "short",
    "vOnStyle": "short",
    "vForDelimiterStyle": "in",
    "vSlotStyle": "vSlot",
    "component.vSlotStyle": "vSlot",
    "default.vSlotStyle": "vSlot",
    "named.vSlotStyle": "vSlot",
    "vBindSameNameShortHand": true,
    "astroAttrShorthand": true,
  },
  "newLineKind": "lf",
  "toml": {
    "indentTables": "never",
    "indentEntries": "never",
    "sortKeys": true,
    "sortArrays": false,
    "sortInlineTables": true,
    "array.preferSingleLine": true,
    "array.spaceSurroundingBrackets": true,
    "inlineTable.spaceSurroundingBraces": true,
    "comment.forceLeadingSpace": false,
  },
  "json": {
    "trailingCommas": "jsonc",
    "jsonTrailingCommaFiles": ["*.jsonc", ".vscode/settings.json"],
    "preferSingleLine": false,
  },
  "markdown": {
    "tags": {
      "sh": "sh",
      "bash": "bash",
      "zsh": "zsh",
      "shell": "sh",
    },
    "textWrap": "maintainAndWrap",
    "emphasisKind": "asterisks",
    "strongKind": "asterisks",
  },
  "typescript": {
    "quoteProps": "consistent",
    "useBraces": "always",
    "arrowFunction.useParentheses": "force",
    "binaryExpression.linePerExpression": true,
    "memberExpression.linePerExpression": true,
    "enumDeclaration.memberSpacing": "newLine",
    "exportDeclaration.sortTypeOnlyExports": "last",
    "importDeclaration.sortTypeOnlyImports": "first",
    "exportDeclaration.forceMultiLine": "whenMultiple",
    "importDeclaration.forceMultiLine": "whenMultiple",
  },
  "yaml": {
    "formatComments": true,
    "bracketSpacing": true,
    "proseWrap": "always",
  },
  "exec": {
    // Rust formatting command
    "commands": [{
      "command": "mise x -- rustfmt --edition 2024",
      "exts": ["rs"],
      // add the config files for automatic cache invalidation when the rust version or rustfmt config changes
      "cacheKeyFiles": [
        "rustfmt.toml",
        "rust-toolchain.toml",
      ],
    }],
  },
  "tailwindcss": {},
  "ruff": {
    "indentWidth": 2,
    "lineLength": 120,
  },
  "shuck": {
    // mise task scripts have no file extension, so the shuck plugin does not
    // match them by default. Templates (*.tmpl) are not valid shell.
    "associations": [
      "**/.config/mise/tasks/**",
      "!**/*.tmpl",
    ],
    "indentWidth": 2,
    "useTabs": false,
    "binaryNextLine": true,
    "switchCaseIndent": true,
    "spaceRedirects": true,
  },
  "plugins": [
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/typescript@0.96.1",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-tailwindcss@0.1.0",
    "npm:@dprint/ruff@0.11.3",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3",
    "npm:@dprint/shuck@0.2.2",
  ],
}
