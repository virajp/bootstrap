#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/macos-setup/tasks/upgrade-macos-download. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Download macOS updates"
#MISE hide=true
#MISE dir="~"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

print_header "Installing Rosetta 2 ..."
softwareupdate --install-rosetta --agree-to-license

print_header "Downloading macOS updates ..."
softwareupdate --download --all

print_header "Upgrades from AppStore ..."
if command -v mas > /dev/null 2>&1; then
  mas upgrade
else
  print_warn "Skipping mas upgrade: mas is not on PATH (its tool is not selected)"
fi
