#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/macos-setup/tasks/helpers. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE hide=true
# Helper functions for mise tasks
# Source this file in other tasks using: source "${HOME}/.config/mise/tasks/_scripts/helpers"

# Color codes
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly RED='\033[0;31m'
readonly BOLD='\033[1m'
readonly NORMAL='\033[0m'

# Emojis
readonly SUCCESS_EMOJI="✅"
readonly ERROR_EMOJI="🚫"

# Print colored section header with new line
print_header() {
  local msg="$1"
  line_sep "="
  echo -e "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section sub-header with new line
print_subheader() {
  local msg="$1"
  line_sep "-"
  echo -e "${GREEN}${BOLD}${msg}${NORMAL}"
}

# Print colored section header without new line
print_wait() {
  local msg="$1"
  echo -en "${YELLOW}${BOLD}${msg}${NORMAL}"
}

# Print empty line
print_newline() {
  echo ""
}

print_error() {
  local msg="$1"
  echo -e "${ERROR_EMOJI} ${RED}${BOLD}${msg}${NORMAL}"
}

print_success() {
  local msg="$1"
  echo -e "${SUCCESS_EMOJI} ${GREEN}${BOLD}${msg}${NORMAL}"
}

print_warn() {
  local msg="$1"
  echo -e "${YELLOW}${BOLD}${msg}${NORMAL}"
}

# Print line separator
line_sep() {
  local COL
  COL=$(stty size 2> /dev/null | awk '{print $2}')
  # Build a string of spaces equal to width, then replace with '='
  local line
  printf -v line '%*s' "${COL:-80}" ''
  printf '%s\n' "${line// /$1}"
}

# 0 when the mise task <task> exists: the tool that ships it is selected
task_exists() {
  mise tasks info "$1" > /dev/null 2>&1
}

# Run the mise task <task> [args...] when it exists, else skip it with a log
# line: the tasks of an opt-in tool exist only when that tool is selected
run_task_if_exists() {
  local task="$1"
  if task_exists "${task}"; then
    mise run "$@"
  else
    print_warn "Skipping ${task}: no such task (its tool is not selected)"
  fi
}
