#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/macos-setup/.config/mise/tasks/updateall/configs/sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Render the Mac tools from the temp copy that updateall:configs made"
#MISE hide=true

#USAGE flag "--dry-run" help="show the changes without writing them"
#USAGE flag "--no-bootstrap" help="skip every mise bootstrap step"

set -uo pipefail

printf '%s\n' "setup-sync: running ${BASH_SOURCE[0]}" >&2

# `updateall:configs` passes its temp copy of the cache clone. The sync code
# then comes from the commit that it renders, so a change to that code applies
# in the same run. A Mac has no local copy of the sync code, so without a clone
# this task stops.
if [[ -z ${SYNC_ENGINE_CLONE:-} ]]; then
  printf '%s\n' "setup-sync: SYNC_ENGINE_CLONE is not set - run mise run updateall:configs instead" >&2
  exit 2
fi
lib="${SYNC_ENGINE_CLONE}/sync-engine/setup-sync"
if [[ ! -f ${lib} ]]; then
  printf '%s\n' "setup-sync: ${lib} not found - nothing synced" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "${lib}"

# The exit code of setup_sync is the exit code of this task, exit 4 (the stop
# after a changed init stage) too.
setup_sync "$@"
