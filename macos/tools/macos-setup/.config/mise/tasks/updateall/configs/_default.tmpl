#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/macos-setup/.config/mise/tasks/updateall/configs/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Render the selected Mac tools of bootstrap into $HOME, then run mise bootstrap"

#USAGE flag "--dry-run" help="show the changes without writing them"
#USAGE flag "--no-bootstrap" help="skip every mise bootstrap step"
#USAGE flag "--verbose" help="list each file, also an unchanged one"

set -euo pipefail

# This task only refreshes the cache clone and copies it. The Go engine then
# runs in a child process with that temp copy, so the render never reads the
# clone itself. sync-engine/VERSION of the copy selects the engine release.

# The code below is sync-engine/clone of the bootstrap clone: the sync embeds
# it when it renders this template. It comes first, because log uses it.
<% file.Read (print .sync_engine "/clone") | strings.TrimPrefix "#!/usr/bin/env bash\n" %>

# An info line and an error line: a glyph when styled, else the prefix.
log() {
  if _se_clone_styled 2; then
    printf 'ℹ️ %s\n' "$*" >&2
  else
    printf '%s\n' "setup-sync: $*" >&2
  fi
}
log_error() {
  if _se_clone_styled 2; then
    printf '❌ %s\n' "$*" >&2
  else
    printf '%s\n' "setup-sync: $*" >&2
  fi
}

usage() {
  cat << 'EOF'
usage: mise run updateall:configs [--dry-run] [--no-bootstrap] [--verbose]

  --dry-run       show the changes without writing them
  --no-bootstrap  skip every mise bootstrap step
  --verbose       list each file, also an unchanged one
  -h, --help      show this help

exit codes: 0 done, 1 other failure, 2 usage or config error, 3 a tool
that macos-setup does not have, 4 the init stage changed (open a new
terminal, then run mise run updateall:configs), 5 the clone or fetch failed
EOF
}

# The flags come from "$@", never from mise's usage_* variables, so the task
# works the same under `mise run` and under `bash`. `for` expands its list once,
# so each pass can move its argument to the end of "$@", and --verbose stays
# out: the engine refuses an unknown flag.
dry_run=''
for arg in "$@"; do
  shift
  case ${arg} in
    --dry-run)
      dry_run=1
      ;;
    --no-bootstrap) ;;
    --verbose)
      export SYNC_ENGINE_VERBOSE=1
      continue
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log_error "unknown flag '${arg}'"
      usage >&2
      exit 2
      ;;
  esac
  set -- "$@" "${arg}"
done

if [[ -n ${_MACOS_SETUP_DEFAULT_RUNNING:-} ]]; then
  log_error "updateall:configs is already running in this process tree - a nested run is refused"
  exit 2
fi
export _MACOS_SETUP_DEFAULT_RUNNING=1

# A git hook exports these, and the clone below must not follow them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Before any network use: without the config folder there is nothing to
# render.
if [[ -z ${MACOS_SETUP_CONFIG_PATH:-} ]]; then
  log_error "MACOS_SETUP_CONFIG_PATH is not set - set it to the folder of macos.toml"
  exit 2
fi
if [[ ! -d ${MACOS_SETUP_CONFIG_PATH} ]]; then
  log_error "the config folder ${MACOS_SETUP_CONFIG_PATH} does not exist - set MACOS_SETUP_CONFIG_PATH to the folder of macos.toml"
  exit 2
fi

# The cache of the old Mac task. Its list of generated files moves to the new
# cache, when that cache has no list. The old folder then goes, but not while
# the old Mac sync holds its lock: a later run removes it. A failure here is
# not an error of the sync, and a list that cannot move keeps the old folder.
mac_legacy_cleanup() {
  local old=${XDG_CACHE_HOME:-${HOME}/.cache}/macos-setup
  local manifest=${_SE_CACHE}/macos-generated.tsv
  local pid
  [[ -e ${old} ]] || return 0
  if [[ ! -e ${manifest} && -f ${old}/generated.txt ]]; then
    if ! mv -- "${old}/generated.txt" "${manifest}"; then
      log_error "cannot move ${old}/generated.txt to ${manifest} - keeping ${old}"
      return 0
    fi
  fi
  pid=$(cat -- "${old}/lock/pid" 2> /dev/null) || pid=''
  if [[ -n ${pid} ]] && kill -0 "${pid}" 2> /dev/null; then
    log "the old Mac sync runs (pid ${pid}) - keeping ${old}"
    return 0
  fi
  rm -rf -- "${old}" 2> /dev/null || true
}

_se_clone_init
trap _se_clone_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

_se_lock
_se_legacy_cleanup
mac_legacy_cleanup
rc=0
_se_fetch || rc=$?
((rc == 0)) || exit "${rc}"
_se_copy macos-setup || exit 1
# A dry run writes nothing in $HOME, so it holds the lock only over the refresh
# and the copy; a real run holds it to the end of the engine.
if [[ -n ${dry_run} ]]; then
  _se_unlock
fi

# The engine: SYNC_ENGINE_BIN, a local build, else the release that
# sync-engine/VERSION of the copy names. VERSION has one line, MAJOR.MINOR.PATCH.
if [[ -n ${SYNC_ENGINE_BIN:-} ]]; then
  if [[ ! -f ${SYNC_ENGINE_BIN} || ! -x ${SYNC_ENGINE_BIN} ]]; then
    log_error "SYNC_ENGINE_BIN ${SYNC_ENGINE_BIN} is not an executable file - nothing synced"
    exit 2
  fi
  engine=("${SYNC_ENGINE_BIN}")
else
  version=''
  IFS= read -r version 2> /dev/null < "${_SE_COPY}/sync-engine/VERSION" || true
  if [[ ! ${version} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    log_error "sync-engine/VERSION of the clone is not MAJOR.MINOR.PATCH ('${version}') - nothing synced"
    exit 5
  fi
  if ! mise install "github:virajp/bootstrap@${version}"; then
    log_error "cannot install the sync engine ${version} (github:virajp/bootstrap) - nothing synced"
    exit 5
  fi
  engine=(mise x "github:virajp/bootstrap@${version}" -- sync-engine)
fi
if [[ ${SYNC_ENGINE_VERBOSE:-} == 1 ]]; then
  printf '%s\n' "setup-sync: running ${engine[*]} macos" >&2
fi
# The exit code of the engine is the exit code of this task, exit 4 (the stop
# after a changed init stage) too.
rc=0
SYNC_ENGINE_CLONE="${_SE_COPY}" "${engine[@]}" macos "$@" || rc=$?
exit "${rc}"
