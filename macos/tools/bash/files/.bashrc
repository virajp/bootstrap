# Synced from bootstrap: macos/tools/bash/files/.bashrc. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
# =============================================================================
# Bash Configuration
# =============================================================================

# Load all BASH configuration
# A bash glob with no match stays literal, so skip a path that does not exist.
for f in ~/.config/bash/*.bash; do
  [[ -e "$f" ]] || continue
  # echo "$(date): $f"
  # shellcheck source=/dev/null
  source "$f"
done
