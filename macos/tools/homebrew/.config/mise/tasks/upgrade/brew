#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/homebrew/.config/mise/tasks/upgrade/brew. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Upgrade all tools managed using Homebrew"
#MISE hide=true
#MISE dir="~"

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

print_header "Homebrew packages ..."

# Check if brew is installed before attempting to update
if ! command -v brew > /dev/null 2>&1; then
  print_error "Homebrew is not installed. Please install Homebrew first."
  exit 1
fi

# Update Homebrew itself
print_subheader "Updating Homebrew ..."
brew update --force # --verbose

# Formulae, casks and mas apps are mise's: [mise.bootstrap.packages] in
# tools.toml, generated into conf.d/<tool>/mise.toml. VS Code extensions are
# brew's (Brewfile, via brew:casks).

# Tailscale runs as a root service and needs special handling before the
# generic upgrade below would otherwise fail on its root-owned keg.
run_task_if_exists upgrade:tailscale

print_subheader "Deleting brew packages NOT in [bootstrap.packages] ..."
mise bootstrap packages prune --yes

print_subheader "Install/Upgrade all declared packages ..."
mise bootstrap packages upgrade --yes
mise bootstrap packages apply --update --yes

