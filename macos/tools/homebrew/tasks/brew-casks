#!/usr/bin/env bash
# Synced from bootstrap: macos/tools/homebrew/tasks/brew-casks. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Install/upgrade casks and VS Code extensions from the Brewfile"
#MISE hide=true
#MISE dir="~"

# Run by hand. Formulae and most casks are mise's: [mise.bootstrap.packages] in
# tools.toml, generated into conf.d/<tool>/mise.toml. The Brewfile only holds
# casks and VS Code extensions, so cleanup is scoped to those types and never
# touches formulae.

set -e
source "${HOME}/.config/mise/tasks/_scripts/helpers"

readonly BREWFILE="${HOME}/.config/brewfile"

print_header "Installing/upgrading casks from the Brewfile ..."
brew bundle install --upgrade --file "${BREWFILE}"

print_header "Removing casks and extensions NOT in the Brewfile ..."
brew bundle cleanup --force --casks --vscode --file "${BREWFILE}"
