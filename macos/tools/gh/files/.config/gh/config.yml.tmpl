# Merged by bootstrap: macos/tools/gh/.config/gh/config.yml.tmpl
# Only these keys are enforced; gh owns every other key.
version: "1"
# WHY: Use SSH for git operations instead of HTTPS for better security with keys
# What protocol to use when performing git operations. Supported values: ssh, https
git_protocol: ssh
# WHY: the editor comes from editor in [tools.gh] of macos.toml
# What editor gh should run when creating issues, pull requests, etc. If blank, will refer to environment.
editor: <% index .config "editor" | required "gh: set editor in [tools.gh] of macos.toml" %>
# A pager program to send command output to, e.g. "less". Set the value to "cat" to disable the pager.
pager: less
# WHY: Aliases for commonly used commands to speed up workflow
# Aliases allow you to create nicknames for gh commands
aliases:
  co: pr checkout
