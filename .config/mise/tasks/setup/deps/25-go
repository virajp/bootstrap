#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/go/tasks/setup-deps-go. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Download the Go modules, then report the outdated and vulnerable ones; --upgrade upgrades them"
#MISE hide=true

#USAGE flag "--upgrade" help="upgrade the dependencies to their latest minor and patch versions instead of downloading the versions of go.sum"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the go tool. Without go or without a go.mod, this is not a Go
# project, so the task does not apply and prints nothing.
mise x -- which go > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"
# A failed git stops the task, with the error of git.
LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- 'go.mod' '*/go.mod' | sort -u)
[[ -n "${LIST}" ]] || exit 0
MODULES=()
while IFS= read -r file; do
  [[ -n "${file}" ]] && MODULES+=("$(dirname "${file}")")
done <<< "${LIST}"

if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_header "Upgrading Go dependencies ..."
else
  print_header "Downloading Go dependencies ..."
fi

for dir in "${MODULES[@]}"; do
  print_subheader "Preparing the module in ${dir} ..."
  if [[ "${usage_upgrade:-false}" == "true" ]]; then
    # -u never changes a major version, because the major version is part of
    # the module path. Thus an upgrade stays inside the versions that the code
    # can import. tidy then removes the modules that are no longer needed.
    (cd "${dir}" && mise x -- go get -u ./... && mise x -- go mod tidy)
  else
    # go.sum decides the versions; a download never changes it. verify makes
    # sure that each module in the cache matches its hash.
    (cd "${dir}" && mise x -- go mod download && mise x -- go mod verify)
  fi
done

for dir in "${MODULES[@]}"; do
  print_subheader "Checking for outdated Go dependencies in ${dir} ..."
  # A report only: each dependency that has a newer version.
  (cd "${dir}" && mise x -- go list -m -u \
    -f '{{if and (not .Main) (not .Indirect) .Update}}{{.Path}} {{.Version}} -> {{.Update.Version}}{{end}}' all)
done

# The sync installs govulncheck only when it finds a go.mod. Before the first
# sync after that, it can be missing.
if ! mise x -- which govulncheck > /dev/null 2>&1; then
  print_warn "govulncheck is not installed - run mise run setup:configs, then mise install"
  exit 0
fi
for dir in "${MODULES[@]}"; do
  print_subheader "Auditing Go dependencies in ${dir} for known vulnerabilities ..."
  # Exits 3 when the code calls a vulnerable function, and that stops the setup.
  (cd "${dir}" && mise x -- govulncheck ./...)
done
