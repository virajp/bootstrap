#!/usr/bin/env bash
# Synced from bootstrap: tools/base/.config/mise/tasks/setup/configs/_default. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files of this repository's tools from bootstrap"

#USAGE flag "--dry-run" help="show the changes without writing them"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# This task only clones. `setup:configs:sync` then runs in a new process with
# the sync code of this clone, not with the local copy that the sync replaces.
# Thus a change to the sync code applies in the same run.
url=${REPO_SYNC_URL:-git@github.com:virajp/bootstrap.git}
clone=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap.XXXXXX")
trap 'rm -rf -- "${clone}"' EXIT

print_header "Cloning bootstrap ..."
# BatchMode and no terminal prompt: a missing key or no access fails here
# instead of waiting for a password nobody will type.
if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
  git clone --quiet --depth 1 --single-branch -- "${url}" "${clone}"; then
  print_error "Cannot clone ${url} - nothing synced"
  exit 5
fi

# Unquoted on purpose: empty adds no argument.
[[ "${usage_dry_run:-false}" == "true" ]] && DRY_RUN="--dry-run" || DRY_RUN=""
REPO_SYNC_CLONE="${clone}" mise run setup:configs:sync ${DRY_RUN}
