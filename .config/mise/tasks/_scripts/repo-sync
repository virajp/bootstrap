#!/usr/bin/env bash
# Synced from bootstrap: tools/base/.config/mise/tasks/_scripts/repo-sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Helper functions to sync shared files from the bootstrap repo"
#MISE hide=true

# repo-sync — copy the shared files of the selected tools from the private
# `bootstrap` repo into this repo. Meant to be *sourced* by a mise task, not
# executed:
#
#   source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"
#   repo_sync [--dry-run]
#
# The values file lists the tools: `tools = ["base", "node"]`. Each tool is a
# folder `tools/<tool>/` in `bootstrap`, which holds its files at the path
# they get here, and a `tool.toml` manifest:
#
#   depends    = ["python"]     tools added with this one
#   root_only  = false          true: refused in a git submodule
#   extensions = ["a.b"]        VS Code extensions, for `.vscode/extensions.json`
#   seed       = ["bunfig.toml"] files written only when missing; the repo owns
#                               them after that
#   [seed_requires]             optional: a seed written only when this repo
#                               has the file, `"pnpm-workspace.yaml" = "package.json"`
#   [[precommit]]               `repos:` entries of `.config/pre-commit-config.yaml`
#   [mise.<section>]            the mise config of the tool, in mise syntax
#   [mise_env.<env>.<section>]  optional: more mise config for one environment
#
# One call clones the default branch once (shallow, over SSH) and syncs every
# file of every selected tool from that one clone.
#
# Environments: `environments` of the values file, from dev (necessary), ci,
# prod and stage (prod and stage only with ci). Without the key, only dev.
#
# mise config: the sync generates `.config/mise/conf.d/<folder>/mise.<env>.toml`
# for each selected environment and each tool with `[mise]` tables (`_base` for
# base, else the tool name). `.config/mise.toml` is the only file for every
# environment; no `mise.toml` is generated.
#   * A mise tool of a tool listed in `tools` is in the environments of its
#     `envs` (default dev). A mise tool of a tool that only a dependency adds
#     is in dev. Each mise `depends` of a mise tool is in its environments too.
#   * `[tools]`, `[tool_alias]` and `[plugins]` follow each entry. `[settings]`,
#     `[env]` and the other shared sections go to each environment of one of
#     the folder's tools. `[vars]`, `[secrets]`, `[shell_alias]`, `[hooks]`,
#     `[tasks]`, the daemons and the like are for dev only.
#   * `[mise_env.<env>]` is added to that environment as it is.
#   * base also gets `setup-all` and `setup-<submodule>` in dev, from the git
#     submodules of this repo.
#   * The mise `depends` of an entry adds the tool that defines that mise tool.
#   * A shipped `conf.d/*/mise.<env>.toml` of an environment that is not
#     selected is skipped.
#   * Afterwards, a file in `conf.d/*/` with the bootstrap header that this
#     run did not write is removed: it belongs to a tool, an environment or a
#     layout that is gone. A file without the header, such as a seed, is never
#     touched.
#
# Templates: a file that ends in `.tmpl` is rendered with gomplate, formatted
# with this repo's dprint config when dprint is available, and written without
# the suffix. The context is the values file (`<% .repo_name %>`,
# `<% .member.<name>.label %>`) plus:
#   .submodules  the git submodules only, nested ones included
#   .members     the git members from `members()` in `helpers` (submodules,
#                else MEMBERS), then each `[member.<name>]` of the values file
#                that is not one of them — a folder of a monorepo, which must
#                exist
#   .tools       the selected tools, dependencies included
#   .extensions  the VS Code extensions of those tools and of the `extensions`
#                list of the values file, sorted, no duplicates. In the root
#                repository, also those of each git submodule (the tools and
#                the `extensions` list of its values file)
#   .precommit   the `[[precommit]]` entries of those tools, in tool order, then
#                the entries of this repo's `.config/repo-sync/pre-commit.yaml`
# The delimiters are `<% %>`, because `{{ }}` belongs to mise and `[[ ]]` to
# bash, and both must reach the output unchanged. gomplate reads the TOML too;
# the calling task provides it with `#MISE tools.gomplate="latest"`.
#
# Merge tasks: the branch model follows the branches that exist, here or on
# origin. With `main` and `develop`, the sync writes `code/merge/develop` and
# `code/merge/main`; with only one of them, `code/merge/_default`. It removes the
# merge tasks of the other model: they are not seeds, so the repo does not own
# them. With neither branch, the sync stops.
#
# .gitignore: the shared ignore set is written first, then the lines of this
# repo's `.config/repo-sync/gitignore`, if that file exists. A later line wins,
# so the repo can negate a shared pattern with `!`.
#
# Failure handling
#   * A file takes the mode of its source, also when it exists already. To
#     make a template executable, make its `.tmpl` executable.
#   * A destination is only replaced after a complete copy or render, so a
#     failure always leaves the existing file as it was.
#   * A bad file does not stop the others; a failed clone, an unknown tool or a
#     root-only tool in a submodule stops the whole run.
#
# Return codes
#   0  success (or nothing to change)
#   2  usage error, a values file without `tools`, a root-only tool in a
#      submodule, a repo with neither `main` nor `develop`, a template that
#      cannot render, or a `[mise]` config that cannot be generated
#   3  a tool that is not in bootstrap (fix the values file)
#   5  the clone failed (network, SSH key or access to the repo), or
#      `pre-commit autoupdate` could not resolve the hook revisions
#   1  anything else (local filesystem errors, ...)
#
# Environment:
#   REPO_SYNC_URL     the repo to clone (default git@github.com:virajp/bootstrap.git)
#   REPO_SYNC_CLONE   an existing clone to use instead of a new one; set by
#                     `setup:configs`, which also loads this file from it
#   REPO_SYNC_VALUES  the values file
#                     (default $MISE_PROJECT_ROOT/.config/bootstrap.toml)

_rs_log() { printf '%s\n' "repo-sync: $*" >&2; }

# Print the permission bits of <path>, for example 755.
_rs_mode() { stat -c %a -- "$1" 2> /dev/null || stat -f %Lp -- "$1"; }

# Show <path> relative to the current directory when it is under it.
_rs_path() { [[ $1 == "$PWD"/* ]] && printf '%s' "${1#"$PWD"/}" || printf '%s' "$1"; }

# Temp files and directories still on disk; removed if the task exits early.
_RS_TMPS=()
_rs_cleanup() {
  ((${#_RS_TMPS[@]})) && rm -rf -- "${_RS_TMPS[@]}"
  return 0
}
trap _rs_cleanup EXIT
trap '_rs_cleanup; exit 130' INT
trap '_rs_cleanup; exit 143' TERM

# Print the repo's member names, one per line: the git members first, then the
# `[member.<name>]` keys of <values> that are not git members, which must be
# folders in the repo. Returns 2 when a key is neither.
_rs_members() {
  local values=$1 name=$2 member keys seen=" "
  if ! declare -F members > /dev/null; then
    # shellcheck source=/dev/null
    source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
  fi
  while IFS= read -r member; do
    [[ -n $member ]] || continue
    printf '%s\n' "$member"
    seen+="$member "
  done < <(members)
  keys=$(mise x -- gomplate --left-delim '<%' --right-delim '%>' -c "v=${values}" \
  -i '<% if has .v "member" %><% range $k, $x := .v.member %><% $k %>
<% end %><% end %>') || return 2
  while IFS= read -r member; do
    [[ -n $member && $seen != *" $member "* ]] || continue
    if [[ ! -d ${MISE_PROJECT_ROOT}/${member} ]]; then
      _rs_log "$name: [member.${member}] in $(_rs_path "$values") is not a submodule or a folder of the repo"
      return 2
    fi
    printf '%s\n' "$member"
  done <<< "$keys"
}

# gomplate with the template delimiters this repo uses.
_rs_gomplate() { mise x -- gomplate --left-delim '<%' --right-delim '%>' "$@"; }

# Print the items of the list <key> in the TOML file <file>, one per line;
# nothing when the key is absent.
_rs_list() {
  local file=$1 key=$2
  _rs_gomplate -c "v=${file}" -i "<% if has .v \"${key}\" %><% range (index .v \"${key}\") %><% . %>
<% end %><% end %>"
}

# Print the manifest of <tool> in the clone <dir> as `<field> <value>` lines:
# `depends`, `extension`, `seed`, `seed_requires <seed> <file>`,
# `mise <mise-tool> <envs,...|-> [<mise-depends>...]`, and one
# `root_only true|false`.
_rs_manifest() {
  local dir=$1 tool=$2
  _rs_gomplate -c "t=${dir}/tools/${tool}/tool.toml" -i '<% range .t.depends %>depends <% . %>
<% end %><% range .t.extensions %>extension <% . %>
<% end %><% range .t.seed %>seed <% . %>
<% end %><% if has .t "seed_requires" %><% range $k, $v := .t.seed_requires %>seed_requires <% $k %> <% $v %>
<% end %><% end %><% if and (has .t "mise") (has .t.mise "tools") %><% range $k, $v := .t.mise.tools %>mise <% $k %><% if and (test.IsKind "map" $v) (has $v "envs") %> <% join $v.envs "," %><% else %> -<% end %><% if and (test.IsKind "map" $v) (has $v "depends") %><% if test.IsKind "string" $v.depends %> <% $v.depends %><% else %><% range $v.depends %> <% . %><% end %><% end %><% end %>
<% end %><% end %>root_only <% .t.root_only %>
'
}

# Set _RS_MISE_DEFS to the ` <mise-tool>=<tool> ` words of every tool in the
# clone <dir>, selected or not: the mise `depends` of an entry find their tool
# here. Returns 2, after a message, when two tools define the same mise tool.
_rs_mise_index() {
  local dir=$1 manifest tool name names
  _RS_MISE_DEFS=' '
  for manifest in "$dir"/tools/*/tool.toml; do
    tool=${manifest%/tool.toml}
    tool=${tool##*/}
    names=$(_rs_gomplate -c "t=${manifest}" -i '<% if and (has .t "mise") (has .t.mise "tools") %><% range $k, $v := .t.mise.tools %><% $k %>
<% end %><% end %>') || {

      _rs_log "cannot read tools/$tool/tool.toml"
      return 2
    }
    for name in $names; do
      if [[ $_RS_MISE_DEFS == *" $name="* ]]; then
        _rs_log "mise tool '$name' is defined in tools/$tool and in another tool - keep one"
        return 2
      fi
      _RS_MISE_DEFS+="$name=$tool "
    done
  done
}

# Print the tool that defines the mise tool <name>, or nothing.
_rs_mise_owner() {
  local def=${_RS_MISE_DEFS#* "$1="}
  [[ $def != "$_RS_MISE_DEFS" ]] && printf '%s' "${def%% *}"
}

# Resolve the tools of <values> against the clone <dir>, dependencies
# included, into _RS_TOOLS (space separated, a dependency before the tool that
# needs it), _RS_DIRECT (the tools that <values> lists), _RS_EXTENSIONS (one
# per line, sorted, unique), _RS_SEEDS (` <tool>/<path> ` words),
# _RS_SEED_REQUIRES (` <tool>/<path>=<file> ` words) and _RS_MISE_ENTRIES
# (`<tool> <mise-tool> <envs,...|-> [<mise-depends>...]` lines). A mise `depends`
# adds the tool that defines it. Returns 2 or 3, after a message, on any
# problem.
_rs_resolve() {
  local dir=$1 values=$2 requested tool field value pending in_submodule
  requested=$(_rs_list "$values" tools) || {
    _rs_log "cannot read $(_rs_path "$values")"
    return 2
  }
  if [[ -z ${requested//[$'\n ']/} ]]; then
    _rs_log "$(_rs_path "$values") lists no tools - add tools = [\"base\", ...]"
    return 2
  fi
  in_submodule=$(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) || in_submodule=''

  _RS_TOOLS=' ' _RS_SEEDS=' ' _RS_SEED_REQUIRES=' ' _RS_EXTENSIONS='' _RS_MISE_ENTRIES=''
  _RS_DIRECT=" $(printf '%s\n' "$requested" | tr '\n' ' ')"
  # Depth-first, so each dependency lands before the tool that named it. A
  # stack of words rather than recursion: bash 3.2 has no local arrays worth
  # passing around, and the manifests are tiny.
  pending=$(printf '%s\n' "$requested" | tr '\n' ' ')
  local visiting=' '
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $_RS_TOOLS != *" $tool "* ]] || continue
    if [[ ! -f $dir/tools/$tool/tool.toml ]]; then
      _rs_log "tool '$tool' is not in bootstrap"
      return 3
    fi
    local deps='' manifest entry name owner
    manifest=$(_rs_manifest "$dir" "$tool") || {
      _rs_log "cannot read tools/$tool/tool.toml"
      return 2
    }
    while read -r field value; do
      case $field in
        depends)
          [[ $_RS_TOOLS != *" $value "* ]] && deps+="$value "
          ;;
        mise)
          read -r entry _ value <<< "$value"
          for name in $value; do
            owner=$(_rs_mise_owner "$name") || owner=''
            if [[ -z $owner ]]; then
              _rs_log "mise tool '$entry' of tools/$tool depends on '$name', which no tool defines"
              return 2
            fi
            [[ $owner != "$tool" && $_RS_TOOLS != *" $owner "* ]] && deps+="$owner "
          done
          ;;
      esac
    done <<< "$manifest"
    if [[ -n $deps && $visiting != *" $tool "* ]]; then
      # Come back to this tool after its dependencies.
      visiting+="$tool "
      pending="$deps$tool $pending"
      continue
    fi
    while read -r field value; do
      case $field in
        extension)
          _RS_EXTENSIONS+="$value"$'\n'
          ;;
        seed)
          _RS_SEEDS+="$tool/$value "
          ;;
        seed_requires)
          # `<seed> <file>`: neither path has a space.
          _RS_SEED_REQUIRES+="$tool/${value% *}=${value#* } "
          ;;
        mise)
          _RS_MISE_ENTRIES+="$tool $value"$'\n'
          ;;
        root_only)
          if [[ $value == true && -n $in_submodule ]]; then
            _rs_log "tool '$tool' is for the root repository only - remove it from the tools of this submodule"
            return 2
          fi
          ;;
      esac
    done <<< "$manifest"
    _RS_TOOLS+="$tool "
  done
  _RS_EXTENSIONS=$(printf '%s' "$_RS_EXTENSIONS" | sort -u)
}

# Print the VS Code extensions of the tools of <values>, dependencies
# included, one per line. Like `_rs_resolve`, a mise `depends` adds the tool
# that defines it. Nothing is checked: a problem in a member's values file is
# for that member's own sync to report.
_rs_tool_extensions() {
  local dir=$1 values=$2 pending tool field value seen=' ' entry name owner
  pending=$(_rs_list "$values" tools 2> /dev/null | tr '\n' ' ') || pending=''
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $seen != *" $tool "* && -f $dir/tools/$tool/tool.toml ]] || continue
    seen+="$tool "
    while read -r field value; do
      case $field in
        extension)
          printf '%s\n' "$value"
          ;;
        depends)
          pending+=" $value "
          ;;
        mise)
          read -r entry _ value <<< "$value"
          for name in $value; do
            owner=$(_rs_mise_owner "$name") || owner=''
            [[ -n $owner ]] && pending+=" $owner "
          done
          ;;
      esac
    done < <(_rs_manifest "$dir" "$tool" 2> /dev/null)
  done
}

# Add to _RS_EXTENSIONS the `extensions` list of <values>. In the root
# repository, also add the extensions of each git submodule: the tools of its
# `.config/bootstrap.toml` and its own `extensions` list. VS Code opens the
# root only, so the root recommends the extensions of the whole tree.
_rs_extensions() {
  local dir=$1 values=$2 sub subvalues extra
  extra=$(_rs_list "$values" extensions) || extra=''
  if [[ -z $(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) && -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    while IFS= read -r sub; do
      subvalues="${MISE_PROJECT_ROOT}/${sub}/.config/bootstrap.toml"
      [[ -f $subvalues ]] || subvalues="${MISE_PROJECT_ROOT}/${sub}/.config/repo-config.toml"
      [[ -n $sub && -f $subvalues ]] || continue
      extra+=$'\n'$(_rs_tool_extensions "$dir" "$subvalues")
      extra+=$'\n'$(_rs_list "$subvalues" extensions 2> /dev/null) || true
    done < <(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null)
  fi
  _RS_EXTENSIONS=$(printf '%s\n%s\n' "$_RS_EXTENSIONS" "$extra" | grep -v '^$' | sort -u) || _RS_EXTENSIONS=''
}

# A branch that exists here or on origin; the same test as `branch_exists` in
# `checks`, which a first sync does not have yet.
_rs_branch_exists() {
  git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$1" ||
    git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Set _RS_SKIP to the ` base/<path> ` words of the merge tasks of the other
# branch model. Returns 2, after a message, when neither branch exists.
_rs_merge_model() {
  local tasks=base/.config/mise/tasks/code/merge
  local main=0 develop=0
  _rs_branch_exists main && main=1
  _rs_branch_exists develop && develop=1
  if ((main && develop)); then
    _RS_SKIP=" $tasks/_default "
  elif ((main || develop)); then
    _RS_SKIP=" $tasks/develop $tasks/main "
  else
    _rs_log "the repo has neither 'main' nor 'develop' - create one, then sync again"
    return 2
  fi
}

# Remove the file <path> of <tool> from this repo, if it exists.
_rs_remove() {
  local tool=$1 path=$2 dry_run=$3 dest show
  dest="${MISE_PROJECT_ROOT}/${path}"
  show=$(_rs_path "$dest")
  [[ -e $dest ]] || return 0
  if ((dry_run)); then
    _rs_log "would remove $show"
    return 0
  fi
  rm -f -- "$dest" || {
    _rs_log "cannot remove $show"
    return 1
  }
  _rs_log "removed    $show"
}

# Set _RS_ENVS to the ` <env> ` words of `environments` in <values>, in the
# order dev, ci, prod, stage. Without the key, only dev. Returns 2, after a
# message, for an unknown name, no dev, or prod or stage without ci.
_rs_envs() {
  local values=$1 list name
  list=$(_rs_list "$values" environments) || {
    _rs_log "cannot read $(_rs_path "$values")"
    return 2
  }
  if [[ -z ${list//[$'\n ']/} ]]; then
    _rs_log "$(_rs_path "$values") lists no environments - using dev only; add environments = [\"dev\", ...]"
    list=dev
  fi
  for name in $list; do
    case $name in
      dev | ci | prod | stage) ;;
      *)
        _rs_log "environment '$name' in $(_rs_path "$values") is not one of dev, ci, prod, stage"
        return 2
        ;;
    esac
  done
  list=" $(printf '%s ' $list)"
  if [[ $list != *" dev "* ]]; then
    _rs_log "environments in $(_rs_path "$values") must include dev"
    return 2
  fi
  if [[ ($list == *" prod "* || $list == *" stage "*) && $list != *" ci "* ]]; then
    _rs_log "environments in $(_rs_path "$values"): prod and stage need ci"
    return 2
  fi
  _RS_ENVS=' '
  for name in dev ci prod stage; do
    [[ $list == *" $name "* ]] && _RS_ENVS+="$name "
  done
  return 0
}

# Set _RS_MISE_ENVS to the ` <mise-tool>:<env> ` words of the selected
# environments: the `envs` (default dev) of each entry of a tool that the
# values file lists, dev for each entry of a tool that only a dependency adds,
# then, until nothing changes, each environment of an entry for each of its
# mise `depends`. A tool that runs in CI needs its dependencies there too.
# Returns 2, after a message, for an unknown name in `envs`.
_rs_mise_env() {
  local tool entry envs deps name env changed=1
  _RS_MISE_ENVS=' '
  while read -r tool entry envs deps; do
    [[ -n $entry ]] || continue
    if [[ $_RS_DIRECT != *" $tool "* || $envs == - ]]; then
      envs=dev
    fi
    for env in ${envs//,/ }; do
      case $env in
        dev | ci | prod | stage) ;;
        *)
          _rs_log "envs of mise tool '$entry' in tools/$tool/tool.toml: '$env' is not one of dev, ci, prod, stage"
          return 2
          ;;
      esac
      if [[ $_RS_ENVS == *" $env "* && $_RS_MISE_ENVS != *" $entry:$env "* ]]; then
        _RS_MISE_ENVS+="$entry:$env "
      fi
    done
  done <<< "$_RS_MISE_ENTRIES"
  while ((changed)); do
    changed=0
    while read -r tool entry envs deps; do
      [[ -n $entry && -n $deps ]] || continue
      for env in $_RS_ENVS; do
        [[ $_RS_MISE_ENVS == *" $entry:$env "* ]] || continue
        for name in $deps; do
          if [[ $_RS_MISE_ENVS != *" $name:$env "* ]]; then
            _RS_MISE_ENVS+="$name:$env "
            changed=1
          fi
        done
      done
    done <<< "$_RS_MISE_ENTRIES"
  done
  return 0
}

# The template that builds one environment, REPO_SYNC_ENV, from the `[mise]`
# and `[mise_env]` tables of a tool.toml (`.t`), as TOML. An entry is in the
# environment when ` <name>:<env> ` is in REPO_SYNC_ENVS. A section that it
# does not know stops the render. REPO_SYNC_DEV_ALIASES adds `<name>=<command>`
# lines to `[shell_alias]` of dev.
_RS_MISE_TEMPLATE='<% $m := dict %><% if has .t "mise" %><% $m = .t.mise %><% end -%>
<% $env := env.Getenv "REPO_SYNC_ENV" -%>
<% $envw := env.Getenv "REPO_SYNC_ENVS" -%>
<% $entry := coll.Slice "tools" "tool_alias" "plugins" -%>
<% $folder := coll.Slice "settings" "env" "tool_config" "task_config" "task_templates" "doctor" "deps" "oci" -%>
<% $devonly := coll.Slice "vars" "secrets" "redactions" "shell_alias" "hooks" "watch_files" "daemons" "daemon_groups" "daemons_settings" "daemon_providers" "tasks" -%>
<% $in := eq $env "dev" -%>
<% if has $m "tools" %><% $in = false %><% range $k, $v := $m.tools %><% if strings.Contains (printf " %s:%s " $k $env) $envw %><% $in = true %><% end %><% end %><% end -%>
<% $out := dict -%>
<% range $s, $body := $m -%>
<% if has $entry $s -%>
<% $a := dict -%>
<% range $k, $v := $body -%>
<% if and (eq $s "tools") (test.IsKind "map" $v) %><% $v = coll.Omit "envs" $v %><% end -%>
<% if strings.Contains (printf " %s:%s " $k $env) $envw %><% $a = coll.Merge (dict $k $v) $a %><% end -%>
<% end -%>
<% if $a %><% $out = coll.Merge (dict $s $a) $out %><% end -%>
<% else if has $folder $s -%>
<% if $in %><% $out = coll.Merge (dict $s $body) $out %><% end -%>
<% else if has $devonly $s -%>
<% if eq $env "dev" %><% $out = coll.Merge (dict $s $body) $out %><% end -%>
<% else -%>
<% test.Fail (printf "[mise.%s] is not supported in a tool.toml" $s) -%>
<% end -%>
<% end -%>
<% if and (has .t "mise_env") (has .t.mise_env $env) -%>
<% range $s, $body := index .t.mise_env $env -%>
<% if not (or (has $entry $s) (has $folder $s) (has $devonly $s)) %><% test.Fail (printf "[mise_env.%s.%s] is not supported in a tool.toml" $env $s) %><% end -%>
<% if has $out $s %><% $body = coll.Merge $body (index $out $s) %><% end -%>
<% $out = coll.Merge (dict $s $body) $out -%>
<% end -%>
<% end -%>
<% $extra := env.Getenv "REPO_SYNC_DEV_ALIASES" -%>
<% if and (eq $env "dev") $extra -%>
<% $al := dict %><% if has $out "shell_alias" %><% $al = index $out "shell_alias" %><% end -%>
<% range (strings.Split "\n" $extra) %><% if . %><% $kv := strings.SplitN "=" 2 . %><% $al = coll.Merge (dict (index $kv 0) (index $kv 1)) $al %><% end %><% end -%>
<% $out = coll.Merge (dict "shell_alias" $al) $out -%>
<% end -%>
<% if $out %><% $out | data.ToTOML %><% end -%>'

# Generate the mise config of <tool> from the `[mise]` and `[mise_env]` tables
# of its tool.toml in the clone <dir>: one `mise.<env>.toml` for each selected
# environment with content, into tools/<tool>/.config/mise/conf.d/<folder>/ of
# the clone. The file loop then syncs it like a shipped file. Records each
# file in _RS_GENERATED. Returns 2, after a message, when the config cannot be
# generated; the existing files of the folder are then kept.
_rs_mise_render() {
  local dir=$1 tool=$2 folder=$2 env name rel tmp err
  [[ $tool == base ]] && folder=_base
  local out="${dir}/tools/${tool}/.config/mise/conf.d/${folder}"
  local header="# Synced from bootstrap: tools/${tool}/tool.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
"
  tmp="${dir}/.repo-sync-mise" err="${dir}/.repo-sync-mise-err"
  # `setup-all` and `setup-<submodule>` exist only in a repo with git
  # submodules. They depend on this repo, not on tool.toml, so base gets them
  # here.
  local aliases='' subs sub
  if [[ $tool == base && -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    subs=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || subs=''
    if [[ -n $subs ]]; then
      aliases='setup-all=mise run setup --all'
      for sub in $subs; do
        aliases+=$'\n'"setup-${sub}=mise run setup --${sub}"
      done
    fi
  fi
  for env in $_RS_ENVS; do
    name=mise.${env}.toml
    rel=".config/mise/conf.d/${folder}/${name}"
    # gomplate writes no file for an empty output, so the previous one must go.
    rm -f -- "$tmp"
    if ! REPO_SYNC_ENV=$env REPO_SYNC_ENVS=$_RS_MISE_ENVS REPO_SYNC_DEV_ALIASES=$aliases \
      _rs_gomplate -c "t=${dir}/tools/${tool}/tool.toml" -i "$_RS_MISE_TEMPLATE" -o "$tmp" 2> "$err"; then
      _rs_log "tools/$tool/tool.toml: cannot generate the mise config: $(sed -n 's/.*error calling Fail: template generation failed: //p' "$err" | sed 's/"}$//')"
      for name in dev ci prod stage; do
        _RS_SEEN+="${rel%/*}/mise.${name}.toml "
      done
      return 2
    fi
    [[ -s $tmp && -n $(tr -d ' \n' < "$tmp") ]] || continue
    if [[ -e $out/$name ]]; then
      _rs_log "tools/$tool ships $rel and also generates it from [mise] - remove one"
      return 2
    fi
    mkdir -p -- "$out" &&
      { printf '%s\n' "$header" && cat -- "$tmp"; } > "$out/$name" &&
      chmod 644 "$out/$name" || return 1
    _RS_GENERATED+="$tool/$rel "
  done
  rm -f -- "$tmp" "$err"
}

# Remove each `.config/mise/conf.d/*/mise*.toml` with the bootstrap header
# that this run did not write or keep (_RS_SEEN): its tool or its layout is
# gone. A file without the header belongs to the repo and stays.
_rs_stale() {
  local dry_run=$1 file rel rc=0
  local root="${MISE_PROJECT_ROOT}/.config/mise/conf.d"
  [[ -d $root ]] || return 0
  while IFS= read -r file; do
    rel=${file#"$MISE_PROJECT_ROOT"/}
    [[ $_RS_SEEN != *" $rel "* ]] || continue
    # `repo-config` is the old name of this repository, in older copies.
    head -n 1 -- "$file" | grep -qE '^# Synced from (bootstrap|repo-config): ' || continue
    _rs_remove '' "$rel" "$dry_run" || rc=$?
    ((dry_run)) || rmdir -- "${file%/*}" 2> /dev/null || true
  done < <(find "$root" -mindepth 2 -maxdepth 2 -type f -name 'mise*.toml' | sort)
  return "$rc"
}

# Write the template context to <out>: the values of <values>, with
# `members`, `submodules`, `tools`, `extensions` and `precommit` merged in
# first, so a key of the same name in the values file cannot replace them.
# <dir> is the clone.
_rs_context() {
  local dir=$1 values=$2 out=$3 members tool
  members=$(_rs_members "$values" "template context") || return 2
  # The git submodules alone: `members` also has the folder members.
  local submodules=''
  if [[ -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    submodules=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || submodules=''
  fi
  # One context per tool manifest, `tool_<name>`, for the `[[precommit]]`
  # entries; `repo_precommit` for the repo's own entries.
  local args=(-c "v=${values}")
  for tool in $_RS_TOOLS; do
    args+=(-c "tool_${tool}=${dir}/tools/${tool}/tool.toml")
  done
  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/pre-commit.yaml"
  local has_own=''
  if [[ -f $own ]]; then
    args+=(-c "repo_precommit=${own}")
    has_own=1
  fi
  REPO_SYNC_OWN_PRECOMMIT=$has_own REPO_SYNC_MEMBERS=$members REPO_SYNC_SUBMODULES=$submodules REPO_SYNC_TOOLS=$(printf '%s\n' $_RS_TOOLS) REPO_SYNC_EXTENSIONS=$_RS_EXTENSIONS \
    _rs_gomplate "${args[@]}" -o "$out" \
    -i '<% $ctx := dict %><% range (coll.Slice "members" "submodules" "tools" "extensions") %><% $l := coll.Slice %><% range (env.Getenv (printf "REPO_SYNC_%s" (strings.ToUpper .)) | strings.Split "\n") %><% if . %><% $l = coll.Append . $l %><% end %><% end %><% $ctx = coll.Merge $ctx (dict . $l) %><% end %><% $pc := coll.Slice %><% range $ctx.tools %><% $t := index $ (printf "tool_%s" .) %><% if has $t "precommit" %><% range $t.precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% end %><% if env.Getenv "REPO_SYNC_OWN_PRECOMMIT" %><% range $.repo_precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% $ctx = coll.Merge $ctx (dict "precommit" $pc) %><% coll.Merge $ctx .v | data.ToJSON %>' >&2
}

# Remove each synced file (with the bootstrap header) that is at the place
# of a folder in <dir> or above it, up to the repo root. Returns 1, after a
# message, when such a file is the repo's own.
_rs_unblock() {
  local dir=$1 dry_run=$2 show
  while [[ $dir == "$MISE_PROJECT_ROOT"/* ]]; do
    if [[ -f $dir && ! -L $dir ]]; then
      show=$(_rs_path "$dir")
      if ! head -n 3 -- "$dir" | grep -qE 'Synced from (bootstrap|repo-config): '; then
        _rs_log "$show is a file of this repo, but the sync needs a folder there - move it"
        return 1
      fi
      if ((dry_run)); then
        _rs_log "would remove $show (a folder replaces it)"
      else
        rm -f -- "$dir" || return 1
        _rs_log "removed    $show (a folder replaces it)"
      fi
      return 0
    fi
    dir=$(dirname -- "$dir")
  done
}

# Sync the file <path> of <tool> from the clone in <dir>. Leaves the
# destination untouched when the content is identical, when it is a seed that
# exists, when it is a seed whose `seed_requires` file is missing, or on any
# failure.
_rs_file() {
  local dir=$1 tool=$2 path=$3 dry_run=$4 ctx=$5
  local src="${dir}/tools/${tool}/${path}" out=${path%.tmpl}
  local dest destdir tmp show rc=0 env
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_rs_path "$dest")
  # A mise file of an environment that this repo does not use. Not recorded,
  # so `_rs_stale` removes an old copy with the header.
  if [[ $out == .config/mise/conf.d/*/mise.*.toml ]]; then
    env=${out##*/mise.}
    env=${env%.toml}
    if [[ $_RS_ENVS != *" $env "* ]]; then
      _rs_log "skip env   $show"
      return 0
    fi
  fi
  # Written or kept: `_rs_stale` must not remove it, also after a failure.
  _RS_SEEN+="$out "

  if [[ $_RS_SEEDS == *" $tool/$path "* && -e $dest ]]; then
    _rs_log "kept seed  $show"
    return 0
  fi
  # A seed with `seed_requires` is only for a repo that has the named file.
  local requires=${_RS_SEED_REQUIRES#* "$tool/$path="}
  if [[ $requires != "$_RS_SEED_REQUIRES" ]]; then
    requires=${requires%% *}
    if [[ ! -e ${MISE_PROJECT_ROOT}/${requires} ]]; then
      _rs_log "skip seed  $show (no $requires)"
      return 0
    fi
  fi

  # A synced file can become a folder in a later layout, for example
  # code/format -> code/format/_default. Remove the old synced file that is in
  # the way. A file without the header is the repo's, so the sync stops there.
  _rs_unblock "$(dirname -- "$dest")" "$dry_run" || return 1

  if ((dry_run)); then
    destdir=${TMPDIR:-/tmp}
  else
    destdir=$(dirname -- "$dest")
    mkdir -p -- "$destdir" || {
      _rs_log "cannot create $(_rs_path "$destdir")"
      return 1
    }
  fi
  # Temp file in the destination directory so the final mv is atomic.
  tmp=$(mktemp "${destdir%/}/.repo-sync.XXXXXX") || {
    _rs_log "cannot create a temp file in $(_rs_path "$destdir")"
    return 1
  }
  _RS_TMPS+=("$tmp")

  if [[ $path == *.tmpl ]]; then
    if [[ -z $ctx ]]; then
      rc=2
    elif ! _rs_gomplate -c ".=${ctx}?type=application/json" -f "$src" -o "$tmp" >&2; then
      _rs_log "$tool/$path: gomplate failed to render the template"
      rc=2
    fi
  else
    cp -- "$src" "$tmp" || rc=1
  fi
  # The hook revisions: each one becomes the newest tag, chosen by
  # `pre-commit autoupdate` itself. The `rev` in a tool.toml is a real tag, so
  # an older repo-sync without this step still writes a config that runs. A later autoupdate in
  # this repo then picks the same tags, so it and the sync never undo each
  # other. It needs the network; on a failure the existing file stays.
  if ((rc == 0)) && [[ $out == .config/pre-commit-config.yaml ]]; then
    if ! mise x -- which pre-commit > /dev/null 2>&1; then
      _rs_log "$tool/$path: pre-commit is not available to resolve the hook revisions"
      rc=5
    elif ! (cd "$MISE_PROJECT_ROOT" && mise x -- pre-commit autoupdate --config "$tmp" > /dev/null 2>&1); then
      _rs_log "$tool/$path: pre-commit autoupdate failed - examine the network and the hook repositories"
      rc=5
    fi
  fi

  # A rendered template or a generated mise config goes through this repo's
  # formatter before the compare. Otherwise the format hook changes the
  # render, and the next sync writes it back: a loop. A plain file needs no
  # step, because dprint formats its source in bootstrap. Without dprint, or
  # if dprint fails, the raw render stays.
  if ((rc == 0)) && [[ ($path == *.tmpl || $_RS_GENERATED == *" $tool/$path "*) && -n $_RS_DPRINT ]]; then
    local fmt
    fmt=$(mktemp "${destdir%/}/.repo-sync.XXXXXX") || fmt=''
    if [[ -n $fmt ]]; then
      _RS_TMPS+=("$fmt")
      if (cd "$MISE_PROJECT_ROOT" && mise x -- dprint fmt --stdin "$out" < "$tmp" > "$fmt" 2> /dev/null); then
        mv -f -- "$fmt" "$tmp"
      else
        rm -f -- "$fmt"
      fi
    fi
  fi

  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/gitignore"
  if ((rc == 0)) && [[ $path == .gitignore && -f $own ]]; then
    {
      printf '\n'
      cat -- "$own"
    } >> "$tmp" || rc=1
  fi
  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _rs_log "kept existing $show"
    return "$rc"
  fi

  # The file takes the mode of its source in bootstrap, also when it exists:
  # a template task is executable because its `.tmpl` is. mktemp creates 0600.
  local mode
  mode=$(_rs_mode "$src")
  if [[ -f $dest ]] && cmp -s -- "$tmp" "$dest"; then
    rm -f -- "$tmp"
    if [[ $(_rs_mode "$dest") == "$mode" ]]; then
      _rs_log "unchanged  $show"
    elif ((dry_run)); then
      _rs_log "would chmod $mode $show"
    else
      chmod "$mode" "$dest" || {
        _rs_log "cannot chmod $show"
        return 1
      }
      _rs_log "chmod $mode  $show"
    fi
    return 0
  fi

  if ((dry_run)); then
    _rs_log "would update $show"
    if [[ -f $dest ]]; then
      diff -u --label "$show (current)" --label "$show (bootstrap)" -- "$dest" "$tmp" >&2 || true
    fi
    rm -f -- "$tmp"
    return 0
  fi

  chmod "$mode" "$tmp"
  mv -f -- "$tmp" "$dest" || {
    rm -f -- "$tmp"
    _rs_log "cannot write $show"
    return 1
  }
  _rs_log "updated    $show"
}

# repo_sync [--dry-run]
#
# Clone bootstrap once, resolve the tools of the values file, then sync
# every file of every tool. Returns the most severe failure code, or 0.
repo_sync() {
  local dry_run=0
  while (($#)); do
    case $1 in
      --dry-run)
        dry_run=1
        shift
        ;;
      *)
        _rs_log "usage: repo_sync [--dry-run]"
        return 2
        ;;
    esac
  done

  local values=${REPO_SYNC_VALUES:-${MISE_PROJECT_ROOT:-$PWD}/.config/bootstrap.toml}
  # `.config/repo-config.toml` is the old name, from before this repository
  # was renamed to bootstrap.
  local old_values="${MISE_PROJECT_ROOT:-$PWD}/.config/repo-config.toml"
  if [[ -z ${REPO_SYNC_VALUES:-} && ! -f $values && -f $old_values ]]; then
    _rs_log "$(_rs_path "$old_values") is the old name of the values file - rename it to .config/bootstrap.toml"
    values=$old_values
  fi
  if [[ ! -f $values ]]; then
    _rs_log "values file $(_rs_path "$values") not found - it lists the tools to sync"
    return 2
  fi
  if ! mise x -- which gomplate > /dev/null 2>&1; then
    _rs_log "gomplate is not available - add #MISE tools.gomplate=\"latest\" to the calling task"
    return 2
  fi

  local url=${REPO_SYNC_URL:-git@github.com:virajp/bootstrap.git}
  local dir rev
  dir=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync.XXXXXX") || {
    _rs_log "cannot create a temp directory"
    return 1
  }
  _RS_TMPS+=("$dir")
  if [[ -n ${REPO_SYNC_CLONE:-} ]]; then
    # A clone that `setup:configs` already made, so that this code and the
    # files come from the same commit. A private copy, because the sync writes
    # the generated mise config into its clone.
    if [[ ! -d $REPO_SYNC_CLONE/.git ]] || ! cp -R -- "$REPO_SYNC_CLONE/." "$dir"; then
      _rs_log "cannot use the clone $REPO_SYNC_CLONE - nothing synced; existing files were left untouched"
      return 5
    fi
  # BatchMode and no terminal prompt: a missing key or no access fails here
  # instead of waiting for a password nobody will type.
  elif ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
    git clone --quiet --depth 1 --single-branch -- "$url" "$dir" 2>&1 | sed 's/^/  /' >&2 ||
    [[ ! -d $dir/.git ]]; then
    _rs_log "cannot clone $url - nothing synced; existing files were left untouched"
    return 5
  fi
  rev=$(git -C "$dir" rev-parse --short HEAD)
  _rs_log "using bootstrap at ${rev}"

  # The formatter for rendered templates; empty when dprint is not available.
  _RS_DPRINT=''
  mise x -- which dprint > /dev/null 2>&1 && _RS_DPRINT=1

  local rc=0
  { _rs_envs "$values" && _rs_mise_index "$dir" && _rs_resolve "$dir" "$values" && _rs_extensions "$dir" "$values"; } || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  _rs_log "tools:${_RS_TOOLS% }"
  _rs_log "environments:${_RS_ENVS% }"
  _rs_merge_model || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }

  local old_core
  old_core=$(_rs_list "$values" core_tools) || old_core=''
  if [[ -n ${old_core//[$'\n ']/} ]]; then
    _rs_log "core_tools in $(_rs_path "$values") is no longer used - delete it; the envs of each tool decide its environments"
  fi

  # The mise config of each tool, generated into the clone before the file
  # loop. A tool that fails keeps its existing files and counts as failed.
  local tool worst=0 failed=()
  _RS_SEEN=' ' _RS_GENERATED=' '
  _rs_mise_env || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  for tool in $_RS_TOOLS; do
    rc=0
    _rs_mise_render "$dir" "$tool" || rc=$?
    if ((rc != 0)); then
      failed+=("$tool/tool.toml [mise]")
      ((rc > worst)) && worst=$rc
    fi
  done

  # The context is built once, and only when a template needs it. An empty
  # path tells `_rs_file` that it could not be built, so each template fails
  # and every plain file still syncs.
  local ctx=''
  if [[ -n $(find "$dir/tools" -name '*.tmpl' -type f -print -quit) ]]; then
    ctx=$(mktemp "${TMPDIR:-/tmp}/repo-sync-ctx.XXXXXX") || {
      rm -rf -- "$dir"
      return 1
    }
    _RS_TMPS+=("$ctx")
    _rs_context "$dir" "$values" "$ctx" || {
      _rs_log "cannot build the template context"
      ctx=''
    }
  fi

  local path ok=0 total=0
  for tool in $_RS_TOOLS; do
    while IFS= read -r path; do
      [[ -n $path ]] || continue
      ((total += 1))
      rc=0
      if [[ $_RS_SKIP == *" $tool/$path "* ]]; then
        _rs_remove "$tool" "$path" "$dry_run" || rc=$?
      else
        _rs_file "$dir" "$tool" "$path" "$dry_run" "$ctx" || rc=$?
      fi
      if ((rc == 0)); then
        ((ok += 1))
      else
        failed+=("$tool/$path")
        ((rc > worst)) && worst=$rc
      fi
    done < <(cd "$dir/tools/$tool" && find . -type f ! -name tool.toml | sed 's#^\./##' | sort)
  done
  rm -rf -- "$dir"

  rc=0
  _rs_stale "$dry_run" || rc=$?
  if ((rc != 0)); then
    failed+=("stale files in .config/mise/conf.d")
    ((rc > worst)) && worst=$rc
  fi

  if ((${#failed[@]} == 0)); then
    _rs_log "done: $ok/$total files in sync"
    return 0
  fi
  _rs_log "FAILED: ${failed[*]}"
  _rs_log "$ok/$total files in sync; existing copies of the rest were left untouched"
  return "$worst"
}
