#!/usr/bin/env bash

#MISE description="Helper functions to sync shared files from the repo-config repo"
#MISE hide=true

# repo-sync — copy shared files from the private `repo-config` repo into this
# repo. Meant to be *sourced* by a mise task, not executed:
#
#   source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"
#   repo_sync [--dry-run] -- <path> ...
#
# Each <path> is relative to both repo roots: `repo-config` holds every file at
# the path it gets here. One call clones the default branch once (shallow, over
# SSH) and syncs every path from that one clone.
#
# Templates: a path that ends in `.tmpl` is rendered with gomplate and written
# without the suffix. The context is the values file (`<% .repo_name %>`,
# `<% .member.<name>.label %>`) plus `.members`, the repo's member names: the
# git members from `members()` in `helpers` (submodules, else MEMBERS), then
# each `[member.<name>]` of the values file that is not one of them — a folder
# of a monorepo, which must exist. The delimiters are `<% %>`, because `{{ }}`
# belongs to mise and `[[ ]]` to bash, and both must reach the output
# unchanged. gomplate must be on PATH, for example through the calling task's
# `#MISE tools.gomplate="latest"`.
#
# .gitignore: the shared ignore set is written first, then the lines of this
# repo's `.config/repo-sync/gitignore`, if that file exists. A later line wins,
# so the repo can negate a shared pattern with `!`.
#
# Failure handling
#   * A destination is only replaced after a complete copy or render, so a
#     failure always leaves the existing file as it was.
#   * A bad path does not stop the others; a failed clone stops the whole run,
#     because every path would fail the same way.
#
# Return codes
#   0  success (or nothing to change)
#   2  usage error in the calling task, or a template that cannot render
#   3  a path that is not in repo-config (fix the task)
#   5  the clone failed: network, SSH key or access to the repo
#   1  anything else (local filesystem errors, ...)
#
# Environment:
#   REPO_SYNC_URL     the repo to clone (default git@github.com:virajp/repo-config.git)
#   REPO_SYNC_VALUES  values file for templates
#                     (default $MISE_PROJECT_ROOT/.config/repo-config.toml)

_rs_log() { printf '%s\n' "repo-sync: $*" >&2; }

# Show <path> relative to the current directory when it is under it.
_rs_path() { [[ $1 == "$PWD"/* ]] && printf '%s' "${1#"$PWD"/}" || printf '%s' "$1"; }

# Temp files and directories still on disk; removed if the task exits early.
_RS_TMPS=()
_rs_cleanup() { ((${#_RS_TMPS[@]})) && rm -rf -- "${_RS_TMPS[@]}"; return 0; }
trap _rs_cleanup EXIT
trap '_rs_cleanup; exit 130' INT
trap '_rs_cleanup; exit 143' TERM

# Print the repo's member names, one per line: the git members first, then the
# `[member.<name>]` keys of <values> that are not git members, which must be
# folders in the repo. Returns 2 when a key is neither.
_rs_members() {
  local values=$1 name=$2 member keys seen=" "
  if ! declare -F members >/dev/null; then
    # shellcheck source=/dev/null
    source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
  fi
  while IFS= read -r member; do
    [[ -n $member ]] || continue
    printf '%s\n' "$member"
    seen+="$member "
  done < <(members)
  keys=$(gomplate --left-delim '<%' --right-delim '%>' -c "v=${values}" \
    -i '<% if has .v "member" %><% range $k, $x := .v.member %><% $k %>
<% end %><% end %>') || return 2
  while IFS= read -r member; do
    [[ -n $member && $seen != *" $member "* ]] || continue
    if [[ ! -d ${MISE_PROJECT_ROOT}/${member} ]]; then
      _rs_log "$name: [member.${member}] in $(_rs_path "$values") is not a submodule or a folder of the repo"
      return 2
    fi
    printf '%s\n' "$member"
  done <<<"$keys"
}

# Render the template <src> into <out>. <name> is the path, for messages.
_rs_render() {
  local src=$1 out=$2 name=$3 ctx list
  local values=${REPO_SYNC_VALUES:-${MISE_PROJECT_ROOT:-$PWD}/.config/repo-config.toml}
  if ! command -v gomplate >/dev/null 2>&1; then
    _rs_log "$name: gomplate is not on PATH - cannot render the template"
    return 2
  fi
  if [[ ! -f $values ]]; then
    _rs_log "$name: values file $(_rs_path "$values") not found - cannot render the template"
    return 2
  fi
  list=$(_rs_members "$values" "$name") || return 2
  ctx=$(mktemp "${out}.XXXXXX") || { _rs_log "$name: cannot create a temp file to render into"; return 1; }
  _RS_TMPS+=("$ctx")
  # One context file: gomplate's `.` root replaces every other context, so the
  # values and the member list are merged into it first. `members` comes first
  # in the merge, so a `members` key in the values file cannot replace it.
  if ! REPO_SYNC_MEMBERS=$list gomplate --left-delim '<%' --right-delim '%>' -c "v=${values}" -o "$ctx" \
    -i '<% $l := coll.Slice %><% range (env.Getenv "REPO_SYNC_MEMBERS" | strings.Split "\n") %><% if . %><% $l = coll.Append . $l %><% end %><% end %><% coll.Merge (dict "members" $l) .v | data.ToJSON %>' >&2 ||
    ! gomplate --left-delim '<%' --right-delim '%>' -c ".=${ctx}?type=application/json" -f "$src" -o "$out" >&2; then
    rm -f -- "$ctx"
    _rs_log "$name: gomplate failed to render the template"
    return 2
  fi
  rm -f -- "$ctx"
}

# Sync one <path> from the clone in <dir>. Leaves the destination untouched
# when the content is identical or on any failure.
_rs_file() {
  local dir=$1 path=$2 dry_run=$3
  local src="${dir}/${path}" dest="${MISE_PROJECT_ROOT}/${path%.tmpl}"
  local destdir tmp show rc=0
  show=$(_rs_path "$dest")

  if [[ ! -f $src ]]; then
    _rs_log "$path: not found in repo-config"
    return 3
  fi

  if ((dry_run)); then
    destdir=${TMPDIR:-/tmp}
  else
    destdir=$(dirname -- "$dest")
    mkdir -p -- "$destdir" || { _rs_log "cannot create $(_rs_path "$destdir")"; return 1; }
  fi
  # Temp file in the destination directory so the final mv is atomic.
  tmp=$(mktemp "${destdir%/}/.repo-sync.XXXXXX") || { _rs_log "cannot create a temp file in $(_rs_path "$destdir")"; return 1; }
  _RS_TMPS+=("$tmp")

  if [[ $path == *.tmpl ]]; then
    _rs_render "$src" "$tmp" "$path" || rc=$?
  else
    cp -- "$src" "$tmp" || rc=1
  fi
  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/gitignore"
  if ((rc == 0)) && [[ $path == .gitignore && -f $own ]]; then
    { printf '\n'; cat -- "$own"; } >>"$tmp" || rc=1
  fi
  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _rs_log "kept existing $show"
    return "$rc"
  fi

  if [[ -f $dest ]] && cmp -s -- "$tmp" "$dest"; then
    rm -f -- "$tmp"
    _rs_log "unchanged  $show"
    return 0
  fi

  if ((dry_run)); then
    _rs_log "would update $show"
    if [[ -f $dest ]]; then
      diff -u --label "$show (current)" --label "$show (repo-config)" -- "$dest" "$tmp" >&2 || true
    fi
    rm -f -- "$tmp"
    return 0
  fi

  # Keep the existing file's mode; a new file takes the mode it has in
  # repo-config, so a task stays executable. mktemp creates 0600.
  local ref=$src
  [[ -f $dest ]] && ref=$dest
  chmod "$(stat -c %a -- "$ref" 2>/dev/null || stat -f %Lp -- "$ref")" "$tmp"
  mv -f -- "$tmp" "$dest" || { rm -f -- "$tmp"; _rs_log "cannot write $show"; return 1; }
  _rs_log "updated    $show"
}

# repo_sync [--dry-run] -- <path> ...
#
# Clone repo-config once, then sync every <path>. Returns the most severe
# failure code, or 0.
repo_sync() {
  local dry_run=0
  while (($#)) && [[ $1 != -- ]]; do
    case $1 in
      --dry-run) dry_run=1; shift ;;
      *) _rs_log "unknown option: $1"; return 2 ;;
    esac
  done
  [[ ${1:-} == -- ]] || { _rs_log "usage: repo_sync [--dry-run] -- <path> ..."; return 2; }
  shift
  (($#)) || { _rs_log "repo_sync: no paths given"; return 2; }

  local url=${REPO_SYNC_URL:-git@github.com:virajp/repo-config.git}
  local dir rev
  dir=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync.XXXXXX") || { _rs_log "cannot create a temp directory"; return 1; }
  _RS_TMPS+=("$dir")
  # BatchMode and no terminal prompt: a missing key or no access fails here
  # instead of waiting for a password nobody will type.
  if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
    git clone --quiet --depth 1 --single-branch -- "$url" "$dir" 2>&1 | sed 's/^/  /' >&2 ||
    [[ ! -d $dir/.git ]]; then
    _rs_log "cannot clone $url - nothing synced; existing files were left untouched"
    return 5
  fi
  rev=$(git -C "$dir" rev-parse --short HEAD)
  _rs_log "using repo-config at ${rev}"

  local path rc worst=0 ok=0 failed=() total=$#
  for path in "$@"; do
    rc=0
    _rs_file "$dir" "$path" "$dry_run" || rc=$?
    if ((rc == 0)); then
      ((ok += 1))
    else
      failed+=("$path")
      ((rc > worst)) && worst=$rc
    fi
  done
  rm -rf -- "$dir"

  if ((${#failed[@]} == 0)); then
    _rs_log "done: $ok/$total files in sync"
    return 0
  fi
  _rs_log "FAILED: ${failed[*]}"
  _rs_log "$ok/$total files in sync; existing copies of the rest were left untouched"
  return "$worst"
}
