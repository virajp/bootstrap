# target_json <path> <format>: the parsed target as compact JSON, with sorted keys.
target_json() (
  # shellcheck source=/dev/null
  source "$clone/sync-engine/common"
  _se_yq -p "$2" -o=json -I=0 '.' "$1" | _se_jq -cS .
)
target_is() { [[ $(target_json "$1" "$2") == "$3" ]]; }

# Each target parses to the same keys as with a plain value: the double quote and
# the newlines of the value stay in the one string of its key.
case_value_breakout() {
  local f agent='"x\"\nadded = true\n[added_table]\nkey = \"1"'
  use_config breakout
  run_real
  check_exit 0
  for f in json yaml toml; do
    check "data.$f holds the value as one string, with no added key or table" \
      target_is "$home/.config/owner/data.$f" "$f" "{\"agent\":$agent,\"includes\":[\"~/a\"]}"
  done
  check "settings.conf holds the value as one string, with no added key or table" \
    target_is "$home/.config/owner/settings.conf" toml "{\"owner\":{\"agent\":$agent}}"
}

# ---- merge files (mode = "merge") ---------------------------------------------

m_dir() { printf '%s' "$home/.config/merger"; }
# live <ext> <content>: a live merge target, written at test time.
live() {
  mkdir -p -- "$(m_dir)"
  printf '%s' "$2" > "$(m_dir)/m.$1"
}
# same_as <path> <content>: the file holds exactly <content>, byte for byte.
same_as() { [[ -f $1 && $(
  cat -- "$1"
  printf x
) == "$2x" ]]; }
check_same() { check "${1#"$dir"/} is kept byte-equal" same_as "$1" "$2"; }
mode_of() { /usr/bin/stat -f %Lp -- "$1"; }

# A 4-space JSON target: keys kept, scalars, nested tables, a kind change,
# lists as a union with deep equality, remove and remove_items, the source
# wins over a remove, a remove_items item stays out though the source has it,
# 2-space output in the live key order, the permissions
# kept, a second run unchanged, a dry run that writes nothing.
case_merge_json() {
  local f before
  use_config merge
  f="$(m_dir)/m.json"
  live json '{
    "keep": "app",
    "scalar": "app",
    "nested": {"set": 0, "old": 1, "other": 2},
    "kind": {"was": "table"},
    "list": ["x", "drop", "b", {"k": 1, "j": 2}, "drop"],
    "maps": [{"a": 1, "b": 2}],
    "gone": true
}
'
  chmod 600 "$f"
  run_real
  check_exit 0
  check_output "updated    ~/.config/merger/m.json"
  check_file "$f" '{
  "keep": "app",
  "scalar": "src",
  "nested": {
    "set": 1,
    "other": 2,
    "deeper": {
      "x": true
    }
  },
  "kind": [
    1
  ],
  "list": [
    "x",
    "b",
    "c"
  ],
  "maps": [
    {
      "a": 1,
      "b": 2
    }
  ],
  "items": [
    "a"
  ]
}'
  check "the permissions are kept" test "$(mode_of "$f")" = 600
  check "no merge target in the manifest" not grep -qF merger/m. "$manifest"
  run_real
  check_exit 0
  check_output "unchanged  ~/.config/merger/m.json"
  check "a second run writes nothing" not grep -qE '^setup-sync: (updated|chmod).*merger/m\.' "$log"
  printf '%s\n' '{"keep": "edited", "scalar": "app"}' > "$f"
  before=$(cat -- "$f")
  run_dry
  check_exit 0
  check_output "would update ~/.config/merger/m.json"
  check_output '+  "scalar": "src",'
  check_file "$f" "$before"
}

# A YAML target: the comments of the live file stay; an absent remove path is
# not an error; remove_items deletes every equal item.
case_merge_yaml() {
  use_config merge
  live yaml '# top comment
keep: app # after keep
scalar: app
nested:
  # own line
  set: 0
list:
  - x
  - drop
  - drop
kind:
  was: table
'
  run_real
  check_exit 0
  check_file "$(m_dir)/m.yaml" '# top comment
keep: app # after keep
scalar: src
nested:
  # own line
  set: 1
list:
  - x
  - b
kind:
  - 1'
}

# A TOML target: own-line and after-key comments stay (table-header comments
# and inline spacing are not asserted); a remove_items path that is not a
# list is not an error.
case_merge_toml() {
  local f
  use_config merge
  f="$(m_dir)/m.toml"
  live toml '# head comment
keep = "app" # after keep
scalar = "app"
notlist = "s"
gone = 1

# own line
[nested]
set = 0
list = ["x"]
'
  run_real
  check_exit 0
  check "the head comment stays" grep -qxF '# head comment' "$f"
  check "the own-line comment stays" grep -qxF '# own line' "$f"
  check "the after-key comment stays" grep -qE '^keep = "app" +# after keep$' "$f"
  check "the source scalar wins" grep -qxF 'scalar = "src"' "$f"
  check "a nested scalar" grep -qxF 'set = 1' "$f"
  check "a list union" grep -qxF 'list = ["x", "y"]' "$f"
  check "a non-list remove_items path is kept" grep -qxF 'notlist = "s"' "$f"
  check "a removed key" not grep -q '^gone' "$f"
}

# Absent targets: the rendered source is written, with the mode of its source;
# a remove_items item of the source is left out.
case_merge_absent() {
  use_config merge
  run_real
  check_exit 0
  check_output "updated    ~/.config/merger/m.json"
  check_file "$(m_dir)/m.json" '{
  "scalar": "src",
  "nested": {
    "set": 1,
    "deeper": {
      "x": true
    }
  },
  "kind": [
    1
  ],
  "list": [
    "b",
    "c"
  ],
  "maps": [
    {
      "b": 2,
      "a": 1
    }
  ],
  "items": [
    "a"
  ]
}'
  check_file "$(m_dir)/m.yaml" "$(grep -vxF '  - drop' -- "$fixtures/repo/tools/merger/.config/merger/m.yaml.tmpl")"
  check "the toml source is written" grep -qxF 'list = ["x", "y"]' "$(m_dir)/m.toml"
  check "a new target takes the mode of its source" test "$(mode_of "$(m_dir)/m.json")" = 644
}

# Empty, whitespace-only and comments-only targets count as absent; an
# existing one keeps its permissions and is reported as updated.
case_merge_empty() {
  use_config merge
  live json ''
  live yaml $'  \n# only a comment\n\n'
  live toml $'\n\t \n'
  chmod 600 "$(m_dir)/m.json"
  run_real
  check_exit 0
  check_output "updated    ~/.config/merger/m.json"
  check_output "updated    ~/.config/merger/m.yaml"
  check_output "updated    ~/.config/merger/m.toml"
  check "the json source is written" grep -qF '"scalar": "src"' "$(m_dir)/m.json"
  check "the permissions of the empty file are kept" test "$(mode_of "$(m_dir)/m.json")" = 600
  check_file "$(m_dir)/m.yaml" "$(grep -vxF '  - drop' -- "$fixtures/repo/tools/merger/.config/merger/m.yaml.tmpl")"
  check "the toml source is written" grep -qxF 'scalar = "src"' "$(m_dir)/m.toml"
}

# Live targets that cannot merge are kept byte-equal and fail with exit 2.
case_merge_live_bad() {
  local j='{"a": ' y='a: [1
' t='a = [
'
  use_config merge
  live json "$j"
  live yaml "$y"
  live toml "$t"
  run_real
  check_exit 2
  check_output '/.config/merger/m.json is not valid json - kept it as it is'
  check_output '/.config/merger/m.yaml is not valid yaml - kept it as it is'
  check_output '/.config/merger/m.toml is not valid toml - kept it as it is'
  check_same "$(m_dir)/m.json" "$j"
  check_same "$(m_dir)/m.yaml" "$y"
  check_same "$(m_dir)/m.toml" "$t"
  check "no temp file is left" not test -n "$(find "$(m_dir)" -name '.sync-engine.*')"
}

case_merge_live_kind() {
  local j='[1]
' y='~
'
  use_config merge
  live json "$j"
  live yaml "$y"
  run_real
  check_exit 2
  check_output '/.config/merger/m.json holds a list, not a table - kept it as it is'
  check_output '/.config/merger/m.yaml holds null, not a table - kept it as it is'
  check_same "$(m_dir)/m.json" "$j"
  check_same "$(m_dir)/m.yaml" "$y"
}

case_merge_live_docs() {
  local y='a: 1
---
b: 2
'
  use_config merge
  live yaml "$y"
  run_real
  check_exit 2
  check_output '/.config/merger/m.yaml has more than one YAML document - kept it as it is'
  check_same "$(m_dir)/m.yaml" "$y"
}

# Sources that cannot merge: a list, two YAML documents.
src_unusable() {
  printf '%s\n' '[1]' > "$work/tools/merger/.config/merger/m.json.tmpl"
  printf '%s\n' 'a: 1' '---' 'b: 2' > "$work/tools/merger/.config/merger/m.yaml.tmpl"
}
case_merge_src_bad() {
  local j='{"keep": 1}
' y='keep: 1
'
  use_config merge
  case_tree src_unusable
  live json "$j"
  live yaml "$y"
  run_real
  check_exit 2
  check_output "the merge source of ~/.config/merger/m.json is a list, not a table"
  check_output "the merge source of ~/.config/merger/m.yaml has more than one YAML document"
  check_same "$(m_dir)/m.json" "$j"
  check_same "$(m_dir)/m.yaml" "$y"
}

# An empty source enforces nothing: only the removals act; an absent target
# gets an empty table.
src_empty() {
  printf '%s\n' '{}' > "$work/tools/merger/.config/merger/m.json.tmpl"
  printf '%s\n' '# nothing' > "$work/tools/merger/.config/merger/m.yaml.tmpl"
}
case_merge_src_empty() {
  use_config merge
  case_tree src_empty
  live json '{"keep": 1, "gone": 2, "list": ["drop", "x"]}'
  run_real
  check_exit 0
  check_file "$(m_dir)/m.json" '{
  "keep": 1,
  "list": [
    "x"
  ]
}'
  check_file "$(m_dir)/m.yaml" '{}'
}

# Symlinks: the link stays and its source gets the merge; a link whose source
# is missing gets the source written at the source path.
case_merge_link() {
  use_config merge
  mkdir -p -- "$(m_dir)"
  printf '%s\n' '{"keep": "app"}' > "$user/m.json"
  ln -s -- "$user/m.json" "$(m_dir)/m.json"
  ln -s -- "$user/missing/m.yaml" "$(m_dir)/m.yaml"
  run_real
  check_exit 0
  check "the link stays" test -L "$(m_dir)/m.json"
  check "its source keeps the app key" grep -qF '"keep": "app"' "$user/m.json"
  check "its source gets the source keys" grep -qF '"scalar": "src"' "$user/m.json"
  check "a link with a missing source writes the source" test -f "$user/missing/m.yaml" -a -L "$(m_dir)/m.yaml"
}

# A contribution reaches a merge target on a later run; a deselected tool
# leaves its merge targets in place.
case_merge_contrib() {
  use_config merge
  run_real
  check_exit 0
  printf '%s\n' '[tools.merger]' '[tools.merge-contrib]' > "$values"
  run_real
  check_exit 0
  check "the contribution reaches the merge target" \
    test "$(tr -d ' \n' < "$(m_dir)/m.json" | sed 's/.*"items":\(\[[^]]*\]\).*/\1/')" = '["a","z"]'
  use_config -
  run_real
  check_exit 0
  check "the merge targets of a deselected tool stay" test -f "$(m_dir)/m.json" -a -f "$(m_dir)/m.yaml"
}

# Config errors: merge with format text, remove on a generated file, a bad
# remove, a remove_items without items.
merge_text() { append_lines merger '[files.".config/merger/plain.txt"]' 'mode = "merge"'; }
remove_generated() { append_lines merger '[files.".config/merger/plain.txt"]' 'remove = [ [ "a" ] ]'; }
remove_bad() { append_lines merger '[files.".config/merger/plain.txt"]' 'remove = [ "a" ]'; }
remove_items_bad() { append_lines merger '[files.".config/merger/plain.txt"]' 'mode = "merge"' 'format = "json"' 'remove_items = [ { path = [ "a" ] } ]'; }

# ---- the entry task updateall:configs -----------------------------------------

# The entry task, rendered once with the working tree's sync-engine/, as the
# Mac sync renders it. It runs from the case folder, against this origin: the
# fixture tree with the real macos/tools/macos-setup/.
entry_tool="$root/macos/tools/macos-setup"
entry_task="$tmp/updateall-configs"
printf '{"sync_engine":"%s/sync-engine"}\n' "$root" > "$tmp/entry-ctx.json"
mise x gomplate@latest -- gomplate --left-delim '<%' --right-delim '%>' -c ".=$tmp/entry-ctx.json" \
  -f "$entry_tool/.config/mise/tasks/updateall/configs/_default.tmpl" -o "$entry_task"
chmod +x "$entry_task"

entry_src="$tmp/entry-src"
cp -R -- "$tree" "$entry_src"
rm -rf -- "$entry_src/macos/tools/macos-setup"
cp -R -- "$entry_tool" "$entry_src/macos/tools/macos-setup"
_git -C "$entry_src" add -A
_git -C "$entry_src" commit --quiet --no-verify -m "the real entry tool"
entry_url="file://$tmp/entry-origin.git"
_git clone --quiet --bare -- "$entry_src" "$tmp/entry-origin.git"
entry_head=$(_git -C "$entry_src" rev-parse HEAD)

# The start of each entry case: the origin, and a macos.toml with the answer of
# the real tool.
entry_setup() {
  export SYNC_ENGINE_URL=$entry_url
  unset _MACOS_SETUP_DEFAULT_RUNNING
  repo="$SYNC_ENGINE_CACHE/repo"
  lock="$SYNC_ENGINE_CACHE/lock"
  old_cache="$XDG_CACHE_HOME/macos-setup"
  mkdir -p -- "$MACOS_SETUP_CONFIG_PATH"
  printf '%s\n' '[tools.macos-setup]' "config_path = \"$MACOS_SETUP_CONFIG_PATH\"" > "$values"
}

entry_run() {
  runs=$((runs + 1))
  log="$dir/run-$runs.txt"
  rc=0
  (cd "$dir" && bash "$entry_task" "$@") > "$log" 2>&1 || rc=$?
}
entry_real() { entry_run --no-bootstrap; }
entry_dry() { entry_run --dry-run --no-bootstrap; }

# The same task under `mise run`, with the tasks of the tool in the temp
# $XDG_CONFIG_HOME/mise/tasks/.
entry_mise() {
  runs=$((runs + 1))
  log="$dir/run-$runs.txt"
  rc=0
  (cd "$dir" && mise run updateall:configs "$@") > "$log" 2>&1 || rc=$?
}

# entry_origin [<function>]: an origin of this case only, a commit of the entry
# tree after <function> changed it in "$work".
entry_origin() {
  work="$dir/src"
  _git clone --quiet -- "$entry_src" "$work"
  [[ -z ${1:-} ]] || "$1"
  _git -C "$work" add -A
  _git -C "$work" commit --quiet --no-verify --allow-empty -m "case"
  _git clone --quiet --bare -- "$work" "$dir/origin.git"
  export SYNC_ENGINE_URL="file://$dir/origin.git"
}

no_leftovers() {
  [[ ! -e $lock ]] && [[ -z $(find "$TMPDIR" -maxdepth 1 \( -name 'macos-setup.*' -o -name 'setup-sync.*' \) 2> /dev/null) ]]
}

case_entry_clone_first() {
  entry_setup
  entry_real
  check_exit 0
  check_output "Cloning into $repo"
  check "the clone is at the origin commit" test "$(_git -C "$repo" rev-parse HEAD)" = "$entry_head"
  check "the task is rendered with the clone code" grep -qE '^_se_fetch\(\)' "$home/.config/mise/tasks/updateall/configs/_default"
  check "the mise config has the answer" grep -qF "MACOS_SETUP_CONFIG_PATH = \"$MACOS_SETUP_CONFIG_PATH\"" \
    "$home/.config/mise/conf.d/macos-setup/mise.toml"
}

case_entry_clone_refresh() {
  entry_setup
  entry_origin
  entry_real
  check_exit 0
  printf '%s\n' "# local edit" >> "$repo/macos/packs.toml"
  printf '%s\n' "untracked" > "$repo/untracked.txt"
  printf '%s\n' "new line" >> "$work/macos/tools/core/.config/core/plain.txt"
  _git -C "$work" commit --quiet --no-verify -am "new origin commit"
  _git -C "$dir/origin.git" fetch --quiet -- "$work" main:main
  entry_real
  check_exit 0
  check_output "Updating the clone in $repo"
  check "the clone is at the new commit" test "$(_git -C "$repo" rev-parse HEAD)" = "$(_git -C "$work" rev-parse HEAD)"
  check "the local edit is reset" cmp -s "$repo/macos/packs.toml" "$work/macos/packs.toml"
  check "the untracked file is removed" not test -e "$repo/untracked.txt"
  check "the new commit is rendered" grep -qxF "new line" "$home/.config/core/plain.txt"
}

case_entry_clone_other_origin() {
  entry_setup
  _git clone --quiet -- "$entry_url" "$repo"
  _git -C "$repo" config remote.origin.url "file://$dir/other.git"
  entry_real
  check_exit 0
  check_output "has the origin 'file://$dir/other.git', not $entry_url - cloning again"
  check "the origin is the URL" test "$(_git -C "$repo" config --get remote.origin.url)" = "$entry_url"
}

# insteadOf sends both forms to the local origin, so no case needs the network.
case_entry_clone_ssh_https() {
  entry_setup
  _git clone --quiet -- "$entry_url" "$repo"
  _git -C "$repo" config remote.origin.url "git@github.com:virajp/bootstrap.git"
  git config --file "$GIT_CONFIG_GLOBAL" --add "url.$entry_url.insteadOf" "https://github.com/virajp/bootstrap.git"
  git config --file "$GIT_CONFIG_GLOBAL" --add "url.$entry_url.insteadOf" "git@github.com:virajp/bootstrap.git"
  export SYNC_ENGINE_URL="https://github.com/virajp/bootstrap.git"
  entry_real
  check_exit 0
  check_output "Updating the clone in $repo"
  check_no_output "cloning again"
}

case_entry_clone_not_git() {
  entry_setup
  mkdir -p -- "$repo"
  printf '%s\n' "keep" > "$repo/keep.txt"
  entry_real
  check_exit 2
  check_output "is not a git clone and not empty"
  check "the folder is unchanged" test "$(ls -A -- "$repo")" = keep.txt
  check_file "$repo/keep.txt" "keep"
}

case_entry_clone_fails() {
  entry_setup
  export SYNC_ENGINE_URL="file://$dir/missing.git"
  entry_real
  check_exit 5
  check_output "Cannot clone"
}

case_entry_running_line() {
  local lines
  entry_setup
  entry_real
  check_exit 0
  lines=$(grep '^setup-sync: running ' "$log")
  check "one running line" test "$(printf '%s\n' "$lines" | grep -c .)" = 1
  check "it names the sync of the temp copy" \
    grep -qE "^setup-sync: running $TMPDIR/macos-setup\.[^/]+/macos/tools/macos-setup/\.config/mise/tasks/updateall/configs/sync$" <<< "$lines"
}

# Without --verbose only the changes print. The entry task consumes the flag,
# since setup_sync stops on a flag that it does not know.
case_entry_verbose() {
  entry_setup
  unset SYNC_ENGINE_VERBOSE FORCE_COLOR NO_COLOR
  entry_real
  check_exit 0
  check_output "new ~/.config/core/plain.txt"
  check_no_output "setup-sync: running"
  check_no_output "unchanged  "
  entry_run --verbose --no-bootstrap
  check_exit 0
  check_output "setup-sync: running"
  check_output "unchanged  ~/.config/core/plain.txt"
  check_no_output "unknown"
  check_output "| Total "
}

case_entry_lock_wait() {
  local holder runner line
  entry_setup
  mkdir -p -- "$lock"
  sleep 60 &
  holder=$!
  printf '%s\n' "$holder" > "$lock/pid"
  line="Waiting for another sync (pid $holder)"
  runs=$((runs + 1))
  log="$dir/run-$runs.txt"
  (cd "$dir" && bash "$entry_task" --no-bootstrap) > "$log" 2>&1 &
  runner=$!
  for _ in $(seq 1 30); do
    grep -qF "$line" "$log" && break
    sleep 1
  done
  check_output "$line"
  check "the run waits while the holder lives" kill -0 "$runner"
  check "nothing written while waiting" not test -e "$home/.config"
  kill "$holder" 2> /dev/null
  wait "$holder" 2> /dev/null
  for _ in $(seq 1 60); do
    kill -0 "$runner" 2> /dev/null || break
    sleep 1
  done
  rc=0
  kill -0 "$runner" 2> /dev/null && kill "$runner"
  wait "$runner" || rc=$?
  check_exit 0
  check "values.txt written after the takeover" test -f "$home/.config/core/values.txt"
}

case_entry_lock_dead() {
  local dead
  entry_setup
  true &
  dead=$!
  wait "$dead"
  mkdir -p -- "$lock"
  printf '%s\n' "$dead" > "$lock/pid"
  entry_real
  check_exit 0
  check_no_output "Waiting for another sync"
}

# A `sync` that reports the lock and the clone that it sees. Its exit code is
# the exit code of the task.
entry_sync_probe() {
  printf '%s\n' '#!/usr/bin/env bash' \
    'if [[ -e $SYNC_ENGINE_CACHE/lock ]]; then echo "lock held"; else echo "lock released"; fi' \
    'echo "clone $SYNC_ENGINE_CLONE"' 'exit 4' \
    > "$work/macos/tools/macos-setup/.config/mise/tasks/updateall/configs/sync"
}

case_entry_lock_hold() {
  entry_setup
  entry_origin entry_sync_probe
  entry_real
  check_exit 4
  check_output "lock held"
  check_output "clone $TMPDIR/macos-setup."
  entry_dry
  check_exit 4
  check_output "lock released"
  check_output "clone $TMPDIR/macos-setup."
  check "after each run: no lock, no temp copy" no_leftovers
}

case_entry_unknown_flag() {
  entry_setup
  entry_run --bogus
  check_exit 2
  check_output "unknown flag '--bogus'"
  check "no clone made" not test -e "$repo"
}

# The same dry run under `bash _default` and under `mise run`. Only the
# would-update lines: `mise run` starts the task in another folder, and the line
# of bootstrap_commit shows macos.toml relative to the folder of the run.
case_entry_mise_run() {
  local a b tasks="$XDG_CONFIG_HOME/mise/tasks"
  entry_setup
  entry_dry
  check_exit 0
  a=$(grep '^setup-sync: would update ' "$log")
  mkdir -p -- "$XDG_CONFIG_HOME/mise"
  cp -R -- "$entry_tool/.config/mise/tasks" "$tasks"
  rm -- "$tasks/updateall/configs/_default.tmpl"
  cp -- "$entry_task" "$tasks/updateall/configs/_default"
  entry_mise --dry-run --no-bootstrap
  check_exit 0
  b=$(grep '^setup-sync: would update ' "$log")
  check "mise run prints the same would-update lines" test -n "$a" -a "$a" = "$b"
  entry_mise --bogus
  check "mise run rejects an unknown flag itself (exit $rc)" test "$rc" != 0
}

case_entry_config_unset() {
  entry_setup
  unset MACOS_SETUP_CONFIG_PATH
  entry_real
  check_exit 2
  check_output "MACOS_SETUP_CONFIG_PATH is not set"
  check "no clone made" not test -e "$repo"
}

case_entry_nested() {
  entry_setup
  export _MACOS_SETUP_DEFAULT_RUNNING=1
  entry_real
  check_exit 2
  check_output "a nested run is refused"
  check "no clone made" not test -e "$repo"
}

# The list of the old cache names a stale file, so its removal proves the move.
case_entry_legacy_move() {
  local dead
  entry_setup
  true &
  dead=$!
  wait "$dead"
  mkdir -p -- "$old_cache" "$home/.config/old" "$XDG_CACHE_HOME/bootstrap" "$XDG_CACHE_HOME/bootstrap.lock"
  printf '%s\n' "$dead" > "$XDG_CACHE_HOME/bootstrap.lock/pid"
  new_header_file "$home/.config/old/stale.txt" "stale"
  printf 'core\t.config/old/stale.txt\n' > "$old_cache/generated.txt"
  entry_real
  check_exit 0
  check "the old Mac cache is removed" not test -e "$old_cache"
  check "the moved list is the manifest: its stale file is removed" not test -e "$home/.config/old/stale.txt"
  check "the manifest exists" test -f "$manifest"
  check "the cache of the old stubs is removed" not test -e "$XDG_CACHE_HOME/bootstrap"
  check "the lock of the old stubs is removed" not test -e "$XDG_CACHE_HOME/bootstrap.lock"
}

# A dry run does not write the manifest, so its content is the kept one.
case_entry_legacy_keep_manifest() {
  entry_setup
  mkdir -p -- "$old_cache"
  printf 'core\t.config/from-old\n' > "$old_cache/generated.txt"
  seed_manifest "core	.config/core/values.txt"
  entry_dry
  check_exit 0
  check_file "$manifest" "core	.config/core/values.txt"
  check "the old Mac cache is removed" not test -e "$old_cache"
}

case_entry_legacy_live() {
  local holder
  entry_setup
  mkdir -p -- "$old_cache/lock"
  sleep 60 &
  holder=$!
  printf '%s\n' "$holder" > "$old_cache/lock/pid"
  entry_real
  check_exit 0
  check_output "the old Mac sync runs (pid $holder) - keeping $old_cache"
  check "the old Mac cache stays" test -f "$old_cache/lock/pid"
  kill "$holder" 2> /dev/null
  wait "$holder" 2> /dev/null
}

case_entry_leftovers() {
  entry_setup
  entry_real
  check_exit 0
  check "after a real run: no lock, no temp copy" no_leftovers
  entry_dry
  check_exit 0
  check "after a dry run: no lock, no temp copy" no_leftovers
  printf '%s\n' 'colour = "blue"' "$(cat -- "$values")" > "$values.new"
  mv -- "$values.new" "$values"
  entry_real
  check_exit 2
  check_output "colour is not a key of config/macos.toml"
  check "after a bad macos.toml: no lock, no temp copy" no_leftovers
}

