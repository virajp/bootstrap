# ---- --dry-run ----------------------------------------------------------------

snapshot() {
  local p
  find "$@" -print 2> /dev/null | LC_ALL=C sort | while IFS= read -r p; do
    /usr/bin/stat -f '%N %Sp %z %m' -- "$p"
    [[ -f $p && ! -L $p ]] && shasum -- "$p"
  done
}

case_dry_run() {
  local before after
  use_config init
  mkdir -p -- "$home/.config/core" "$home/.config/old"
  printf '%s\n' "old" > "$user/values.txt"
  ln -s -- "$user/values.txt" "$home/.config/core/values.txt"
