  run_dry
  check_exit 0
  check_output "would update ~/.config/core/values.txt (-> $user/values.txt)"
  check_output "would remove home/.config/old/stale.txt"
  check_output "would update ~/.config/core/settings.json"
  check_no_output "setup-sync: open a new terminal"
  after=$(snapshot "$home" "$user" "$MACOS_SETUP_CONFIG_PATH" "$manifest")
  check "nothing written in HOME, a link source, the config folder or the manifest" test "$before" = "$after"
}

