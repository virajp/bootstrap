run_case "merge: sources that are not a table" case_merge_src_bad
run_case "merge: an empty source" case_merge_src_empty
run_case "merge: targets behind symlinks" case_merge_link
run_case "merge: a contribution, then a deselected tool" case_merge_contrib
run_case "merge: a merge target of format text" expect merge 2 'macos/tools/merger/tools.toml: [files.".config/merger/plain.txt"] mode = "merge" needs a json, yaml or toml target' merge_text
run_case "merge: remove on a generated file" expect merge 2 'macos/tools/merger/tools.toml: [files.".config/merger/plain.txt"] remove works only with mode = "merge"' remove_generated
run_case "merge: a remove of a bad shape" expect merge 2 'macos/tools/merger/tools.toml: [files.".config/merger/plain.txt"] remove must be a list of key paths' remove_bad
run_case "merge: a remove_items without items" expect merge 2 'macos/tools/merger/tools.toml: [files.".config/merger/plain.txt"] remove_items must be a list of tables' remove_items_bad

run_case "entry clone: a first clone" case_entry_clone_first
run_case "entry clone: a refresh after a new origin commit" case_entry_clone_refresh
run_case "entry clone: a clone with another origin" case_entry_clone_other_origin
run_case "entry clone: the SSH and https forms of one URL" case_entry_clone_ssh_https
run_case "entry clone: a non-empty non-git folder" case_entry_clone_not_git
run_case "entry clone: an origin that cannot be cloned" case_entry_clone_fails
run_case "entry clone: the running line" case_entry_running_line
run_case "entry flags: --verbose" case_entry_verbose
run_case "entry lock: a run waits for a live holder, then takes over" case_entry_lock_wait
run_case "entry lock: a lock whose pid is dead" case_entry_lock_dead
run_case "entry lock: a real run holds it, a dry run releases it" case_entry_lock_hold
run_case "entry flags: an unknown flag under bash" case_entry_unknown_flag
run_case "entry flags: --dry-run under bash and under mise run" case_entry_mise_run
run_case "entry config: MACOS_SETUP_CONFIG_PATH unset" case_entry_config_unset
run_case "entry: a nested run" case_entry_nested
run_case "entry legacy: the old list moves, the old caches go" case_entry_legacy_move
run_case "entry legacy: an existing manifest stays" case_entry_legacy_keep_manifest
run_case "entry legacy: a live old lock keeps the old cache" case_entry_legacy_live
run_case "entry: no lock and no temp copy after each run" case_entry_leftovers

while ((${#case_pids[@]})); do
  collect_case
done

if ((failures)); then
  print_error "$failures check(s) failed in $case_count cases"
  exit 1
fi
print_success "All $case_count setup-sync cases passed"
