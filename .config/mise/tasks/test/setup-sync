# The next sync replaces it, and a manual change is lost.

[shell_alias]
  fixture = "echo fixture"'
  check "the manifest has its line" grep -qxF "zz-macos	.config/mise/conf.d/zz-macos/mise.toml" "$manifest"
}

case_mise_override() {
  local file="$home/.config/mise/conf.d/core/mise.toml"
  use_config override-mise
  run_real
  check_exit 0
  check "the key changes, with the comment" grep -qE '^ *CORE_NAME = "from-override"  # override: macos\.toml$' "$file"
  check "the other key has no comment" grep -qE '^ *CORE_HOME = "\{\{ env\.HOME }}"$' "$file"
}

case_mise_deselected() {
  local file="$home/.config/mise/conf.d/init/mise.toml"
  use_config init
  run_real
  check_exit 4
  check "the mise config is written" test -f "$file"
  use_config -
  run_real
  check_exit 0
  check "the mise config of the tool is removed" not test -e "$file"
  check "and its folder" not test -e "${file%/*}"
  check "the mise config of core stays" test -f "$home/.config/mise/conf.d/core/mise.toml"
}

