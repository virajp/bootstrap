# A tool in two packs is selected once.
case_packs_two() {
  use_config packs-two
  case_tree pack_two
  run_real
  check_exit 0
  check_output "tools: core macos-setup opt"
  check "the manifest has the file once" test "$(grep -cF .config/opt/opt.txt "$manifest")" = 1
}

# ---- mise (the check of the install) ------------------------------------------

# fake_mise <folder>: a mise in <folder> that is not ~/.local/bin/mise.
fake_mise() {
  mkdir -p -- "$1"
  printf '%s\n' '#!/bin/sh' 'exit 0' > "$1/mise"
  chmod +x "$1/mise"
}

case_mise_elsewhere() {
  use_config ok
  fake_mise "$dir/homebrew/bin"
  export PATH="$dir/homebrew/bin:$PATH"
  run_real
  check_exit 2
  check_output "mise must be installed with \`curl https://mise.run | sh\` at ~/.local/bin/mise, not from a package manager (found: $dir/homebrew/bin/mise)"
  check "nothing written" not test -e "$home/.config"
}

# A ~/.local/bin/mise that is a link into a package manager's folder.
case_mise_link() {
  use_config ok
  fake_mise "$dir/homebrew/bin"
  mkdir -p -- "$dir/link/.local/bin"
  ln -s -- "$dir/homebrew/bin/mise" "$dir/link/.local/bin/mise"
  export PATH="$dir/link/.local/bin:$PATH"
  run_real
  check_exit 2
  check_output "(found: $dir/homebrew/bin/mise)"
}

# ---- the generated mise config ------------------------------------------------

mise_core_header='# Synced from bootstrap: macos/tools/core/tools.toml. Do not edit this file.
# The next sync replaces it, and a manual change is lost.'

