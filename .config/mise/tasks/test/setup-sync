case_values_opt_in() {
  use_config replace
  run_real
  check_exit 0
  check_file "$home/.config/owner/config" "$(owner_config "Include ~/z" "" "Host *" \
    "  IdentityAgent agent-a" "nested=default," "# again: agent-a")"
}

# An opt-in tool: a value of another type replaces the merged one.
case_values_opt_in_type() {
