}

# ---- symlinks -----------------------------------------------------------------

case_link_file() {
  use_config ok
  mkdir -p -- "$home/.config/core"
  printf '%s\n' "old" > "$user/values.txt"
  ln -s -- "$user/values.txt" "$home/.config/core/values.txt"
  ln -s -- "$user/missing/plain.txt" "$home/.config/core/plain.txt"
