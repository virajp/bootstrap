# ---- values -------------------------------------------------------------------

synced() {
  printf '%s\n' "# Synced from bootstrap: macos/tools/$1. Do not edit this file." \
    '# The next sync replaces it, and a manual change is lost.'
}

case_values() {
  use_config ok
  run_real
  check_exit 0
  check_file "$home/.config/core/values.txt" "$(synced core/.config/core/values.txt.tmpl)
name=override-name
items=a,b,x,
left=file-left
right=default-right
tools=core,macos-setup,opt,
opt_extra=extra-value
home=$home
passthrough={{ mise }} [[ bash ]]"
  check_file "$home/.config/opt/opt.txt" "$(synced opt/.config/opt/opt.txt.tmpl)
