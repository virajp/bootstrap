  local file="$home/.config/mise/conf.d/core/mise.toml"
  use_config ok
  run_real
  check_exit 0
  check_file "$file" "$mise_core_header

[env]
  CORE_HOME = \"{{ env.HOME }}\"
  CORE_NAME = \"override-name\""
  check "the manifest has its line" grep -qxF "core	.config/mise/conf.d/core/mise.toml" "$manifest"
  check "a tool with no [mise.*] gets no file" not test -e "$home/.config/mise/conf.d/opt"
}

