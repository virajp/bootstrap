  run_real
  check_exit 0
  check "the number replaces the string" grep -qxF "level=3" "$home/.config/opt/opt.txt"
}

# ---- render -------------------------------------------------------------------

# The class of a target: 1 init ~/.config/mise, 2 init rest, 3 main
# ~/.config/mise, 4 main rest.
case_render_order() {
  local path class last=0 ok=1 n=0 t='~'
  use_config init
  run_dry
  check_exit 0
  while read -r path; do
    case $path in
      "$t/.config/init/"* | "$t/.config/initdep/"*)
        class=2
        ;;
      "$t/.config/mise/conf.d/init/mise.toml")
        class=1
        ;;
      "$t/.config/mise/"*)
        class=3
        ;;
      *)
        class=4
        ;;
    esac
    ((class >= last)) || ok=0
    last=$class
    n=$((n + 1))
  done < <(sed -n 's/^setup-sync: would update \([^ ]*\).*/\1/p' "$log")
  check "$t/.config/mise/** first in each stage, the init stage first ($n files)" test "$ok" = 1 -a "$n" -gt 5
}

add_executables() {
  printf '%s\n' '#!/bin/sh' > "$work/tools/core/.config/core/run"
  printf '%s\n' '#!/bin/sh' '# <% .config.name %>' > "$work/tools/core/.config/core/rendered.tmpl"
  chmod 755 "$work/tools/core/.config/core/run" "$work/tools/core/.config/core/rendered.tmpl"
}

case_render_exact() {
  use_config ok
  case_tree add_executables
  run_real
  check_exit 0
  check "plain.txt equals its source" cmp -s "$fixtures/repo/tools/core/.config/core/plain.txt" "$home/.config/core/plain.txt"
  check_file "$home/.config/core/settings.json" '{"name":"override-name","list":[1,2]}'
  check "a file keeps its mode" test "$(mode_of "$home/.config/core/plain.txt")" = 644
  check "an executable keeps its mode" test "$(mode_of "$home/.config/core/run")" = 755
  check "a rendered file takes the mode of its template" test "$(mode_of "$home/.config/core/rendered")" = 755
}

case_seed() {
  local seed="$home/.config/core/seeded.toml"
  use_config ok
  run_real
  check_exit 0
  check_output "skip seed  ~/.config/core/seeded.toml (no ~/.config/core-needed)"
  check "no seed while a requires target is missing" not test -e "$seed"
  : > "$home/.config/core-needed"
  run_real
  check_exit 0
  check_file "$seed" 'name = "override-name"'
  printf '%s\n' "mine" > "$seed"
  run_real
  check_exit 0
  check_output "kept seed  ~/.config/core/seeded.toml"
  check_file "$seed" "mine"
  check "no seed in the manifest" not grep -qF seeded.toml "$manifest"
}

