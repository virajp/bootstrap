#!/usr/bin/env bash
#MISE description="Test setup-sync against fixtures, with no network"

# Runs `setup_sync` of the working tree's sync-engine/ against the fixture repo
# in macos/fixtures/repo/ and the fixture config folders in
# macos/fixtures/config/, and checks the exit code, the output and the files of
# each case. Every case has its own temp HOME, XDG_* folders, cache, TMPDIR and
# git config, so it needs no network and never touches the real $HOME. Every real
# run passes --no-bootstrap. The entry cases at the end run the rendered entry
# task updateall:configs against a local bare origin with the real
# macos/tools/macos-setup/: they cover the clone, the lock and the temp copy.

set -euo pipefail

# A git hook that runs this task inside `git commit` exports these variables;
# with them set, the git commands of the fixture tree write to the real repo.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_EXEC_PATH \
  GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT \
  "${!GIT_CONFIG_KEY_@}" "${!GIT_CONFIG_VALUE_@}"
git_vars=$(git rev-parse --local-env-vars 2> /dev/null) || git_vars=''
# shellcheck disable=SC2086
unset $git_vars
unset git_vars

# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Each per-file line prints, so the cases compare the log format. A case of the
# default output unsets the variable.
export SYNC_ENGINE_VERBOSE=1

root=${MISE_PROJECT_ROOT}
fixtures="$root/macos/fixtures"
# The tilde at the start of a target in a message.
tilde='~'

# The real mise folders, found before a case changes HOME and XDG_*, so
# `mise x gomplate` resolves from the mise cache with no download.
export MISE_DATA_DIR="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}"
export MISE_CACHE_DIR="${MISE_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/mise}"
unset MISE_ENV SYNC_ENGINE_URL SYNC_ENGINE_CLONE REPO_SYNC_CLONE

tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-setup-sync.XXXXXX")
# The real path: setup-sync logs the real path of a target behind a symlink.
tmp=$(cd "$tmp" && pwd -P)
# shellcheck disable=SC2046
trap 'kill $(jobs -p) 2> /dev/null || true; rm -rf -- "$tmp"' EXIT

# git without the user's config, hooks, signing or identity.
_git() {
  GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c user.name=test -c user.email=test@example.com \
    -c commit.gpgsign=false -c core.hooksPath=/dev/null -c init.defaultBranch=main "$@"
}

print_header "Testing setup-sync against fixtures ..."

# No fixture file may be one that git ignores: it would be missing from a
# fresh checkout.
ignored=$(cd "$root" && find macos/fixtures -type f -print0 | xargs -0 git check-ignore --no-index 2> /dev/null) || true
if [[ -n $ignored ]]; then
  print_error "fixture files that .gitignore matches:"
  printf '    %s\n' "$ignored" >&2
  exit 1
fi

# The tree: sync-engine/ of the working tree, uncommitted work included, and the
# fixture repo as macos/, without tools/bad/ (one case adds it), in a git
# repository, so a run can record its commit.
tree="$tmp/tree"
mkdir -p -- "$tree/macos"
cp -R -- "$root/sync-engine" "$tree/sync-engine"
cp -R -- "$fixtures/repo/." "$tree/macos"
rm -rf -- "$tree/macos/tools/bad"
_git -C "$tree" init --quiet -b main
_git -C "$tree" add -A
_git -C "$tree" commit --quiet --no-verify -m "fixture"
tree_commit=$(_git -C "$tree" rev-parse HEAD)

failures=0
max_jobs=$(getconf _NPROCESSORS_ONLN 2> /dev/null) || max_jobs=4
case_count=0
case_pids=()
case_dirs=()

# run_case <name> <function> [<arg>...]
# Runs <function> in its own folder and environment, in the background. The
# output of each case is printed in the order of the cases.
run_case() {
  local dir
  case_count=$((case_count + 1))
  dir="$tmp/case-$case_count"
  mkdir -p -- "$dir"
  (
    trap - EXIT
    case_body "$dir" "$@" > "$dir/out" 2>&1
  ) &
  case_pids+=("$!")
  case_dirs+=("$dir")
  if ((${#case_pids[@]} >= max_jobs)); then
    collect_case
  fi
}

# Wait for the oldest case, print its output and add its failures. A case
# without a failures file stopped before its end, which is a failure.
collect_case() {
  local dir=${case_dirs[0]} n=1
  wait "${case_pids[0]}" || true
  cat -- "$dir/out"
  [[ -f $dir/failures ]] && n=$(cat -- "$dir/failures")
  failures=$((failures + n))
  rm -rf -- "$dir"
  case_pids=("${case_pids[@]:1}")
  case_dirs=("${case_dirs[@]:1}")
}

# The isolated environment of a case, then the case function.
case_body() {
  dir=$1 name=$2
  shift 2
  set +e
  failures=0 runs=0 rc=0 log=/dev/null
  home="$dir/home"
  clone=$tree
  mkdir -p -- "$home" "$dir/xdg/cache" "$dir/xdg/config" "$dir/xdg/state" "$dir/xdg/data" \
    "$dir/tmp" "$dir/user"
  export HOME=$home
  export XDG_CACHE_HOME="$dir/xdg/cache" XDG_CONFIG_HOME="$dir/xdg/config"
  export XDG_STATE_HOME="$dir/xdg/state" XDG_DATA_HOME="$dir/xdg/data"
  export SYNC_ENGINE_CACHE="$XDG_CACHE_HOME/sync-engine"
  export MACOS_SETUP_CONFIG_PATH="$dir/config"
  export GIT_CONFIG_GLOBAL="$dir/gitconfig" GIT_CONFIG_NOSYSTEM=1
  : > "$GIT_CONFIG_GLOBAL"
  export TMPDIR="$dir/tmp"
  unset SYNC_ENGINE_URL
  manifest="$SYNC_ENGINE_CACHE/macos-generated.tsv"
  values="$MACOS_SETUP_CONFIG_PATH/macos.toml"
  user="$dir/user"
  "$@"
  printf '%s\n' "$failures" > "$dir/failures"
}

pass() { print_success "$name: $1"; }
fail() {
  print_error "$name: $1"
  failures=$((failures + 1))
  [[ -f $log ]] && sed 's/^/    /' "$log" >&2
}

# check <what> <command> [<arg>...]: passes when the command succeeds.
check() {
  local what=$1
  shift
  if "$@"; then pass "$what"; else fail "$what"; fi
}
check_exit() {
  if [[ $rc == "$1" ]]; then pass "exit $rc"; else fail "exit $rc, expected $1"; fi
}
check_output() { check "the output has: $1" grep -qF -- "$1" "$log"; }
check_no_output() { check "the output lacks: $1" not grep -qF -- "$1" "$log"; }
# check_file <path> <content>: the file exists with exactly <content>.
check_file() { check "${1#"$dir"/} has the expected content" file_is "$1" "$2"; }
file_is() { [[ -f $1 && $(cat -- "$1") == "$2" ]]; }
not() { ! "$@"; }

# Run setup_sync as its entry task does, from the case folder.
sync_run() {
  runs=$((runs + 1))
  log="$dir/run-$runs.txt"
  rc=0
  # shellcheck disable=SC2016
  (cd "$dir" && SYNC_ENGINE_CLONE=$clone bash -c 'source "$SYNC_ENGINE_CLONE/sync-engine/setup-sync" && setup_sync "$@"' setup-sync "$@") > "$log" 2>&1 || rc=$?
}
run_real() { sync_run --no-bootstrap; }
run_dry() { sync_run --dry-run; }

# use_config <name>: a copy of a fixture config folder; `-` is an empty one.
use_config() {
  rm -rf -- "$MACOS_SETUP_CONFIG_PATH"
  if [[ $1 == - ]]; then
    mkdir -p -- "$MACOS_SETUP_CONFIG_PATH"
  else
    cp -R -- "$fixtures/config/$1" "$MACOS_SETUP_CONFIG_PATH"
  fi
}

# case_tree <function>: a copy of the tree for this case only, after <function>
# changed its macos/ folder, "$work".
case_tree() {
  cp -R -- "$tree" "$dir/tree"
  clone="$dir/tree"
  work="$clone/macos"
  "$1"
}

# seed_manifest <row>...: a manifest from an earlier run.
seed_manifest() {
  mkdir -p -- "$SYNC_ENGINE_CACHE"
  printf '%s\n' "$@" > "$manifest"
}

header_file() { printf '%s\n' "# Generated by macos-setup: test" "$2" > "$1"; }
new_header_file() { printf '%s\n' "# Synced from bootstrap: test. Do not edit this file." "$2" > "$1"; }

# ---- config ----------------------------------------------------------------

case_config_missing() {
  run_real
  check_exit 2
  check_output "the config folder $MACOS_SETUP_CONFIG_PATH does not exist"
  check_output MACOS_SETUP_CONFIG_PATH
  check "nothing written" not test -e "$home/.config"
}

case_config_unset() {
  unset MACOS_SETUP_CONFIG_PATH
  run_real
  check_exit 2
  check_output "MACOS_SETUP_CONFIG_PATH is not set"
  check "nothing written" not test -e "$home/.config"
}

# expect <config> <code> <message> [<tree change>]: a dry run that stops.
expect() {
  use_config "$1"
  [[ -z ${4:-} ]] || case_tree "$4"
  run_dry
  check_exit "$2"
  check_output "$3"
}

add_bad_tool() { cp -R -- "$fixtures/repo/tools/bad" "$work/tools/bad"; }
no_packs() { rm -- "$work/packs.toml"; }
no_base() { printf '%s\n' '[pack.extra]' 'opt = { default = true }' > "$work/packs.toml"; }
base_no_engine() { printf '%s\n' '[pack.base]' 'core = { default = true }' > "$work/packs.toml"; }
pack_is_tool() { printf '\n%s\n%s\n' '[pack.core]' 'init = { default = true }' >> "$work/packs.toml"; }
pack_unknown() { printf '\n%s\n%s\n' '[pack.more]' 'nope = { default = true }' >> "$work/packs.toml"; }
pack_old_key() { printf '\n%s\n%s\n' '[pack.more]' 'depends = [ "opt" ]' >> "$work/packs.toml"; }
pack_entry_key() { printf '\n%s\n%s\n' '[pack.more]' 'opt = { tag = true }' >> "$work/packs.toml"; }
pack_not_table() { printf '\n%s\n%s\n' '[pack.more]' 'tools = "init"' >> "$work/packs.toml"; }
pack_two() { printf '\n%s\n%s\n' '[pack.more]' 'opt = { default = true }' >> "$work/packs.toml"; }
# prepend_key <tool> <line>: a top-level line before the tables of a tools.toml.
prepend_key() {
  printf '%s\n' "$2" "$(cat -- "$work/tools/$1/tools.toml")" > "$work/$1.toml"
  mv -- "$work/$1.toml" "$work/tools/$1/tools.toml"
}
# append_lines <tool> <line>...: lines at the end of a tools.toml.
append_lines() {
  local t=$1
  shift
  printf '\n' >> "$work/tools/$t/tools.toml"
  printf '%s\n' "$@" >> "$work/tools/$t/tools.toml"
}
bad_manifest_key() { prepend_key opt 'depend = [ "core" ]'; }
bad_stage() { prepend_key opt 'stage = "login"'; }
old_stage() { prepend_key opt 'stage = "shell"'; }
old_seed_key() { prepend_key core 'seed = [ ".config/core/seeded.toml" ]'; }
old_seed_requires() { append_lines core '[seed_requires]' '".config/core/seeded.toml" = [ ".config/core-needed" ]'; }
files_no_source() { append_lines core '[files.".config/core/nothing"]' 'mode = "seed"'; }
bad_files_key() { append_lines opt '[files.".config/opt/opt.txt"]' 'owner = "core"'; }
bad_question() { append_lines opt '[questions.level]' 'ask = "Which level?"'; }
repo_default_envs() { prepend_key opt 'default_envs = [ "dev" ]'; }
repo_mise_env() { append_lines opt '[mise_env.dev.tools]' 'jq = "latest"'; }
repo_requires_found() { append_lines opt '[files.".config/opt/opt.txt"]' 'requires_found = [ "x" ]'; }
tool_zz_macos() {
  mkdir -p -- "$work/tools/zz-macos"
  printf '%s\n' 'description = "x"' > "$work/tools/zz-macos/tools.toml"
}
tool_after_zz_macos() {
  mkdir -p -- "$work/tools/zzz"
  printf '%s\n' 'description = "x"' > "$work/tools/zzz/tools.toml"
}
ships_conf_d() {
  mkdir -p -- "$work/tools/core/.config/mise/conf.d"
  printf '%s\n' '[env]' > "$work/tools/core/.config/mise/conf.d/x.toml"
}
file_and_tmpl() {
  printf '%s\n' 'a' > "$work/tools/core/.config/core/foo"
  printf '%s\n' 'b' > "$work/tools/core/.config/core/foo.tmpl"
}

case_unknown_flag() {
  use_config ok
  sync_run --bogus
  check_exit 2
  check_output "unknown flag '--bogus'"
  check_output "usage: setup_sync"
}

# ---- packs and selection ------------------------------------------------------

# A [tools.<name>] table selects a tool of pack extra; its other members stay out.
case_tools_list() {
  use_config ok
  run_real
  check_exit 0
  check_output "tools: core macos-setup opt"
  check "merger (pack extra, not listed) is not rendered" not test -e "$home/.config/merger"
}

# A [packs.<name>] table adds only its default = true members.
case_packs_table() {
  use_config packs-table
  run_real
  check_exit 0
  check_output "tools: core macos-setup opt"
  check "opt (default = true) is rendered" test -f "$home/.config/opt/opt.txt"
  check "merger (default = false) is not rendered" not test -e "$home/.config/merger"
}

# A default = false member arrives only with [tools.<name>].
case_packs_member() {
