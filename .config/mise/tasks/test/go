#!/usr/bin/env bash
#MISE description="Vet and format-check the Go modules of cli/ and of the root"

# Runs `go vet` and a `gofmt` check in the two Go modules of this repository:
# cli/ (the engine) and the root (the end-to-end tests of e2e/). The task
# `test` runs the tests. The task runs the Go of the `go` tool, which this
# repository selects.

set -euo pipefail

# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

root=${MISE_PROJECT_ROOT}

print_header "Examining the Go modules ..."

print_subheader "Running go vet ..."
(cd "$root/cli" && mise x -- go vet ./...)
(cd "$root" && mise x -- go vet ./...)

print_subheader "Examining the format with gofmt ..."
unformatted=$(mise x -- gofmt -l "$root/cli" "$root/e2e")
if [[ -n $unformatted ]]; then
  print_error "files that gofmt changes:"
  printf '%s\n' "$unformatted" >&2
  exit 1
fi

print_success "The Go modules pass go vet and gofmt"
