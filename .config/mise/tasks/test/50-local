#!/usr/bin/env bash
#MISE description="Run every test: the Go module of cli/ and the end-to-end tests of e2e/"
#MISE depends=["test:go"]
#MISE tools.gotestsum="latest"
#MISE tools.gomplate="latest"
#USAGE flag "--all" help="run each test again, also a test whose inputs did not change (go test -count=1)"

# Runs `go test` with gotestsum in the two Go modules of this repository, at
# the same time: cli/ (the unit tests of the engine) and the root (the
# end-to-end tests of e2e/). `go test` keeps the result of a package whose
# inputs did not change, and does not run it again; --all runs each package.
# Each run writes the JSON log of `go test -json` to
# ${XDG_STATE_HOME:-$HOME/.local/state}/bootstrap/test-runs/, with the time of
# each test and the TIMING lines of the end-to-end cases, and prints the
# slowest tests.

set -euo pipefail

# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The tests never read the real config file of the user: the engine reads
# this path, which does not exist, so each setting has its default.
export BOOTSTRAP_CONFIG=/nonexistent/bootstrap/config.toml

root=${MISE_PROJECT_ROOT}
runs="${XDG_STATE_HOME:-$HOME/.local/state}/bootstrap/test-runs"
mkdir -p -- "$runs"
stamp=$(date -u +%Y%m%dT%H%M%SZ)
log="$runs/$stamp.json"
part="$runs/.$stamp"

# mise gives the tool folders of a task in a different order on each run, and
# `go test` keeps a result only for the same PATH. The tool folders of mise
# go in the order of their names, at the place of the first one.
stable=''
tools=$(printf '%s\n' "$PATH" | tr ':' '\n' | grep '/mise/installs/' | LC_ALL=C sort) || tools=''
done_tools=''
while IFS= read -r dir; do
  if [[ $dir == */mise/installs/* ]]; then
    [[ -n $done_tools ]] && continue
    dir=$(printf '%s' "$tools" | tr '\n' ':')
    dir=${dir%:}
    done_tools=1
  fi
  stable+="${stable:+:}$dir"
done < <(printf '%s\n' "$PATH" | tr ':' '\n')
export PATH=$stable

go_flags=()
[[ ${usage_all:-false} == true ]] && go_flags+=(-count=1)

print_header "Running the Go tests ..."
start=$SECONDS
rc_cli=0
rc_e2e=0
(cd "$root/cli" && gotestsum --format pkgname --jsonfile "$part.cli.json" -- ${go_flags[@]+"${go_flags[@]}"} ./...) &
pid_cli=$!
(cd "$root" && gotestsum --format pkgname --jsonfile "$part.e2e.json" -- ${go_flags[@]+"${go_flags[@]}"} ./...) || rc_e2e=$?
wait "$pid_cli" || rc_cli=$?
cat -- "$part.cli.json" "$part.e2e.json" > "$log"
rm -f -- "$part.cli.json" "$part.e2e.json"

print_subheader "Listing the slowest tests ..."
gotestsum tool slowest --jsonfile "$log" --threshold 5s --num 10
print_info "The log of the run: $log"
print_info "The run took $((SECONDS - start)) s"

if ((rc_cli || rc_e2e)); then
  print_error "Tests failed"
  exit 1
fi
line_sep1
print_success "All tests passed"
