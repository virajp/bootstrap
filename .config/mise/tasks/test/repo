detect_files() {
  local f
  for f in "${DETECT_FILES[@]}"; do
    mkdir -p -- "$consumer/$(dirname -- "${f%%=*}")"
    printf '%s\n' "${f#*=}" > "$consumer/${f%%=*}"
  done
}
# check_detect_found: the tool of the case is in the output as found or offered.
