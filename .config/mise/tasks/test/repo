  check_that "the manifest: a generated conf.d file" grep -qxF "mise${tab}.config/mise/conf.d/mise/mise.dev.toml" "$file"
  check_that "the manifest: no seed" lacks_in_file '.config/mise/conf.d/zz-repo/' "$file"
  check_that "the manifest: no removed merge task" lacks_in_file '.config/mise/tasks/git/merge/develop' "$file"
  case_rerun || got=$?
  check_that "the manifest: a second run exits 0" test "$got" = 0
  check_that "the manifest: a second run does not write it" log_lacks "wrote      $file"
}
case_args=' ' run_case "the manifest of a real run" 0 "$no_tool_values" '' '' check_manifest_written

