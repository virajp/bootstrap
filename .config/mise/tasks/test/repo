# The clone of bootstrap. Without BOOTSTRAP_CLONE, bootstrap takes the lock of
# its cache, fetches main of BOOTSTRAP_URL into the cache and syncs from a
# copy. Each run is `bootstrap sync --dry-run` in a scratch consumer. The log
# names the commit of the copy (BOOTSTRAP_VERBOSE=1).
remote="$tmp/remote"
_git clone --quiet -- "$base_clone" "$remote"
clone_consumer="$tmp/clone-consumer"
cp -R -- "$base_consumer" "$clone_consumer"
printf '%s\n' 'repo_name = "test"' 'environments = [ "dev" ]' > "$clone_consumer/.config/bootstrap.toml"
_git -C "$clone_consumer" add -A
_git -C "$clone_consumer" commit --quiet --no-verify -m "values"

# A binary with a release version, for the version check.
release_bin="$tmp/engine-1.0.0"
(cd "$root" && mise x -- go build -C "$base_clone/sync-engine" -buildvcs=false -ldflags "-X main.version=1.0.0" \
  -o "$release_bin" ./cmd/bootstrap)

# run_bin <url>: `bootstrap sync --dry-run` with the cache $cache. RUN_BIN
# replaces the engine.
run_bin() {
  (
    cd -- "$clone_consumer"
    env -u BOOTSTRAP_CLONE -u REPO_SYNC_VALUES BOOTSTRAP_CACHE="$cache" BOOTSTRAP_URL="$1" \
      MISE_PROJECT_ROOT="$clone_consumer" "${RUN_BIN:-$bin}" sync --dry-run
  ) > "$log" 2>&1
}

# check_clone <name> <want> <got> [<commit>]: the exit code, the commit of the
# copy, and no lock left.
check_clone() {
  local name=$1 want=$2 got=$3 commit=${4:-}
  if [[ $got != "$want" ]]; then
    print_error "$name: exit $got, expected $want"
  elif [[ -n $commit ]] && ! grep -qF "using bootstrap at ${commit:0:7}" "$log"; then
    print_error "$name: the sync did not use ${commit:0:7}"
  elif [[ -e $cache/lock ]]; then
    print_error "$name: the lock is still there"
  else
    print_success "$name: exit $got"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
}

# The rules of the shared cache. Each case has its own cache.
new_cache() {
  cache="$tmp/$1/bootstrap"
  mkdir -p -- "${cache%/*}"
}

# check_paths <name> [-e <path>]... [-n <path>]...: -e needs the path, -n needs
# no such path.
check_paths() {
  local name=$1 bad=''
  shift
  while (($#)); do
    case $1 in
      -e)
        [[ -e $2 ]] || bad+=" missing:$2"
        ;;
      -n)
        [[ ! -e $2 ]] || bad+=" present:$2"
        ;;
    esac
    shift 2
  done
  if [[ -n $bad ]]; then
    print_error "$name:$bad"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  else
    print_success "$name: the folders"
  fi
}

# check_configs_log <name> -h|-l <text>: the output of the last run has (-h) or
# lacks (-l) the fixed string.
check_configs_log() {
  local found=0
  grep -qF -- "$3" "$log" && found=1
  if [[ $2 == -h && $found == 1 || $2 == -l && $found == 0 ]]; then
    print_success "$1: the output"
  else
    print_error "$1: the check $2 of the output fails for: $3"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}

