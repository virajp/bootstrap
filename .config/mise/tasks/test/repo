# The shared mise generator, side repo. mtest is a tool of the clone with only a
# tools.toml, and the consumer has its generated dev file, so the dry run shows
# the diff of that file.
mtest_tool() {
  mkdir -p -- "$clone/repo/tools/mtest"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' 'root_only = false' "$@" \
    > "$clone/repo/tools/mtest/tools.toml"
  conf_file mtest dev
}
mtest_bootstrap() {
  mtest_tool '[mise.bootstrap.packages]' 'brew = "a"' '[mise.dotfiles]' 'src = "b"' '[mise.env]' 'A = "1"'
  conf_file mtest ci
}
mtest_render() { mtest_tool '[defaults]' 'x = "a"' '[mise.env]' 'X = "<% .config.x %>"'; }
mtest_required() {
  # shellcheck disable=SC2016
  mtest_tool '[mise.env]' 'X = "<% required `x is needed` .config.x %>"'
}
mtest_home() { mtest_tool '[mise.env]' 'H = "<% .env.HOME %>"'; }
mtest_bad_toml() { mtest_tool '[defaults]' "q = 'a\"b'" '[mise.env]' 'X = "<% .config.q %>"'; }
# A new file: a real run writes it, with no file of the consumer before it.
mtest_new() {
  mtest_render
  rm -f -- "$consumer/.config/mise/conf.d/mtest/mise.dev.toml"
}

# mtest_diff <file>: the diff of the dry run for a generated file of mtest.
mtest_diff() {
  awk -v file="would update $consumer/.config/mise/conf.d/mtest/$1" \
    'index($0, file) { on = 1; next } /^bootstrap: / { on = 0 } on' "$log"
}
diff_has() { [[ $(mtest_diff "$1") == *"$2"* ]]; }
diff_lacks() { ! diff_has "$1" "$2"; }
file_has() { grep -qF -- "$1" "$2"; }

check_mtest_dev_only() {
  local name="[mise.bootstrap.*], [mise.dotfiles]"
  check_that "$name: the dev file has [bootstrap.packages]" diff_has mise.dev.toml '[bootstrap.packages]'
  check_that "$name: the dev file has [dotfiles]" diff_has mise.dev.toml '[dotfiles]'
  check_that "$name: the ci file has [env]" diff_has mise.ci.toml '+[env]'
  check_that "$name: the ci file lacks bootstrap" diff_lacks mise.ci.toml '[bootstrap'
  check_that "$name: the ci file lacks dotfiles" diff_lacks mise.ci.toml '[dotfiles'
}
check_mtest_kept() {
  check_log_lacks "a required value that is missing: the file stays" \
    "would update $consumer/.config/mise/conf.d/mtest/mise.dev.toml"
}
check_mtest_new() {
