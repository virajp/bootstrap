hook_main() { expect_hook "the protected branches, develop true" "--branch main"; }
hook_none() { expect_hook "the protected branches, both true" ""; }
own_hook_stays() {
  local f="$consumer/.config/pre-commit-config.yaml"
  if grep -qF 'example.com/own-hooks' "$f" && grep -qxF 'own_key: 1' "$f" && grep -qxF '# own comment' "$f"; then
    print_success "the own hook block, key and comment stay"
  else
    print_error "the own hook block, key or comment is gone"
    sed 's/^/    /' "$f" >&2
    failures=$((failures + 1))
  fi
  hook_both
}

