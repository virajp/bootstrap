    '(.data.servers | has("typescript-lsp") | not) and (.data.checks | has("typescript-lsp") | not)'
}
check_lsp_typescript() {
  check_that "lsp --json: the checks of typescript-lsp" lsp_jq \
    '.data.checks."typescript-lsp" == {"command":"typescript-language-server","source":"npm:typescript-language-server"}'
}
node_values='environments = [ "dev" ]
[tools.node]'
CASE_CALL=lsp_json run_case "lsp --json: node alone has no server" 0 "$node_values" '' \
  '"command":"lsp","ok":true' check_lsp_no_typescript
CASE_CALL=lsp_json run_case "lsp --json: a tsconfig.json alone lists typescript-lsp" 0 "$node_values" lsp_tsconfig \
  '"data":{"servers":{"typescript-lsp":' check_lsp_typescript
# The generated dev config of node already exists in the consumer, so the
# dry run shows its diff.
node_conf() { conf_file node dev; }
lacks_typescript_pins() { check_log_lacks "node alone: no typescript pins" 'npm:typescript'; }
run_case "node alone: no typescript pins in dev" 0 "$node_values" node_conf '[tools.node]' lacks_typescript_pins
# With a package.json or a tsconfig.json, the dev config of node has both pins,
# without the requires_found key of their [mise_env.dev.tools] entries (D40).
node_conf_package() { node_conf && lsp_package_json; }
node_conf_tsconfig() { node_conf && lsp_tsconfig; }
check_node_pins() {
  check_that "$1: the typescript pin" log_has '"npm:typescript"'
  check_log_lacks "$1" 'requires_found'
}
check_node_pins_package() { check_node_pins "node and a package.json"; }
check_node_pins_tsconfig() { check_node_pins "node and a tsconfig.json"; }
run_case "node and a package.json: the typescript pins in dev" 0 "$node_values" node_conf_package \
  '"npm:typescript-language-server"' check_node_pins_package
run_case "node and a tsconfig.json: the typescript pins in dev" 0 "$node_values" node_conf_tsconfig \
  '"npm:typescript-language-server"' check_node_pins_tsconfig

# check refuses a wrong [lsp] block (D7, D30). Each change adds a table to
# the go tool of the clone of the case.
lsp_add() { printf '%s\n' '' "$@" >> "$clone/repo/tools/go/tools.toml"; }
lsp_no_extensions() { lsp_add '[lsp.x]' 'command = "x"' 'source = "host"'; }
lsp_empty_extensions() { lsp_add '[lsp.x]' 'command = "x"' 'extensions = {}' 'source = "host"'; }
lsp_no_command() { lsp_add '[lsp.x]' 'extensions = { ".x" = "x" }' 'source = "host"'; }
lsp_twice() { lsp_add '[lsp.typescript-lsp]' 'command = "x"' 'extensions = { ".x" = "x" }' 'source = "host"'; }
lsp_not_pinned() { lsp_add '[lsp.x]' 'command = "x"' 'extensions = { ".x" = "x" }' 'source = "nope"'; }
lsp_spaces() { lsp_add '[lsp.x]' 'command = "pyrefly lsp"' 'extensions = { ".x" = "x" }' 'source = "host"'; }
run_check "[lsp.x] with no extensions" 2 "$lsp_values" lsp_no_extensions \
  'repo/tools/go/tools.toml: [lsp.x] needs extensions, a table of ".<ext>" = "<language id>" that is not empty'
run_check "[lsp.x] with empty extensions" 2 "$lsp_values" lsp_empty_extensions \
  'repo/tools/go/tools.toml: [lsp.x] needs extensions, a table of ".<ext>" = "<language id>" that is not empty'
run_check "[lsp.x] with no command" 2 "$lsp_values" lsp_no_command \
  'repo/tools/go/tools.toml: [lsp.x] needs command, the binary of the server (a string)'
run_check "one server name in two tools" 2 "$lsp_values" lsp_twice \
  "language server 'typescript-lsp' is defined in repo/tools/go and in repo/tools/node - keep one"
run_check "[lsp.x] with a source that the tool does not pin" 2 "$lsp_values" lsp_not_pinned \
  "repo/tools/go/tools.toml: source 'nope' of [lsp.x] is not a mise tool of this tool - name its pin"
run_check "[lsp.x] with a command with spaces" 2 "$lsp_values" lsp_spaces \
  "repo/tools/go/tools.toml: [lsp.x] command 'pyrefly lsp' has whitespace - command is one binary; put the rest in args"

# A server follows its source pin and the envs of its tool (D12, D28):
# pyrefly needs the pyproject.toml of its pin, and a tool without dev has no
# server. lsp does not run the rules of check, so it reads a values file in
# which go has env ci only.
check_lsp_no_pyrefly() { check_that "lsp --json: no pyrefly" lsp_jq '.data.servers | has("pyrefly") | not'; }
check_lsp_pyrefly() {
  check_that "lsp --json: the pyrefly entry" lsp_jq \
    '.data.servers.pyrefly == {"command":"mise","args":["x","--","pyrefly","lsp"],"extensionToLanguage":{".py":"python",".pyi":"python"}}'
  check_that "lsp --json: the checks of pyrefly" lsp_jq \
    '.data.checks.pyrefly == {"command":"pyrefly","source":"pipx:pyrefly"}'
}
check_lsp_no_gopls() {
  check_that "lsp --json: no gopls" lsp_jq \
    '(.data.servers | has("gopls") | not) and (.data.checks | has("gopls") | not)'
}
CASE_CALL=lsp_json run_case "lsp --json: python without a pyproject.toml" 0 "$python_values" '' \
  '"command":"lsp","ok":true' check_lsp_no_pyrefly
CASE_CALL=lsp_json run_case "lsp --json: python with a pyproject.toml" 0 "$python_values" pyproject_root \
  '"command":"lsp","ok":true' check_lsp_pyrefly
CASE_CALL=lsp_json run_case "lsp --json: a tool without dev has no server" 0 'environments = [ "dev", "ci" ]
[tools.go]
env = [ "ci" ]' '' '"command":"lsp","ok":true' check_lsp_no_gopls

# code:lsp:check (D16, D20, D29): the case runs the synced task file with bash,
# not with mise run. A PATH shim for mise answers `which` with a path only in
# MISE_ENV=dev, and fails with LSP_WHICH_FAIL=1; it runs the command of `x --`
# itself, so jq comes from jq_dir. LSP_BIN is the engine of the task: by
# default a stub that prints an envelope with the one server gopls, or exits
# with LSP_STUB_CODE.
jq_dir=$(dirname -- "$(mise x jq@latest -- which jq)")
lsp_check_task() {
  synced
  mkdir -p -- "$tmp/shim"
  cat > "$tmp/shim/mise" << 'EOF'
#!/usr/bin/env bash
case $1 in
  which)
    [[ ${MISE_ENV:-} == dev && -z ${LSP_WHICH_FAIL:-} ]] || exit 1
    printf '%s\n' "/servers/$2"
    ;;
  x)
    shift
    [[ ${1:-} != -- ]] || shift
    exec "$@"
    ;;
  *) exit 1 ;;
esac
EOF
  cat > "$tmp/stub" << 'EOF'
#!/usr/bin/env bash
[[ $* == "lsp --json" ]] || exit 1
if [[ -n ${LSP_STUB_CODE:-} ]]; then
  printf '%s\n' '[ERROR] the stub fails' >&2
  exit "$LSP_STUB_CODE"
fi
printf '%s\n' '{"contract":1,"command":"lsp","ok":true,"code":0,"data":{"servers":{"gopls":{"command":"mise","args":["x","--","gopls"],"extensionToLanguage":{".go":"go"}}},"checks":{"gopls":{"command":"gopls","source":"go:golang.org/x/tools/gopls"}}},"errors":[],"warnings":[]}'
EOF
  chmod +x "$tmp/shim/mise" "$tmp/stub"
  (
    cd -- "$consumer"
    BOOTSTRAP_BIN=${LSP_BIN:-$tmp/stub} LSP_WHICH_FAIL=${LSP_WHICH_FAIL:-} LSP_STUB_CODE=${LSP_STUB_CODE:-} \
      PATH="$tmp/shim:$jq_dir:$PATH" bash "$consumer/.config/mise/tasks/code/lsp/check"
  )
}
check_lsp_header() { check_that "code:lsp:check: the header" log_has 'Checking the LSP servers ...'; }
CASE_CALL=lsp_check_task run_case "code:lsp:check: each server resolves" 0 "$dev_values" '' \
  'gopls: /servers/gopls' check_lsp_header
LSP_WHICH_FAIL=1 CASE_CALL=lsp_check_task run_case "code:lsp:check: a server that does not resolve" 1 "$dev_values" '' \
  'gopls: gopls not found - run MISE_ENV=dev mise install' check_lsp_header
LSP_STUB_CODE=2 CASE_CALL=lsp_check_task run_case "code:lsp:check: lsp --json exits 2" 2 "$dev_values" '' \
  'the stub fails'
LSP_STUB_CODE=3 CASE_CALL=lsp_check_task run_case "code:lsp:check: lsp --json exits 3" 1 "$dev_values" '' \
  'the stub fails'

# A repo with no server: the task prints nothing and exits 0, with the real
# engine. The repo has node through base, but no package.json or tsconfig.json.
lsp_check_none() { LSP_BIN=$bin lsp_check_task; }
empty_log() { [[ ! -s $log ]]; }
check_lsp_silent() { check_that "code:lsp:check: no output without a server" empty_log; }
CASE_CALL=lsp_check_none run_case "code:lsp:check: a repo with no server" 0 "$dev_values" '' '' check_lsp_silent

# setup:ai (D2 to D5, D13, D18, D19, D25 to D27, D29, D34): the case runs the
# synced task file with bash, as code:lsp:check does, with the real engine in
# BOOTSTRAP_BIN and the clone of the case in BOOTSTRAP_CLONE (D27). A PATH shim for mise runs
# the command of `x --` itself. A stub claude on the path logs each call to
# $tmp/ai/calls and answers `plugin list --json` and
# `plugin marketplace list --json` from the state files $tmp/ai/installed
# (`<plugin>|<scope>` lines) and $tmp/ai/marketplaces. AI_FAIL=install or
# AI_FAIL=uninstall makes that call fail. A case may set AI_BIN, the engine of
# the task, to $tmp/ai/engine: the real engine, except that `config set` exits 5
# with AI_SET_FAIL=1.
# No case uses the network or a real claude.
ai_setup() {
  synced
  mkdir -p -- "$tmp/ai/bin"
  : > "$tmp/ai/installed"
  : > "$tmp/ai/marketplaces"
  cat > "$tmp/ai/bin/mise" << 'EOF'
#!/usr/bin/env bash
case $1 in
  x)
    shift
    [[ ${1:-} != -- ]] || shift
    exec "$@"
    ;;
  *) exit 1 ;;
esac
EOF
  cat > "$tmp/ai/bin/claude" << 'EOF'
#!/usr/bin/env bash
state=$AI_STATE
printf '%s\n' "$*" >> "$state/calls"
case "$*" in
  "plugin list --json")
    jq -Rnc --arg root "$AI_ROOT" '[inputs | select(length > 0) | split("|")
      | {id: .[0], scope: .[1]} + (if .[1] == "project" then {projectPath: $root} else {} end)]' \
      < "$state/installed"
    ;;
  "plugin marketplace list --json")
    jq -Rnc '[inputs | select(length > 0) | {name: .}]' < "$state/marketplaces"
    ;;
  "plugin marketplace add --scope "*)
    case $5 in
      virajp/claude-plugins) printf '%s\n' virajp-plugins >> "$state/marketplaces" ;;
      *) printf '%s\n' "${5##*/}" >> "$state/marketplaces" ;;
    esac
    ;;
  "plugin install --scope "*)
    if [[ ${AI_FAIL:-} == install ]]; then
      printf '%s\n' 'the stub install fails' >&2
      exit 1
    fi
    printf '%s|%s\n' "$5" "$4" >> "$state/installed"
    ;;
  "plugin uninstall --scope project --prune -y "*)
    if [[ ${AI_FAIL:-} == uninstall ]]; then
      printf '%s\n' 'the stub uninstall fails' >&2
      exit 1
    fi
    grep -vFx "$7|project" "$state/installed" > "$state/installed.new" || true
    mv -- "$state/installed.new" "$state/installed"
    ;;
esac
EOF
  cat > "$tmp/ai/engine" << 'EOF'
#!/usr/bin/env bash
if [[ $1 == config && $2 == set && -n ${AI_SET_FAIL:-} ]]; then
  printf '%s\n' '[ERROR] the stub set fails' >&2
  exit 5
fi
exec "$AI_REAL_BIN" "$@"
EOF
  chmod +x "$tmp/ai/bin/mise" "$tmp/ai/bin/claude" "$tmp/ai/engine"
}
# ai_run <n> [--upgrade]: run <n> of the task. Its output goes to the log of the
# case, and its claude calls to $tmp/ai/calls<n>.
ai_run() {
  local n=$1 upgrade=false got=0
  [[ ${2:-} != --upgrade ]] || upgrade=true
  : > "$tmp/ai/calls"
  printf '%s\n' "--- run $n"
  (
    cd -- "$consumer"
    BOOTSTRAP_BIN=${AI_BIN:-$bin} AI_REAL_BIN=$bin AI_STATE=$tmp/ai AI_ROOT=$consumer \
      PATH="$tmp/ai/bin:$jq_dir:$PATH" usage_upgrade=$upgrade bash "$consumer/.config/mise/tasks/setup/ai"
  ) || got=$?
  cp -- "$tmp/ai/calls" "$tmp/ai/calls$n"
  return "$got"
}
# ai_called <n> <call>: run <n> made the claude call <call>.
ai_called() { grep -qxF -- "$2" "$tmp/ai/calls$1"; }
ai_not_called() { ! ai_called "$@"; }
# ai_no_change <n>: run <n> made no install, update, uninstall or add call.
ai_no_change() { ! grep -qE '^plugin (install|uninstall|update|marketplace (add|update)) ' "$tmp/ai/calls$1"; }
# ai_record <plugins>: the record tools.claude.plugins.installed of the values
# file, its entries joined with commas; no key is an empty record.
ai_record() { tomlq "((.tools.claude.plugins.installed // []) | join(\",\")) == \"$1\""; }

# A project plugin of the list, and the vwf plugin that virajp-plugins
# contributes at user scope.
ai_values='environments = [ "dev" ]
[tools.virajp-plugins]
[tools.claude.plugins.project]
"lsp@tools" = "acme/tools"'
# The same list with a record.
ai_record_values() {
  printf '%s\n' "$ai_values" '[tools.claude.plugins]' "installed = $1"
}

# 1. A first run installs; 2. a second run changes nothing (D4); 3. --upgrade
# makes the update calls (D4).
ai_first() {
  ai_setup
  ai_run 1 || exit
  ai_run 2 || exit
  ai_run 3 --upgrade
}
check_ai_first() {
  check_that "setup:ai: the first run adds the marketplace of vwf" ai_called 1 \
    'plugin marketplace add --scope user virajp/claude-plugins'
  check_that "setup:ai: the first run installs vwf at user scope" ai_called 1 \
    'plugin install --scope user vwf@virajp-plugins'
  check_that "setup:ai: the first run installs the listed project plugin" ai_called 1 \
    'plugin install --scope project lsp@tools'
  check_that "setup:ai: the project plugin is recorded" ai_record 'lsp@tools'
  check_that "setup:ai: the second run changes nothing (D4)" ai_no_change 2
  check_that "setup:ai: --upgrade updates the marketplaces (D4)" ai_called 3 'plugin marketplace update'
  check_that "setup:ai: --upgrade updates vwf at user scope (D4)" ai_called 3 \
    'plugin update --scope user vwf@virajp-plugins'
  check_that "setup:ai: --upgrade updates the project plugin (D4)" ai_called 3 \
    'plugin update --scope project lsp@tools'
  check_that "setup:ai: --upgrade installs nothing" ai_not_called 3 'plugin install --scope project lsp@tools'
}
CASE_CALL=ai_first run_case "setup:ai: install, a second run, then --upgrade" 0 "$ai_values" '' \
  'Installing vwf@virajp-plugins (user)' check_ai_first

# setup passes --upgrade to setup:ai (D39): the case runs the synced task setup
# with bash, a plain run, then a run with --upgrade. A PATH shim for mise logs
# each `mise run` to $tmp/setup/runs<n> and does nothing else.
setup_run() {
  local n=$1 upgrade=false
  [[ ${2:-} != --upgrade ]] || upgrade=true
  (
    cd -- "$consumer"
    SETUP_RUNS=$tmp/setup/runs$n PATH="$tmp/setup/bin:$PATH" usage_upgrade=$upgrade \
      bash "$consumer/.config/mise/tasks/setup/_default"
  )
}
setup_upgrade() {
  synced
  mkdir -p -- "$tmp/setup/bin"
  cat > "$tmp/setup/bin/mise" << 'EOF'
#!/usr/bin/env bash
[[ $1 != run ]] || printf '%s\n' "$*" >> "$SETUP_RUNS"
EOF
  chmod +x "$tmp/setup/bin/mise"
  setup_run 1 || exit
  setup_run 2 --upgrade
}
setup_ran() { grep -qxF -- "$2" "$tmp/setup/runs$1"; }
check_setup_upgrade() {
  check_that "setup: the synced setup:ai is there" test -x "$consumer/.config/mise/tasks/setup/ai"
  check_that "setup: a plain run does not run setup:ai (D4)" not_grep -F 'run setup:ai' "$tmp/setup/runs1"
  check_that "setup: --upgrade runs setup:ai --upgrade (D39)" setup_ran 2 'run setup:ai --upgrade'
}
CASE_CALL=setup_upgrade run_case "setup: --upgrade passes --upgrade to setup:ai" 0 "$ai_values" '' \
  'Setup complete!' check_setup_upgrade

# A plugin that leaves plugins.project is uninstalled, with --prune -y, and
# leaves the record (D3, D29). A project plugin installed by hand, not in the
# record, stays.
ai_leaves() {
  ai_setup
  printf '%s\n' 'hand@tools|project' >> "$tmp/ai/installed"
  ai_run 1 || exit
  grep -vF '"lsp@tools" = ' "$tools_values" > "$tmp/tools.toml"
  cp -- "$tmp/tools.toml" "$tools_values"
  ai_run 2
}
check_ai_leaves() {
  check_that "setup:ai: a plugin that left the list is uninstalled (D3, D29)" ai_called 2 \
    'plugin uninstall --scope project --prune -y lsp@tools'
  check_that "setup:ai: the uninstalled plugin leaves the record (D3)" ai_record ''
  check_that "setup:ai: a plugin installed by hand is never uninstalled (D3)" ai_not_called 2 \
    'plugin uninstall --scope project --prune -y hand@tools'
  check_that "setup:ai: user scope is never uninstalled (D3)" not_grep -F 'uninstall --scope user' "$tmp/ai/calls2"
}
CASE_CALL=ai_leaves run_case "setup:ai: a project plugin leaves the list" 0 "$ai_values" '' \
  'Uninstalling lsp@tools (project)' check_ai_leaves

# A failed install records nothing; a failed uninstall keeps the record; both
# exit 1 (D13).
ai_fail_install() {
  ai_setup
  AI_FAIL=install ai_run 1
}
check_ai_fail_install() {
  check_that "setup:ai: a failed install is not recorded (D13)" ai_record ''
}
CASE_CALL=ai_fail_install run_case "setup:ai: a failed install" 1 "$ai_values" '' 'the stub install fails' \
  check_ai_fail_install
ai_fail_uninstall() {
  ai_setup
  printf '%s\n' 'vwf@virajp-plugins|user' 'old@tools|project' 'lsp@tools|project' >> "$tmp/ai/installed"
  AI_FAIL=uninstall ai_run 1
}
check_ai_fail_uninstall() {
  check_that "setup:ai: a failed uninstall stays recorded (D13)" ai_record 'lsp@tools,old@tools'
}
CASE_CALL=ai_fail_uninstall run_case "setup:ai: a failed uninstall" 1 \
  "$(ai_record_values '[ "lsp@tools", "old@tools" ]')" '' 'the stub uninstall fails' check_ai_fail_uninstall

# A recorded plugin that is not installed leaves the record with no uninstall
# call (D18); a listed project plugin that is installed is recorded with no
# install call (D19).
ai_found() {
  ai_setup
  printf '%s\n' 'vwf@virajp-plugins|user' 'lsp@tools|project' >> "$tmp/ai/installed"
  printf '%s\n' virajp-plugins tools >> "$tmp/ai/marketplaces"
  ai_run 1
}
check_ai_found() {
  check_that "setup:ai: a recorded plugin that is not installed, no uninstall call (D18)" ai_not_called 1 \
    'plugin uninstall --scope project --prune -y gone@tools'
  check_that "setup:ai: an installed listed plugin, no install call (D19)" ai_no_change 1
  check_that "setup:ai: the record drops gone@tools and adds lsp@tools (D18, D19)" ai_record 'lsp@tools'
}
CASE_CALL=ai_found run_case "setup:ai: the record follows the installed plugins" 0 \
  "$(ai_record_values '[ "gone@tools" ]')" '' '' check_ai_found

# A recorded, listed plugin that is not installed is installed again and stays
# recorded (D26).
ai_again() {
  ai_setup
  printf '%s\n' 'vwf@virajp-plugins|user' >> "$tmp/ai/installed"
  printf '%s\n' virajp-plugins tools >> "$tmp/ai/marketplaces"
  ai_run 1
}
check_ai_again() {
  check_that "setup:ai: a recorded plugin that is not installed is installed again (D26)" ai_called 1 \
    'plugin install --scope project lsp@tools'
  check_that "setup:ai: the plugin stays recorded (D26)" ai_record 'lsp@tools'
}
CASE_CALL=ai_again run_case "setup:ai: a recorded plugin installed again" 0 "$(ai_record_values '[ "lsp@tools" ]')" \
  '' '' check_ai_again

# A record write that fails is a failed step (D25).
ai_set_fails() {
  ai_setup
  AI_BIN=$tmp/ai/engine AI_SET_FAIL=1 ai_run 1
}
CASE_CALL=ai_set_fails run_case "setup:ai: a config set that fails" 1 "$ai_values" '' 'the stub set fails'

# No catalog: the first config get exits 2, so the task stops with code 2
# before any change: it installs nothing, uninstalls nothing and keeps the
# record (D34).
ai_no_catalog() {
  ai_setup
  printf '%s\n' 'vwf@virajp-plugins|user' 'old@tools|project' >> "$tmp/ai/installed"
  printf '%s\n' virajp-plugins tools >> "$tmp/ai/marketplaces"
  unset BOOTSTRAP_CLONE
  BOOTSTRAP_CACHE=$tmp/no-cache BOOTSTRAP_URL="file://$tmp/no-such-remote" ai_run 1
}
check_ai_no_catalog() {
  check_that "setup:ai, no catalog: no install call (D34)" not_grep -F 'install' "$tmp/ai/calls1"
  check_that "setup:ai, no catalog: no uninstall call (D34)" not_grep -F 'uninstall' "$tmp/ai/calls1"
  check_that "setup:ai, no catalog: the record is unchanged (D34)" ai_record 'old@tools,gone@tools'
}
CASE_CALL=ai_no_catalog run_case "setup:ai: config get reads no catalog" 2 \
  "$(ai_record_values '[ "old@tools", "gone@tools" ]')" '' \
  'config get tools.claude.plugins.user needs the catalog' check_ai_no_catalog

# setup:configs --all with the real engine (D54, D62, D63): the sibling api is
# a repository next to the consumer with its own .config/bootstrap/, so its
# sync writes [home]. The sibling web is not there: the sync of the home skips
# it with an info line, and the task with a warning. The task and helpers come
# from a sync of the consumer. members of helpers parses with yq.
yq_dir=$(dirname -- "$(mise x -- which yq)")
sibling_api() {
  mkdir -p -- "$tmp/api"
  _git -C "$tmp/api" init --quiet -b main
  write_values "$tmp/api/.config/bootstrap" 'environments = [ "dev" ]'
  sed 's/^repo_name = .*/repo_name = "api"/' "$tmp/api/.config/bootstrap/repo.toml" > "$tmp/api.toml"
  mv -- "$tmp/api.toml" "$tmp/api/.config/bootstrap/repo.toml"
  _git -C "$tmp/api" add -A
  _git -C "$tmp/api" commit --quiet --no-verify -m "values"
}
configs_all() {
  synced
  (
    unset BOOTSTRAP_VALUES
    cd -- "$consumer"
    BOOTSTRAP_BIN=$bin PATH="$yq_dir:$PATH" usage_all=true bash "$consumer/.config/mise/tasks/setup/configs/_default"
  )
}
check_sibling_home() {
  local home=$tmp/api/.config/bootstrap/repo.toml
  check_that "--all: the sibling gets [home] type sibling" tomlq '.home.type == "sibling"' "$home"
  check_that "--all: [home] has the url of the home" tomlq '.home.url == "https://example.com/test"' "$home"
  check_that "--all: [home] has the folder of the home" tomlq '.home | has("folder")' "$home"
  check_that "--all: the header of the sibling" log_has 'Syncing api ...'
  check_that "--all: the missing sibling, the info line of the sync" log_has 'member web skipped: ../web is not there'
  check_that "--all: the missing sibling, the warning of the task" log_has 'member web: ../web is not on this machine'
}
sibling_values='environments = [ "dev" ]
[members.api]
folder = "../api"
type = "sibling"
url = "https://example.com/api"
[members.web]
folder = "../web"
type = "sibling"
url = "https://example.com/web"'
CASE_CALL=configs_all run_case "setup:configs --all writes [home] in a sibling that is there" 0 "$sibling_values" \
