# The default output. A <change> of these cases unsets BOOTSTRAP_VERBOSE and
# the style variables, and the output is a log file, not a terminal.
output_default() { unset BOOTSTRAP_VERBOSE FORCE_COLOR NO_COLOR; }
# table_count <label>: the count of the row <label> of the plain table.
table_count() { sed -n "s/^| $1 *| *\([0-9]*\) |\$/\1/p" "$log"; }
table_is() { [[ $(table_count "$1") == "$2" ]]; }
# One table, and its Total is the sum of its rows.
table_adds_up() {
  local label n sum=0
  for label in Changed New Seeded Removed Unchanged 'Kept seeds' Skipped Failed; do
    n=$(table_count "$label")
    [[ -n $n ]] || return 1
    sum=$((sum + n))
  done
  [[ $(grep -c '^| Total ' "$log") == 1 ]] && table_is Total "$sum"
}
log_line() { grep -qxF -- "$1" "$log"; }
# The state of the consumer, without its .git.
consumer_state() {
  (cd -- "$consumer" && find . -path ./.git -prune -o -type f -exec cksum {} + | LC_ALL=C sort)
}
# The tool `fixture` with three files that have the header.
output_files() {
  local header name
  output_default
  fixture_tool
  for name in a b c; do
    fixture_header "$name.txt" '#'
    fixture_file "$name.txt" "${header[@]}" "$name"
  done
}
output_edit_a() { printf '%s\n' '# Synced from bootstrap: repo/tools/fixture/a.txt. Do not edit this file.' 'edited' > "$consumer/a.txt"; }

check_output_list() {
  local got=0 unchanged lines
  check_that "the default output: the first run lists a new file" log_line "new $consumer/c.txt"
  check_that "the default output: the first run has a table" table_adds_up
  # A second run writes the mise fragments and `_default` of the first run
  # again, so the third run is the one with exact counts.
  case_rerun || got=$?
  check_that "the default output: the second run exits 0" test "$got" = 0
  output_edit_a
  rm -- "$consumer/b.txt"
  case_rerun || got=$?
  check_that "the default output: exit 0" test "$got" = 0
  check_that "the default output: a changed file" log_line "changed $consumer/a.txt"
  check_that "the default output: a new file" log_line "new $consumer/b.txt"
  check_that "the default output: no unchanged file" log_lacks "$consumer/c.txt"
  check_that "the default output: Changed" table_is Changed 1
  check_that "the default output: New" table_is New 1
  check_that "the default output: Seeded" table_is Seeded 0
  check_that "the default output: Removed" table_is Removed 0
  check_that "the default output: Failed" table_is Failed 0
  check_that "the default output: the sum" table_adds_up
  check_that "the default output: the last line" test "$(tail -n 1 -- "$log")" = '[OK] Synced: 2 files changed'
  check_that "the default output: no per-file log line" log_lacks 'unchanged  '
  unchanged=$(table_count Unchanged)
  got=0
  (
    export BOOTSTRAP_VERBOSE=1
    case_rerun
  ) || got=$?
  check_that "verbose: exit 0" test "$got" = 0
  lines=$(grep -c '^bootstrap: unchanged  ' "$log") || lines=0
  check_that "verbose: each unchanged file, a.txt and b.txt too" test "$lines" = "$((unchanged + 2))"
  check_that "verbose: the table" table_adds_up
  check_that "verbose: the last line" test "$(tail -n 1 -- "$log")" = '[OK] Synced: no file changed'
  got=0
  (
    export BOOTSTRAP_VERBOSE=true
    case_rerun
  ) || got=$?
  check_that "only the value 1 is verbose" log_lacks 'unchanged  '
}
