  mise x yq@latest -- yq '[.repos[].hooks[] | select(.id == "no-commit-to-branch") | .args[]] | join(" ")' \
    "$consumer/.config/pre-commit-config.yaml" 2> /dev/null
}
expect_hook() {
  local got
  got=$(hook_args) || got=''
  if [[ $got == "$2" ]]; then
    print_success "$1: the hook args are '$2'"
  else
    print_error "$1: the hook args are '$got', expected '$2'"
    failures=$((failures + 1))
  fi
}
