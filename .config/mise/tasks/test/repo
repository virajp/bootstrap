# replace: the migrate script of the new tool, then the swap. A fake aube
# records its calls in $tmp/aube-calls and writes the lock file of its format.
fake_aube() {
  mkdir -p -- "$tmp/fakebin"
  cat > "$tmp/fakebin/aube" << 'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "${0%/*}/../aube-calls"
case $1 in
  import) printf '%s\n' 'lockfileVersion: aube' > aube-lock.yaml ;;
  install) printf '%s\n' "lockfileVersion: '9.0'" > "${AUBE_DEFAULT_LOCKFILE:-aube-lock.yaml}" ;;
esac
EOF
  chmod +x "$tmp/fakebin/aube"
}
pnpm_lock_files() { pnpm_files && printf '%s\n' "lockfileVersion: '9.0'" > "$consumer/pnpm-lock.yaml" && fake_aube; }
aube_lock_files() { aube_files && printf '%s\n' 'lockfileVersion: aube' > "$consumer/aube-lock.yaml" && fake_aube; }
replace_tools() { synced && PATH="$tmp/fakebin:$PATH" "$bin" replace tool --yes "$@"; }
replace_pnpm_aube() { replace_tools pnpm aube; }
check_replace_pnpm_aube() {
  check_that "replace: the values file selects aube" tomlq '.tools | has("aube") and (has("pnpm") | not)'
  check_that "replace: aube gets the env of pnpm" tomlq '.tools.aube.env[0] == "dev"'
  check_that "replace: aube-workspace.yaml" test -f "$consumer/aube-workspace.yaml"
  check_that "replace: no pnpm-workspace.yaml" no_file "$consumer/pnpm-workspace.yaml"
  check_that "replace: aube-lock.yaml" test -f "$consumer/aube-lock.yaml"
  check_that "replace: no pnpm-lock.yaml" no_file "$consumer/pnpm-lock.yaml"
  check_that "replace: aube import ran" grep -qxF 'import --lockfile-only' "$tmp/aube-calls"
  check_that "replace: the mise config of aube" test -f "$consumer/.config/mise/conf.d/aube/mise.dev.toml"
  check_that "replace: no mise config of pnpm" no_file "$consumer/.config/mise/conf.d/pnpm/mise.dev.toml"
}
