#!/usr/bin/env bash

#MISE description="Test bootstrap sync, check and init against scratch values files"
#MISE tools.gomplate="latest"

# Runs `bootstrap sync --dry-run`, `bootstrap check` and, for a case
# that compares a written file, `bootstrap sync`, with the working tree's
# repo/ and sync-engine/, against scratch values files and scratch consumers,
# and checks the exit code and message of each case. BOOTSTRAP_BIN, when set,
# is the engine to test (an absolute path); else the task builds it once from
# the copy of sync-engine/. Each case has its own cache (BOOTSTRAP_CACHE).
# Needs no network when gomplate, jq and yq are installed. Writes nothing
# outside its temporary folder.

set -euo pipefail

# A git hook that runs this task inside `git commit` exports these variables. With them set, the git init, add and commit of the
# scratch repositories write to the real repository (gap G2).
# The fixed list goes first, with no git call before it. Then
# `git rev-parse --local-env-vars`, in a clean environment, lists any other
# local variable of this git version. It does not list GIT_CONFIG_KEY_<n> and
# GIT_CONFIG_VALUE_<n>.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_EXEC_PATH \
  GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT \
  "${!GIT_CONFIG_KEY_@}" "${!GIT_CONFIG_VALUE_@}"
git_vars=$(git rev-parse --local-env-vars 2> /dev/null) || git_vars=''
# shellcheck disable=SC2086
unset $git_vars
unset git_vars

# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Each per-file line prints, so the cases compare the log format. A case of the
# default output unsets the variable.
export BOOTSTRAP_VERBOSE=1

root=${MISE_PROJECT_ROOT}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-repo.XXXXXX")
# The engine runs the scripts of a tool with `mise x` in the scratch
# consumers, so mise must trust their config files.
MISE_TRUSTED_CONFIG_PATHS="$tmp:$(cd -- "$tmp" && pwd -P)${MISE_TRUSTED_CONFIG_PATHS:+:$MISE_TRUSTED_CONFIG_PATHS}"
export MISE_TRUSTED_CONFIG_PATHS
# shellcheck disable=SC2046
trap 'kill $(jobs -p) 2> /dev/null || true; rm -rf -- "$tmp"' EXIT

# git without the user's hooks, signing or identity.
_git() {
  git -c user.name=test -c user.email=test@example.com -c commit.gpgsign=false \
    -c core.hooksPath=/dev/null "$@"
}

print_header "Testing bootstrap against scratch values files ..."

# The bootstrap copy: the working tree's repo/ and sync-engine/, uncommitted
# work included, committed in a temporary repository on main.
clone="$tmp/bootstrap"
mkdir -p -- "$clone"
cp -R -- "$root/repo" "$clone/repo"
cp -R -- "$root/sync-engine" "$clone/sync-engine"
_git -C "$clone" init --quiet -b main
_git -C "$clone" add -A
_git -C "$clone" commit --quiet --no-verify -m "test copy"

# The engine: BOOTSTRAP_BIN, else one build from the copy of sync-engine/.
if [[ -n ${BOOTSTRAP_BIN:-} ]]; then
  bin=$BOOTSTRAP_BIN
else
  (cd "$root" && mise x -- go build -C "$clone/sync-engine" -buildvcs=false -o "$tmp/engine" ./cmd/bootstrap)
  bin="$tmp/engine"
fi

# The consumer: a repository with a `main` branch.
consumer="$tmp/consumer"
mkdir -p -- "$consumer/.config"
_git -C "$consumer" init --quiet -b main
_git -C "$consumer" commit --quiet --no-verify --allow-empty -m "init"
log="$tmp/log"

failures=0

# The cases run in parallel, one job for each CPU. Each case has its own
# folder: a clone of the bootstrap copy and a copy of the consumer. Inside a
# case, `tmp`, `clone`, `consumer`, `values` and `log` name the files of that
# case, so a <change> or a <check> function changes only its own case. The
# output of each case is printed in the sequence of the cases.
base_clone=$clone
base_consumer=$consumer
max_jobs=$(getconf _NPROCESSORS_ONLN 2> /dev/null) || max_jobs=4
case_color=''
style_enabled && case_color=1
case_count=0
case_pids=()
case_dirs=()

# run_case <name> <code> <values> [<change>] [<message>] [<check>]
# Writes <values> after the common keys, applies <change> to the copy (a
# function name, or empty), runs the dry run, and compares the exit code.
# A <message> (a fixed string) must also be in the output. If the case
# passes, the function <check> examines its output.
# `case_args` replaces the arguments of `bootstrap sync` for the case; with
# `--check` in them, the case runs `bootstrap check` with the other
# arguments. `CASE_BOOTSTRAP_URL`, when set, becomes BOOTSTRAP_URL of the case.
# `CASE_CLONE=none` sets no BOOTSTRAP_CLONE, so bootstrap fetches its clone
# into the cache of the case. `CASE_CALL` names a function that the case runs
# instead of bootstrap. `CASE_DIRTY=1` does not commit the consumer before the
# run.
run_case() {
  local dir
  case_count=$((case_count + 1))
  dir="$tmp/case-$case_count"
  mkdir -p -- "$dir"
  (
    trap - EXIT
    case_body "$dir" "$@" > "$dir/out" 2>&1
  ) &
  case_pids+=("$!")
  case_dirs+=("$dir")
  if ((${#case_pids[@]} >= max_jobs)); then
    collect_case
  fi
}

case_body() {
  local dir=$1 name=$2 want=$3 body=$4 change=${5:-} message=${6:-} check=${7:-} got=0
  tmp=$dir clone=$dir/bootstrap consumer=$dir/consumer log=$dir/log failures=0
  values="$consumer/.config/bootstrap.toml"
  _git clone --quiet -- "$base_clone" "$clone"
  cp -R -- "$base_consumer" "$consumer"
  {
    printf '%s\n' 'repo_name = "test"' 'repo_url = "https://example.com/test"'
    printf '%s\n' "$body"
  } > "$values"
  if [[ -n $change ]]; then
    "$change"
  fi
  [[ -n ${CASE_OLD_FORM:-} ]] || new_form_all
  # The clean-target rule: a target with changes that are not committed stops
  # a sync, so the case commits its consumer first.
  [[ -n ${CASE_DIRTY:-} ]] || commit_consumer
  local args=${case_args:---dry-run} cmd=sync
  if [[ " $args " == *" --check "* ]]; then
    cmd=check
    args=" $args "
    args=${args/ --check / }
  fi
  (
    unset BOOTSTRAP_URL BOOTSTRAP_CLONE REPO_SYNC_CLONE
    export BOOTSTRAP_CACHE=$tmp/cache
    [[ -z ${CASE_BOOTSTRAP_URL:-} ]] || export BOOTSTRAP_URL=$CASE_BOOTSTRAP_URL
    export REPO_SYNC_VALUES=$values MISE_PROJECT_ROOT=$consumer REPO_SYNC_NO_AUTOUPDATE=1
    [[ ${CASE_CLONE:-} == none ]] || export BOOTSTRAP_CLONE=$clone
    if [[ -n ${CASE_CALL:-} ]]; then
      "$CASE_CALL"
      exit
    fi
    # shellcheck disable=SC2086
    "$bin" $cmd $args
  ) > "$log" 2>&1 || got=$?
  # After the dry run, so that its output stays plain for the greps.
  [[ -n $case_color ]] && export FORCE_COLOR=1
  if [[ $got != "$want" ]]; then
    print_error "$name: exit $got, expected $want"
  elif [[ -n $message ]] && ! grep -qF -- "$message" "$log"; then
    print_error "$name: exit $got, but the output lacks: $message"
  else
    print_success "$name: exit $got"
    [[ -n $check ]] && "$check"
    printf '%s\n' "$failures" > "$dir/failures"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  printf '%s\n' "$((failures + 1))" > "$dir/failures"
}

# new_form <tool folder>: a case writes its scratch tools in the old form of a
# tool folder: each file at its target path, and a [files."<target>"] table only
# for a file with a mode or a condition. This moves each such file below files/
# (or tasks/ for a task), and gives it its entry: it adds `source` to the table
# of the file, or writes a new table. A `.tmpl` file becomes mode = "template",
# or render = true for a seed. `CASE_OLD_FORM=1` keeps the old form, for a case
# that tests the refusal of it.
new_form() {
  local dir=$1 rel target key table src dest mode toml=$1/tools.toml
  [[ -f $toml ]] || return 0
  while IFS= read -r rel; do
    target=${rel%.tmpl}
    if [[ $target == .config/mise/tasks/* ]]; then
      key=${target#.config/mise/tasks/}
      table=tasks
      src=${key//\//-}
      [[ $key != _scripts/* ]] || src=${key#_scripts/}
    else
      key=$target
      table=files
      src=$target
    fi
    [[ $rel == "$target" ]] || src+=.tmpl
    dest=$dir/$table/$src
    mkdir -p -- "$(dirname -- "$dest")"
    mv -- "$dir/$rel" "$dest"
    mode=$(awk -v h="[files.\"$target\"]" '
      $0 == h { inside = 1; next }
      /^\[/ { inside = 0 }
      inside && $1 == "mode" { gsub(/"/, "", $3); print $3 }' "$toml")
    awk -v h="[files.\"$target\"]" -v nh="[$table.\"$key\"]" -v src="$src" \
      -v tmpl="$([[ $rel == "$target" ]] || echo 1)" -v mode="$mode" \
      -v lib="$([[ $table == tasks && $key == _scripts/* ]] && echo 1)" '
      function extra() {
        print "source = \"" src "\""
        if (tmpl && mode == "seed") print "render = true"
        else if (tmpl && (mode == "" || mode == "generated")) print "mode = \"template\""
        if (lib) print "library = true"
      }
      $0 == h { print nh; extra(); found = 1; inside = 1; next }
      /^\[/ { inside = 0 }
      inside && $1 == "mode" && $3 == "\"generated\"" { next }
      { print }
      END { if (!found) { print ""; print nh; extra() } }' "$toml" > "$toml.new"
    mv -- "$toml.new" "$toml"
  done < <(cd "$dir" && find . -type f ! -path ./tools.toml ! -path './files/*' ! -path './tasks/*' ! -path './scripts/*' | sed 's#^\./##' | sort)
}
new_form_all() {
  local d
  for d in "$clone"/repo/tools/*/; do
    new_form "${d%/}"
  done
}

# commit_consumer: commit each file of the consumer of the case.
commit_consumer() {
  _git -C "$consumer" add -A > /dev/null 2>&1 || true
  _git -C "$consumer" commit --quiet --no-verify --allow-empty -m "case" > /dev/null 2>&1 || true
}

# run_check: run_case with `bootstrap check`.
run_check() { case_args=--check run_case "$@"; }

# Wait for the oldest case, print its output and add its failures. A case
# without a failures file stopped before its end, which is a failure.
# The files give the result, not the status of `wait`. When a fork of this
# shell gets the pid of a case that ended, bash forgets the status of that
# case, and `wait` fails with "is not a child of this shell".
collect_case() {
  local dir=${case_dirs[0]} n=1
  wait "${case_pids[0]}" 2> /dev/null || true
  cat -- "$dir/out"
  [[ -f $dir/failures ]] && n=$(cat -- "$dir/failures")
  failures=$((failures + n))
  rm -rf -- "$dir"
  case_pids=("${case_pids[@]:1}")
  case_dirs=("${case_dirs[@]:1}")
}

# The first line of a manifest, and the TAB of its rows.
manifest_first='# Written by bootstrap. Do not edit this file.'
tab=$'\t'
# manifest_file [<row>...]: .config/repo-generated.tsv of the consumer of the
# case, with the first line and these rows.
manifest_file() {
  mkdir -p -- "$consumer/.config"
  {
    printf '%s\n' "$manifest_first"
    (($# == 0)) || printf '%s\n' "$@"
  } > "$consumer/.config/repo-generated.tsv"
}
# header_file <path>: a file of the consumer of the case with the bootstrap
# header.
header_file() {
  mkdir -p -- "$(dirname -- "$consumer/$1")"
  printf '%s\n' "# Synced from bootstrap: tools/oldtool/$1. Do not edit this file." \
    '# The next sync writes it again, and each change in this file is lost.' > "$consumer/$1"
}

# The tools of the pack base. _security_base arrives through the depends of the
# scanners. The first case checks that each one syncs a file.
base_tools="mise git pre-commit dprint linter vscode _security_base gitleaks grype osv-scanner"

check_base_files() {
  local tool path found missing=''
  for tool in $base_tools; do
    found=0
    # The targets of the entries of the tool: [files."<target>"] and
    # [tasks."<path>"].
    while IFS= read -r path; do
      if grep -qF "would update $consumer/$path" "$log"; then
        found=1
        break
      fi
    done < <(sed -n -e 's/^\[files\."\(.*\)"\]$/\1/p' -e 's#^\[tasks\."\(.*\)"\]$#.config/mise/tasks/\1#p' \
      "$clone/repo/tools/$tool/tools.toml")
    # A tool without an entry ships no file, for example _security_base.
    grep -qE '^\[(files|tasks)\.' "$clone/repo/tools/$tool/tools.toml" || found=1
    ((found)) || missing+=" $tool"
  done
  if [[ -n $missing ]]; then
    print_error "base: no file listed for:$missing"
    failures=$((failures + 1))
  else
    print_success "base: a file of each tool listed"
  fi
  if grep -qF "conf.d/_base/" "$log"; then
    print_error "base: the output lists conf.d/_base/"
    failures=$((failures + 1))
  else
    print_success "base: no conf.d/_base/"
  fi
}

pack_loop() {
  printf '%s\n' '' '[pack.a]' '"pack:b" = { default = true }' '' '[pack.b]' '"pack:a" = { default = true }' \
    >> "$clone/repo/packs.toml"
}

pack_named_like_tool() {
  printf '%s\n' '' '[pack.node]' 'node = { default = true }' >> "$clone/repo/packs.toml"
}

node_needs_pulumi() {
  sed 's/^depends = \[\]$/depends = [ "pulumi" ]/' "$clone/repo/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/repo/tools/node/tools.toml"
}

node_prod() {
  sed 's/^default_envs = .*$/default_envs = [ "dev", "prod" ]/' "$clone/repo/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/repo/tools/node/tools.toml"
}

node_ci_only() {
  sed 's/^default_envs = .*$/default_envs = [ "ci" ]/' "$clone/repo/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/repo/tools/node/tools.toml"
}

tool_folder_zz_repo() {
  mkdir -p -- "$clone/repo/tools/zz-repo"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' \
    'root_only = false' > "$clone/repo/tools/zz-repo/tools.toml"
}

node_no_envs() {
  sed 's/^default_envs = .*$/default_envs = []/' "$clone/repo/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/repo/tools/node/tools.toml"
}

# A folder member below the root of the consumer.
member_folder() {
  mkdir -p -- "$consumer/projects/web"
}

late_tool_folder() {
  mkdir -p -- "$clone/repo/tools/zzz-late"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' \
    'root_only = false' > "$clone/repo/tools/zzz-late/tools.toml"
}

run_case "no [tools], environments dev" 0 'environments = [ "dev" ]' '' '' check_base_files
run_case "bootstrap_commit: a dry run names the commit of the clone" 0 'environments = [ "dev" ]' '' \
  "would set bootstrap_commit $(git -C "$clone" rev-parse HEAD)"
run_case "[tools.node] env dev, ci" 0 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "dev", "ci" ]'
run_case "tools = [\"node\"], the old list" 2 'environments = [ "dev" ]
tools = [ "node" ]' '' 'is a list, the old format'
run_case "a pack loop a -> b -> a" 2 'environments = [ "dev" ]
[packs.a]' pack_loop 'a pack loop: a -> b -> a'
run_case "a pack named like a tool folder" 2 'environments = [ "dev" ]
[packs.node]' pack_named_like_tool "pack 'node' is also a tool folder"
run_case "[tools.git.branch.main], the merge config of the repo" 0 'environments = [ "dev" ]
[tools.git.branch.main]
merge_model = "pr"
merge_never = [ "develop" ]'
run_case "[member.web], a folder below the root" 0 'environments = [ "dev" ]
[member.web]
folder = "projects/web"' member_folder
run_case "[member.nope], not a submodule or a folder" 2 'environments = [ "dev" ]
[member.nope]' '' '[member.nope] in'
run_case "[member.self], the folder of the repo itself" 2 'environments = [ "dev" ]
[member.self]
folder = "."' '' 'has the folder of the repo itself'
run_case "[member.web], type submodule without a submodule" 2 'environments = [ "dev" ]
[member.web]
folder = "projects/web"
type = "submodule"' member_folder 'has type submodule, but projects/web is not in .gitmodules'
run_case "[member.web], an unknown type" 2 'environments = [ "dev" ]
[member.web]
folder = "projects/web"
type = "repo"' member_folder "has the type 'repo'"
run_case "[packs.nope], an unknown pack" 3 'environments = [ "dev" ]
[packs.nope]' '' "pack 'nope' is not in bootstrap"
run_case "env ci on a tool whose mise tool allows dev only" 2 'environments = [ "dev", "ci" ]
[tools.pulumi]
env = [ "dev", "ci" ]' '' "mise tool 'pulumi' of repo/tools/pulumi allows only dev"
run_case "env ci not in environments dev" 2 'environments = [ "dev" ]
[tools.node]
env = [ "ci" ]' '' 'is not in environments: dev'
run_case "a dependency without the environment of its parent" 2 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "dev", "ci" ]' node_needs_pulumi \
  "repo/tools/node needs repo/tools/pulumi in 'ci', but its mise tool 'pulumi' allows only dev"
run_case "env ci without dev" 2 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "ci" ]' '' 'has no dev - each tool must be in dev, for example env = '
run_case "default_envs ci without dev" 2 'environments = [ "dev", "ci" ]
[tools.node]' node_ci_only 'default_envs of repo/tools/node/tools.toml has no dev'
run_case "default_envs with prod, outside dev and ci" 2 'environments = [ "dev" ]
[tools.node]' node_prod "default_envs of repo/tools/node/tools.toml: 'prod' is not one of dev, ci"
run_case "a tool folder that sorts after zz-repo" 2 'environments = [ "dev" ]' late_tool_folder \
  'tool folder repo/tools/zzz-late sorts after zz-repo'
run_case "a tool folder named zz-repo" 2 'environments = [ "dev" ]' tool_folder_zz_repo \
  'tool folder repo/tools/zz-repo sorts after zz-repo or is named zz-repo'
run_case "default_envs empty" 2 'environments = [ "dev" ]' node_no_envs \
  'default_envs of repo/tools/node/tools.toml has no dev'

# The consumer as a git submodule: a gitlink at its path in a superproject
# at the folder of the case.
consumer_submodule() {
  _git init --quiet "$tmp"
  _git -C "$tmp" update-index --add --cacheinfo "160000,$(git -C "$consumer" rev-parse HEAD),consumer"
}

check_no_vscode() {
  if grep -F 'bootstrap: tools:' "$log" | grep -qw vscode; then
    print_error "submodule: the tools include vscode"
    failures=$((failures + 1))
  else
    print_success "submodule: the tools do not include vscode"
  fi
}

run_case "a submodule skips vscode, a root_only tool of the pack base" 0 'environments = [ "dev" ]' \
  consumer_submodule '' check_no_vscode
run_case "a submodule with [tools.vscode], a root_only tool" 2 'environments = [ "dev" ]
[tools.vscode]' consumer_submodule "tool 'vscode' is for the root repository only"

# The generated java config already exists in the consumer, so the dry run
# shows its diff, with the override comments.
java_conf() {
  mkdir -p -- "$consumer/.config/mise/conf.d/java"
  printf '%s\n' '# x' > "$consumer/.config/mise/conf.d/java/mise.dev.toml"
  printf '%s\n' '# x' > "$consumer/.config/mise/conf.d/java/mise.ci.toml"
}

run_case "[overrides.mise.tools.java] version" 0 'environments = [ "dev" ]
[tools.java]
[overrides.mise.tools.java]
version = "21"' java_conf 'version = "21" # override: .config/bootstrap.toml'
run_case "[overrides.mise_env.ci] wins over [overrides.mise]" 0 'environments = [ "dev", "ci" ]
[tools.java]
[overrides.mise.tools.java]
version = "21"
[overrides.mise_env.ci.tools.java]
version = "17"' java_conf 'version = "17" # override: .config/bootstrap.toml'
run_case "[overrides.mise.tools.jav], an unknown mise tool" 2 'environments = [ "dev" ]
[tools.java]
[overrides.mise.tools.jav]
version = "21"' '' 'no selected tool has mise.tools.jav.version'
run_case "[overrides.mise.tools.java] without the java tool" 2 'environments = [ "dev" ]
[overrides.mise.tools.java]
version = "21"' '' 'no selected tool has mise.tools.java.version'
run_case "[overrides.mise.env], a key that no tool has" 2 'environments = [ "dev" ]
[tools.python]
[overrides.mise.env]
NEW_VAR = "1"' '' 'no selected tool has mise.env.NEW_VAR'
run_case "[overrides.mise.tools.java] envs" 2 'environments = [ "dev" ]
[tools.java]
[overrides.mise.tools.java]
envs = [ "dev" ]' '' 'the envs, the depends, the requires, the requires_found and the files of a mise tool cannot be overridden'
run_case "[overrides.tools.java], not mise or mise_env" 2 'environments = [ "dev" ]
[tools.java]
[overrides.tools.java]
version = "21"' '' 'the only keys of [overrides] are mise and mise_env'
run_case "[overrides.mise_env.ci] without ci in environments" 2 'environments = [ "dev" ]
[tools.java]
[overrides.mise_env.ci.tools.java]
version = "21"' '' ".config/bootstrap.toml: 'ci' is not in environments: dev"

# The `requires_found` of a mise tool: ruff and pyrefly of the python tool need
# a pyproject.toml. The generated python config already exists in the
# consumer, so the dry run shows its diff.
python_conf() {
  mkdir -p -- "$consumer/.config/mise/conf.d/python"
  printf '%s\n' '# x' > "$consumer/.config/mise/conf.d/python/mise.dev.toml"
}

pyproject_at() {
  python_conf
  mkdir -p -- "$consumer/$1"
  : > "$consumer/$1/pyproject.toml"
}
pyproject_root() { pyproject_at .; }
pyproject_depth4() { pyproject_at a/b/c/d; }
pyproject_depth5() { pyproject_at a/b/c/d/e; }
pyproject_ignored() {
  pyproject_at ignored
  printf '%s\n' '/ignored/' > "$consumer/.gitignore"
}

# check_log_lacks <name> <text>: the output of the last case must not have
# the fixed string <text>.
check_log_lacks() {
  if grep -qF -- "$2" "$log"; then
    print_error "$1: the output has: $2"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  else
    print_success "$1: no $2"
  fi
}

lacks_requires() { check_log_lacks "requires_found, a pyproject.toml at the root" 'requires_found'; }
lacks_ruff_depth5() { check_log_lacks "requires_found, a pyproject.toml 5 folders down" '[tools.ruff]'; }
lacks_ruff_ignored() { check_log_lacks "requires_found, a pyproject.toml in an ignored folder" '[tools.ruff]'; }

python_values='environments = [ "dev" ]
[tools.python]'
run_case "requires_found, a pyproject.toml at the root" 0 "$python_values" pyproject_root '[tools.ruff]' lacks_requires
run_case "requires_found, a pyproject.toml 4 folders down" 0 "$python_values" pyproject_depth4 \
  '[tools."pipx:pyrefly"]'
run_case "requires_found, a pyproject.toml 5 folders down" 0 "$python_values" pyproject_depth5 '[tools.uv]' \
  lacks_ruff_depth5
run_case "requires_found, a pyproject.toml in an ignored folder" 0 "$python_values" pyproject_ignored '[tools.uv]' \
