  check_that "add pack --exclude pack:extra: no table of java" not_grep 'java' "$tools_values"
}
ADD_PACK_ARGS='outer --exclude pack:extra' CASE_CALL=add_pack_args run_case "add pack --exclude of a nested pack" 0 \
  "$dev_values" packs_outer 'Synced: ' check_add_pack_no_nested
check_add_pack_nested_member() {
  check_that "add pack --exclude of a member of a nested pack: no table of java" not_grep 'java' "$tools_values"
  check_that "add pack --exclude of a member of a nested pack: the table of pulumi" tomlq '.tools | has("pulumi")'
}
ADD_PACK_ARGS='outer --exclude java' CASE_CALL=add_pack_args run_case "add pack --exclude of a member of a nested pack" \
  0 "$dev_values" packs_outer 'Synced: ' check_add_pack_nested_member
check_add_pack_kept() { check_that "add pack: the values file stays" not_grep 'pulumi' "$tools_values"; }
ADD_PACK_ARGS='extra --exclude nope' CASE_CALL=add_pack_args run_case "add pack --exclude of a name that is not a member" \
  2 "$dev_values" packs_extra 'nope is not a member of the pack extra' check_add_pack_kept
ADD_PACK_ARGS='base --exclude mise' CASE_CALL=add_pack_args run_case "add pack --exclude of a required member" 2 \
  "$dev_values" '' 'mise is required in the pack base, so add pack cannot exclude it'
ADD_PACK_ARGS='extra outer --exclude java' CASE_CALL=add_pack_args run_case "add pack of two packs with --exclude" 2 \
