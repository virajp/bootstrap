  check_that "links: the folder link stays" link_is "$consumer/linked" "$tmp/outside"
  check_that "links: the file link stays" link_is "$consumer/link.txt" "$tmp/outside/stale.txt"
}
run_case "the stale rule, listed links, a dry run" 0 "$no_tool_values" stale_links '' check_stale_links
case_args=' ' run_case "the stale rule, listed links, a real run" 0 "$no_tool_values" stale_links '' check_stale_links

# The rows of a real run. A second run does not write the manifest again.
manifest_rows_sorted() { tail -n +2 -- "$consumer/.config/bootstrap/repo-generated.tsv" | LC_ALL=C sort -c; }
