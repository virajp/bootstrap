# The landing of [branches.<b>] in repo.toml, and the args of the
# no-commit-to-branch hook: the git derive script gives the protected
# branches, each core branch without landing = "direct-commit". Each case
# syncs for real and reads the hook. The consumer has main; a case adds
# develop, or renames main to develop.
precommit_both_branches() { _git -C "$consumer" branch develop; }
precommit_develop_branch() { _git -C "$consumer" branch -m main develop; }
# The own hook block and the own key of the repository stay in the file.
precommit_own() {
  mkdir -p -- "$consumer/.config"
  printf '%s\n' '# own comment' 'own_key: 1' 'repos:' '  - repo: https://example.com/own-hooks' '    rev: v1.0.0' \
    '    hooks:' '      - id: own' > "$consumer/.config/pre-commit-config.yaml"
}
old_precommit_file() {
  mkdir -p -- "$consumer/.config/repo-sync"
  printf '%s\n' '- repo: https://example.com/own-hooks' > "$consumer/.config/repo-sync/pre-commit.yaml"
}
# hook_args: the args of the no-commit-to-branch hook, on one line.
hook_args() {
  mise x yq@latest -- yq '[.repos[].hooks[] | select(.id == "no-commit-to-branch") | .args[]] | join(" ")' \
    "$consumer/.config/pre-commit-config.yaml" 2> /dev/null
}
expect_hook() {
  local got
  got=$(hook_args) || got=''
  if [[ $got == "$2" ]]; then
    print_success "$1: the hook args are '$2'"
  else
    print_error "$1: the hook args are '$got', expected '$2'"
    failures=$((failures + 1))
  fi
}
hook_both() { expect_hook "the protected branches, no landing" "--branch main --branch develop"; }
hook_main_only() { expect_hook "the protected branches, main only, no landing" "--branch main"; }
hook_main() { expect_hook "the protected branches, develop direct-commit" "--branch main"; }
hook_none() { expect_hook "the protected branches, each one direct-commit" ""; }
own_hook_stays() {
  local f="$consumer/.config/pre-commit-config.yaml"
  if grep -qF 'example.com/own-hooks' "$f" && grep -qxF 'own_key: 1' "$f" && grep -qxF '# own comment' "$f"; then
    print_success "the own hook block, key and comment stay"
  else
    print_error "the own hook block, key or comment is gone"
    sed 's/^/    /' "$f" >&2
    failures=$((failures + 1))
  fi
  hook_main_only
}

