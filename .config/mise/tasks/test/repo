# Shared files (mode = "merge"). test:mac and the Go tests cover each
# kind of item; these cases cover the rules of the repo side: the manifest
# rows, the mode, requires, symlinks and the config errors.
# merge_spec <name> <line>...: a spec below files/ of the tool fixture.
merge_spec() {
  local name=$1
  shift
  mkdir -p -- "$(dirname -- "$clone/repo/tools/fixture/files/$name")"
  printf '%s\n' "$@" > "$clone/repo/tools/fixture/files/$name"
}
merge_tool() {
  fixture_tool
  merge_spec m.json.merge.toml '[[item]]' 'kind = "keys"' 'value = { scalar = "src", nested = { set = 1 } }' \
    '[[item]]' 'kind = "item"' 'path = [ "list" ]' 'value = "b"' \
    '[[item]]' 'kind = "key"' 'path = [ "gone" ]' '"$mode" = "remove"'
  fixture_toml '[files.".config/merger/m.json"]' 'mode = "merge"' 'source = "m.json.merge.toml"'
}
# live <ext> <content>: a live shared file.
live() {
  mkdir -p -- "$consumer/.config/merger"
  printf '%s' "$2" > "$consumer/.config/merger/m.$1"
}
m_file() { printf '%s' "$consumer/.config/merger/m.$1"; }
# json_is <path> <json>: the file holds the JSON value <json>.
# On a mismatch, the log gets the file, so the failure shows it.
json_is() {
  local got want
  got=$(mise x jq@latest -- jq -cS . "$1" 2>&1) || got="(no JSON) $got"
  want=$(mise x jq@latest -- jq -cS . <<< "$2")
  [[ $got == "$want" ]] && return 0
  printf '%s\n' "$1 holds: $got" "expected: $want" >> "$log"
  return 1
}

merge_json_live() {
  merge_tool
  live json '{"keep": 1, "scalar": "app", "list": ["x"], "gone": true}'
}
check_merge_json() {
  local f got=0
  f=$(m_file json)
  check_that "merge: a found key keeps its value, new items are added, a removed key goes" \
    json_is "$f" '{"keep": 1, "scalar": "app", "list": ["x", "b"], "nested": {"set": 1}}'
  check_that "merge: the manifest records an added item" \
    grep -qF "fixture${tab}.config/merger/m.json${tab}{\"kind\":\"item\",\"path\":[\"list\"],\"value\":\"b\"}" \
    "$consumer/.config/repo-generated.tsv"
  check_that "merge: the manifest does not record a found key" \
    lacks_in_file '"path":["scalar"]' "$consumer/.config/repo-generated.tsv"
  case_rerun || got=$?
  check_that "merge: a second run exits 0" test "$got" = 0
  check_that "merge: a second run writes nothing" log_lacks "updated    $f"
}

merge_absent() { merge_tool; }
check_merge_absent() {
  check_that "merge absent: the items are written" \
    json_is "$(m_file json)" '{"scalar": "src", "nested": {"set": 1}, "list": ["b"]}'
}

# The spec drops an item that bootstrap added before: the next run removes it.
merge_cleanup() {
  merge_tool
  live json '{"list": ["x", "b"]}'
  manifest_file "fixture${tab}.config/merger/m.json${tab}{\"kind\":\"item\",\"path\":[\"list\"],\"value\":\"b\"}" \
    "fixture${tab}.config/merger/m.json${tab}{\"kind\":\"item\",\"path\":[\"list\"],\"value\":\"old\"}"
  live json '{"list": ["x", "b", "old"]}'
}
check_merge_cleanup() {
  check_that "merge cleanup: the item that no spec has now goes" \
    json_is "$(m_file json)" '{"list": ["x", "b"], "scalar": "src", "nested": {"set": 1}}'
  check_that "merge cleanup: its row goes" lacks_in_file '"value":"old"' "$consumer/.config/repo-generated.tsv"
