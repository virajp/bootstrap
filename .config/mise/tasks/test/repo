  check_that "a pack: no table of its member" not_grep 'pulumi' "$tools_values"
}
run_case "a pack is not a selection" 0 "$dev_values" packs_extra '' check_extra_not_selected
check_add_pack_extra() {
  check_that "add pack extra: the table of java" tomlq '.tools | has("java")'
  check_that "add pack extra: the table of pulumi" tomlq '.tools | has("pulumi")'
  check_that "add pack extra: no table of a pack" not_grep '^\[packs\.' "$tools_values"
}
ADD_PACK_ARGS=extra CASE_CALL=add_pack_args run_case "add pack extra" 0 "$dev_values" packs_extra 'Synced: ' \
  check_add_pack_extra
check_add_pack_exclude() {
  check_that "add pack --exclude: no table of java" not_grep 'java' "$tools_values"
  check_that "add pack --exclude: the table of pulumi" tomlq '.tools | has("pulumi")'
}
ADD_PACK_ARGS='extra --exclude java' CASE_CALL=add_pack_args run_case "add pack extra --exclude java" 0 "$dev_values" \
  packs_extra 'Synced: ' check_add_pack_exclude
check_add_pack_again() {
  check_that "add pack again: java keeps its env" tomlq '.tools.java.env[0] == "dev"'
  check_that "add pack again: the table of pulumi" tomlq '.tools | has("pulumi")'
}
ADD_PACK_ARGS=extra CASE_CALL=add_pack_args run_case "add pack again adds only the members that are not selected" 0 \
  "$dev_values
[tools.java]
env = [ \"dev\" ]" packs_extra 'Synced: ' check_add_pack_again
check_add_pack_nested() {
  check_that "add pack outer: the table of go" tomlq '.tools | has("go")'
  check_that "add pack outer: the nested pack: java" tomlq '.tools | has("java")'
  check_that "add pack outer: the nested pack: pulumi" tomlq '.tools | has("pulumi")'
}
ADD_PACK_ARGS=outer CASE_CALL=add_pack_args run_case "add pack: a nested pack" 0 "$dev_values" packs_outer 'Synced: ' \
  check_add_pack_nested
check_add_pack_no_nested() {
