# count_of <label>: the count of the kind <label> in the last line of the plain
# output. The kind `changed` is the headline count minus the other kinds in it.
count_of() {
  local last n
  last=$(tail -n 1 -- "$log")
  if [[ $1 == changed ]]; then
    n=$(sed -nE 's/^\[[A-Z]+\] (Synced|Dry run): ([0-9]+) files?.*/\2/p' <<< "$last")
    [[ -n $n ]] || n=0
    n=$((n - $(count_of new) - $(count_of seeded) - $(count_of removed)))
    echo "$n"
    return
  fi
  n=$(sed -nE "s/.* · ([0-9]+) $1( .*)?\$/\1/p" <<< "$last")
  echo "${n:-0}"
}
count_is() { [[ $(count_of "$1") == "$2" ]]; }
# The last line is one line: no table.
no_table() { ! grep -qE '^\| |^\+---' "$log"; }
log_line() { grep -qxF -- "$1" "$log"; }
