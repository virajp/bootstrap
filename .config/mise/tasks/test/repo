# A template of the mise tool that prints .cli_dir. The consumer
# already has its output file, so the dry run shows its diff.
cli_dir_template() {
  local path=.config/cli-dir-path
  mkdir -p -- "$clone/repo/tools/mise/.config"
  {
    printf '%s\n' "# Synced from bootstrap: repo/tools/mise/$path.tmpl. Do not edit this file."
    printf '%s\n' '# The next sync writes it again, and each change in this file is lost.'
    printf '%s\n' '<% .cli_dir %>'
  } > "$clone/repo/tools/mise/$path.tmpl"
  printf '%s\n' x > "$consumer/$path"
}
check_cli_dir() {
  if grep -qE '^\+.*/cli$' "$log"; then
    print_success "the template context has cli_dir: the path of the copy"
  else
    print_error "the template context has cli_dir: no line ends in /cli"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}
run_case "the template context has cli_dir" 0 'environments = [ "dev" ]' cli_dir_template '' check_cli_dir

# The tool `fixture` of the scratch clone. A case selects it with
# [tools.fixture].
fixture_values='environments = [ "dev" ]
[tools.fixture]'
fixture_tool() {
  mkdir -p -- "$clone/repo/tools/fixture"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' \
    'root_only = false' > "$clone/repo/tools/fixture/tools.toml"
}
# fixture_file <path> [<line>...]: a file of the tool, with these lines.
fixture_file() {
  local path=$1
  shift
  printf '%s\n' "$@" > "$clone/repo/tools/fixture/$path"
}
# The bootstrap header of <path> with the comment marker <marker>, in `header`.
fixture_header() {
  header=("$2 Synced from bootstrap: repo/tools/fixture/$1. Do not edit this file."
    "$2 The next sync writes it again, and each change in this file is lost.")
}

# A JSON file cannot have the header without becoming JSONC, so the bad JSON
# template and the empty one have none.
fixture_bad_json() {
  fixture_tool
  fixture_file bad.json.tmpl '{"a": }'
  printf '%s\n' '{"known": true}' > "$consumer/bad.json"
}
fixture_bad_yaml() {
  local header
  fixture_tool
  fixture_header bad.yaml '#'
  fixture_file bad.yaml "${header[@]}" 'a: ['
}
fixture_bad_toml() {
  local header
  fixture_tool
  fixture_header bad.toml '#'
  fixture_file bad.toml "${header[@]}" 'a = '
}
fixture_empty_json() {
  fixture_tool
  : > "$clone/repo/tools/fixture/empty.json.tmpl"
}
fixture_jsonc() {
  local header
  fixture_tool
  fixture_header ok.json '  //'
  fixture_file ok.json '{' "${header[@]}" '  "a": 1,' '}'
}
fixture_bad_and_good() {
  local header
  fixture_bad_json
  fixture_header good.txt '#'
  fixture_file good.txt "${header[@]}" 'good'
}

check_bad_json_kept() {
  if [[ $(cat -- "$consumer/bad.json") == '{"known": true}' ]]; then
    print_success "a JSON template that does not parse: the current file stays"
  else
    print_error "a JSON template that does not parse: bad.json changed"
    failures=$((failures + 1))
  fi
}
check_good_written() {
  if grep -qxF 'good' "$consumer/good.txt" 2> /dev/null; then
    print_success "one bad file does not stop the others: the good file is written"
  else
    print_error "one bad file does not stop the others: the good file is not written"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}

case_args=' ' run_case "a JSON template that does not parse" 2 "$fixture_values" fixture_bad_json \
