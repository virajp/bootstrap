# The helpers of the cases of the [files] tables and of merge mode.
# check_that <name> <command>...: the command must pass.
check_that() {
  local name=$1
  shift
  if "$@"; then
    print_success "$name"
  else
    print_error "$name"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}
# log_count <text> <n>: the output has <n> lines with the fixed string <text>.
log_count() { [[ $(grep -cF -- "$1" "$log") == "$2" ]]; }
lacks_in_file() { ! grep -qF -- "$1" "$2"; }
no_file() { [[ ! -e $1 ]]; }
mode_is() { [[ $(stat -c %a -- "$2" 2> /dev/null || stat -f %Lp -- "$2") == "$1" ]]; }
# check_file <name> <path> <content>: the file holds <content>, without the
# newlines at the end.
check_file() {
  if [[ -f $2 && $(cat -- "$2") == "$3" ]]; then
    print_success "$1"
  else
    print_error "$1: $2 is not the expected file"
    sed 's/^/    /' "$2" >&2
    failures=$((failures + 1))
  fi
}
# check_exact <name> <path> <content>: the file holds <content>, byte for byte.
check_exact() {
  local got
  got=$(
    cat -- "$2"
    printf x
  ) || got=''
  if [[ $got == "$3x" ]]; then
    print_success "$1"
  else
    print_error "$1: $2 changed"
    sed 's/^/    /' "$2" >&2
    failures=$((failures + 1))
  fi
}
# case_rerun: run the engine again in the case. The log gets its output.
case_rerun() {
  (
    unset FORCE_COLOR BOOTSTRAP_URL
    export BOOTSTRAP_VALUES=$values MISE_PROJECT_ROOT=$consumer BOOTSTRAP_CLONE=$clone
    export BOOTSTRAP_CACHE=$tmp/cache
    [[ -n ${CASE_DIRTY:-} ]] || commit_consumer
    "$bin" sync "$@"
  ) > "$log" 2>&1
}

