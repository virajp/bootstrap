# The examples of repo/examples/. Each folder with a repo.toml is the values
# folder of a repository, with its tools.toml next to it. Each one must pass a
# dry run in a consumer with its core branches and its members: a folder for
# each folder member, and a git submodule for each submodule member. A sibling
# member is not there, so the sync skips it with an info line. The dry run
# refuses an unknown key, an unknown tool, a wrong member and a wrong shape.
example_consumer() {
  local name type folder branch
  rm -rf -- "$values"
  mkdir -p -- "$values"
  cp -- "$root/repo/examples/${case_example:?}/repo.toml" "$root/repo/examples/$case_example/tools.toml" "$values/"
  while IFS= read -r branch; do
    [[ -z $branch ]] || git -C "$consumer" rev-parse --verify --quiet "refs/heads/$branch" > /dev/null ||
      _git -C "$consumer" branch "$branch"
  done < <(mise x -- yq -p toml -o tsv '.core_branches // [] | .[]' "$repo_values")
  while IFS=$'\t' read -r name type folder; do
    folder=${folder:-$name}
    if [[ $type == submodule ]]; then
      _git -C "$consumer" -c protocol.file.allow=always submodule --quiet add -- "$base_clone" "$folder"
    elif [[ $type == folder ]]; then
      mkdir -p -- "$consumer/$folder"
    fi
  done < <(mise x -- yq -p toml -o tsv '.members // {} | to_entries | .[] | [.key, .value.type // "", .value.folder // ""]' "$repo_values")
}
while IFS= read -r example; do
  case_example=$example run_case "the example $example" 0 '' example_consumer
done < <(cd -- "$root/repo/examples" && find . -name repo.toml | sed -e 's#^\./##' -e 's#/repo\.toml$##' | LC_ALL=C sort)

