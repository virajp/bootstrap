# The test ports (D2, D3, D4, D7, D8, D12, D15, D18, D20, D21, D26): the
# dispatchers test, test:e2e and test:golden, their NN- parts, and the init
# move of a repo's own test task to <group>/50-local.
tasks_dir=.config/mise/tasks
# own_task <path> [<line>...]: an executable task of the repo of the case
# below .config/mise/tasks/, with these lines after the shebang.
own_task() {
  local file=$consumer/$tasks_dir/$1
  shift
  mkdir -p -- "$(dirname -- "$file")"
  printf '%s\n' '#!/usr/bin/env bash' "$@" > "$file"
  chmod +x "$file"
}
# consumer_mise <task> [<arg>...]: mise run in the consumer of the case, as a
# user runs it there, without the mise variables of this task. The log gets
# its output.
consumer_mise() {
  (
    unset MISE_ENV MISE_ORIGINAL_CWD MISE_TASK_NAME MISE_TASK_DIR MISE_TASK_FILE MISE_CONFIG_ROOT FORCE_COLOR
    cd -- "$consumer"
    MISE_PROJECT_ROOT=$consumer mise run "$@"
  ) > "$log" 2>&1
}
# case_engine <command> [<arg>...]: the engine again in the case, after a
# commit of the consumer. The log gets its output.
case_engine() {
  (
    unset FORCE_COLOR BOOTSTRAP_URL
    export BOOTSTRAP_VALUES=$values MISE_PROJECT_ROOT=$consumer BOOTSTRAP_CLONE=$clone
    export BOOTSTRAP_CACHE=$tmp/cache
    commit_consumer
    "$bin" "$@"
  ) > "$log" 2>&1
}
is_dispatcher() { grep -qF "own_tasks $1" "$consumer/$tasks_dir/${1//://}/_default"; }
check_ports_empty() {
  local port got
  for port in test test:e2e test:golden; do
    check_that "the test ports: init writes the dispatcher of $port" is_dispatcher "$port"
    got=0
    consumer_mise "$port" || got=$?
    check_that "the test ports: mise run $port with no part exits 0" test "$got" = 0
    check_that "the test ports: mise run $port with no part prints the line" \
      log_has "No $port part in this repository"
  done
}
CASE_CALL=init_new run_case "the test ports: init writes the three dispatchers" 0 "$dev_values" '' 'Synced: ' \
  check_ports_empty
ports_parts() {
  own_task test/10-a 'echo part-test-a'
  own_task test/b 'echo part-test-b'
  own_task test/e2e/10-a 'echo part-e2e-a'
}
check_ports_parts() {
  local got=0
  consumer_mise test || got=$?
  check_that "the test ports: mise run test exits 0" test "$got" = 0
  check_that "the test ports: mise run test runs test:10-a" log_has 'part-test-a'
  check_that "the test ports: mise run test skips test:b, no NN- name" log_lacks 'part-test-b'
  check_that "the test ports: mise run test does not run test:e2e:10-a (D3)" log_lacks 'part-e2e-a'
  got=0
  consumer_mise test:e2e || got=$?
  check_that "the test ports: mise run test:e2e exits 0" test "$got" = 0
  check_that "the test ports: mise run test:e2e runs test:e2e:10-a" log_has 'part-e2e-a'
}
