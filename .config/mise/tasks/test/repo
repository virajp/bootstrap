cp -- "$root/repo/tools/mise/tasks/helpers" "$members_root/.config/mise/tasks/_scripts/helpers"
export FAKE_MEMBERS='{"sub":{"folder":"sub","type":"submodule"}}'

# run_configs: the task, with the fake engine. CONFIGS_BIN=path runs the fake
# engine as `bootstrap` of PATH, without BOOTSTRAP_BIN.
run_configs() {
  local bin_env=(BOOTSTRAP_BIN="$tmp/bin/bootstrap")
  [[ ${CONFIGS_BIN:-} != path ]] || bin_env=(-u BOOTSTRAP_BIN)
  rm -f -- "$tmp/synced"
  env "${bin_env[@]}" MISE_PROJECT_ROOT="$members_root" PATH="$tmp/bin:$yq_dir:$PATH" \
    SYNC_OUT="$tmp/synced" SYNC_ROOT="$members_root" bash "$task" > "$log" 2>&1
}

# check_configs <name> <want> <got> <lines>: the exit code, and the calls of
# the fake engine.
check_configs() {
  local synced=''
  synced=$(cat -- "$tmp/synced" 2> /dev/null) || synced=''
  if [[ $3 != "$2" ]]; then
    print_error "$1: exit $3, expected $2"
  elif [[ $synced != "$4" ]]; then
    print_error "$1: synced '${synced}', expected '$4'"
  else
    print_success "$1: exit $3"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
}

# check_configs_log <name> -h|-l <text>: the output of the last run has (-h) or
# lacks (-l) the fixed string.
check_configs_log() {
  local found=0
  grep -qF -- "$3" "$log" && found=1
  if [[ $2 == -h && $found == 1 || $2 == -l && $found == 0 ]]; then
    print_success "$1: the output"
  else
    print_error "$1: the check $2 of the output fails for: $3"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}

