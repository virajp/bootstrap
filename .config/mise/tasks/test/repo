# setup:configs runs `bootstrap sync` for the root, then for each selected
# submodule. A fake engine, through BOOTSTRAP_BIN, records each call: the folder
# below the root and the flag. It fails when it does not run in the folder of
# MISE_PROJECT_ROOT. The task is rendered with one submodule `sub`.
task="$tmp/setup-configs"
printf '{"members":["sub"],"member_types":{"sub":"submodule"},"member_folders":{"sub":"sub"},"sync_engine":"%s/sync-engine"}\n' "$root" > "$tmp/ctx.json"
gomplate --left-delim '<%' --right-delim '%>' -c ".=$tmp/ctx.json" \
  -f "$root/repo/tools/mise/tasks/setup-configs.tmpl" -o "$task"
mkdir -p -- "$tmp/bin"
cat > "$tmp/bin/bootstrap" << 'EOF'
#!/usr/bin/env bash
[[ ${1:-} == sync && $(pwd -P) == "$(cd -- "$MISE_PROJECT_ROOT" && pwd -P)" ]] || exit 1
sub=${MISE_PROJECT_ROOT#"$SYNC_ROOT"}
sub=${sub#/}
printf '%s\n' "sync${sub:+ $sub}${2:+ $2}" >> "$SYNC_OUT"
[[ -z ${SYNC_FAIL:-} || ${SYNC_FAIL_IN:-$sub} != "$sub" ]] || exit "$SYNC_FAIL"
EOF
chmod +x "$tmp/bin/bootstrap"

# The member `sub` is a folder of a scratch root.
members_root="$tmp/members"
mkdir -p -- "$members_root/.config/mise/tasks/_scripts" "$members_root/sub"
cp -- "$root/.config/mise/tasks/_scripts/helpers" "$members_root/.config/mise/tasks/_scripts/helpers"

# run_configs: the task, with the fake engine. CONFIGS_BIN=path runs the fake
# engine as `bootstrap` of PATH, without BOOTSTRAP_BIN.
run_configs() {
  local bin_env=(BOOTSTRAP_BIN="$tmp/bin/bootstrap")
  [[ ${CONFIGS_BIN:-} != path ]] || bin_env=(-u BOOTSTRAP_BIN)
  rm -f -- "$tmp/synced"
  env "${bin_env[@]}" MISE_PROJECT_ROOT="$members_root" PATH="$tmp/bin:$PATH" \
    SYNC_OUT="$tmp/synced" SYNC_ROOT="$members_root" bash "$task" > "$log" 2>&1
}

# check_configs <name> <want> <got> <lines>: the exit code, and the calls of
# the fake engine.
check_configs() {
  local synced=''
  synced=$(cat -- "$tmp/synced" 2> /dev/null) || synced=''
  if [[ $3 != "$2" ]]; then
    print_error "$1: exit $3, expected $2"
  elif [[ $synced != "$4" ]]; then
    print_error "$1: synced '${synced}', expected '$4'"
  else
    print_success "$1: exit $3"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
}

got=0
run_configs || got=$?
check_configs "setup:configs without a member flag" 0 "$got" "sync"

got=0
CONFIGS_BIN=path run_configs || got=$?
check_configs "setup:configs runs bootstrap of PATH" 0 "$got" "sync"

