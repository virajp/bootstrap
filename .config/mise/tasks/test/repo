# setup:configs runs `bootstrap sync` for the root, then for each selected
# member. A fake engine, through BOOTSTRAP_BIN, records each call: the folder
# below the root, the flag, and the member name of BOOTSTRAP_MEMBER. It fails
# when it does not run in the folder of MISE_PROJECT_ROOT, or when a member
# sync has no BOOTSTRAP_HOME of the root. It answers `config get repo.members`
# with the members of FAKE_MEMBERS. The task is rendered with one submodule
# `sub` that has a [members.sub] table.
task="$tmp/setup-configs"
printf '{"members":["sub"],"member_tables":["sub"],"member_types":{"sub":"submodule"},"member_folders":{"sub":"sub"},"cli_dir":"%s/cli"}\n' "$root" > "$tmp/ctx.json"
