# The packs model: each member of a pack is a default, and a pack is a
# shortcut of add (D2, D4). A change function appends to, or rewrites, the
# packs of the scratch clone. The sync examines each pack of the file.
packs_lines() { printf '%s\n' '' "$@" >> "$clone/repo/packs.toml"; }
packs_old_depends() { packs_lines '[pack.odd]' 'depends = [ "p:security" ]'; }
packs_old_required() { packs_lines '[pack.odd]' 'required = [ "_security_base" ]'; }
packs_old_tools() { packs_lines '[pack.odd]' 'tools = [ "node" ]'; }
packs_old_default() { packs_lines '[pack.odd]' 'default = [ "node" ]'; }
packs_old_prefix() { packs_lines '[pack.odd]' '"p:x" = {}'; }
packs_entry_key() { packs_lines '[pack.odd]' 'node = { version = "1" }'; }
packs_default_true() { packs_lines '[pack.odd]' 'node = { default = true }'; }
packs_required_outside_base() { packs_lines '[pack.odd]' 'node = { required = true }'; }
packs_member_string() { packs_lines '[pack.odd]' 'node = "x"'; }
packs_empty_loop() { packs_lines '[pack.x]' '"pack:y" = {}' '' '[pack.y]' '"pack:x" = {}'; }
packs_unknown_tool() { packs_lines '[pack.odd]' 'nope = {}'; }
packs_unknown_pack() { packs_lines '[pack.odd]' '"pack:nope" = {}'; }
packs_two_lines() { packs_lines '[pack.odd]' 'node = {' '}'; }
packs_subtable() { packs_lines '[pack.odd.node]'; }

old_format='is the old format - write each member as <tool> = {}'
run_case "[pack.*], the old depends" 2 "$no_tool_values" packs_old_depends \
  "repo/packs.toml: [pack.odd] depends $old_format"
run_case "[pack.*], the old required" 2 "$no_tool_values" packs_old_required \
  "repo/packs.toml: [pack.odd] required $old_format"
run_case "[pack.*], the old tools" 2 "$no_tool_values" packs_old_tools \
  "repo/packs.toml: [pack.odd] tools $old_format"
run_case "[pack.*], the old default list" 2 "$no_tool_values" packs_old_default \
  "repo/packs.toml: [pack.odd] default $old_format"
run_case "[pack.*], a key with the old prefix p:" 2 "$no_tool_values" packs_old_prefix \
  'repo/packs.toml: [pack.odd] "p:x" is the old form - write "pack:x" = {}'
run_case "[pack.*], an entry key other than required" 2 "$no_tool_values" packs_entry_key \
  "repo/packs.toml: [pack.odd] node has the entry key 'version' - a member is {}, or { required = true } in pack base"
run_case "[pack.*], the key default" 2 "$no_tool_values" packs_default_true \
  "repo/packs.toml: [pack.odd] node has the entry key 'default', the old form - each member is a default: write node = {}"
run_case "[pack.*], required = true in a pack other than base" 2 "$no_tool_values" packs_required_outside_base \
  'repo/packs.toml: [pack.odd] node: required = true is only for a tool of pack base'
run_case "[pack.*], a member that is a string" 2 "$no_tool_values" packs_member_string \
  'repo/packs.toml: [pack.odd] node must be a table, {} or { required = true }'
run_case "[pack.*], a loop through nested packs" 2 "$no_tool_values" packs_empty_loop \
  'repo/packs.toml: a pack loop: x -> y -> x'
run_case "[pack.*], an unknown tool in a pack" 3 "$no_tool_values" packs_unknown_tool \
  "nope is not a bootstrap tool (named in pack odd)"
run_case "[pack.*], an unknown pack in a pack" 3 "$no_tool_values" packs_unknown_pack \
  "nope is not a bootstrap pack (named in pack odd)"
run_case "[pack.*], a member on two lines" 2 "$no_tool_values" packs_two_lines \
  'repo/packs.toml: [pack.odd] node must be on one line'
run_case "[pack.*], a member as its own table" 2 "$no_tool_values" packs_subtable \
  'repo/packs.toml: [pack.odd] node must be on one line'

# tools_has <tool>: the `tools:` line of the output has the tool.
tools_has() { grep -F 'bootstrap: tools:' "$log" | grep -qw -- "$1"; }
tools_lacks() { ! tools_has "$1"; }

# add pack: a table for each member that is not selected and for its new
# dependencies; --exclude leaves out a member (D2, D16 e, D17 f). The members
# of the pack extra are outside the pack base and its depends. No tool is
# selected by a pack only: a sync of a values file without their tables does
# not select them.
packs_extra() { packs_lines '[pack.extra]' 'java = {}' 'pulumi = {}'; }
packs_outer() { packs_extra && packs_lines '[pack.outer]' 'go = {}' '"pack:extra" = {}'; }
packs_flutter() { packs_lines '[pack.mobile]' 'flutter = {}' 'android = {}' 'go = {}'; }
add_pack() { synced && "$bin" add pack --yes "$@"; }
add_pack_args() {
  # shellcheck disable=SC2086
  add_pack $ADD_PACK_ARGS
}
check_extra_not_selected() {
