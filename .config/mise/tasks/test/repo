# The manifest is a file of the consumer, so the engine does not trust its rows.
stale_bad_rows() {
  printf '%s\n' '# Synced from bootstrap: x. Do not edit this file.' \
    | tee "$tmp/outside.txt" "$tmp/abs.txt" "$consumer/notab.txt" > /dev/null
  manifest_file "x${tab}../outside.txt" "x${tab}$tmp/abs.txt" notab.txt "${tab}notab.txt" "x${tab}" \
