# Contributed merge items (D1, D7, D11, D17, D32): virajp-plugins adds the vwf
# lines to the .gitignore of the git tool. The cases sync for real and read the
# written .gitignore.
vwf_lines=(docs/memory/handoff/ docs/memory/doctor/ docs/memory/runs/ docs/scratchpad/ '!docs/plans/**/*.log')
# gitignore_count <line> <n>: the .gitignore of the consumer has <n> lines <line>.
gitignore_count() { [[ $(grep -cxF -- "$1" "$consumer/.gitignore") == "$2" ]]; }
check_vwf_lines_once() {
  local line
  for line in "${vwf_lines[@]}"; do
    check_that "virajp-plugins: .gitignore has $line once" gitignore_count "$line" 1
  done
  check_that "virajp-plugins: the vwf lines after the lines of git" awk -v first="${vwf_lines[0]}" '
    $0 == "*.log" { git = NR } $0 == first { vwf = NR } END { exit !(git && vwf > git) }' "$consumer/.gitignore"
}
check_vwf_lines_none() {
  local line
  for line in "${vwf_lines[@]}"; do
    check_that "no virajp-plugins: .gitignore lacks $line" gitignore_count "$line" 0
  done
  check_that "no virajp-plugins: .gitignore keeps *.log" gitignore_count '*.log' 1
}
check_vwf_line_removed() {
  check_that "a vwf line with \$mode = remove: docs/scratchpad/ is gone" gitignore_count docs/scratchpad/ 0
  check_that "a vwf line with \$mode = remove: the other lines stay" gitignore_count docs/memory/runs/ 1
}
