# The values of the tools. A template prints `.config` and `.all` with the name of
# its tool. The consumer already has its output file, so the dry run shows its diff.
value_template() {
  printf '%s\n' "$1 config=<% .config | data.ToJSON %>" "$1 all=<% .all | data.ToJSON %>" \
    > "$clone/repo/tools/$1/$1.txt.tmpl"
  printf '%s\n' x > "$consumer/$1.txt"
}
# value_tool <tool> [<line>...]: a new tool with the template, and these lines at
# the end of its tools.toml.
value_tool() {
  local tool=$1
  shift
  mkdir -p -- "$clone/repo/tools/$tool"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' 'root_only = false' "$@" \
    > "$clone/repo/tools/$tool/tools.toml"
  value_template "$tool"
}
# value_list <tool>: a tool of the clone with the template and a default list.
value_list() {
  printf '%s\n' '' '[defaults]' 'items = [ "a" ]' >> "$clone/repo/tools/$1/tools.toml"
  value_template "$1"
}
value_needs_vdep() {
  sed 's/^depends = \[\]$/depends = [ "vdep" ]/' "$clone/repo/tools/vtest/tools.toml" > "$tmp/vtest.toml"
  cp -- "$tmp/vtest.toml" "$clone/repo/tools/vtest/tools.toml"
}

values_defaults() { value_tool vtest '[defaults]' 'key = "default"'; }
values_contribution() {
  value_tool vtest '[defaults]' 'items = [ "a" ]' 'key = "default"'
  value_tool vother '[contributes.vtest]' 'items = [ "b" ]' 'key = "other"'
}
values_conflict() {
  values_contribution
  value_tool vthird '[contributes.vtest]' 'key = "third"'
}
values_unknown() { value_tool vother '[contributes.nope]' 'key = "x"'; }
values_linter() { value_list linter; }
values_vdep() {
  value_tool vtest
  value_needs_vdep
  value_tool vdep '[defaults]' 'items = [ "a" ]'
}
# The mise tool of vtest depends on vdep-x through the depends of its tool.
values_mise_vdep() {
  value_tool vtest '[mise.tools.vtest-x]' 'version = "latest"'
  sed -i.bak 's/^depends = \[\]$/depends = [ "vdep" ]/' "$clone/repo/tools/vtest/tools.toml"
  rm -f -- "$clone/repo/tools/vtest/tools.toml.bak"
  value_tool vdep '[defaults]' 'items = [ "a" ]' '[mise.tools.vdep-x]' 'version = "latest"'
}
values_replace() {
  value_tool vtest '[defaults]' 'items = [ "a" ]' '[defaults.t]' 'a = "1"' 'b = "2"'
}
# value_empty_member <pack>: the tool vtest with a default list, and a {} member of <pack>.
value_empty_member() {
  value_tool vtest '[defaults]' 'items = [ "a" ]'
  awk -v table="[pack.$1]" '{ print } $0 == table { print "vtest = {}" }' "$clone/repo/packs.toml" > "$tmp/packs.toml"
  cp -- "$tmp/packs.toml" "$clone/repo/packs.toml"
}
values_empty_base_member() { value_empty_member base; }
values_empty_nested_member() { value_empty_member security; }
values_question_none() { value_tool vtest '[questions.q]' 'example = "x"'; }
values_question_key() { value_tool vtest '[questions.q]' 'foo = "x"' 'question = "Which?"'; }
values_question_detect() { value_tool vtest '[questions.q]' 'detect = 1' 'question = "Which?"'; }
values_question_valid() {
  value_tool vtest '[questions.q]' 'detect = "echo x"' 'example = "x"' 'question = "Which?"'
