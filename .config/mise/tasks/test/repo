: > "$cache/file"
got=0
run_bin "file://$remote" || got=$?
check_clone "$name" 2 "$got"
check_paths "$name" -e "$cache/.git" -e "$cache/file" -n "$cache/repo"
check_configs_log "$name" -h 'is a git repository with the origin'

# The version check: cli/VERSION of the clone is the minimum version
# of the binary. A dev build is new enough.
version_remote="$tmp/remote-version"
_git clone --quiet -- "$base_clone" "$version_remote"
printf '%s\n' 99.0.0 > "$version_remote/cli/VERSION"
_git -C "$version_remote" commit --quiet --no-verify -am "a newer VERSION"
name="bootstrap, a binary older than VERSION stops with 2"
new_cache version-old
got=0
RUN_BIN=$release_bin run_bin "file://$version_remote" || got=$?
check_clone "$name" 2 "$got"
check_configs_log "$name" -h "bootstrap ${release_version} is older than 99.0.0, the version that the clone needs"
check_configs_log "$name" -h "Upgrade it with: mise use -g github:virajp/bootstrap"
check_configs_log "$name" -l 'using bootstrap at'

name="bootstrap, a dev build is new enough"
new_cache version-dev
got=0
run_bin "file://$version_remote" || got=$?
check_clone "$name" 0 "$got"

name="bootstrap, a binary at VERSION"
new_cache version-same
got=0
RUN_BIN=$release_bin run_bin "file://$remote" || got=$?
check_clone "$name" 0 "$got"

printf '%s\n' v1.2 > "$version_remote/cli/VERSION"
_git -C "$version_remote" commit --quiet --no-verify -am "a bad VERSION"
name="bootstrap, a VERSION that is not MAJOR.MINOR.PATCH stops with 5"
new_cache version-bad
got=0
RUN_BIN=$release_bin run_bin "file://$version_remote" || got=$?
check_clone "$name" 5 "$got"
check_configs_log "$name" -h "cli/VERSION of the clone is not MAJOR.MINOR.PATCH ('v1.2'): nothing synced"

# The gate code:lint:60-bootstrap. It runs `bootstrap check` with the cache
# clone, and it never fetches.
lint_task="$root/repo/tools/mise/tasks/code-lint-bootstrap"
gate_root="$tmp/gate-consumer"
gate_cache="$tmp/gate-cache"
cp -R -- "$base_consumer" "$gate_root"
mkdir -p -- "$gate_root/.config/mise/tasks/_scripts"
cp -- "$root/repo/tools/mise/tasks/helpers" "$gate_root/.config/mise/tasks/_scripts/helpers"
write_values "$gate_root/.config/bootstrap" 'environments = [ "dev" ]'

run_gate() {
  (
    cd -- "$root"
    env -u usage_files -u BOOTSTRAP_VALUES -u BOOTSTRAP_CLONE MISE_PROJECT_ROOT="$gate_root" \
      BOOTSTRAP_CACHE="$gate_cache" BOOTSTRAP_URL="file://$tmp/no-such-remote" BOOTSTRAP_BIN="$bin" bash "$lint_task"
  ) > "$log" 2>&1
}

got=0
run_gate || got=$?
if [[ $got == 0 && ! -s $log ]]; then
  print_success "the gate without a cache: exit 0, no output"
else
  print_error "the gate without a cache: exit $got, or an output"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

_git clone --quiet -- "$base_clone" "$gate_cache/repo"
_git -C "$gate_cache/repo" remote set-url origin https://github.com/virajp/bootstrap.git
got=0
run_gate || got=$?
if [[ $got == 0 ]] && grep -qF ' is valid' "$log"; then
  print_success "the gate with a cache: exit 0, valid"
else
  print_error "the gate with a cache: exit $got, or no valid line"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

_git -C "$gate_cache/repo" remote set-url origin https://github.com/virajp/other.git
got=0
run_gate || got=$?
if [[ $got == 0 && ! -s $log ]]; then
  print_success "the gate with another origin: exit 0, no output"
else
  print_error "the gate with another origin: exit $got, or an output"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

if ((failures)); then
  print_error "$failures check(s) failed"
  exit 1
fi
print_success "All bootstrap cases passed"
