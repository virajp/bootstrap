}
check_merge_link_dangling() {
  check_that "merge dangling link: the message" log_has "$(m_file json) is a symlink - kept it as it is"
  check_link_kept "merge dangling link" "$(m_file json)" "$tmp/outside/absent.json"
  check_that "merge dangling link: no bootstrap_commit" no_commit_set
}

merge_link_folder() {
  merge_link_tool
