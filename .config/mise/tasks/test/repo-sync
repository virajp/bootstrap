# The new seed of fnox has the profile of repo_name and no top-level
# [secrets]. A dry run prints no content for a new file, so this case syncs
# for real into its own scratch consumer.
check_fnox_seed() {
  local file="$consumer/.config/fnox.toml"
  if grep -qxF '[profiles.test.secrets]' "$file" && ! grep -qx '\[secrets\]' "$file"; then
    print_success "fnox: the seed has [profiles.test.secrets] only"
  else
    print_error "fnox: the seed lacks [profiles.test.secrets], or has [secrets]"
    failures=$((failures + 1))
