run_configs "file://$tmp/remote" || got=$?
kill "$holder" 2> /dev/null || true
wait "$holder" 2> /dev/null || true
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -e "$old/file" -e "$old.lock/pid"
check_configs_log "$name" -l 'Waiting for another sync'

name="setup:configs leaves the old Mac cache"
new_cache legacy-mac
old="${cache%/*}/macos-setup"
mkdir -p -- "$old"
: > "$old/generated.txt"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -e "$old/generated.txt" -n "$cache/macos-generated.tsv"

name="setup:configs releases the old lock on a failure"
new_cache legacy-failure
old="${cache%/*}/bootstrap"
mkdir -p -- "$old"
got=0
run_configs "file://$tmp/no-such-repo" || got=$?
check_configs "$name" 5 "$got"
check_paths "$name" -n "$old.lock"

name="setup:configs, a normalized origin is the same clone"
new_cache normalized
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name, the first run" 0 "$got" "$commit"
got=0
run_configs "$tmp/remote" || got=$?
check_configs "$name, the second run" 0 "$got" "$commit"
check_configs_log "$name" -h 'Updating the clone'
check_configs_log "$name" -l 'Cloning into'

name="setup:configs, a non-git folder stops with 2"
new_cache not-a-clone
mkdir -p -- "$cache/repo"
: > "$cache/repo/file"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 2 "$got"
check_paths "$name" -e "$cache/repo/file"

name="setup:configs, an old clone at the cache root"
new_cache old-layout
mkdir -p -- "$cache"
_git init --quiet "$cache"
_git -C "$cache" remote add origin "file://$tmp/remote"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -n "$cache/.git" -e "$cache/repo/.git"

# Any other repository at the cache root stays.
name="setup:configs, another origin at the cache root stops with 2"
new_cache other-root-origin
mkdir -p -- "$cache"
_git init --quiet "$cache"
_git -C "$cache" remote add origin "file://$tmp/remote2"
: > "$cache/file"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 2 "$got"
check_paths "$name" -e "$cache/.git" -e "$cache/file" -n "$cache/repo" -n "$tmp/synced"
check_configs_log "$name" -h 'is a git repository with the origin'

name="setup:configs, no origin at the cache root stops with 2"
new_cache no-root-origin
mkdir -p -- "$cache"
_git init --quiet "$cache"
: > "$cache/file"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 2 "$got"
check_paths "$name" -e "$cache/.git" -e "$cache/file" -n "$cache/repo" -n "$tmp/synced"
check_configs_log "$name" -h 'is a git repository with the origin'

# The compare of the origins drops the scheme, so the fetch must use the URL: a
# fetch from this origin fails.
name="setup:configs, another scheme of the origin fetches from the URL"
new_cache other-scheme
new_remote "$tmp/remote3"
got=0
run_configs "file://$tmp/remote3" || got=$?
check_configs "$name, the first run" 0 "$got" "$(git -C "$tmp/remote3" rev-parse HEAD)"
_git -C "$cache/repo" remote set-url origin "bogus://$tmp/remote3"
_git -C "$tmp/remote3" commit --quiet --no-verify --allow-empty -m "second"
got=0
run_configs "file://$tmp/remote3" || got=$?
check_configs "$name, the second run" 0 "$got" "$(git -C "$tmp/remote3" rev-parse HEAD)"
check_configs_log "$name" -h 'Updating the clone'
check_configs_log "$name" -l 'Cloning into'

# Each line of the old cache: the folder, and only its lock.
name="setup:configs reports the old cache that it removes"
new_cache legacy-line
old="${cache%/*}/bootstrap"
mkdir -p -- "$old"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got"
check_paths "$name" -n "$old"
check_configs_log "$name" -h "Removed the old cache $old"

name="setup:configs with only the old lock does not report a removal"
new_cache legacy-lock-only
old="${cache%/*}/bootstrap"
mkdir -p -- "$old.lock"
sleep 0 &
holder=$!
wait "$holder" 2> /dev/null || true
printf '%s\n' "$holder" > "$old.lock/pid"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got"
check_paths "$name" -n "$old.lock"
check_configs_log "$name" -l 'Removed the old cache'

# The copy of the local sync task. The remote has both files of the copy. Each
# case has its own scratch root and its own cache.
task_remote="$tmp/remote-task"
sync_path=.config/mise/tasks/setup/configs/sync
helpers_path=.config/mise/tasks/_scripts/helpers
new_remote "$task_remote"
mkdir -p -- "$task_remote/repo/tools/repo-sync/${sync_path%/*}" "$task_remote/repo/tools/mise/${helpers_path%/*}"
cp -- "$root/repo/tools/repo-sync/$sync_path" "$task_remote/repo/tools/repo-sync/$sync_path"
cp -- "$root/repo/tools/mise/$helpers_path" "$task_remote/repo/tools/mise/$helpers_path"
_git -C "$task_remote" add -A
_git -C "$task_remote" commit --quiet --no-verify -m "the sync task"
task_commit=$(git -C "$task_remote" rev-parse HEAD)
task_short=$(git -C "$task_remote" rev-parse --short HEAD)
new_task_case() {
  new_cache "$1"
  task_root="${cache%/*}/root"
  task_sync="$task_root/$sync_path"
  task_helpers="$task_root/$helpers_path"
  mkdir -p -- "$task_root/${sync_path%/*}" "$task_root/${helpers_path%/*}"
  cp -- "$root/repo/tools/mise/$helpers_path" "$task_helpers"
}
stale_sync() {
  rm -f -- "$1"
  printf '%s\n' '#!/usr/bin/env bash' '# an old sync task' > "$1"
  chmod 755 "$1"
}
is_stale_sync() { grep -qxF '# an old sync task' "$1"; }
is_clone_sync() { cmp -s -- "$1" "$task_remote/repo/tools/repo-sync/$sync_path"; }
run_task() { CONFIGS_ROOT=$task_root run_configs "file://$task_remote"; }
# settle_task: a first run makes both local files equal to the clone.
settle_task() {
  stale_sync "$task_sync"
  got=0
  run_task || got=$?
  check_configs "$name, the first run" 0 "$got" "$task_commit"
}
# check_lines_order <name> <first> <second>: <first> is on an earlier line.
check_lines_order() {
  local first second
  first=$(grep -nF -- "$2" "$log" | head -n 1 | cut -d: -f1) || first=''
  second=$(grep -nF -- "$3" "$log" | head -n 1 | cut -d: -f1) || second=''
  check_that "$1: '$2' is above '$3'" test "${first:-0}" -gt 0 -a "${second:-0}" -gt "${first:-0}"
}

name="setup:configs replaces a stale local sync task"
new_task_case task-stale
stale_sync "$task_sync"
got=0
run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h "Updated the local sync task to $task_short"
check_that "$name: the file of the clone" is_clone_sync "$task_sync"

name="setup:configs with equal files"
new_task_case task-equal
settle_task
got=0
run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h 'The local sync task is up to date'
check_configs_log "$name" -l 'Updated the local sync task'
check_lines_order "$name" 'Updating the clone' 'The local sync task is up to date'

name="setup:configs, a dry run with equal files"
new_task_case task-dry-equal
settle_task
got=0
usage_dry_run=true run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h 'The local sync task is up to date'
check_configs_log "$name" -l 'Would update the local sync task'

name="setup:configs, a dry run copies nothing"
new_task_case task-dry-stale
stale_sync "$task_sync"
got=0
usage_dry_run=true run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h "Would update the local sync task to $task_short"
check_configs_log "$name" -l 'Updated the local sync task'
check_that "$name: the local file stays" is_stale_sync "$task_sync"

name="setup:configs, a difference in the mode"
new_task_case task-mode
settle_task
task_mode=$(stat -c %a -- "$task_helpers" 2> /dev/null || stat -f %Lp -- "$task_helpers")
chmod 600 "$task_helpers"
got=0
run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h "Updated the local sync task to $task_short"
check_that "$name: the mode of the clone" mode_is "$task_mode" "$task_helpers"

name="setup:configs, a local symlink stays"
new_task_case task-symlink
settle_task
task_link_target="${cache%/*}/link-target"
printf '%s\n' '# my own task' > "$task_link_target"
rm -f -- "$task_sync"
ln -s -- "$task_link_target" "$task_sync"
got=0
run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h 'The local sync task is up to date'
check_that "$name: the link" test -L "$task_sync"
check_that "$name: its target" grep -qxF '# my own task' "$task_link_target"

name="setup:configs, a copy that fails continues"
new_task_case task-copy-fails
settle_task
stale_sync "$task_sync"
chmod 555 "${task_sync%/*}"
got=0
run_task || got=$?
chmod 755 "${task_sync%/*}"
check_configs "$name" 0 "$got" "$task_commit"
check_configs_log "$name" -h "Cannot update $task_sync - using the local file"
check_configs_log "$name" -l 'Updated the local sync task'
check_configs_log "$name" -l 'The local sync task is up to date'
check_that "$name: the local file stays" is_stale_sync "$task_sync"

name="setup:configs --sub replaces the sync task of the member"
new_task_case task-sub
mkdir -p -- "$task_root/sub/${sync_path%/*}"
stale_sync "$task_sync"
stale_sync "$task_root/sub/$sync_path"
got=0
usage_sub=true run_task || got=$?
check_configs "$name" 0 "$got" "$task_commit"
check_synced "$name" "$task_commit"$'\n'"$task_commit sub"
check_that "$name: the file of the root" is_clone_sync "$task_sync"
check_that "$name: the file of the member" is_clone_sync "$task_root/sub/$sync_path"

# The gate code:lint:repo-sync. It finds gomplate with `mise x`, so it starts in
# this repository, and then it does a cd to its own MISE_PROJECT_ROOT.
lint_task="$root/repo/tools/repo-sync/.config/mise/tasks/code/lint/repo-sync"
gate_root="$tmp/gate-consumer"
gate_cache="$tmp/gate-cache"
cp -R -- "$base_consumer" "$gate_root"
mkdir -p -- "$gate_root/.config/mise/tasks/_scripts"
cp -- "$root/.config/mise/tasks/_scripts/helpers" "$gate_root/.config/mise/tasks/_scripts/helpers"
printf '%s\n' 'repo_name = "test"' 'repo_url = "https://example.com/test"' 'environments = [ "dev" ]' \
  > "$gate_root/.config/bootstrap.toml"

run_gate() {
  (
    cd -- "$root"
    env -u usage_files -u REPO_SYNC_VALUES MISE_PROJECT_ROOT="$gate_root" SYNC_ENGINE_CACHE="$gate_cache" \
      bash "$lint_task"
  ) > "$log" 2>&1
}

got=0
run_gate || got=$?
if [[ $got == 0 && ! -s $log ]]; then
  print_success "the gate without a cache: exit 0, no output"
else
  print_error "the gate without a cache: exit $got, or an output"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

mkdir -p -- "$gate_cache/repo/sync-engine"
cp -- "$root/sync-engine/repo-sync" "$root/sync-engine/common" "$root/sync-engine/write" "$root/sync-engine/merge" \
  "$root/sync-engine/select" "$root/sync-engine/manifest" "$root/sync-engine/values" "$root/sync-engine/mise" "$gate_cache/repo/sync-engine/"
_git init --quiet "$gate_cache/repo"
_git -C "$gate_cache/repo" remote add origin https://github.com/virajp/bootstrap.git
got=0
run_gate || got=$?
if [[ $got == 0 ]] && grep -qF 'valid (local rules)' "$log"; then
  print_success "the gate with a cache: exit 0, valid"
else
  print_error "the gate with a cache: exit $got, or no valid line"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

# A library that leaves a mark when the gate sources it.
gate_cache="$tmp/gate-cache-other"
mkdir -p -- "$gate_cache/repo/sync-engine"
printf ': > %q\n' "$tmp/gate-sourced" > "$gate_cache/repo/sync-engine/repo-sync"
_git init --quiet "$gate_cache/repo"
_git -C "$gate_cache/repo" remote add origin https://github.com/virajp/other.git
got=0
run_gate || got=$?
if [[ $got == 0 && ! -s $log && ! -e $tmp/gate-sourced ]]; then
  print_success "the gate with another origin: exit 0, no output, not sourced"
else
  print_error "the gate with another origin: exit $got, or an output, or the library was sourced"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

if ((failures)); then
  print_error "$failures check(s) failed"
  exit 1
fi
print_success "All repo-sync cases passed"
