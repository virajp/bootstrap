#!/usr/bin/env bash

#MISE description="Test repo-sync against scratch values files"
#MISE tools.gomplate="latest"

# Runs `repo_sync --dry-run` of the working tree's tools/ against scratch
# values files, and checks the exit code and message of each case. Needs no
# network: REPO_SYNC_NO_AUTOUPDATE=1 skips `pre-commit autoupdate`. Writes
# nothing outside its temporary folder.

set -euo pipefail

# A git hook that runs this task inside `git commit` exports these variables. With them set, the git init, add and commit of the
# scratch repositories write to the real repository (gap G2).
# The fixed list goes first, with no git call before it. Then
# `git rev-parse --local-env-vars`, in a clean environment, lists any other
# local variable of this git version. It does not list GIT_CONFIG_KEY_<n> and
# GIT_CONFIG_VALUE_<n>.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_EXEC_PATH \
  GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT \
  "${!GIT_CONFIG_KEY_@}" "${!GIT_CONFIG_VALUE_@}"
git_vars=$(git rev-parse --local-env-vars 2> /dev/null) || git_vars=''
# shellcheck disable=SC2086
unset $git_vars
unset git_vars

# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

root=${MISE_PROJECT_ROOT}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-repo-sync.XXXXXX")
trap 'rm -rf -- "$tmp"' EXIT

# git without the user's hooks, signing or identity.
_git() {
  git -c user.name=test -c user.email=test@example.com -c commit.gpgsign=false \
    -c core.hooksPath=/dev/null "$@"
}

print_header "Testing repo-sync against scratch values files ..."

# The bootstrap copy: the working tree's tools/, uncommitted work included,
# committed in a temporary repository.
clone="$tmp/bootstrap"
mkdir -p -- "$clone"
cp -R -- "$root/tools" "$clone/tools"
_git -C "$clone" init --quiet
_git -C "$clone" add -A
_git -C "$clone" commit --quiet --no-verify -m "test copy"

# The consumer: a repository with a `main` branch.
consumer="$tmp/consumer"
mkdir -p -- "$consumer/.config"
_git -C "$consumer" init --quiet -b main
_git -C "$consumer" commit --quiet --no-verify --allow-empty -m "init"
values="$consumer/.config/bootstrap.toml"
log="$tmp/log"

failures=0

# run_case <name> <code> <values> [<change>] [<message>]
# Writes <values> after the common keys, applies <change> to the copy (a
# function name, or empty), runs the dry run, and compares the exit code.
# A <message> (a fixed string) must also be in the output. The copy is reset
# afterwards.
run_case() {
  local name=$1 want=$2 body=$3 change=${4:-} message=${5:-} got=0
  {
    printf '%s\n' 'repo_name = "test"' 'repo_url = "https://example.com/test"'
    printf '%s\n' "$body"
  } > "$values"
  if [[ -n $change ]]; then
    "$change"
  fi
  (
    unset REPO_SYNC_URL
    export REPO_SYNC_CLONE=$clone REPO_SYNC_VALUES=$values \
      MISE_PROJECT_ROOT=$consumer REPO_SYNC_NO_AUTOUPDATE=1
    # shellcheck source=/dev/null
    source "$clone/tools/repo-sync/.config/mise/tasks/_scripts/repo-sync"
    repo_sync --dry-run
  ) > "$log" 2>&1 || got=$?
  _git -C "$clone" checkout --quiet -- .
  _git -C "$clone" clean --quiet -fd
  if [[ $got != "$want" ]]; then
    print_error "$name: exit $got, expected $want"
  elif [[ -n $message ]] && ! grep -qF -- "$message" "$log"; then
    print_error "$name: exit $got, but the output lacks: $message"
  else
    print_success "$name: exit $got"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
  return 1
}

# The tools of the pack base, the required tool of the pack security
# included. The first case checks that each one syncs a file.
base_tools="mise repo-sync git pre-commit dprint linter vscode _security_base gitleaks grype osv-scanner"

check_base_files() {
  local tool path found missing=''
  for tool in $base_tools; do
    found=0
    while IFS= read -r path; do
      if grep -qF "would update $consumer/${path%.tmpl}" "$log"; then
        found=1
        break
      fi
    done < <(cd "$clone/tools/$tool" && find . -type f ! -name tools.toml | sed 's#^\./##')
    ((found)) || missing+=" $tool"
  done
  if [[ -n $missing ]]; then
    print_error "base: no file listed for:$missing"
    failures=$((failures + 1))
  else
    print_success "base: a file of each tool listed"
  fi
  if grep -qF "conf.d/_base/" "$log"; then
    print_error "base: the output lists conf.d/_base/"
    failures=$((failures + 1))
  else
    print_success "base: no conf.d/_base/"
  fi
}

pack_loop() {
  printf '%s\n' '' '[pack.a]' 'depends = [ "p:b" ]' '' '[pack.b]' 'depends = [ "p:a" ]' \
    >> "$clone/tools/packs.toml"
}

pack_named_like_tool() {
  printf '%s\n' '' '[pack.node]' 'depends = [ "node" ]' >> "$clone/tools/packs.toml"
}

node_needs_pulumi() {
  sed 's/^depends = \[\]$/depends = [ "pulumi" ]/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

node_prod() {
  sed 's/^default_envs = .*$/default_envs = [ "dev", "prod" ]/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

node_ci_only() {
  sed 's/^default_envs = .*$/default_envs = [ "ci" ]/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

tool_folder_zz_repo() {
  mkdir -p -- "$clone/tools/zz-repo"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' 'extensions = []' \
    'root_only = false' 'seed = []' > "$clone/tools/zz-repo/tools.toml"
}

node_no_envs() {
  sed 's/^default_envs = .*$/default_envs = []/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

# A folder member below the root of the consumer.
member_folder() {
  mkdir -p -- "$consumer/projects/web"
}

late_tool_folder() {
  mkdir -p -- "$clone/tools/zzz-late"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' 'extensions = []' \
    'root_only = false' 'seed = []' > "$clone/tools/zzz-late/tools.toml"
}

if run_case "no [tools], environments dev" 0 'environments = [ "dev" ]'; then
  check_base_files
fi
run_case "bootstrap_commit: a dry run names the commit of the clone" 0 'environments = [ "dev" ]' '' \
  "would set bootstrap_commit $(git -C "$clone" rev-parse HEAD)" || true
run_case "[tools.node] env dev, ci" 0 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "dev", "ci" ]' || true
run_case "tools = [\"node\"], the old list" 2 'environments = [ "dev" ]
tools = [ "node" ]' '' 'is a list, the old format' || true
run_case "a pack loop a -> b -> a" 2 'environments = [ "dev" ]
[packs.a]' pack_loop 'a pack loop: a -> b -> a' || true
run_case "a pack named like a tool folder" 2 'environments = [ "dev" ]
[packs.node]' pack_named_like_tool "pack 'node' is also a tool folder" || true
run_case "[branch.main], the merge config of the repo" 0 'environments = [ "dev" ]
[branch.main]
merge_model = "pr"
merge_never = [ "develop" ]' || true
run_case "[member.web], a folder below the root" 0 'environments = [ "dev" ]
[member.web]
folder = "projects/web"' member_folder || true
run_case "[member.nope], not a submodule or a folder" 2 'environments = [ "dev" ]
[member.nope]' '' '[member.nope] in' || true
run_case "[member.self], the folder of the repo itself" 2 'environments = [ "dev" ]
[member.self]
folder = "."' '' 'has the folder of the repo itself' || true
run_case "[member.web], type submodule without a submodule" 2 'environments = [ "dev" ]
[member.web]
folder = "projects/web"
type = "submodule"' member_folder 'has type submodule, but projects/web is not in .gitmodules' || true
run_case "[member.web], an unknown type" 2 'environments = [ "dev" ]
[member.web]
folder = "projects/web"
type = "repo"' member_folder "has the type 'repo'" || true
run_case "[packs.nope], an unknown pack" 3 'environments = [ "dev" ]
[packs.nope]' '' "pack 'nope' is not in bootstrap" || true
run_case "env ci on a tool whose mise tool allows dev only" 2 'environments = [ "dev", "ci" ]
[tools.pulumi]
env = [ "dev", "ci" ]' '' "mise tool 'pulumi' of tools/pulumi allows only dev" || true
run_case "env ci not in environments dev" 2 'environments = [ "dev" ]
[tools.node]
env = [ "ci" ]' '' 'is not in environments: dev' || true
run_case "a dependency without the environment of its parent" 2 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "dev", "ci" ]' node_needs_pulumi \
  "tools/node needs tools/pulumi in 'ci', but its mise tool 'pulumi' allows only dev" || true
run_case "env ci without dev" 2 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "ci" ]' '' 'has no dev - each tool must be in dev, for example env = ' || true
run_case "default_envs ci without dev" 2 'environments = [ "dev", "ci" ]
[tools.node]' node_ci_only 'default_envs of tools/node/tools.toml has no dev' || true
run_case "default_envs with prod, outside dev and ci" 2 'environments = [ "dev" ]
[tools.node]' node_prod "default_envs of tools/node/tools.toml: 'prod' is not one of dev, ci" || true
run_case "a tool folder that sorts after zz-repo" 2 'environments = [ "dev" ]' late_tool_folder \
  'tool folder tools/zzz-late sorts after zz-repo' || true
run_case "a tool folder named zz-repo" 2 'environments = [ "dev" ]' tool_folder_zz_repo \
  'tool folder tools/zz-repo sorts after zz-repo or is named zz-repo' || true
run_case "default_envs empty" 2 'environments = [ "dev" ]' node_no_envs \
  'default_envs of tools/node/tools.toml has no dev' || true

# The consumer as a git submodule: a gitlink at its path in a superproject
# at $tmp. Removing $tmp/.git after the case undoes it.
consumer_submodule() {
  _git init --quiet "$tmp"
  _git -C "$tmp" update-index --add --cacheinfo "160000,$(git -C "$consumer" rev-parse HEAD),consumer"
}

if run_case "a submodule skips vscode, a root_only tool of the pack base" 0 'environments = [ "dev" ]' \
  consumer_submodule; then
  if grep -F 'repo-sync: tools:' "$log" | grep -qw vscode; then
    print_error "submodule: the tools include vscode"
    failures=$((failures + 1))
  else
    print_success "submodule: the tools do not include vscode"
  fi
fi
rm -rf -- "$tmp/.git"
run_case "a submodule with [tools.vscode], a root_only tool" 2 'environments = [ "dev" ]
[tools.vscode]' consumer_submodule "tool 'vscode' is for the root repository only" || true
rm -rf -- "$tmp/.git"

