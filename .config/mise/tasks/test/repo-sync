chmod +x "$members_root/sub/.config/mise/tasks/setup/configs/sync"

# check_synced <name> <lines>: the lines that the fake mise recorded.
check_synced() {
  local got=''
  got=$(cat -- "$tmp/synced" 2> /dev/null) || got=''
  if [[ $got == "$2" ]]; then
    print_success "$1: the synced repositories"
  else
    print_error "$1: synced '${got}', expected '$2'"
    failures=$((failures + 1))
  fi
}

got=0
CONFIGS_ROOT=$members_root run_configs "file://$tmp/remote" || got=$?
check_configs "setup:configs without a member flag" 0 "$got" "$commit"
check_synced "setup:configs without a member flag" "$commit"

got=0
usage_sub=true CONFIGS_ROOT=$members_root run_configs "file://$tmp/remote" || got=$?
check_configs "setup:configs --sub" 0 "$got" "$commit"
check_synced "setup:configs --sub" "$commit"$'\n'"$commit sub"
grep -qF "Syncing sub ..." "$log" || {
  print_error "setup:configs --sub: no header for sub"
  failures=$((failures + 1))
}

got=0
usage_all=true CONFIGS_ROOT=$members_root run_configs "file://$tmp/remote" || got=$?
check_configs "setup:configs --all" 0 "$got" "$commit"
check_synced "setup:configs --all" "$commit"$'\n'"$commit sub"

got=0
SYNC_FAIL=2 usage_all=true CONFIGS_ROOT=$members_root run_configs "file://$tmp/remote" || got=$?
check_configs "setup:configs --all, the root fails" 2 "$got" "$commit"
check_synced "setup:configs --all, the root fails" "$commit"

rm -f -- "$members_root/sub/.config/mise/tasks/setup/configs/sync"
got=0
usage_all=true CONFIGS_ROOT=$members_root run_configs "file://$tmp/remote" || got=$?
check_configs "setup:configs --all, a member without the sync task" 2 "$got" "$commit"
check_synced "setup:configs --all, a member without the sync task" "$commit"
grep -qF "sub has no setup:configs:sync task" "$log" || {
  print_error "setup:configs --all, a member without the sync task: no error message"
  failures=$((failures + 1))
}

# The rules of the shared cache. Each case has its own XDG_CACHE_HOME.
new_cache() {
  cache="$tmp/$1/sync-engine"
  mkdir -p -- "${cache%/*}"
}

# check_paths <name> [-e <path>]... [-n <path>]...: -e needs the path, -n needs
# no such path.
check_paths() {
  local name=$1 bad=''
  shift
  while (($#)); do
    case $1 in
      -e)
        [[ -e $2 ]] || bad+=" missing:$2"
        ;;
      -n)
        [[ ! -e $2 ]] || bad+=" present:$2"
        ;;
    esac
    shift 2
  done
  if [[ -n $bad ]]; then
    print_error "$name:$bad"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  else
    print_success "$name: the folders"
  fi
}

# check_configs_log <name> -h|-l <text>: the output of the last run has (-h) or
# lacks (-l) the fixed string.
check_configs_log() {
  local found=0
  grep -qF -- "$3" "$log" && found=1
  if [[ $2 == -h && $found == 1 || $2 == -l && $found == 0 ]]; then
    print_success "$1: the output"
  else
    print_error "$1: the check $2 of the output fails for: $3"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}

name="setup:configs removes the old bootstrap cache"
new_cache legacy-removed
old="${cache%/*}/bootstrap"
mkdir -p -- "$old"
: > "$old/file"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -n "$old" -n "$old.lock"

name="setup:configs keeps the old cache of a live old stub"
new_cache legacy-live
old="${cache%/*}/bootstrap"
mkdir -p -- "$old" "$old.lock"
: > "$old/file"
sleep 60 &
holder=$!
printf '%s\n' "$holder" > "$old.lock/pid"
got=0
run_configs "file://$tmp/remote" || got=$?
kill "$holder" 2> /dev/null || true
wait "$holder" 2> /dev/null || true
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -e "$old/file" -e "$old.lock/pid"
check_configs_log "$name" -l 'Waiting for another sync'

name="setup:configs leaves the old Mac cache"
new_cache legacy-mac
old="${cache%/*}/macos-setup"
mkdir -p -- "$old"
: > "$old/generated.txt"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -e "$old/generated.txt" -n "$cache/macos-generated.tsv"

name="setup:configs releases the old lock on a failure"
new_cache legacy-failure
old="${cache%/*}/bootstrap"
mkdir -p -- "$old"
got=0
run_configs "file://$tmp/no-such-repo" || got=$?
check_configs "$name" 5 "$got"
check_paths "$name" -n "$old.lock"

name="setup:configs, a normalized origin is the same clone"
new_cache normalized
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name, the first run" 0 "$got" "$commit"
got=0
run_configs "$tmp/remote" || got=$?
check_configs "$name, the second run" 0 "$got" "$commit"
check_configs_log "$name" -h 'Updating the clone'
check_configs_log "$name" -l 'Cloning into'

name="setup:configs, a non-git folder stops with 2"
new_cache not-a-clone
mkdir -p -- "$cache/repo"
: > "$cache/repo/file"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 2 "$got"
check_paths "$name" -e "$cache/repo/file"

name="setup:configs, an old clone at the cache root"
new_cache old-layout
mkdir -p -- "$cache"
_git init --quiet "$cache"
got=0
run_configs "file://$tmp/remote" || got=$?
check_configs "$name" 0 "$got" "$commit"
check_paths "$name" -n "$cache/.git" -e "$cache/repo/.git"

# The gate code:lint:repo-sync. It finds gomplate with `mise x`, so it starts in
# this repository, and then it does a cd to its own MISE_PROJECT_ROOT.
lint_task="$root/tools/repo-sync/.config/mise/tasks/code/lint/repo-sync"
gate_root="$tmp/gate-consumer"
gate_cache="$tmp/gate-cache"
cp -R -- "$base_consumer" "$gate_root"
mkdir -p -- "$gate_root/.config/mise/tasks/_scripts"
cp -- "$root/.config/mise/tasks/_scripts/helpers" "$gate_root/.config/mise/tasks/_scripts/helpers"
printf '%s\n' 'repo_name = "test"' 'repo_url = "https://example.com/test"' 'environments = [ "dev" ]' \
  > "$gate_root/.config/bootstrap.toml"

run_gate() {
  (
    cd -- "$root"
    env -u usage_files -u REPO_SYNC_VALUES MISE_PROJECT_ROOT="$gate_root" SYNC_ENGINE_CACHE="$gate_cache" \
      bash "$lint_task"
  ) > "$log" 2>&1
}

got=0
run_gate || got=$?
if [[ $got == 0 && ! -s $log ]]; then
  print_success "the gate without a cache: exit 0, no output"
else
  print_error "the gate without a cache: exit $got, or an output"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

mkdir -p -- "$gate_cache/repo/sync-engine"
cp -- "$root/sync-engine/repo-sync" "$gate_cache/repo/sync-engine/repo-sync"
got=0
run_gate || got=$?
if [[ $got == 0 ]] && grep -qF 'valid (local rules)' "$log"; then
  print_success "the gate with a cache: exit 0, valid"
else
  print_error "the gate with a cache: exit $got, or no valid line"
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
fi

if ((failures)); then
  print_error "$failures check(s) failed"
  exit 1
fi
print_success "All repo-sync cases passed"
