}
check_both_need() {
  check_that "requires present, requires_found absent" log_has "skip file  $consumer/a.txt (no marker.toml)"
  check_that "requires present, requires_found absent: not written" log_lacks "would update $consumer/a.txt"
}
check_both_marker() {
  check_that "requires absent, requires_found present" log_has "skip file  $consumer/a.txt (no need.txt)"
  check_that "requires absent, requires_found present: not written" log_lacks "would update $consumer/a.txt"
}
check_both_absent() {
