# The shared mise generator, side macos: a direct call of the library, in the order
# of a front-end, with the tools of $tmp/macos/tools. The value of a case is the
# values file. `macos_tools` names the tools of the case.
macos_tool() {
  local tool=$1
  shift
  mkdir -p -- "$tmp/macos/tools/$tool"
  printf '%s\n' "$@" > "$tmp/macos/tools/$tool/tools.toml"
}
macos_source() {
  # shellcheck source=/dev/null
  source "$clone/sync-engine/common"
  # shellcheck source=/dev/null
  source "$clone/sync-engine/values"
  # shellcheck source=/dev/null
  source "$clone/sync-engine/mise"
}
macos_sync() {
  macos_source
  local tools=${macos_tools:-mtest} dir="$tmp/macos/tools" all="$tmp/macos/all.json" out tool rc=0
  out=$(_se_values "$tools" '' "$dir" '{}' macos/tools macos.toml) || return
  printf '%s\n' "$out" | _se_jq -R -n 'reduce (inputs | split("\t")) as $l ({}; .[$l[1]] = ($l[2] | fromjson))' > "$all" || return
  _se_mise_overrides macos "$values" "$dir" macos/tools "$tools" '' || return
  for tool in $tools; do
    _se_mise_render macos "$dir" macos/tools "$tool" "$values" "$tmp/macos/conf.d" '' "$all" || rc=$?
  done
  return "$rc"
}
