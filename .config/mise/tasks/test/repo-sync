# The merged packs model. A change function appends to, or rewrites, the packs
# of the scratch clone. The values file does not select the pack of a shape
# case: the sync examines each pack of the file.
packs_lines() { printf '%s\n' '' "$@" >> "$clone/repo/packs.toml"; }
packs_old_depends() { packs_lines '[pack.odd]' 'depends = [ "p:security" ]'; }
packs_old_required() { packs_lines '[pack.odd]' 'required = [ "_security_base" ]'; }
packs_old_tools() { packs_lines '[pack.odd]' 'tools = [ "node" ]'; }
packs_old_default() { packs_lines '[pack.odd]' 'default = [ "node" ]'; }
packs_old_prefix() { packs_lines '[pack.odd]' '"p:x" = { default = true }'; }
packs_entry_key() { packs_lines '[pack.odd]' 'node = { version = "1" }'; }
packs_default_string() { packs_lines '[pack.odd]' 'node = { default = "yes" }'; }
packs_member_string() { packs_lines '[pack.odd]' 'node = "x"'; }
packs_empty_loop() { packs_lines '[pack.x]' '"pack:y" = {}' '' '[pack.y]' '"pack:x" = {}'; }
packs_unknown_tool() { packs_lines '[pack.odd]' 'nope = {}'; }
packs_unknown_pack() { packs_lines '[pack.odd]' '"pack:nope" = {}'; }
packs_two_lines() { packs_lines '[pack.odd]' 'node = {' '  default = true' '}'; }
packs_subtable() { packs_lines '[pack.odd.node]' 'default = true'; }

old_format='is the old format - write each member as <tool> = { default = true } or <tool> = {}'
run_case "[pack.*], the old depends in a pack that is not selected" 2 "$no_tool_values" packs_old_depends \
  "repo/packs.toml: [pack.odd] depends $old_format"
run_case "[pack.*], the old required in a pack that is not selected" 2 "$no_tool_values" packs_old_required \
  "repo/packs.toml: [pack.odd] required $old_format"
run_case "[pack.*], the old tools in a pack that is not selected" 2 "$no_tool_values" packs_old_tools \
  "repo/packs.toml: [pack.odd] tools $old_format"
run_case "[pack.*], the old default list in a pack that is not selected" 2 "$no_tool_values" packs_old_default \
  "repo/packs.toml: [pack.odd] default $old_format"
run_case "[pack.*], a key with the old prefix p:" 2 "$no_tool_values" packs_old_prefix \
  'repo/packs.toml: [pack.odd] "p:x" is the old form - write "pack:x" = { default = true }'
run_case "[pack.*], an entry key other than default" 2 "$no_tool_values" packs_entry_key \
  "repo/packs.toml: [pack.odd] node has the entry key 'version' - the only entry key is default"
run_case "[pack.*], default that is not a boolean" 2 "$no_tool_values" packs_default_string \
  'repo/packs.toml: [pack.odd] node: default must be true or false, not string'
run_case "[pack.*], a member that is a string" 2 "$no_tool_values" packs_member_string \
  'repo/packs.toml: [pack.odd] node must be a table, { default = true } or {}'
run_case "[pack.*], a loop through {} members in packs that are not selected" 2 "$no_tool_values" packs_empty_loop \
  'repo/packs.toml: a pack loop: x -> y -> x'
run_case "[pack.*], an unknown tool in a pack that is not selected" 3 "$no_tool_values" packs_unknown_tool \
  "tool 'nope' is not in bootstrap (named in pack odd)"
run_case "[pack.*], an unknown pack in a pack that is not selected" 3 "$no_tool_values" packs_unknown_pack \
  "pack 'nope' is not in bootstrap (named in pack odd)"
run_case "[pack.*], a member on two lines" 2 "$no_tool_values" packs_two_lines \
  'repo/packs.toml: [pack.odd] node must be on one line'
