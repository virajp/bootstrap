# The rules of the shared cache. Each case has its own XDG_CACHE_HOME.
new_cache() {
  cache="$tmp/$1/sync-engine"
  mkdir -p -- "${cache%/*}"
}

# check_paths <name> [-e <path>]... [-n <path>]...: -e needs the path, -n needs
# no such path.
check_paths() {
  local name=$1 bad=''
  shift
  while (($#)); do
    case $1 in
      -e)
        [[ -e $2 ]] || bad+=" missing:$2"
        ;;
      -n)
        [[ ! -e $2 ]] || bad+=" present:$2"
        ;;
    esac
    shift 2
  done
  if [[ -n $bad ]]; then
    print_error "$name:$bad"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  else
    print_success "$name: the folders"
  fi
}

# check_configs_log <name> -h|-l <text>: the output of the last run has (-h) or
# lacks (-l) the fixed string.
check_configs_log() {
  local found=0
  grep -qF -- "$3" "$log" && found=1
  if [[ $2 == -h && $found == 1 || $2 == -l && $found == 0 ]]; then
    print_success "$1: the output"
  else
    print_error "$1: the check $2 of the output fails for: $3"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}

