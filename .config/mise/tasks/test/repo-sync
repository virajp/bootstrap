#!/usr/bin/env bash
[[ -e $SYNC_ENGINE_CLONE/.git && $SYNC_ENGINE_CLONE != "$XDG_CACHE_HOME"/* && ! -e $XDG_CACHE_HOME/sync-engine/lock && ${REPO_SYNC_CLONE:-} == "$SYNC_ENGINE_CLONE" ]] || exit 1
cd=''
[[ ${2:-} == --cd ]] && cd=${3#"$MISE_PROJECT_ROOT"/}
printf '%s\n' "$(git -C "$SYNC_ENGINE_CLONE" rev-parse HEAD)${cd:+ $cd}" >> "$SYNC_OUT"
[[ -z ${SYNC_FAIL:-} ]] || exit "$SYNC_FAIL"
EOF
chmod +x "$tmp/bin/mise"

# A remote with one commit: file:// so that --depth applies.
new_remote() {
  _git init --quiet -b main "$1"
  _git -C "$1" commit --quiet --no-verify --allow-empty -m "init"
}
new_remote "$tmp/remote"
new_remote "$tmp/remote2"

run_configs() {
  rm -f -- "$tmp/synced"
  env -u SYNC_ENGINE_CACHE MISE_PROJECT_ROOT="${CONFIGS_ROOT:-$root}" PATH="$tmp/bin:$PATH" \
    XDG_CACHE_HOME="${cache%/*}" SYNC_ENGINE_URL="$1" SYNC_OUT="$tmp/synced" bash "$task" > "$log" 2>&1
}

# check_configs <name> <want> <got> [<commit>]: the exit code, the commit that
# the first sync got, and no lock left.
check_configs() {
  local name=$1 want=$2 got=$3 commit=${4:-} synced=''
  synced=$(head -n 1 -- "$tmp/synced" 2> /dev/null) || synced=''
  if [[ $got != "$want" ]]; then
    print_error "$name: exit $got, expected $want"
  elif [[ -n $commit && $synced != "$commit" ]]; then
    print_error "$name: the sync got '${synced}', expected $commit"
  elif [[ -e $cache/lock ]]; then
    print_error "$name: the lock is still there"
  else
    print_success "$name: exit $got"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  failures=$((failures + 1))
}

