# check_manifest_refused <message>: the sync failed at the manifest, with its
# message after the path of the manifest.
check_manifest_refused() {
  check_that "a refused manifest: the message" log_has "$consumer/.config/repo-generated.tsv: $1"
  check_that "a refused manifest: FAILED" log_has 'FAILED: .config/repo-generated.tsv'
  check_that "a refused manifest: no remove" log_lacks 'remove'
  check_that "a refused manifest: no bootstrap_commit in the log" log_lacks 'bootstrap_commit'
  check_that "a refused manifest: no bootstrap_commit" lacks_in_file 'bootstrap_commit' "$values"
  check_that "a refused manifest: the stale file stays" test -f "$consumer/stale.txt"
}
