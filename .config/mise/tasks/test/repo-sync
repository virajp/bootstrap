# Merge mode, from the merge cases of test:setup-sync. The tool has a merge
# target of each format. A source has no bootstrap header.
merge_tool() {
  local header
  fixture_tool
  mkdir -p -- "$clone/tools/fixture/.config/merger"
  fixture_header .config/merger/plain.txt '#'
  fixture_file .config/merger/plain.txt "${header[@]}" 'plain=1'
  fixture_file .config/merger/m.json.tmpl '{' '  "scalar": "src",' \
    '  "nested": { "set": 1, "deeper": { "x": true } },' '  "kind": [1],' \
    '  "list": ["b", "c", "c", { "j": 2, "k": 1 }],' '  "maps": [{ "b": 2, "a": 1 }],' \
    '  "items": ["a"]' '}'
  fixture_file .config/merger/m.yaml.tmpl '# Merged by bootstrap: .config/merger/m.yaml' 'scalar: src' 'nested:' \
    '  set: 1' 'list:' '  - x' '  - drop' '  - b' 'kind:' '  - 1'
  fixture_file .config/merger/m.toml.tmpl '# Merged by bootstrap: .config/merger/m.toml' 'scalar = "src"' '' \
    '[nested]' 'set = 1' 'list = ["x", "y"]'
  fixture_toml '[files.".config/merger/m.json"]' 'mode = "merge"' \
    'remove = [ [ "gone" ], [ "nested", "old" ], [ "absent", "path" ] ]' \
    'remove_items = [ { items = [ "drop", { j = 2, k = 1 } ], path = [ "list" ] }, { items = [ "app" ], path = [ "keep" ] } ]' \
    '[files.".config/merger/m.yaml"]' 'mode = "merge"' 'remove = [ [ "gone" ] ]' \
    'remove_items = [ { items = [ "drop" ], path = [ "list" ] } ]' \
    '[files.".config/merger/m.toml"]' 'mode = "merge"' 'remove = [ [ "gone" ] ]' \
    'remove_items = [ { items = [ "s" ], path = [ "notlist" ] } ]'
}
# live <ext> <content>: a live merge target.
live() {
  mkdir -p -- "$consumer/.config/merger"
  printf '%s' "$2" > "$consumer/.config/merger/m.$1"
}
m_file() { printf '%s' "$consumer/.config/merger/m.$1"; }

# A 4-space JSON target: keys kept, scalars, nested tables, a kind change, lists
# as a union with deep equality, remove and remove_items, the source wins over
# a remove, a remove_items item stays out though the source has it, 2-space
# output in the live key order, the permissions kept, no header, a second run
# unchanged, a dry run that writes nothing.
merge_json_live() {
  merge_tool
  live json '{
    "keep": "app",
    "scalar": "app",
    "nested": {"set": 0, "old": 1, "other": 2},
    "kind": {"was": "table"},
    "list": ["x", "drop", "b", {"k": 1, "j": 2}, "drop"],
    "maps": [{"a": 1, "b": 2}],
    "gone": true
}
'
  chmod 600 "$(m_file json)"
}
check_merge_json() {
  local f before got=0
  f=$(m_file json)
  check_that "merge json: updated" log_has "updated    $f"
  check_file "merge json: the result" "$f" '{
  "keep": "app",
  "scalar": "src",
  "nested": {
    "set": 1,
    "other": 2,
    "deeper": {
      "x": true
    }
  },
  "kind": [
    1
  ],
  "list": [
    "x",
    "b",
    "c"
  ],
  "maps": [
    {
      "a": 1,
      "b": 2
    }
  ],
  "items": [
    "a"
  ]
}'
  check_that "merge json: the permissions are kept" mode_is 600 "$f"
  check_that "merge json: no header" lacks_in_file 'Synced from bootstrap' "$f"
  case_rerun || got=$?
  check_that "merge json: a second run exits 0" test "$got" = 0
  check_that "merge json: a second run, unchanged" log_has "unchanged  $f"
  printf '%s\n' '{"keep": "edited", "scalar": "app"}' > "$f"
  before=$(cat -- "$f")
  got=0
  case_rerun --dry-run || got=$?
  check_that "merge json: a dry run exits 0" test "$got" = 0
  check_that "merge json: a dry run, would update" log_has "would update $f"
  check_that "merge json: a dry run, the diff" log_has '+  "scalar": "src",'
  check_file "merge json: a dry run writes nothing" "$f" "$before"
}

# A YAML target: the comments of the live file stay; an absent remove path is
# not an error; remove_items deletes every equal item.
merge_yaml_live() {
  merge_tool
  live yaml '# top comment
keep: app # after keep
scalar: app
nested:
  # own line
  set: 0
list:
  - x
  - drop
  - drop
kind:
  was: table
'
}
check_merge_yaml() {
  check_file "merge yaml: the result" "$(m_file yaml)" '# top comment
keep: app # after keep
scalar: src
nested:
  # own line
  set: 1
list:
  - x
  - b
kind:
  - 1'
}

# A TOML target: own-line and after-key comments stay; a remove_items path that
# is not a list is not an error.
merge_toml_live() {
  merge_tool
  live toml '# head comment
keep = "app" # after keep
scalar = "app"
notlist = "s"
gone = 1

# own line
[nested]
set = 0
list = ["x"]
'
}
# The list of the TOML target. dprint, when `mise x` finds it, writes its own
# spaces and sorts the keys, and the case has no dprint config of its own.
merge_toml_list='^list = \[ ?"x", "y" ?\]$'
check_merge_toml() {
  local f
  f=$(m_file toml)
  check_that "merge toml: the head comment stays" grep -qxF '# head comment' "$f"
  check_that "merge toml: the own-line comment stays" grep -qxF '# own line' "$f"
  check_that "merge toml: the after-key comment stays" grep -qE '^keep = "app" +# after keep$' "$f"
  check_that "merge toml: the source scalar wins" grep -qxF 'scalar = "src"' "$f"
  check_that "merge toml: a nested scalar" grep -qxF 'set = 1' "$f"
  check_that "merge toml: a list union" grep -qE "$merge_toml_list" "$f"
  check_that "merge toml: a non-list remove_items path is kept" grep -qxF 'notlist = "s"' "$f"
  check_that "merge toml: a removed key" lacks_in_file 'gone' "$f"
}

