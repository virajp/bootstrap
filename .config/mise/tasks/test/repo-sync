# The header detection: a generated mise file that no tool writes, with a header
# text on line 2, listed in the manifest. The stale removal reads 3 lines. A dry
# run names the file with its full path, and a case has its own consumer, so a
# <check> examines it.
old_conf=.config/mise/conf.d/oldtool/mise.dev.toml
# old_conf_file <line 2>
old_conf_file() {
  mkdir -p -- "$consumer/${old_conf%/*}"
  printf '%s\n' '# A plain comment.' "$1" > "$consumer/$old_conf"
  manifest_file "oldtool${tab}$old_conf"
}
old_conf_bootstrap() { old_conf_file '# Synced from bootstrap: tools/oldtool/tools.toml. Do not edit this file.'; }
