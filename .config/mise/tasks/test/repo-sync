# The default output. A <change> of these cases unsets SYNC_ENGINE_VERBOSE and
# the style variables, and the output is a log file, not a terminal.
output_default() { unset SYNC_ENGINE_VERBOSE FORCE_COLOR NO_COLOR; }
# table_count <label>: the count of the row <label> of the plain table.
table_count() { sed -n "s/^| $1 *| *\([0-9]*\) |\$/\1/p" "$log"; }
table_is() { [[ $(table_count "$1") == "$2" ]]; }
# One table, and its Total is the sum of its rows.
table_adds_up() {
  local label n sum=0
  for label in Changed New Seeded Removed Unchanged 'Kept seeds' Skipped Failed; do
    n=$(table_count "$label")
    [[ -n $n ]] || return 1
    sum=$((sum + n))
  done
  [[ $(grep -c '^| Total ' "$log") == 1 ]] && table_is Total "$sum"
}
log_line() { grep -qxF -- "$1" "$log"; }
# The state of the consumer, without its .git.
consumer_state() {
  (cd -- "$consumer" && find . -path ./.git -prune -o -type f -exec cksum {} + | LC_ALL=C sort)
