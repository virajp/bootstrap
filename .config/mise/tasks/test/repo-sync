check_output_list() {
  local got=0 unchanged lines
  check_that "the default output: the first run lists a new file" log_line "new $consumer/c.txt"
  check_that "the default output: the first run has a table" table_adds_up
  # A second run writes the mise fragments and `_default` of the first run
  # again, so the third run is the one with exact counts.
  case_rerun || got=$?
  check_that "the default output: the second run exits 0" test "$got" = 0
  output_edit_a
  rm -- "$consumer/b.txt"
  case_rerun || got=$?
  check_that "the default output: exit 0" test "$got" = 0
  check_that "the default output: a changed file" log_line "changed $consumer/a.txt"
  check_that "the default output: a new file" log_line "new $consumer/b.txt"
  check_that "the default output: no unchanged file" log_lacks "$consumer/c.txt"
  check_that "the default output: Changed" table_is Changed 1
  check_that "the default output: New" table_is New 1
  check_that "the default output: Seeded" table_is Seeded 0
  check_that "the default output: Removed" table_is Removed 0
  check_that "the default output: Failed" table_is Failed 0
  check_that "the default output: the sum" table_adds_up
  check_that "the default output: the last line" test "$(tail -n 1 -- "$log")" = '[OK] Synced: 2 files changed'
  check_that "the default output: no per-file log line" log_lacks 'unchanged  '
  unchanged=$(table_count Unchanged)
  got=0
  (
    export SYNC_ENGINE_VERBOSE=1
    case_rerun
  ) || got=$?
  check_that "verbose: exit 0" test "$got" = 0
  lines=$(grep -c '^repo-sync: unchanged  ' "$log") || lines=0
  check_that "verbose: each unchanged file, a.txt and b.txt too" test "$lines" = "$((unchanged + 2))"
  check_that "verbose: the table" table_adds_up
