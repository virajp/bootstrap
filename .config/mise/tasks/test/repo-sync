#!/usr/bin/env bash

#MISE description="Test repo-sync against scratch values files"
#MISE tools.gomplate="latest"

# Runs `repo_sync --dry-run` and `repo_sync --check` of sync-engine/repo-sync,
# with the working tree's tools/ and sync-engine/, against scratch values files,
# and checks the exit code and message of each case. Needs no
# network: REPO_SYNC_NO_AUTOUPDATE=1 skips `pre-commit autoupdate`. Writes
# nothing outside its temporary folder.

set -euo pipefail

# A git hook that runs this task inside `git commit` exports these variables. With them set, the git init, add and commit of the
# scratch repositories write to the real repository (gap G2).
# The fixed list goes first, with no git call before it. Then
# `git rev-parse --local-env-vars`, in a clean environment, lists any other
# local variable of this git version. It does not list GIT_CONFIG_KEY_<n> and
# GIT_CONFIG_VALUE_<n>.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY \
  GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_PREFIX GIT_EXEC_PATH \
  GIT_CONFIG GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT \
  "${!GIT_CONFIG_KEY_@}" "${!GIT_CONFIG_VALUE_@}"
git_vars=$(git rev-parse --local-env-vars 2> /dev/null) || git_vars=''
# shellcheck disable=SC2086
unset $git_vars
unset git_vars

# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

root=${MISE_PROJECT_ROOT}
tmp=$(mktemp -d "${TMPDIR:-/tmp}/test-repo-sync.XXXXXX")
# shellcheck disable=SC2046
trap 'kill $(jobs -p) 2> /dev/null || true; rm -rf -- "$tmp"' EXIT

# git without the user's hooks, signing or identity.
_git() {
  git -c user.name=test -c user.email=test@example.com -c commit.gpgsign=false \
    -c core.hooksPath=/dev/null "$@"
}

print_header "Testing repo-sync against scratch values files ..."

# The bootstrap copy: the working tree's tools/ and sync-engine/, uncommitted
# work included, committed in a temporary repository.
clone="$tmp/bootstrap"
mkdir -p -- "$clone"
cp -R -- "$root/tools" "$clone/tools"
cp -R -- "$root/sync-engine" "$clone/sync-engine"
_git -C "$clone" init --quiet
_git -C "$clone" add -A
_git -C "$clone" commit --quiet --no-verify -m "test copy"

# The consumer: a repository with a `main` branch.
consumer="$tmp/consumer"
mkdir -p -- "$consumer/.config"
_git -C "$consumer" init --quiet -b main
_git -C "$consumer" commit --quiet --no-verify --allow-empty -m "init"
log="$tmp/log"

failures=0

# The cases run in parallel, one job for each CPU. Each case has its own
# folder: a clone of the bootstrap copy and a copy of the consumer. Inside a
# case, `tmp`, `clone`, `consumer`, `values` and `log` name the files of that
# case, so a <change> or a <check> function changes only its own case. The
# output of each case is printed in the sequence of the cases.
base_clone=$clone
base_consumer=$consumer
max_jobs=$(getconf _NPROCESSORS_ONLN 2> /dev/null) || max_jobs=4
case_color=''
style_enabled && case_color=1
case_count=0
case_pids=()
case_dirs=()

# run_case <name> <code> <values> [<change>] [<message>] [<check>]
# Writes <values> after the common keys, applies <change> to the copy (a
# function name, or empty), runs the dry run, and compares the exit code.
# A <message> (a fixed string) must also be in the output. If the case
# passes, the function <check> examines its output.
# `case_args` replaces the arguments of repo_sync for the case; a case with
# `--check` in them runs without SYNC_ENGINE_CLONE. `CASE_SYNC_ENGINE_URL`, when
# set, becomes SYNC_ENGINE_URL of the case. `CASE_LIB=forward` sources the
# forwarding file at the old library path, with REPO_SYNC_CLONE only.
# `CASE_CLONE=none` sets no clone variable.
run_case() {
  local dir
  case_count=$((case_count + 1))
  dir="$tmp/case-$case_count"
  mkdir -p -- "$dir"
  (
    trap - EXIT
    case_body "$dir" "$@" > "$dir/out" 2>&1
  ) &
  case_pids+=("$!")
  case_dirs+=("$dir")
  if ((${#case_pids[@]} >= max_jobs)); then
    collect_case
  fi
}

case_body() {
  local dir=$1 name=$2 want=$3 body=$4 change=${5:-} message=${6:-} check=${7:-} got=0
  tmp=$dir clone=$dir/bootstrap consumer=$dir/consumer log=$dir/log failures=0
  values="$consumer/.config/bootstrap.toml"
  _git clone --quiet -- "$base_clone" "$clone"
  cp -R -- "$base_consumer" "$consumer"
  {
    printf '%s\n' 'repo_name = "test"' 'repo_url = "https://example.com/test"'
    printf '%s\n' "$body"
  } > "$values"
  if [[ -n $change ]]; then
    "$change"
  fi
  local args=${case_args:---dry-run}
  (
    unset SYNC_ENGINE_URL SYNC_ENGINE_CLONE REPO_SYNC_CLONE
    [[ -z ${CASE_SYNC_ENGINE_URL:-} ]] || export SYNC_ENGINE_URL=$CASE_SYNC_ENGINE_URL
    export REPO_SYNC_VALUES=$values MISE_PROJECT_ROOT=$consumer REPO_SYNC_NO_AUTOUPDATE=1
    lib=$clone/sync-engine/repo-sync
    if [[ ${CASE_LIB:-} == forward ]]; then
      lib=$clone/tools/repo-sync/.config/mise/tasks/_scripts/repo-sync
      [[ ${CASE_CLONE:-} == none ]] || export REPO_SYNC_CLONE=$clone
    elif [[ ${CASE_CLONE:-} != none && " $args " != *" --check "* ]]; then
      export SYNC_ENGINE_CLONE=$clone
    fi
    # `set -e` does not apply on the left of `||`, so a failed source stops here.
    # shellcheck source=/dev/null
    source "$lib" || exit $?
    # shellcheck disable=SC2086
    repo_sync $args
  ) > "$log" 2>&1 || got=$?
  # After the dry run, so that its output stays plain for the greps.
  [[ -n $case_color ]] && export FORCE_COLOR=1
  if [[ $got != "$want" ]]; then
    print_error "$name: exit $got, expected $want"
  elif [[ -n $message ]] && ! grep -qF -- "$message" "$log"; then
    print_error "$name: exit $got, but the output lacks: $message"
  else
    print_success "$name: exit $got"
    [[ -n $check ]] && "$check"
    printf '%s\n' "$failures" > "$dir/failures"
    return 0
  fi
  sed 's/^/    /' "$log" >&2
  printf '%s\n' "$((failures + 1))" > "$dir/failures"
}

# run_check: run_case with `repo_sync --check`.
run_check() { case_args=--check run_case "$@"; }

# Wait for the oldest case, print its output and add its failures. A case
# without a failures file stopped before its end, which is a failure.
collect_case() {
  local dir=${case_dirs[0]} n=1
  wait "${case_pids[0]}"
  cat -- "$dir/out"
  [[ -f $dir/failures ]] && n=$(cat -- "$dir/failures")
  failures=$((failures + n))
  rm -rf -- "$dir"
  case_pids=("${case_pids[@]:1}")
  case_dirs=("${case_dirs[@]:1}")
}

# The tools of the pack base, the required tool of the pack security
# included. The first case checks that each one syncs a file.
base_tools="mise repo-sync git pre-commit dprint linter vscode _security_base gitleaks grype osv-scanner"

check_base_files() {
  local tool path found missing=''
  for tool in $base_tools; do
    found=0
    while IFS= read -r path; do
      if grep -qF "would update $consumer/${path%.tmpl}" "$log"; then
        found=1
        break
      fi
    done < <(cd "$clone/tools/$tool" && find . -type f ! -name tools.toml | sed 's#^\./##')
    ((found)) || missing+=" $tool"
  done
  if [[ -n $missing ]]; then
    print_error "base: no file listed for:$missing"
    failures=$((failures + 1))
  else
    print_success "base: a file of each tool listed"
  fi
  if grep -qF "conf.d/_base/" "$log"; then
    print_error "base: the output lists conf.d/_base/"
    failures=$((failures + 1))
  else
    print_success "base: no conf.d/_base/"
  fi
}

pack_loop() {
  printf '%s\n' '' '[pack.a]' 'depends = [ "p:b" ]' '' '[pack.b]' 'depends = [ "p:a" ]' \
    >> "$clone/tools/packs.toml"
}

pack_named_like_tool() {
  printf '%s\n' '' '[pack.node]' 'depends = [ "node" ]' >> "$clone/tools/packs.toml"
}

node_needs_pulumi() {
  sed 's/^depends = \[\]$/depends = [ "pulumi" ]/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

node_prod() {
  sed 's/^default_envs = .*$/default_envs = [ "dev", "prod" ]/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

node_ci_only() {
  sed 's/^default_envs = .*$/default_envs = [ "ci" ]/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

tool_folder_zz_repo() {
  mkdir -p -- "$clone/tools/zz-repo"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' 'extensions = []' \
    'root_only = false' 'seed = []' > "$clone/tools/zz-repo/tools.toml"
}

node_no_envs() {
  sed 's/^default_envs = .*$/default_envs = []/' "$clone/tools/node/tools.toml" > "$tmp/node.toml"
  cp -- "$tmp/node.toml" "$clone/tools/node/tools.toml"
}

# A folder member below the root of the consumer.
member_folder() {
  mkdir -p -- "$consumer/projects/web"
}

late_tool_folder() {
  mkdir -p -- "$clone/tools/zzz-late"
  printf '%s\n' 'default_envs = [ "dev" ]' 'depends = []' 'extensions = []' \
    'root_only = false' 'seed = []' > "$clone/tools/zzz-late/tools.toml"
}

run_case "no [tools], environments dev" 0 'environments = [ "dev" ]' '' '' check_base_files
run_case "bootstrap_commit: a dry run names the commit of the clone" 0 'environments = [ "dev" ]' '' \
  "would set bootstrap_commit $(git -C "$clone" rev-parse HEAD)"
run_case "[tools.node] env dev, ci" 0 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "dev", "ci" ]'
run_case "tools = [\"node\"], the old list" 2 'environments = [ "dev" ]
tools = [ "node" ]' '' 'is a list, the old format'
run_case "a pack loop a -> b -> a" 2 'environments = [ "dev" ]
[packs.a]' pack_loop 'a pack loop: a -> b -> a'
run_case "a pack named like a tool folder" 2 'environments = [ "dev" ]
[packs.node]' pack_named_like_tool "pack 'node' is also a tool folder"
run_case "[branch.main], the merge config of the repo" 0 'environments = [ "dev" ]
[branch.main]
merge_model = "pr"
merge_never = [ "develop" ]'
run_case "[member.web], a folder below the root" 0 'environments = [ "dev" ]
[member.web]
folder = "projects/web"' member_folder
run_case "[member.nope], not a submodule or a folder" 2 'environments = [ "dev" ]
[member.nope]' '' '[member.nope] in'
run_case "[member.self], the folder of the repo itself" 2 'environments = [ "dev" ]
[member.self]
folder = "."' '' 'has the folder of the repo itself'
run_case "[member.web], type submodule without a submodule" 2 'environments = [ "dev" ]
[member.web]
folder = "projects/web"
type = "submodule"' member_folder 'has type submodule, but projects/web is not in .gitmodules'
run_case "[member.web], an unknown type" 2 'environments = [ "dev" ]
[member.web]
folder = "projects/web"
type = "repo"' member_folder "has the type 'repo'"
run_case "[packs.nope], an unknown pack" 3 'environments = [ "dev" ]
[packs.nope]' '' "pack 'nope' is not in bootstrap"
run_case "env ci on a tool whose mise tool allows dev only" 2 'environments = [ "dev", "ci" ]
[tools.pulumi]
env = [ "dev", "ci" ]' '' "mise tool 'pulumi' of tools/pulumi allows only dev"
run_case "env ci not in environments dev" 2 'environments = [ "dev" ]
[tools.node]
env = [ "ci" ]' '' 'is not in environments: dev'
run_case "a dependency without the environment of its parent" 2 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "dev", "ci" ]' node_needs_pulumi \
  "tools/node needs tools/pulumi in 'ci', but its mise tool 'pulumi' allows only dev"
run_case "env ci without dev" 2 'environments = [ "dev", "ci" ]
[tools.node]
env = [ "ci" ]' '' 'has no dev - each tool must be in dev, for example env = '
run_case "default_envs ci without dev" 2 'environments = [ "dev", "ci" ]
[tools.node]' node_ci_only 'default_envs of tools/node/tools.toml has no dev'
run_case "default_envs with prod, outside dev and ci" 2 'environments = [ "dev" ]
[tools.node]' node_prod "default_envs of tools/node/tools.toml: 'prod' is not one of dev, ci"
run_case "a tool folder that sorts after zz-repo" 2 'environments = [ "dev" ]' late_tool_folder \
  'tool folder tools/zzz-late sorts after zz-repo'
run_case "a tool folder named zz-repo" 2 'environments = [ "dev" ]' tool_folder_zz_repo \
  'tool folder tools/zz-repo sorts after zz-repo or is named zz-repo'
run_case "default_envs empty" 2 'environments = [ "dev" ]' node_no_envs \
  'default_envs of tools/node/tools.toml has no dev'

# The consumer as a git submodule: a gitlink at its path in a superproject
# at the folder of the case.
consumer_submodule() {
  _git init --quiet "$tmp"
  _git -C "$tmp" update-index --add --cacheinfo "160000,$(git -C "$consumer" rev-parse HEAD),consumer"
}

check_no_vscode() {
  if grep -F 'repo-sync: tools:' "$log" | grep -qw vscode; then
    print_error "submodule: the tools include vscode"
    failures=$((failures + 1))
  else
    print_success "submodule: the tools do not include vscode"
  fi
}

run_case "a submodule skips vscode, a root_only tool of the pack base" 0 'environments = [ "dev" ]' \
  consumer_submodule '' check_no_vscode
run_case "a submodule with [tools.vscode], a root_only tool" 2 'environments = [ "dev" ]
[tools.vscode]' consumer_submodule "tool 'vscode' is for the root repository only"

# The generated java config already exists in the consumer, so the dry run
# shows its diff, with the override comments.
java_conf() {
  mkdir -p -- "$consumer/.config/mise/conf.d/java"
  printf '%s\n' x > "$consumer/.config/mise/conf.d/java/mise.dev.toml"
  printf '%s\n' x > "$consumer/.config/mise/conf.d/java/mise.ci.toml"
}

run_case "[overrides.mise.tools.java] version" 0 'environments = [ "dev" ]
[tools.java]
[overrides.mise.tools.java]
version = "21"' java_conf 'version = "21"  # override: .config/bootstrap.toml'
run_case "[overrides.mise_env.ci] wins over [overrides.mise]" 0 'environments = [ "dev", "ci" ]
[tools.java]
[overrides.mise.tools.java]
version = "21"
[overrides.mise_env.ci.tools.java]
version = "17"' java_conf 'version = "17"  # override: .config/bootstrap.toml'
run_case "[overrides.mise.tools.jav], an unknown mise tool" 2 'environments = [ "dev" ]
[tools.java]
[overrides.mise.tools.jav]
version = "21"' '' 'no selected tool has mise.tools.jav.version'
run_case "[overrides.mise.tools.java] without the java tool" 2 'environments = [ "dev" ]
[overrides.mise.tools.java]
version = "21"' '' 'no selected tool has mise.tools.java.version'
run_case "[overrides.mise.env], a key that no tool has" 2 'environments = [ "dev" ]
[tools.python]
[overrides.mise.env]
NEW_VAR = "1"' '' 'no selected tool has mise.env.NEW_VAR'
run_case "[overrides.mise.tools.java] envs" 2 'environments = [ "dev" ]
[tools.java]
[overrides.mise.tools.java]
envs = [ "dev" ]' '' 'the envs, the depends, the requires and the files of a mise tool cannot be overridden'
run_case "[overrides.tools.java], not mise, mise_env or gitignore" 2 'environments = [ "dev" ]
[tools.java]
[overrides.tools.java]
version = "21"' '' 'the only keys of [overrides] are mise, mise_env and gitignore'
run_case "[overrides.mise_env.ci] without ci in environments" 2 'environments = [ "dev" ]
[tools.java]
[overrides.mise_env.ci.tools.java]
version = "21"' '' ".config/bootstrap.toml: 'ci' is not in environments: dev"

# The `requires` of a mise tool: ruff and pyrefly of the python tool need a
# pyproject.toml. The generated python config already exists in the
# consumer, so the dry run shows its diff.
python_conf() {
  mkdir -p -- "$consumer/.config/mise/conf.d/python"
  printf '%s\n' x > "$consumer/.config/mise/conf.d/python/mise.dev.toml"
}

pyproject_at() {
  python_conf
  mkdir -p -- "$consumer/$1"
  : > "$consumer/$1/pyproject.toml"
}
pyproject_root() { pyproject_at .; }
pyproject_depth4() { pyproject_at a/b/c/d; }
pyproject_depth5() { pyproject_at a/b/c/d/e; }
pyproject_ignored() {
  pyproject_at ignored
  printf '%s\n' '/ignored/' > "$consumer/.gitignore"
}

# check_log_lacks <name> <text>: the output of the last case must not have
# the fixed string <text>.
check_log_lacks() {
  if grep -qF -- "$2" "$log"; then
    print_error "$1: the output has: $2"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  else
    print_success "$1: no $2"
  fi
}

lacks_requires() { check_log_lacks "requires, a pyproject.toml at the root" 'requires ='; }
lacks_ruff_depth5() { check_log_lacks "requires, a pyproject.toml 5 folders down" '[tools.ruff]'; }
lacks_ruff_ignored() { check_log_lacks "requires, a pyproject.toml in an ignored folder" '[tools.ruff]'; }

python_values='environments = [ "dev" ]
[tools.python]'
run_case "requires, a pyproject.toml at the root" 0 "$python_values" pyproject_root '[tools.ruff]' lacks_requires
run_case "requires, a pyproject.toml 4 folders down" 0 "$python_values" pyproject_depth4 \
  '[tools."pipx:pyrefly"]'
run_case "requires, a pyproject.toml 5 folders down" 0 "$python_values" pyproject_depth5 '[tools.uv]' \
  lacks_ruff_depth5
run_case "requires, a pyproject.toml in an ignored folder" 0 "$python_values" pyproject_ignored '[tools.uv]' \
  lacks_ruff_ignored
run_case "[overrides.mise.tools.ruff] requires" 2 "$python_values
[overrides.mise.tools.ruff]
requires = \"setup.py\"" '' 'the envs, the depends, the requires and the files of a mise tool cannot be overridden'

# The `files` of a mise tool: the ruff and pyrefly tasks follow the
# `requires` of their mise tool.
gate=.config/mise/tasks/code/lint/pyrefly
gate_synced() {
  python_conf
  mkdir -p -- "$consumer/${gate%/*}"
  printf '%s\n' '#!/usr/bin/env bash' "# Synced from bootstrap: tools/python/$gate. Do not edit this file." \
    > "$consumer/$gate"
}
gate_own() {
  python_conf
  mkdir -p -- "$consumer/${gate%/*}"
  printf '%s\n' '#!/usr/bin/env bash' 'echo own' > "$consumer/$gate"
}
python_files_edit() {
  awk -v old="$1" -v new="$2" '$0 == old { $0 = new } { print }' "$clone/tools/python/tools.toml" > "$tmp/python.toml"
  cp -- "$tmp/python.toml" "$clone/tools/python/tools.toml"
}
ruff_no_requires() {
  awk '/^\[mise.tools.ruff\]$/ { r = 1 } r && /^requires = / { r = 0; next } { print }' \
    "$clone/tools/python/tools.toml" > "$tmp/python.toml"
  cp -- "$tmp/python.toml" "$clone/tools/python/tools.toml"
}
pyrefly_missing_file() {
  python_files_edit 'files = [ ".config/mise/tasks/code/lint/pyrefly" ]' 'files = [ ".config/mise/tasks/code/lint/nope" ]'
}
pyrefly_parent_path() {
  python_files_edit 'files = [ ".config/mise/tasks/code/lint/pyrefly" ]' 'files = [ "../python/tools.toml" ]'
}

lacks_gate_update() {
  check_log_lacks "files, no pyproject.toml: the gates are skipped" "would update $consumer/$gate"
  check_log_lacks "files, no pyproject.toml: code:lint:uv stays" "skip file  $consumer/.config/mise/tasks/code/lint/uv"
}
lacks_gate_skip() {
  check_log_lacks "files, a pyproject.toml: the gates are written" '(no pyproject.toml)'
  check_log_lacks "files, a pyproject.toml: no files in the mise config" 'files ='
}
lacks_gate_remove() { check_log_lacks "files, a gate of the repo without the header" 'would remove'; }
has_gate_remove() {
  if grep -qF -- "would remove $consumer/$gate (no pyproject.toml)" "$log"; then
    print_success "files, a synced gate: would remove"
  else
    print_error "files, a synced gate: the output lacks would remove"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}

run_case "files, no pyproject.toml: the gates are skipped" 0 "$python_values" python_conf \
  'skip file  ' lacks_gate_update
run_case "files, a pyproject.toml at the root: the gates are written" 0 "$python_values" pyproject_root \
  "$gate" lacks_gate_skip
run_case "files, no pyproject.toml: a synced gate is removed" 0 "$python_values" gate_synced \
  "$gate (no pyproject.toml)" has_gate_remove
run_case "files, no pyproject.toml: a gate of the repo without the header stays" 0 "$python_values" gate_own \
  "$gate (no pyproject.toml)" lacks_gate_remove
run_case "files without requires" 2 "$python_values" ruff_no_requires \
  "files of mise tool 'ruff' in tools/python/tools.toml: the entry has no requires"
run_case "files, a path that is not a file of the tool folder" 2 "$python_values" pyrefly_missing_file \
  "'.config/mise/tasks/code/lint/nope' is not a file of tools/python"
run_case "files, a path outside the tool folder" 2 "$python_values" pyrefly_parent_path \
  "'../python/tools.toml' is not a file of tools/python"
run_case "[overrides.mise.tools.ruff] files" 2 "$python_values
[overrides.mise.tools.ruff]
files = []" '' 'the envs, the depends, the requires and the files of a mise tool cannot be overridden'

# kotlin and swift in ci. A dry run shows the diff of an existing file only,
# so each case makes one generated file of the consumer.
conf_file() {
  mkdir -p -- "$consumer/.config/mise/conf.d/$1"
  printf '%s\n' x > "$consumer/.config/mise/conf.d/$1/mise.$2.toml"
}
kotlin_ci() { conf_file kotlin ci; }
kotlin_dev() { conf_file kotlin dev; }
swift_ci() { conf_file swift ci; }

kotlin_values='environments = [ "dev", "ci" ]
[tools.kotlin]
env = [ "dev", "ci" ]'
lacks_kotlin_lsp() { check_log_lacks "[tools.kotlin] env dev, ci: the gates in ci" 'kotlin-lsp'; }
run_case "[tools.kotlin] env dev, ci: the gates in ci" 0 "$kotlin_values" kotlin_ci '+[tools.ktlint]' \
  lacks_kotlin_lsp
run_case "[tools.kotlin] env dev, ci: kotlin-lsp in dev" 0 "$kotlin_values" kotlin_dev 'kotlin-lsp'
run_case "[tools.swift] env dev, ci: os macos in ci" 0 'environments = [ "dev", "ci" ]
[tools.swift]
env = [ "dev", "ci" ]' swift_ci '+os = "macos"'

# The consumer already has a .gitignore, so the dry run shows its diff.
gitignore_file() {
  printf '%s\n' x > "$consumer/.gitignore"
}

old_gitignore_file() {
  mkdir -p -- "$consumer/.config/repo-sync"
