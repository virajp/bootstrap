  check_that "merge link, dry run: the message" log_has "$(m_file json) is a symlink - kept it as it is"
  check_link_kept "merge link, dry run" "$(m_file json)" "$tmp/outside/m.json"
  check_that "merge link, dry run: no bootstrap_commit" no_commit_set
  check_that "merge link, dry run: would set nothing" log_lacks 'would set bootstrap_commit'
}
