# The rules of a [files] table. The tool `fixture` is not selected.
files_table() {
  fixture_txt
  fixture_toml '[files."a.txt"]' "$@"
}
files_unknown_key() { files_table 'owner = "me"'; }
files_no_source() {
  fixture_txt
  fixture_toml '[files."nope.txt"]' 'mode = "seed"'
}
files_tmpl_target() {
  fixture_txt
  fixture_file b.txt.tmpl 'b'
  fixture_toml '[files."b.txt.tmpl"]' 'mode = "seed"'
}
# files_merge_key <key>: a merge target spelled <key>. The file sub/m.json
# exists, so only the spelling of the key breaks the rule.
files_merge_key() {
  fixture_tool
  mkdir -p -- "$clone/repo/tools/fixture/sub"
  fixture_file sub/m.json '{"a": 1}'
  fixture_toml "[files.\"$1\"]" 'mode = "merge"'
}
files_dot_target() { files_merge_key ./sub/m.json; }
files_double_slash_target() { files_merge_key sub//m.json; }
# A file system that ignores case finds A.TXT, and only the exact match refuses it.
files_case_variant() {
  fixture_txt
  fixture_toml '[files."A.TXT"]' 'mode = "seed"'
}
# The file exists through the link, and only the exact match refuses it.
files_symlink_folder() {
  files_merge_key link/m.json
  ln -s sub "$clone/repo/tools/fixture/link"
}
files_both_sources() {
  fixture_txt
  fixture_file a.txt.tmpl 'a'
}
files_not_table() {
  fixture_txt
  fixture_toml '[files]' '"a.txt" = 1'
}
files_bad_mode() { files_table 'mode = "copy"'; }
files_bad_format() { files_table 'format = "ini"'; }
files_requires_parent() { files_table 'requires = [ "../a" ]'; }
files_requires_inner() { files_table 'requires = [ "x/../a" ]'; }
files_requires_absolute() { files_table 'requires = [ "/a" ]'; }
files_requires_empty() { files_table 'requires = []'; }
files_requires_number() { files_table 'requires = 1'; }
files_found_slash() { files_table 'requires_found = [ "a/b" ]'; }
files_found_empty() { files_table 'requires_found = []'; }
files_two_errors() { files_table 'format = "ini"' 'mode = "copy"'; }
