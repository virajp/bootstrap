run_case "[overrides.mise.tools.ruff] requires" 2 "$python_values
[overrides.mise.tools.ruff]
requires = \"setup.py\"" '' 'the envs, the depends and the requires of a mise tool cannot be overridden' || true

# kotlin and swift in ci. A dry run shows the diff of an existing file only,
# so each case makes one generated file of the consumer.
conf_file() {
  mkdir -p -- "$consumer/.config/mise/conf.d/$1"
  printf '%s\n' x > "$consumer/.config/mise/conf.d/$1/mise.$2.toml"
}
kotlin_ci() { conf_file kotlin ci; }
kotlin_dev() { conf_file kotlin dev; }
swift_ci() { conf_file swift ci; }

kotlin_values='environments = [ "dev", "ci" ]
[tools.kotlin]
env = [ "dev", "ci" ]'
