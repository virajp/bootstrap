[overrides.gitignore]
add = "/build/"' '' 'must be a list of one-line strings' || true
run_case "[overrides.gitignore] add, an empty line" 2 'environments = [ "dev" ]
[overrides.gitignore]
add = [ " " ]' '' 'has an empty line' || true

