old_conf_macos() { old_conf_file '# Generated by macos-setup'; }
old_conf_own() { old_conf_file '# Written by this repo.'; }
old_conf_mention() {
  mkdir -p -- "$consumer/${old_conf%/*}"
  printf '%s\n' '# Hand-written. Not Generated by macos-setup, keep it.' > "$consumer/$old_conf"
  manifest_file "oldtool${tab}$old_conf"
}

check_old_conf_removed() {
  if grep -qF -- "would remove $consumer/$old_conf" "$log"; then
    print_success "the header on line 2: would remove"
  else
    print_error "the header on line 2: the output lacks would remove"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}
lacks_old_conf_remove() {
  check_log_lacks "a file without the header stays" "would remove $consumer/$old_conf"
}
lacks_old_conf_remove_mention() {
  check_log_lacks "a comment that only mentions a header text stays" "would remove $consumer/$old_conf"
}

run_case "the header on line 2: Synced from bootstrap" 0 'environments = [ "dev" ]' old_conf_bootstrap '' \
  check_old_conf_removed
run_case "the header on line 2: Synced from repo-config" 0 'environments = [ "dev" ]' old_conf_repo_config '' \
  check_old_conf_removed
run_case "the header on line 2: Generated by macos-setup" 0 'environments = [ "dev" ]' old_conf_macos '' \
  check_old_conf_removed
run_case "a file without the header stays" 0 'environments = [ "dev" ]' old_conf_own '' lacks_old_conf_remove
