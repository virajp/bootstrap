  printf '%s\n' '/build/' > "$consumer/.config/repo-sync/gitignore"
}

run_case "[overrides.gitignore] remove" 0 'environments = [ "dev" ]
[overrides.gitignore]
remove = [ "*.log" ]
add = [ "/coverage/" ]' gitignore_file '+# *.log  # override: removed by .config/bootstrap.toml' || true
