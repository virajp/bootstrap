# A template of the repo-sync tool that prints .sync_engine. The consumer
# already has its output file, so the dry run shows its diff.
sync_engine_template() {
  local path=.config/sync-engine-path
  {
    printf '%s\n' "# Synced from bootstrap: repo/tools/repo-sync/$path.tmpl. Do not edit this file."
    printf '%s\n' '# The next sync replaces it, and a manual change is lost.'
    printf '%s\n' '<% .sync_engine %>'
  } > "$clone/repo/tools/repo-sync/$path.tmpl"
  printf '%s\n' x > "$consumer/$path"
}
check_sync_engine() {
  if grep -qE '^\+.*/sync-engine$' "$log"; then
    print_success "the template context has sync_engine: the path of the copy"
  else
    print_error "the template context has sync_engine: no line ends in /sync-engine"
    sed 's/^/    /' "$log" >&2
    failures=$((failures + 1))
  fi
}
run_case "the template context has sync_engine" 0 'environments = [ "dev" ]' sync_engine_template '' check_sync_engine

