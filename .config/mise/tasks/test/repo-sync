# A live holder makes the run wait. When the holder dies, the run takes its
# stale lock.
sleep 30 &
holder=$!
mkdir -- "$cache/lock"
printf '%s\n' "$holder" > "$cache/lock/pid"
run_configs "file://$tmp/remote" &
