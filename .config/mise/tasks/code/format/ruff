#!/usr/bin/env bash
# Synced from bootstrap: tools/python/.config/mise/tasks/code/format/ruff. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Check or format the Python files with ruff"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .py and .pyi files are used; the default is the whole project"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the python tool. The sync installs ruff only in a repository
# with a pyproject.toml. Without ruff, the task does not apply and prints
# nothing.
mise x -- which ruff > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:format passes its files to each code:format:* task. Only the Python
# files are for ruff. Given files without a Python file: nothing to do.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
TARGETS=()
if ((${#FILES[@]})); then
  for file in "${FILES[@]}"; do
    [[ ("${file}" == *.py || "${file}" == *.pyi) && -f "${file}" ]] && TARGETS+=("${file}")
  done
  ((${#TARGETS[@]})) || exit 0
fi

ARGS=()
[[ "${usage_fix:-false}" == "true" ]] || ARGS+=(--check)
[[ "${usage_debug:-false}" == "true" ]] && ARGS+=(--verbose)

print_header "Formatting the Python files with ruff ..."
# --force-exclude: a given file that the ruff config excludes stays excluded.
mise x -- ruff format --force-exclude ${ARGS[@]+"${ARGS[@]}"} ${TARGETS[@]+"${TARGETS[@]}"}
