#!/usr/bin/env bash
# Synced from bootstrap: tools/claude/.config/mise/tasks/code/graph. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Refresh the graphify knowledge graph after a commit (code only, no LLM)"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Runs from the pre-commit framework's post-commit and post-merge stages (see
# .config/pre-commit-config.yaml), replacing graphify's own raw git hook. The
# raw hook pinned a Python interpreter path at install time and broke on every
# graphify upgrade; here mise resolves the CLI, so nothing is pinned.
#
# `--force` rebuilds whatever HEAD changed; `GRAPHIFY_SKIP_HOOK=1` skips.
#
# One refresh at a time: the lock folder `graphify-refresh.lock` in the git
# folder holds the pid of the background refresh. A run that finds a live
# refresh leaves the mark `graphify-refresh.again`, and the refresh runs once
# more when it ends. Thus `code:merge`, whose pull and merge each run this
# task, ends with one graph of the newest tree.

FORCE=false
[ "${1:-}" = "--force" ] && FORCE=true

if [ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ]; then
  exit 0
fi

if ! mise x -- which graphify > /dev/null 2>&1; then
  print_warn "graphify is not on PATH — graph not refreshed (mise use -g pipx:graphifyy@latest)"
  exit 0
fi

# Only the main checkout holds a graph; a linked worktree never rebuilds one.
GIT_DIR_ABS="$(cd "$(git rev-parse --git-dir)" && pwd -P)"
GIT_COMMON_ABS="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
if [ "$GIT_DIR_ABS" != "$GIT_COMMON_ABS" ]; then
  exit 0
fi

# Never during a rebase, merge or cherry-pick: the rebuild would race the
# working tree the operation is still writing.
for marker in rebase-merge rebase-apply; do
  [ -d "$GIT_DIR_ABS/$marker" ] && exit 0
done
for marker in MERGE_HEAD CHERRY_PICK_HEAD; do
  [ -f "$GIT_DIR_ABS/$marker" ] && exit 0
done

if [ "$FORCE" = false ]; then
  # pre-commit sets PRE_COMMIT_IS_SQUASH_MERGE only in post-merge. A merge or
  # a fast-forward pull can bring many commits: git sets ORIG_HEAD to the tip
  # before it. A squash merge makes no commit, so its diff is empty.
  if [ -n "${PRE_COMMIT_IS_SQUASH_MERGE+x}" ]; then
    CHANGED="$(git diff --name-only ORIG_HEAD HEAD 2> /dev/null || true)"
  else
    CHANGED="$(git diff --name-only HEAD~1 HEAD 2> /dev/null || git diff --name-only HEAD 2> /dev/null || true)"
  fi
  # A commit that only touched graphify-out/ is the previous rebuild landing;
  # rebuilding again would loop.
  if [ -z "$(printf '%s\n' "$CHANGED" | grep -v '^graphify-out/' || true)" ]; then
    exit 0
  fi
fi

# Deterministic clustering: louvain iterates string-keyed sets whose order
# follows PYTHONHASHSEED, so an unpinned seed churns community ids per run.
export PYTHONHASHSEED=0

LOG="${HOME}/.cache/graphify-rebuild.log"
mkdir -p "$(dirname "$LOG")"

FORCE_FLAG=""
[ "$FORCE" = true ] && FORCE_FLAG="--force"

LOCK="${GIT_COMMON_ABS}/graphify-refresh.lock"
AGAIN="${GIT_COMMON_ABS}/graphify-refresh.again"

# 0 when the lock of a dead refresh was removed. The removal is in its own
# lock, so that two runs cannot both remove it. A folder without a pid that is
# older than one minute is from a run that stopped before it wrote the pid.
remove_stale_lock() {
  local pid stale=1
  mkdir -- "${LOCK}.takeover" 2> /dev/null || {
    if [ -n "$(find "${LOCK}.takeover" -maxdepth 0 -mmin +1 2> /dev/null)" ]; then
      rm -rf -- "${LOCK}.takeover"
    fi
    return 1
  }
  pid="$(cat -- "${LOCK}/pid" 2> /dev/null)" || pid=''
  if [ -n "$pid" ]; then
    kill -0 "$pid" 2> /dev/null || stale=0
  elif [ -n "$(find "${LOCK}" -maxdepth 0 -mmin +1 2> /dev/null)" ]; then
    stale=0
  fi
  [ "$stale" = 0 ] && rm -rf -- "${LOCK}"
  rmdir -- "${LOCK}.takeover"
  return "$stale"
}

# Take the lock, or leave the mark for the refresh that holds it. The second
# mkdir covers a refresh that ended between the first mkdir and the mark.
until mkdir -- "$LOCK" 2> /dev/null; do
  remove_stale_lock && continue
  : > "$AGAIN"
  mkdir -- "$LOCK" 2> /dev/null && break
  print_yellow "graphify: a refresh is running - it refreshes once more when it ends"
  exit 0
done

# The pid of this subshell: bash 3.2 has no BASHPID, and the parent of a
# simple command is the shell that runs it.
write_pid() { sh -c 'echo "$PPID"' > "${LOCK}/pid"; }

print_yellow "graphify: refreshing the graph in the background (log: ${LOG})"
# Detached so the commit returns at once; a full rebuild can take minutes.
# The subshell ignores SIGHUP, as nohup does, and releases the lock at its
# end. A mark that comes after its last check makes it take the lock again.
(
  trap '' HUP
  write_pid
  while :; do
    while :; do
      rm -f -- "$AGAIN"
      # shellcheck disable=SC2086
      mise x -- graphify update . $FORCE_FLAG || true
      FORCE_FLAG=""
      [ -e "$AGAIN" ] || break
    done
    rm -rf -- "$LOCK"
    [ -e "$AGAIN" ] && mkdir -- "$LOCK" 2> /dev/null || break
    write_pid
  done
) >> "$LOG" 2>&1 < /dev/null &
disown
exit 0
