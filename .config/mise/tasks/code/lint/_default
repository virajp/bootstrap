#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/tasks/code-lint.tmpl. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
#MISE description="Lint files"
#MISE dir="{{ config_root }}"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to lint in this repository; the default is the whole tree"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd $MISE_PROJECT_ROOT

[[ "${usage_fix:-false}" == "true" ]] && FIX="--fix" || FIX=""
# Unquoted on purpose where it is used: empty adds no argument.
[[ "${usage_debug:-false}" == "true" ]] && DEBUG="--debug" || DEBUG=""

# The pre-commit hook passes the staged files.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"

# The linters: each code:lint:<name> task, from a tool or from this
# repository, in the order of its number (05-linter first). Each gets the
# same files, and picks the ones of its language.
for task in $(own_tasks code:lint); do
  mise run "${task}" ${FIX} ${DEBUG} ${FILES[@]+"${FILES[@]}"}
done

print_success "Linting done"
