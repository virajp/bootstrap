#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/go/tasks/code-lint-gomod. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Fail when a go.mod or a go.sum is not tidy"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="run go mod tidy in each selected module"
#USAGE arg "[files]" var=#true help="the files to lint; a .go file, a go.mod or a go.sum selects its module; the default is the uncommitted files"
#FILES include="*.go go.mod go.sum"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the go tool. Without go, the task does not apply and prints
# nothing.
mise x -- which go > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its flags and files to each code:lint:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

# A file of the list selects the module of its nearest go.mod: a new import in
# a Go file can make go.mod untidy. No module: nothing to do.
MODULES=()
while IFS= read -r file; do
  dir=$(dirname "${file}")
  while [[ ! -f "${dir}/go.mod" && "${dir}" != "." && "${dir}" != "/" ]]; do
    dir=$(dirname "${dir}")
  done
  [[ -f "${dir}/go.mod" ]] || continue
  [[ " ${MODULES[*]-} " == *" ${dir} "* ]] || MODULES+=("${dir}")
done < "${list}"
((${#MODULES[@]})) || exit 0

print_header "Checking the Go modules with go mod tidy ..."
for dir in "${MODULES[@]}"; do
  print_subheader "Checking the module in ${dir} ..."
  if [[ "${usage_fix:-false}" == "true" ]]; then
    (cd "${dir}" && mise x -- go mod tidy)
  else
    # -diff prints the changes that go mod tidy makes, and exits 1 when there
    # are changes. It writes no file.
    (cd "${dir}" && mise x -- go mod tidy -diff)
  fi
done
