#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/linter/tasks/code-lint-linter. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Lint the files with the linter and ShellCheck"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to lint; the default is the whole tree"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the linter tool. Without the linter, the task does not apply
# and prints nothing.
mise x -- which linter > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="--debug" || LOG_LEVEL=""
[[ "${usage_fix:-false}" == "true" ]] && FIX="--fix" || FIX=""

# The pre-commit hook passes the staged files.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"

print_header "Linting the files with the linter ..."
mise x -- linter \
  ${LOG_LEVEL} \
  ${FIX} \
  ${FILES[@]+"${FILES[@]}"}

# The shell files go to ShellCheck: the given ones, else every tracked one. It
# cannot parse zsh or a template, so they are skipped. Only warnings and errors
# fail; the info and style notes are advice.
SHELL_FILES=()
while IFS= read -r file; do
  [[ "${file}" == *.tmpl ]] && continue
  head -n 1 "${file}" | grep -q zsh && continue
  SHELL_FILES+=("${file}")
done < <(shell_files_in_scope ${FILES[@]+"${FILES[@]}"})
if ((${#SHELL_FILES[@]})); then
  print_subheader "Checking the shell scripts with ShellCheck ..."
  mise x -- shellcheck --severity=warning "${SHELL_FILES[@]}"
fi
