#!/usr/bin/env bash
# Synced from bootstrap: tools/python/.config/mise/tasks/code/lint/pyrefly. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Type check the Python files with pyrefly"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; pyrefly check only reports"
#USAGE arg "[files]" var=#true help="the files to check; only the .py and .pyi files are used; the default is the whole project"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the python tool. The sync installs pyrefly only in a repository
# with a pyproject.toml. Without pyrefly, the task does not apply and prints
# nothing.
mise x -- which pyrefly > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Only the Python files
# are for pyrefly. Given files without a Python file: nothing to do.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
TARGETS=()
if ((${#FILES[@]})); then
  for file in "${FILES[@]}"; do
    [[ ("${file}" == *.py || "${file}" == *.pyi) && -f "${file}" ]] && TARGETS+=("${file}")
  done
  ((${#TARGETS[@]})) || exit 0
fi

print_header "Type checking the Python files with pyrefly ..."
# Without files, pyrefly checks the project of its config. With files, it
# finds the config of each file.
mise x -- pyrefly check ${TARGETS[@]+"${TARGETS[@]}"}
