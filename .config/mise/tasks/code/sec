#!/usr/bin/env bash
# Synced from repo-config: tools/base/.config/mise/tasks/code/sec. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Security check (gitleaks + grype)"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--staged" help="scan only the staged changes for secrets, and skip grype (for the pre-commit hook)"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# The hook scans what is staged: the commit is the content that leaves the
# machine. grype reads the lockfiles of the whole tree, so it belongs to the
# full run and to CI, not to each commit.
if [[ "${usage_staged:-false}" == "true" ]]; then
  print_header "Scanning the staged changes for secrets ..."
  [[ "${usage_debug:-false}" == "true" ]] && FLAGS="--verbose" || FLAGS=""
  mise x -- gitleaks git --staged --config "$MISE_PROJECT_ROOT/.config/gitleaks.toml" --redact 50 ${FLAGS}
  exit 0
fi

print_header "Scanning for security problems ..."

print_subheader "Scanning the dependencies with grype ..."
[[ "${usage_debug:-false}" == "true" ]] && FLAGS="-vv" || FLAGS=""
mise x -- grype . --config .config/grype.yaml --name ${MISE_PROJECT_ROOT} ${FLAGS}

print_subheader "Scanning the files for secrets with gitleaks ..."
[[ "${usage_debug:-false}" == "true" ]] && FLAGS="--verbose" || FLAGS=""
mise x -- gitleaks dir ${PWD} --config $MISE_PROJECT_ROOT/.config/gitleaks.toml --redact 50 ${FLAGS}

print_success "Scanning done"
