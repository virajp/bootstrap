#!/usr/bin/env bash
# Synced from bootstrap: tools/git/.config/mise/tasks/code/merge/_default. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Land a feature branch on the only long-lived branch — merge it, or open a pull request"

#USAGE arg "<branch>" help="the local branch to merge into main or develop"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/merge"

# For a repo with only one of `main` and `develop`. `repo_sync` writes this task
# instead of `code:merge:develop` and `code:merge:main` when it finds only one of
# them, so the destination is the branch that exists.
if branch_exists main && branch_exists develop; then
  print_error "this repo has both 'main' and 'develop'."
  print_warn "- run \`mise run setup:configs\` to get \`code:merge:develop\` and \`code:merge:main\`"
  exit 1
elif branch_exists main; then
  DESTINATION=main
elif branch_exists develop; then
  DESTINATION=develop
else
  print_error "this repo has neither 'main' nor 'develop'."
  exit 1
fi

# `usage_branch` is set by mise from the `#USAGE arg` above, so shellcheck
# cannot see the assignment.
# shellcheck disable=SC2154
merge_to_destination_branch "${DESTINATION}" "${usage_branch}"
