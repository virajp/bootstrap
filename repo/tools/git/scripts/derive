#!/usr/bin/env bash
# The derive script of the git tool. The sync runs it in the root of the
# repository, and never copies it. It prints the values of the branch model:
# - branch_pair is true when core_branches of .config/bootstrap/repo.toml has
#   both main and develop. A [tasks] entry with `when = "git.branch_pair"` (or
#   "!git.branch_pair") applies to one branch model only.
# - protected_branches is each core branch whose landing in
#   [branches.<name>] is not direct-commit. The pre-commit config gives them to
#   the no-commit-to-branch hook.
# The input has no keys of repo.toml, so the script reads them with
# `bootstrap config get`, which reads the values folder of the sync
# (BOOTSTRAP_VALUES). repo.toml has no overrides.

set -euo pipefail

# Read stdin, so the writer of the input never blocks.
cat > /dev/null

# The fallback for an engine older than 4.0.0, which has no `config get`. Such
# an engine reads the old values file .config/bootstrap.toml, and sets
# BOOTSTRAP_VALUES to that file or not at all. Then the script gives the values
# from the git refs and the old values file, as before 4.0.0. Remove this
# fallback after the release of bootstrap 4.0.0.
legacy=${BOOTSTRAP_VALUES:-}
if [[ -f ${legacy} ]] || [[ -z ${legacy} && ! -d .config/bootstrap && -f .config/bootstrap.toml ]]; then
  values=${legacy:-.config/bootstrap.toml}
  overrides=${values%.toml}.overrides.toml
  # A branch that exists here or on origin.
  legacy_branch_exists() {
    git show-ref --verify --quiet "refs/heads/$1" ||
      git show-ref --verify --quiet "refs/remotes/origin/$1"
  }
  # direct_commit of the branch <name>: the overrides file wins.
  legacy_direct_commit() {
    local value=false file v
    for file in "${values}" "${overrides}"; do
      [[ -f ${file} ]] || continue
      v=$(B="$1" mise x yq@latest -- yq -p toml -o yaml '.tools.git.branch[strenv(B)].direct_commit // ""' "${file}") || v=''
      [[ -n ${v} ]] && value=${v}
    done
    printf '%s' "${value}"
  }
  pair=false
  if legacy_branch_exists main && legacy_branch_exists develop; then
    pair=true
  fi
  protected=()
  for name in main develop; do
    [[ $(legacy_direct_commit "${name}") == true ]] || protected+=("\"${name}\"")
  done
  list=$(IFS=,; printf '%s' "${protected[*]-}")
  printf '{"branch_pair": %s, "protected_branches": [%s]}\n' "${pair}" "${list}"
  exit 0
fi

# jq of the PATH, else the jq of mise.
jq_() {
  if command -v jq > /dev/null 2>&1; then
    jq "$@"
  else
    mise x jq@latest -- jq "$@"
  fi
}

# The engine of the sync (BOOTSTRAP_BIN), else the bootstrap of mise.
bin=(mise x -- bootstrap)
[[ -z ${BOOTSTRAP_BIN:-} ]] || bin=("${BOOTSTRAP_BIN}")

# get <key>: the value of <key> as JSON. Without an engine that answers, the
# script stops with code 2; a read failure stops it with code 1.
get() {
  local out rc=0
  if [[ -z ${BOOTSTRAP_BIN:-} ]] && ! mise x -- which bootstrap > /dev/null 2>&1; then
    rc=2
  else
    out=$("${bin[@]}" config get "$1" --format json) || rc=$?
  fi
  if ((rc == 0)); then
    jq_ -c '.value' <<< "${out}"
    return 0
  fi
  ((rc != 1)) || exit 1
  printf '%s\n' "bootstrap config get $1 failed - it needs bootstrap 4.0.0 or newer: mise use -g github:virajp/bootstrap" >&2
  exit 2
}

core=$(get repo.core_branches) || exit $?
branches=$(get repo.branches) || exit $?

jq_ -cn --argjson core "${core}" --argjson branches "${branches}" '
  ($core // []) as $c | ($branches // {}) as $b
  | {branch_pair: (($c | index("main")) != null and ($c | index("develop")) != null),
    protected_branches: [$c[] | select(($b[.].landing // "direct-merge") != "direct-commit")]}'
