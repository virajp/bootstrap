#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/kotlin/tasks/code-format-ktlint. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check or format the Kotlin files with ktlint"
#MISE hide=true

#USAGE flag "--all" help="format every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .kt and .kts files are used; the default is the uncommitted files"
#FILES include="*.kt *.kts" exclude="**/generated/**"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the kotlin tool. Without ktlint, the task does not apply and
# prints nothing.
mise x -- which ktlint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:format passes its flags and files to each code:format:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

ARGS=(--relative --editorconfig=.config/ktlint.editorconfig)
[[ "${usage_debug:-false}" == "true" ]] && ARGS+=(--log-level=debug)
[[ "${usage_fix:-false}" == "true" ]] && ARGS+=(--format)

print_header "Formatting the Kotlin files with ktlint ..."
# Without --fix, the check is the lint of ktlint: it reports each file that
# --format changes, and each problem that --format cannot fix.
tr '\n' '\0' < "${list}" | xargs -0 mise x -- ktlint "${ARGS[@]}"
