#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/android/tasks/test-golden-android. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Verify the Android screens against their golden images with Roborazzi or Paparazzi; --record records them again"
#MISE hide=true

#USAGE flag "--record" help="record every golden again instead of verifying against them"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "${MISE_PROJECT_ROOT}"

# Shipped with the android tool. It acts on the Gradle build at the root only:
# the android/ folder of a Flutter app is for the flutter tool. Its one flag is
# --record, because test:golden passes the same arguments to each part. It
# reads this value, with a default; a repository sets it in the [env] of
# .config/mise/conf.d/zz-repo/mise.<env>.toml:
#   ANDROID_VARIANT  the build variant whose unit tests hold the goldens
#                    (debug)
#
# The library comes from the plugin ids in settings.gradle(.kts), each
# build.gradle(.kts) and gradle/libs.versions.toml: Roborazzi
# (io.github.takahirom.roborazzi), Paparazzi (app.cash.paparazzi), or both.
# Without either id or without an executable ./gradlew, the part does not
# apply and prints nothing.
[[ -x gradlew ]] || exit 0
# A failed git stops the task, with the error of git.
LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- \
  settings.gradle settings.gradle.kts build.gradle build.gradle.kts \
  '*/build.gradle' '*/build.gradle.kts' gradle/libs.versions.toml)
FILES=()
while IFS= read -r file; do
  [[ -n "${file}" && -f "${file}" ]] && FILES+=("${file}")
done <<< "${LIST}"
((${#FILES[@]})) || exit 0

ROBORAZZI=false
PAPARAZZI=false
grep -qF 'io.github.takahirom.roborazzi' "${FILES[@]}" && ROBORAZZI=true
grep -qF 'app.cash.paparazzi' "${FILES[@]}" && PAPARAZZI=true
[[ "${ROBORAZZI}" == "true" || "${PAPARAZZI}" == "true" ]] || exit 0

VARIANT="${ANDROID_VARIANT:-debug}"
FIRST=$(printf '%s' "${VARIANT:0:1}" | tr '[:lower:]' '[:upper:]')
VARIANT_NAME="${FIRST}${VARIANT:1}"

[[ "${usage_record:-false}" == "true" ]] && MODE=record || MODE=verify
TASKS=()
[[ "${ROBORAZZI}" == "true" ]] && TASKS+=("${MODE}Roborazzi${VARIANT_NAME}")
[[ "${PAPARAZZI}" == "true" ]] && TASKS+=("${MODE}Paparazzi${VARIANT_NAME}")

if [[ "${MODE}" == "record" ]]; then
  print_header "Recording the Android goldens (${VARIANT_NAME}) ..."
else
  # Verify fails on a changed render and on a screen with no golden.
  print_header "Verifying the Android goldens (${VARIANT_NAME}) ..."
fi
./gradlew "${TASKS[@]}"
