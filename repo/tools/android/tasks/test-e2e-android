#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/android/tasks/test-e2e-android. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Run the instrumented Android tests on a Gradle managed device, or on the connected device"
#MISE hide=true

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "${MISE_PROJECT_ROOT}"

# Shipped with the android tool. It acts on the Gradle build at the root only:
# the android/ folder of a Flutter app is for the flutter tool. The part has
# no flag, because test:e2e passes the same arguments to each part. It reads
# these values, with a default; a repository sets them in the [env] of
# .config/mise/conf.d/zz-repo/mise.<env>.toml:
#   ANDROID_VARIANT    the build variant whose androidTest source set runs
#                      (debug)
#   ANDROID_DEVICE     the managed device of testOptions.managedDevices (e2e)
#   ANDROID_CONNECTED  true runs connected<Variant>AndroidTest on the device or
#                      emulator already attached, and ANDROID_DEVICE does not
#                      apply (false)
#
# Without an executable ./gradlew or without a src/androidTest folder in a
# module, the part does not apply and prints nothing.
[[ -x gradlew ]] || exit 0
# A failed git stops the task, with the error of git.
LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- \
  'src/androidTest/*' '*/src/androidTest/*')
[[ -n "${LIST}" ]] || exit 0

VARIANT="${ANDROID_VARIANT:-debug}"
DEVICE="${ANDROID_DEVICE:-e2e}"
FIRST=$(printf '%s' "${VARIANT:0:1}" | tr '[:lower:]' '[:upper:]')
VARIANT_NAME="${FIRST}${VARIANT:1}"

if [[ "${ANDROID_CONNECTED:-false}" == "true" ]]; then
  TASK="connected${VARIANT_NAME}AndroidTest"
  print_header "Running ${TASK} on the connected device ..."
else
  TASK="${DEVICE}${VARIANT_NAME}AndroidTest"
  print_header "Running ${TASK} on the managed device ${DEVICE} ..."
fi

if [[ -z "${ANDROID_HOME:-}" || ! -d "${ANDROID_HOME}/platforms" ]]; then
  print_error "test:e2e: no Android SDK at ANDROID_HOME (${ANDROID_HOME:-unset})."
  print_yellow "Run: mise run setup"
  exit 1
fi

GRADLE_ARGS=()
# A CI runner has no GPU; the software renderer keeps the managed emulator
# deterministic there.
if [[ "${ANDROID_CONNECTED:-false}" != "true" && -n "${CI:-}" ]]; then
  GRADLE_ARGS+=(-Pandroid.testoptions.manageddevices.emulator.gpu=swiftshader_indirect)
fi

./gradlew ${GRADLE_ARGS[@]+"${GRADLE_ARGS[@]}"} "${TASK}"
