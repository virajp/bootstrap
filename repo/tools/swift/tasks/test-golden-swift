#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/swift/tasks/test-golden-swift. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Compare the views of the Xcode app against their golden images; --record records them again"
#MISE hide=true

#USAGE flag "--record" help="record every golden again, then compare against the new ones"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/xcode"

cd "${MISE_PROJECT_ROOT}"

# Shipped with the swift tool. Its one flag is --record, because test:golden
# passes the same arguments to each part. It reads these values, with a
# default; a repository sets them in the [env] of
# .config/mise/conf.d/zz-repo/mise.<env>.toml:
#   XCODE_SCHEME           the scheme whose test action holds the target (the
#                          name of the project)
#   XCODE_SNAPSHOT_TARGET  the snapshot test target to run (SnapshotTests)
#   SIMULATOR_PLATFORM, SIMULATOR_DEVICE, SIMULATOR_OS
#                          the simulator to render on; see _scripts/xcode
#
# Without an *.xcodeproj at the root, the part does not apply and prints
# nothing. With one, it applies: more than one *.xcodeproj or no Xcode stops
# it with code 1, and a project without the target XCODE_SNAPSHOT_TARGET
# prints nothing.
HAS_PROJECT=false
for p in *.xcodeproj; do
  [[ -d "${p}" ]] && HAS_PROJECT=true
done
[[ "${HAS_PROJECT}" == "true" ]] || exit 0

PROJECT=$(find_xcodeproj "test:golden")
require_xcode "test:golden"
TARGET="${XCODE_SNAPSHOT_TARGET:-SnapshotTests}"

# The targets are the lines below "Targets:" of xcodebuild -list, up to the
# first empty line. A failed xcodebuild stops the part with its code.
LIST=$(xcodebuild -list -project "${PROJECT}") || exit $?
FOUND=$(printf '%s\n' "${LIST}" | awk -v target="${TARGET}" '
  /^ *Targets:/ { in_targets = 1; next }
  in_targets && /^ *$/ { in_targets = 0 }
  in_targets { name = $0; sub(/^ +/, "", name); sub(/ +$/, "", name); if (name == target) { print "yes"; exit } }
') || FOUND=''
[[ "${FOUND}" == "yes" ]] || exit 0

SCHEME="${XCODE_SCHEME:-$(basename "${PROJECT}" .xcodeproj)}"
[[ "${usage_record:-false}" == "true" ]] && RECORD=true || RECORD=false

if [[ "${RECORD}" == "true" ]]; then
  print_header "Recording and comparing the Swift goldens ..."
else
  print_header "Comparing the Swift goldens ..."
fi

PLATFORM="${SIMULATOR_PLATFORM}"
if [[ "${PLATFORM}" == "macOS" ]]; then
  DESTINATION="platform=macOS"
elif [[ -z "${SIMULATOR_DEVICE:-}" || -z "${SIMULATOR_OS:-}" ]]; then
  print_error "test:golden: the ${PLATFORM} pin is incomplete - SIMULATOR_DEVICE and SIMULATOR_OS are both required."
  print_yellow "Set SIMULATOR_DEVICE and SIMULATOR_OS in the [env] of .config/mise/conf.d/zz-repo/mise.<env>.toml; xcrun simctl list devices available lists the choices."
  exit 1
else
  # require_xcode defaults the platform to iOS; xcodebuild names it
  # "iOS Simulator".
  [[ "${PLATFORM}" == "iOS" ]] && DESTINATION_PLATFORM="iOS Simulator" || DESTINATION_PLATFORM="${PLATFORM}"
  DESTINATION="platform=${DESTINATION_PLATFORM},name=${SIMULATOR_DEVICE},OS=${SIMULATOR_OS}"
fi
print_info "Destination: ${DESTINATION}"

ARTIFACTS="${PWD}/.build/snapshot-artifacts"
RESULT_BUNDLE=".build/golden.xcresult"

run_goldens() {
  rm -rf "${RESULT_BUNDLE}"
  # xcodebuild strips TEST_RUNNER_ and hands the rest to the tests.
  TEST_RUNNER_SNAPSHOT_TESTING_RECORD="$1" \
    TEST_RUNNER_SNAPSHOT_ARTIFACTS="${ARTIFACTS}" \
    xcodebuild test \
    -project "${PROJECT}" \
    -scheme "${SCHEME}" \
    -destination "${DESTINATION}" \
    -only-testing:"${TARGET}" \
    -derivedDataPath .build/DerivedData \
    -clonedSourcePackagesDirPath .build/SourcePackages \
    -onlyUsePackageVersionsFromResolvedFile \
    -resultBundlePath "${RESULT_BUNDLE}" \
    -collect-test-diagnostics never
}

if [[ "${RECORD}" == "true" ]]; then
  print_subheader "Recording the goldens ..."
  # Recording fails every assertion by design; the comparison below is the
  # verdict.
  run_goldens all || true
  print_subheader "Comparing the goldens ..."
fi

rm -rf "${ARTIFACTS}"
mkdir -p "${ARTIFACTS}"
run_goldens never
