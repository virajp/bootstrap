#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/swift/tasks/code-lint-swiftlint. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Lint the Swift files with SwiftLint"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; swift-format decides the layout"
#USAGE arg "[files]" var=#true help="the files to lint; only the .swift files are used; the default is the uncommitted files"
#FILES include="*.swift" exclude="*.generated.swift .build/** .swiftpm/** **/Derived/** **/DerivedData/**"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the swift tool. Without SwiftLint (a host that is not macOS, or
# swift not in this environment), the task does not apply and prints nothing.
mise x -- which swiftlint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its flags and files to each code:lint:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

print_header "Linting the Swift files with SwiftLint ..."
# --strict: a warning is a failure.
tr '\n' '\0' < "${list}" | xargs -0 mise x -- swiftlint lint --strict --quiet --config .config/swiftlint.yml
