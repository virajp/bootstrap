#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/swift/tasks/code-format-swift-format. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check or format the Swift files with swift-format"
#MISE hide=true

#USAGE flag "--all" help="format every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="accepted for the code:format contract"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .swift files are used; the default is the uncommitted files"
#FILES include="*.swift" exclude="*.generated.swift .build/** .swiftpm/** **/Derived/** **/DerivedData/**"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the swift tool. swift-format comes with the Swift toolchain of
# the host, not from mise. Without it, the task does not apply and prints
# nothing.
swift format --version > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:format passes its flags and files to each code:format:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

print_header "Formatting the Swift files with swift-format ..."
# Without --fix, the check is the strict lint: format has no mode that only
# reports. It also reports the rules that format cannot fix.
if [[ "${usage_fix:-false}" == "true" ]]; then
  tr '\n' '\0' < "${list}" | xargs -0 swift format format --in-place --parallel --configuration .config/swift-format.json
else
  tr '\n' '\0' < "${list}" | xargs -0 swift format lint --strict --parallel --configuration .config/swift-format.json
fi
