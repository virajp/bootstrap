#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/repo-sync/tasks/code-lint-repo-sync. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Validate .config/bootstrap.toml with repo_sync --check"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="accepted and ignored: the check has no fixes"
#USAGE arg "[files]" var=#true help="the files to lint; only .config/bootstrap.toml is used; the default is .config/bootstrap.toml"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the repo-sync tool, which installs gomplate. Without gomplate,
# the task does not apply and prints nothing, so a commit never needs the
# network.
mise x -- which gomplate > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Only the values file is
# for this check. Given files without it: nothing to do. Without files, the
# check runs when the values file exists.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ((${#FILES[@]})); then
  found=false
  for file in "${FILES[@]}"; do
    [[ "${file}" == ".config/bootstrap.toml" ]] && found=true
  done
  [[ "${found}" == "true" ]] || exit 0
else
  [[ -f .config/bootstrap.toml ]] || exit 0
fi

# Without the shared cache, the gate does not apply and prints nothing.
repo="${BOOTSTRAP_CACHE:-${XDG_CACHE_HOME:-${HOME}/.cache}/bootstrap}/repo"
lib="${repo}/sync-engine/repo-sync"
[[ -f ${lib} ]] || exit 0

# This task sources code at commit time, so only from a clone of bootstrap. The
# config file itself, because a git hook sets GIT_DIR to the consumer. Any other
# origin: the gate does not apply and prints nothing.
origin=$(git config --file "${repo}/.git/config" --get remote.origin.url 2> /dev/null) || origin=''
case "${origin}" in
  https://github.com/virajp/bootstrap.git | https://github.com/virajp/bootstrap | git@github.com:virajp/bootstrap.git | git@github.com:virajp/bootstrap | ssh://git@github.com/virajp/bootstrap.git) ;;
  *)
    exit 0
    ;;
esac

print_header "Validating .config/bootstrap.toml ..."

# The check needs no clone of its own: it reads the values file, the local git
# repository, and the check scripts of the tools in the shared cache. The gate
# reads the cache without its lock, and it never clones. A fetch at the same
# time is rare, and the next commit runs the gate again.
unset REPO_SYNC_CLONE
export BOOTSTRAP_CLONE="${repo}"
# shellcheck source=/dev/null
source "${lib}"
repo_sync --check
