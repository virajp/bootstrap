#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/repo-sync/.config/mise/tasks/setup/configs/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files of this repository's tools from bootstrap"
#MISE tools.pre-commit="latest"

#USAGE flag "--dry-run" help="show the changes without writing them"
#USAGE flag "--verbose" help="list each file, also an unchanged one"
<%/* The member flags are only for the submodules: a folder of a monorepo is
   part of this tree. */ -%>
<% $subs := coll.Slice %><% range .members %><% if eq (index $.member_types .) "submodule" %><% $subs = coll.Append . $subs %><% end %><% end -%>
<% $last := math.Sub (len $subs) 1 -%>
<% if $subs -%>
#USAGE flag "--all" help="Also sync all members: <% range $i, $m := $subs %><% if $i %><% if eq $i $last %> and <% else %>, <% end %><% end %><% $m %><% end %>"
<% end -%>
<% range $subs -%>
#USAGE flag "--<% . %>" help="Also sync <% . %>"
<% end %>
set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# This task only refreshes the cache clone and copies it. The Go engine then
# runs in a child process with that copy, so a change to the sync code applies
# in the same run. sync-engine/VERSION of the copy selects the engine release.
# The cache is ~/.cache/sync-engine/, which each consumer of this machine
# uses, and each run fetches main into it. The code below is sync-engine/clone
# of the bootstrap clone: the sync embeds it when it renders this template. A
# lock makes a second run wait until the first has updated the cache and copied
# it. The sync then reads only its own copy.
<% file.Read (printf "%s/clone" .sync_engine) | strings.TrimPrefix "#!/usr/bin/env bash\n" %>
_se_clone_init
trap _se_clone_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

print_header "Fetching bootstrap ..."
_se_lock
_se_legacy_cleanup
rc=0
_se_fetch || rc=$?
((rc == 0)) || exit "${rc}"
_se_copy bootstrap || exit 1
_se_unlock

# Unquoted on purpose: empty adds no argument.
[[ "${usage_dry_run:-false}" == "true" ]] && DRY_RUN="--dry-run" || DRY_RUN=""
if [[ "${usage_verbose:-false}" == "true" ]]; then
  export SYNC_ENGINE_VERBOSE=1
fi

# The engine: SYNC_ENGINE_BIN, a local build, else the release that
# sync-engine/VERSION of the copy names. VERSION has one line, MAJOR.MINOR.PATCH.
if [[ -n ${SYNC_ENGINE_BIN:-} ]]; then
  if [[ ! -f ${SYNC_ENGINE_BIN} || ! -x ${SYNC_ENGINE_BIN} ]]; then
    print_error "SYNC_ENGINE_BIN ${SYNC_ENGINE_BIN} is not an executable file - nothing synced"
    exit 2
  fi
  engine=("${SYNC_ENGINE_BIN}")
else
  version=''
  IFS= read -r version 2> /dev/null < "${_SE_COPY}/sync-engine/VERSION" || true
  if [[ ! ${version} =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    print_error "sync-engine/VERSION of the clone is not MAJOR.MINOR.PATCH ('${version}') - nothing synced"
    exit 5
  fi
  if ! mise install "github:virajp/bootstrap@${version}"; then
    print_error "cannot install the sync engine ${version} (github:virajp/bootstrap) - nothing synced"
    exit 5
  fi
  engine=(mise x "github:virajp/bootstrap@${version}" -- sync-engine)
fi

# sync_repo <folder>: run the engine in the folder of a repository, with that
# folder as MISE_PROJECT_ROOT, as mise runs a task. The first failure stops the
# task with its code.
sync_repo() {
  local rc=0
  print_header "Syncing the shared files from bootstrap ..."
  # The tools come from the pack base and from the [tools.*] and [packs.*]
  # tables of .config/bootstrap.toml.
  # shellcheck disable=SC2086
  (cd -- "$1" && MISE_PROJECT_ROOT=$1 SYNC_ENGINE_CLONE="${_SE_COPY}" "${engine[@]}" repo ${DRY_RUN}) || rc=$?
  ((rc == 0)) || exit "${rc}"
}

sync_repo "${MISE_PROJECT_ROOT}"
<% if $subs %>
# Each member syncs from the same copy, so all get the same commit. The first
# failure stops the task: the last header names the repository that failed.
# A member is a separate repository with its own values file. Without that
# file, the engine stops with code 2.
sync_member() {
  print_header "Syncing $1 ..."
  sync_repo "${MISE_PROJECT_ROOT}/$2"
}
<% end -%>
<% range $subs %>
<% $x := dict %><% if and (has $ "member") (has $.member .) %><% $x = index $.member . %><% end -%>
if [[ "${usage_all:-false}" == "true" || "${usage_<% . | strings.ReplaceAll "-" "_" %>:-false}" == "true" ]]; then
  sync_member "<% index $x "label" | default . %>" "<% index $.member_folders . %>"
fi
<% end -%>
