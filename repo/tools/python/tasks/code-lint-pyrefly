#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/python/tasks/code-lint-pyrefly. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Type check the Python files with pyrefly"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; pyrefly check only reports"
#USAGE arg "[files]" var=#true help="the files to check; only the .py and .pyi files are used; the default is the uncommitted files"
#FILES include="*.py *.pyi"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the python tool. The sync installs pyrefly only in a repository
# with a pyproject.toml. Without pyrefly, the task does not apply and prints
# nothing.
mise x -- which pyrefly > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its flags and files to each code:lint:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

print_header "Type checking the Python files with pyrefly ..."
# pyrefly finds the config of each file.
tr '\n' '\0' < "${list}" | xargs -0 mise x -- pyrefly check
