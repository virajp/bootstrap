#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/python/tasks/code-lint-ruff. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Lint the Python files with ruff"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to lint; only the .py and .pyi files are used; the default is the uncommitted files"
#FILES include="*.py *.pyi" exclude=".config/mise/tasks/**"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the python tool. The sync installs ruff only in a repository
# with a pyproject.toml. Without ruff, the task does not apply and prints
# nothing.
mise x -- which ruff > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its flags and files to each code:lint:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

ARGS=()
[[ "${usage_fix:-false}" == "true" ]] && ARGS+=(--fix)
[[ "${usage_debug:-false}" == "true" ]] && ARGS+=(--verbose)

print_header "Linting the Python files with ruff ..."
tr '\n' '\0' < "${list}" | xargs -0 mise x -- ruff check ${ARGS[@]+"${ARGS[@]}"}
