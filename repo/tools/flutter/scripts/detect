#!/usr/bin/env bash
# The detect script of the flutter tool. bootstrap detect runs it in the root of
# the repository, and never copies it. It prints one JSON object: the result
# (match, none or mismatch), the evidence (config files, never lock files) and
# a message.

set -euo pipefail
cat > /dev/null

# Print the result as JSON: <result> <message> [evidence...].
emit() {
  local result=$1 message=$2 sep="" e
  shift 2
  printf '{ "result": "%s", "evidence": [' "$result"
  for e in "$@"; do
    printf '%s"%s"' "$sep" "$e"
    sep=", "
  done
  printf '], "message": "%s" }\n' "$message"
}

# A pubspec.yaml of Dart only has no flutter SDK dependency.
if [ -f pubspec.yaml ] && grep -Eq "^[[:space:]]*sdk:[[:space:]]*flutter[[:space:]]*$" pubspec.yaml; then
  emit match "pubspec.yaml depends on the flutter SDK" pubspec.yaml
elif [ -f pubspec.yaml ]; then
  emit none "pubspec.yaml has no flutter SDK dependency"
else
  emit none "no pubspec.yaml"
fi
