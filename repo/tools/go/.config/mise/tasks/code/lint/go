#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/go/.config/mise/tasks/code/lint/go. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Lint the Go packages with go vet"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; go vet only reports"
#USAGE arg "[files]" var=#true help="the files to lint; a .go file, a go.mod or a go.sum selects its module; the default is each module"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the go tool. Without go or without a go.mod, the task does not
# apply and prints nothing.
mise x -- which go > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"
# A failed git stops the task, with the error of git.
LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- 'go.mod' '*/go.mod' | sort -u)
[[ -n "${LIST}" ]] || exit 0

# code:lint passes its files to each code:lint:* task. go vet checks
# packages, not files: a given Go file selects the module of its nearest
# go.mod. Given files without a Go file: nothing to do. Without files, each
# module that git does not ignore.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
MODULES=()
if ((${#FILES[@]})); then
  for file in "${FILES[@]}"; do
    case "${file}" in
      *.go | go.mod | */go.mod | go.sum | */go.sum) ;;
      *)
        continue
        ;;
    esac
    dir=$(dirname "${file}")
    while [[ ! -f "${dir}/go.mod" && "${dir}" != "." && "${dir}" != "/" ]]; do
      dir=$(dirname "${dir}")
    done
    [[ -f "${dir}/go.mod" ]] || continue
    [[ " ${MODULES[*]-} " == *" ${dir} "* ]] || MODULES+=("${dir}")
  done
else
  while IFS= read -r file; do
    [[ -n "${file}" ]] && MODULES+=("$(dirname "${file}")")
  done <<< "${LIST}"
fi
((${#MODULES[@]})) || exit 0

print_header "Checking the Go packages with go vet ..."
for dir in "${MODULES[@]}"; do
  print_subheader "Checking the module in ${dir} ..."
  (cd "${dir}" && mise x -- go vet ./...)
done
