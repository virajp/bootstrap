#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/go/tasks/code-lint-go. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Lint the Go packages with golangci-lint"
#MISE hide=true

#USAGE flag "--all" help="lint every file of the repository, not only the uncommitted files"
#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="apply the fixes that golangci-lint can make"
#USAGE arg "[files]" var=#true help="the files to lint; a .go file, a go.mod or a go.sum selects its module; the default is the uncommitted files"
#FILES include="*.go go.mod go.sum"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the go tool. Without golangci-lint, the task does not apply and
# prints nothing. The sync installs golangci-lint only when it finds a go.mod.
mise x -- which golangci-lint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its flags and files to each code:lint:* task. The list
# comes from gate_files (the #FILES header above). An empty list: nothing
# to do.
args=()
[[ "${usage_all:-false}" == "true" ]] && args+=(--all)
[[ "${usage_debug:-false}" == "true" ]] && args+=(--debug)
[[ "${usage_fix:-false}" == "true" ]] && args+=(--fix)
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
list=$(gate_files "$0" ${args[@]+"${args[@]}"} ${FILES[@]+"${FILES[@]}"}) || exit $?
trap 'rm -f "${list}"' EXIT
[[ -s ${list} ]] || exit 0

# golangci-lint checks packages, not files: a file of the list selects the
# module of its nearest go.mod. No module: nothing to do.
MODULES=()
while IFS= read -r file; do
  dir=$(dirname "${file}")
  while [[ ! -f "${dir}/go.mod" && "${dir}" != "." && "${dir}" != "/" ]]; do
    dir=$(dirname "${dir}")
  done
  [[ -f "${dir}/go.mod" ]] || continue
  [[ " ${MODULES[*]-} " == *" ${dir} "* ]] || MODULES+=("${dir}")
done < "${list}"
((${#MODULES[@]})) || exit 0

# Without a config file, golangci-lint runs its standard linters: errcheck,
# govet, ineffassign, staticcheck and unused. A .golangci.yml of the module
# changes the set.
FIX=()
[[ "${usage_fix:-false}" == "true" ]] && FIX=(--fix)
print_header "Linting the Go packages with golangci-lint ..."
for dir in "${MODULES[@]}"; do
  print_subheader "Linting the module in ${dir} ..."
  (cd "${dir}" && mise x -- golangci-lint run ${FIX[@]+"${FIX[@]}"} ./...)
done
