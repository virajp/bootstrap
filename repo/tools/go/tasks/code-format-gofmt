#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/go/tasks/code-format-gofmt. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check or format the Go files with gofmt"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:format contract"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .go files are used; the default is each Go file that git does not ignore"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the go tool. Without gofmt, without a go.mod or without a Go
# file, the task does not apply and prints nothing.
mise x -- which gofmt > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"
# A failed git stops the task, with the error of git.
MODULES=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- 'go.mod' '*/go.mod')
[[ -n "${MODULES}" ]] || exit 0

# code:format passes its files to each code:format:* task. Only the Go files
# are for gofmt. Without files the list comes from git, so gofmt never reads
# an ignored folder.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ! ((${#FILES[@]})); then
  LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- '*.go' | sort -u)
  while IFS= read -r file; do
    [[ -n "${file}" ]] && FILES+=("${file}")
  done <<< "${LIST}"
fi
TARGETS=()
for file in ${FILES[@]+"${FILES[@]}"}; do
  [[ "${file}" == *.go && -f "${file}" ]] && TARGETS+=("${file}")
done
((${#TARGETS[@]})) || exit 0

print_header "Formatting the Go files with gofmt ..."
if [[ "${usage_fix:-false}" == "true" ]]; then
  mise x -- gofmt -w "${TARGETS[@]}"
  exit 0
fi
# gofmt -l lists each file that gofmt -w changes, and exits 0. Thus the
# check fails on a list that is not empty.
UNFORMATTED=$(mise x -- gofmt -l "${TARGETS[@]}")
if [[ -n "${UNFORMATTED}" ]]; then
  printf '%s\n' "${UNFORMATTED}"
  print_error "These Go files are not formatted. Run mise run code:format --fix."
  exit 1
fi
