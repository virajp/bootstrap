#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/dprint/tasks/code-format-dprint. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Check or format the files with dprint"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; the default is the whole tree"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the dprint tool. Without dprint, the task does not apply and
# prints nothing.
mise x -- which dprint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="debug" || LOG_LEVEL="warn"
[[ "${usage_fix:-false}" == "true" ]] && CMD="fmt" || CMD="check"

# The pre-commit hook passes the staged files. dprint picks the files of its
# config.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"

print_header "Formatting the files with dprint ..."
if ((${#FILES[@]})); then
  mise x -- dprint "${CMD}" --allow-no-files --log-level "${LOG_LEVEL}" "${FILES[@]}"
else
  mise x -- dprint "${CMD}" --log-level "${LOG_LEVEL}"
fi
