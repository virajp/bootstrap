#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/dprint/tasks/setup-dprint. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Upgrade dprint plugins"
#MISE hide=true
#MISE tools.dprint="latest"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Updating dprint plugins ..."

# The plugins of the shared dprint.jsonc of this repository. The sync finds a
# plugin by its name, so the new version stays at the next sync.
cd "${MISE_PROJECT_ROOT}"
mise x -- dprint config update --yes
