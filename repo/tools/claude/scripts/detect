#!/usr/bin/env bash
# The detect script of the claude tool. bootstrap detect runs it in the root of
# the repository, and never copies it. It prints one JSON object: the result
# (match, none or mismatch), the evidence (config files, never lock files) and
# a message.

set -euo pipefail
cat > /dev/null

# Print the result as JSON: <result> <message> [evidence...].
emit() {
  local result=$1 message=$2 sep="" e
  shift 2
  printf '{ "result": "%s", "evidence": [' "$result"
  for e in "$@"; do
    printf '%s"%s"' "$sep" "$e"
    sep=", "
  done
  printf '], "message": "%s" }\n' "$message"
}

found=()
[ -f CLAUDE.md ] && found+=(CLAUDE.md)
[ -d .claude ] && found+=(.claude/)
if [ ${#found[@]} -gt 0 ]; then
  emit match "a Claude Code config exists" "${found[@]}"
else
  emit none "no CLAUDE.md and no .claude/"
fi
