#!/usr/bin/env -S uv run --script
# Synced from bootstrap: repo/tools/mise/tasks/setup-worktree.py.tmpl. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
# MISE description="Initialise a fresh git worktree: checkout submodules, copy local files, install tools, secrets and deps (lighter than setup)"
# MISE hide=false
# MISE tools={uv="latest", python="3.14"}

import os
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, f"{os.environ['MISE_PROJECT_ROOT']}/.config/mise/tasks/_scripts")
<% if has .config "worktree_files" -%>
import checks  # noqa: E402
<% end -%>
import helpers  # noqa: E402


def run(*args):
  """Run the command args. A failure stops the task with its code."""
  rc = subprocess.run(list(args), check=False).returncode
  if rc != 0:
    sys.exit(rc)


# The same install steps as `setup`, without --upgrade and without the steps
# that configure the machine rather than the checkout: the linter init and
# `setup:ai`. The hooks stay: the root shares the main checkout's hooks, but a
# submodule checked out in a linked worktree gets a new git directory under
# `.git/worktrees/<name>/modules/`, with no hooks in it.

root = os.environ["MISE_PROJECT_ROOT"]

helpers.print_header("Checking out submodules ...")
run("git", "-C", root, "submodule", "update", "--init", "--recursive")
<% if has .config "worktree_files" %>
# The gitignored files a checkout needs but git never brings, copied from the
# main worktree. An existing file is never overwritten. In the main checkout
# itself there is nothing to copy from.
if checks.is_git_worktree():
  helpers.print_header("Copying local files from the main worktree ...")
  main_worktree_path = checks.get_main_worktree_path()
  files = [<% range $i, $f := .config.worktree_files %><% if $i %>, <% end %>"<% $f %>"<% end %>]
  for file in files:
    if os.path.exists(f"{root}/{file}"):
      helpers.print_info(f"{file}: already present")
    elif os.path.exists(f"{main_worktree_path}/{file}"):
      os.makedirs(os.path.dirname(f"{root}/{file}"), exist_ok=True)
      run("cp", "-R", f"{main_worktree_path}/{file}", f"{root}/{file}")
      helpers.print_success(f"{file}: copied")
    else:
      helpers.print_warn(f"{file}: not in the main worktree")
<% end %>
run("mise", "run", "setup:mise")

for task in helpers.own_tasks("setup:secrets"):
  run("mise", "run", task)

for task in helpers.own_tasks("setup:deps"):
  run("mise", "run", task)

if helpers.has_own_task("setup:precommit"):
  run("mise", "run", "setup:precommit")

<% range .members -%>
<% $x := dict %><% if and (has $ "member") (has $.member .) %><% $x = index $.member . %><% end -%>
<% if has $x "worktree_install" -%>
helpers.print_header("Installing <% . %> dependencies ...")
# The command is a shell command line, so bash runs it. The full command line
# runs in the member folder.
run(
  "mise",
  "x",
  "--cd",
  f"{root}/<% index $.member_folders . %>",
  "--",
  "bash",
  "-c",
  <% $x.worktree_install | strings.Quote %>,
)
<% else -%>
# The member runs its own git:worktree:setup task, when it has one.
os.environ["MISE_PROJECT_ROOT"] = f"{root}/<% index $.member_folders . %>"
found = helpers.has_own_task("git:worktree:setup")
os.environ["MISE_PROJECT_ROOT"] = root
if found:
  helpers.print_header("Setting up the <% index $x "label" | default . %> worktree ...")
  run("mise", "run", "--cd", f"{root}/<% index $.member_folders . %>", "git:worktree:setup")
<% end -%>

<% end -%>
helpers.line_sep1()
helpers.print_success("Worktree ready!")
