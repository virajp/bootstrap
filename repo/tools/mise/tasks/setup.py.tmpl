#!/usr/bin/env -S uv run --script
# Synced from bootstrap: repo/tools/mise/tasks/setup.py.tmpl. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
# MISE description="Setup the project: install tools, dependencies and hooks; --upgrade also upgrades them"
# MISE hide=true
# MISE tools={uv="latest", python="3.14"}

# USAGE flag "--upgrade" help="also upgrade tools, dependencies, plugins and hooks"
<%/* The member flags are only for the submodule and sibling members, each a
   separate repository: a folder of a monorepo is part of this tree. A git
   submodule with no [members.<name>] table gets no flag, as members() of
   helpers skips it. */ -%>
<% $subs := coll.Slice %><% range .members %><% $t := index $.member_types . %><% if and (coll.Has $.member_tables .) (or (eq $t "submodule") (eq $t "sibling")) %><% $subs = coll.Append . $subs %><% end %><% end -%>
<% $last := math.Sub (len $subs) 1 -%>
# USAGE flag "--all" help="Setup all: workspace<% range $i, $m := $subs %><% if eq $i $last %> and <% else %>, <% end %><% $m %><% end %>"
<% range $subs -%>
# USAGE flag "--<% . %>" help="Setup workspace & <% . %>"
<% end %>
import os
<% if $subs -%>
import re
<% end -%>
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, f"{os.environ['MISE_PROJECT_ROOT']}/.config/mise/tasks/_scripts")
import helpers  # noqa: E402


def mise(*args):
  """Run `mise <args>`. A failure stops the task with its code."""
  rc = subprocess.run(["mise", *args], check=False).returncode
  if rc != 0:
    sys.exit(rc)


# Without --upgrade every step only installs what the lockfiles and configs
# already pin. An empty list adds no argument.
upgrade = ["--upgrade"] if os.environ.get("usage_upgrade") == "true" else []

mise("run", "setup:mise", *upgrade)

for task in helpers.own_tasks("setup:secrets"):
  mise("run", task)

for task in helpers.own_tasks("setup:deps"):
  mise("run", task, *upgrade)

# Optional, and only in the root repository.
if upgrade and helpers.has_own_task("setup:external:update"):
  mise("run", "setup:external:update")

# `setup:linter` (`linter --init`) is not run for now: it writes
# .vscode/settings.json, also in a submodule. Run it by hand when necessary.

# The repository's dprint.jsonc extends no other config, and it has its own
# plugins. setup:dprint updates their versions, and the next sync keeps them.
if upgrade:
  mise("run", "setup:dprint")

mise("run", "setup:precommit", *upgrade)

# Only in the root repository, with the vscode tool.
if helpers.has_own_task("setup:vscode"):
  mise("run", "setup:vscode")

# Only in the root repository. It updates the plugins, so only on request.
if upgrade and helpers.has_own_task("setup:ai"):
  mise("run", "setup:ai", "--upgrade")

<% if $subs -%>
# Each member is a separate repository. The members come from [members.*] of
# .config/bootstrap/repo.toml, read only when a member flag is given. A member
# that is not on this machine is skipped with a warning.
want = os.environ.get("usage_all") == "true"
<% range $subs -%>
if os.environ.get("usage_<% . | strings.ReplaceAll "-" "_" %>") == "true":
  want = True
<% end -%>
member_list = helpers.members() if want else []
root = os.environ["MISE_PROJECT_ROOT"]
for name, folder, label, _ in member_list:
  # A name outside the member grammar has no flag, so it is skipped.
  if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
    continue
  flag = f"usage_{name.replace('-', '_')}"
  if os.environ.get("usage_all") != "true" and os.environ.get(flag) != "true":
    continue
  helpers.print_header(f"Setting up {label} project ...")
  if not os.path.isdir(f"{root}/{folder}"):
    helpers.print_warn(f"member {name}: {folder} is not on this machine")
    continue
  mise("run", "--cd", f"{root}/{folder}", "setup", *upgrade)

<% end -%>
helpers.line_sep1()
helpers.print_success("Setup complete!")
