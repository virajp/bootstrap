#!/usr/bin/env bash
# Synced from bootstrap: repo/tools/mise/tasks/code-lint-bootstrap. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.

#MISE description="Validate .config/bootstrap.toml with bootstrap check"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="accepted and ignored: the check has no fixes"
#USAGE arg "[files]" var=#true help="the files to lint; only .config/bootstrap.toml is used; the default is .config/bootstrap.toml"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Without bootstrap, the task does not apply and prints nothing. BOOTSTRAP_BIN,
# a local build, replaces the bootstrap of mise.
if [[ -n ${BOOTSTRAP_BIN:-} ]]; then
  bin=("${BOOTSTRAP_BIN}")
else
  mise x -- which bootstrap > /dev/null 2>&1 || exit 0
  bin=(mise x -- bootstrap)
fi
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Only the values file is
# for this check. Given files without it: nothing to do. Without files, the
# check runs when the values file exists.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ((${#FILES[@]})); then
  found=false
  for file in "${FILES[@]}"; do
    [[ "${file}" == ".config/bootstrap.toml" ]] && found=true
  done
  [[ "${found}" == "true" ]] || exit 0
else
  [[ -f .config/bootstrap.toml ]] || exit 0
fi

# The gate never uses the network: it reads the shared cache clone of
# bootstrap, without its lock, and it never fetches. Without that clone, the
# gate does not apply and prints nothing. A fetch at the same time is rare,
# and the next commit runs the gate again.
repo="${BOOTSTRAP_CACHE:-${XDG_CACHE_HOME:-${HOME}/.cache}/bootstrap}/repo"
[[ -f ${repo}/sync-engine/VERSION ]] || exit 0

# Only a clone of bootstrap. The config file itself, because a git hook sets
# GIT_DIR to the consumer. Any other origin: the gate does not apply and prints
# nothing.
origin=$(git config --file "${repo}/.git/config" --get remote.origin.url 2> /dev/null) || origin=''
case "${origin}" in
  https://github.com/virajp/bootstrap.git | https://github.com/virajp/bootstrap | git@github.com:virajp/bootstrap.git | git@github.com:virajp/bootstrap | ssh://git@github.com/virajp/bootstrap.git) ;;
  *)
    exit 0
    ;;
esac

print_header "Validating .config/bootstrap.toml ..."

# A git hook exports these, and the check must examine this repository.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
BOOTSTRAP_CLONE="${repo}" "${bin[@]}" check
