#!/usr/bin/env -S uv run --script
# Synced from bootstrap: repo/tools/mise/tasks/setup-configs.py.tmpl. Do not edit this file.
# The next sync writes it again, and each change in this file is lost.
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
# MISE description="Sync the shared files of this repository's tools from bootstrap"
# MISE tools={uv="latest", python="3.14", "github:virajp/bootstrap"="latest"}

# USAGE flag "--dry-run" help="show the changes without writing them"
# USAGE flag "--verbose" help="list each file, also an unchanged one"
<%/* The member flags are only for the submodule and sibling members, each a
   separate repository: a folder of a monorepo is part of this tree. A git
   submodule with no [members.<name>] table gets no flag, as members() of
   helpers skips it. */ -%>
<% $subs := coll.Slice %><% range .members %><% $t := index $.member_types . %><% if and (coll.Has $.member_tables .) (or (eq $t "submodule") (eq $t "sibling")) %><% $subs = coll.Append . $subs %><% end %><% end -%>
<% $last := math.Sub (len $subs) 1 -%>
<% if $subs -%>
# USAGE flag "--all" help="Also sync all members: <% range $i, $m := $subs %><% if $i %><% if eq $i $last %> and <% else %>, <% end %><% end %><% $m %><% end %>"
<% end -%>
<% range $subs -%>
# USAGE flag "--<% . %>" help="Also sync <% . %>"
<% end %>
import os
<% if $subs -%>
import re
<% end -%>
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, f"{os.environ['MISE_PROJECT_ROOT']}/.config/mise/tasks/_scripts")
import helpers  # noqa: E402

# `bootstrap sync` fetches the bootstrap clone into ~/.cache/bootstrap/,
# examines its version and syncs the repository of its folder. BOOTSTRAP_BIN,
# a local build, replaces the bootstrap of mise.

# An empty list adds no argument.
dry_run = ["--dry-run"] if os.environ.get("usage_dry_run") == "true" else []
if os.environ.get("usage_verbose") == "true":
  os.environ["BOOTSTRAP_VERBOSE"] = "1"


def sync_repo(folder, env=None):
  """Run bootstrap in the folder of a repository, with that folder as
  MISE_PROJECT_ROOT, as mise runs a task. env adds variables to the
  environment of bootstrap. The first failure stops the task with its code."""
  helpers.print_header("Syncing the shared files from bootstrap ...")
  # The tools come from the [tools.*] tables of .config/bootstrap/tools.toml
  # and from the required members of the pack base.
  engine = os.environ.get("BOOTSTRAP_BIN") or shutil.which("bootstrap") or "bootstrap"
  try:
    rc = subprocess.run(
      [engine, "sync", *dry_run],
      check=False,
      cwd=folder,
      env={**os.environ, **(env or {}), "MISE_PROJECT_ROOT": folder},
    ).returncode
  except OSError as e:
    # The codes of the shell for a command that it cannot find or run.
    print(f"{engine}: {e.strerror}", file=sys.stderr, flush=True)
    rc = 127 if isinstance(e, FileNotFoundError) else 126
  if rc != 0:
    sys.exit(rc)


root = os.environ["MISE_PROJECT_ROOT"]
sync_repo(root)
<% if $subs -%>

# Each member is a separate repository with its own .config/bootstrap/. The
# members come from [members.*] of .config/bootstrap/repo.toml, read after the
# sync above. A member that is not on this machine, or that has no
# .config/bootstrap/ (no values, or the old form), is skipped with a warning.
# The list is read only when a member flag is given. The first failure of a
# sync stops the task: the last header names the
# repository that failed. BOOTSTRAP_HOME and BOOTSTRAP_MEMBER tell the sync of
# the member its home repository and its name, so it writes [home].
want = os.environ.get("usage_all") == "true"
<% range $subs -%>
if os.environ.get("usage_<% . | strings.ReplaceAll "-" "_" %>") == "true":
  want = True
<% end -%>
member_list = helpers.members() if want else []
for name, folder, label, _ in member_list:
  # A name outside the member grammar has no flag, so it is skipped.
  if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
    continue
  flag = f"usage_{name.replace('-', '_')}"
  if os.environ.get("usage_all") != "true" and os.environ.get(flag) != "true":
    continue
  helpers.print_header(f"Syncing {label} ...")
  if not os.path.isdir(f"{root}/{folder}"):
    helpers.print_warn(f"member {name}: {folder} is not on this machine")
    continue
  if not os.path.isdir(f"{root}/{folder}/.config/bootstrap"):
    helpers.print_warn(f"member {name}: run bootstrap migrate there")
    continue
  sync_repo(f"{root}/{folder}", {"BOOTSTRAP_HOME": root, "BOOTSTRAP_MEMBER": name})
<% end -%>
