#!/usr/bin/env bash
# Synced from bootstrap: tools/fnox/.config/mise/tasks/setup/secrets/fnox. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Check that every secret fnox needs is configured"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# A repository without a fnox config has no secrets to check.
[[ -f "${MISE_PROJECT_ROOT}/.config/fnox.toml" ]] || exit 0

print_header "Checking secrets with fnox ..."

if ! mise x -- which fnox > /dev/null 2>&1; then
  print_warn "fnox is not on PATH — skipping secrets setup."
  print_yellow "Install the repo's pinned tools with 'mise install', then re-run this task."
  exit 0
fi

# fnox 1.36.0 does not search .config/, and 1.39.0 does. With an older
# version, fnox finds no config here.
min_version=1.39.0
version=$(cd "${MISE_PROJECT_ROOT}" && mise x -- fnox --version 2> /dev/null) || version=''
version=${version##* }
if ! awk -v v="${version}" -v m="${min_version}" 'BEGIN {
  split(v, a, "."); split(m, b, ".")
  for (i = 1; i <= 3; i++) {
    if (a[i] + 0 > b[i] + 0) exit 0
    if (a[i] + 0 < b[i] + 0) exit 1
  }
  exit 0
}'; then
  print_warn "fnox ${version:-<unknown>} is older than ${min_version} — skipping secrets setup."
  print_yellow "Run 'mise upgrade fnox', then re-run this task."
  exit 0
fi

# fnox finds .config/fnox.toml from the repository root. `--config` is not
# used: it also stops the search, but it still loads the global config.
cd "${MISE_PROJECT_ROOT}"
mise x -- fnox check
