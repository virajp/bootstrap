#!/usr/bin/env bash
# Synced from repo-config: tools/fnox/.config/mise/tasks/setup/secrets/fnox. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Check that every secret fnox needs is configured"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

if ! mise x -- which fnox > /dev/null 2>&1; then
  print_warn "fnox is not on PATH — skipping secrets setup."
  print_yellow "Install the repo's pinned tools with 'mise install', then re-run this task."
  exit 0
fi

# The repo's config sits under .config/, where fnox's default search may not
# look, so it is named explicitly and read from the repository root.
cd "${MISE_PROJECT_ROOT}"
print_subheader "Checking secrets with fnox ..."
mise x -- fnox --config .config/fnox.toml check
