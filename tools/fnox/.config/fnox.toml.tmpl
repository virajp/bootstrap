#:schema https://fnox.jdx.dev/schema.json
# fnox: this repository's secrets. A seed: the repo owns this file after the
# first sync. Values never live here. Add each secret with `fnox set <NAME>`,
# and load them with `fnox exec -- <command>`. fnox finds .config/fnox.toml by
# itself.

# Only this file. `root = true` stops the search in parent directories, so a
# submodule does not get the secrets of the repository that contains it. The
# fnox tool sets FNOX_CONFIG_DIR to .config/fnox/, a folder without a
# config.toml, so your global ~/.config/fnox/config.toml does not load here.
root = true

# fnox is a development tool here, so the secrets live in the OS keychain:
# the macOS Keychain, the Windows Credential Manager, or the Linux Secret
# Service. The keychain needs an unlocked desktop session, so it does not work
# in CI. The service is the product. In a product with members, each
# repository adds its name as a prefix, so its secrets stay apart from those of
# the other repositories of the product.
default_provider = "keychain"

# Secrets go only into `fnox exec` subprocesses, never into the interactive
# shell. Thus a tool or an AI agent that runs in the shell does not inherit
# them. A secret can opt back in with its own `env = true`.
env = "exec"

[providers]
keychain = { type = "keychain", <% if has . "product_name" %>service = "<% .product_name %>", prefix = "<% .repo_name %>/"<% else %>service = "<% .repo_name %>"<% end %> }

# A repository with one set of secrets for each target (for example each
# Pulumi stack) can keep them in `[profiles.<name>.secrets]`, with its own
# `[profiles.<name>.providers]`. `setup:secrets:fnox` checks each profile, and
# `fnox -P <name> exec -- <command>` loads one.

[secrets]
