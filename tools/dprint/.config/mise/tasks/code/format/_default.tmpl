#!/usr/bin/env bash
# Synced from bootstrap: tools/dprint/.config/mise/tasks/code/format/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Check or format files"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
<%/* The member flags are only for the submodules: a folder of a monorepo is
   part of this tree. */ -%>
<% $subs := coll.Slice %><% range .members %><% if eq (index $.member_types .) "submodule" %><% $subs = coll.Append . $subs %><% end %><% end -%>
<% $last := math.Sub (len $subs) 1 -%>
<% if $subs -%>
#USAGE flag "--all" help="Also format all members: <% range $i, $m := $subs %><% if $i %><% if eq $i $last %> and <% else %>, <% end %><% end %><% $m %><% end %>"
<% end -%>
<% range $subs -%>
#USAGE flag "--<% . %>" help="Also format <% . %>"
<% end -%>
#USAGE arg "[files]" var=#true help="the files to format in this repository; the default is the whole tree"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Formatting files ..."

[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="debug" || LOG_LEVEL="warn"
[[ "${usage_fix:-false}" == "true" ]] && CMD="fmt" || CMD="check"
# Unquoted on purpose where they are used: empty adds no argument.
[[ "${usage_debug:-false}" == "true" ]] && DEBUG="--debug" || DEBUG=""
[[ "${usage_fix:-false}" == "true" ]] && FIX="--fix" || FIX=""

# The pre-commit hook passes the staged files.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"

print_subheader "Running dprint ..."
if ((${#FILES[@]})); then
  mise x -- dprint ${CMD} --allow-no-files --log-level ${LOG_LEVEL} "${FILES[@]}"
else
  mise x -- dprint ${CMD} --log-level ${LOG_LEVEL}
fi

# The formatters of a language that dprint does not cover: each
# code:format:<name> task, from a tool or from this repository. Each gets the
# same files, and picks the ones of its language.
for task in $(own_tasks code:format); do
  mise run "${task}" ${FIX} ${DEBUG} ${FILES[@]+"${FILES[@]}"}
done
<% range $subs %>
if [[ "${usage_all:-false}" == "true" || "${usage_<% . | strings.ReplaceAll "-" "_" %>:-false}" == "true" ]]; then
  # A member is a separate repository: it formats its whole tree.
  print_header "Formatting <% . %> ..."
  mise run --cd <% index $.member_folders . %> code:format ${FIX} ${DEBUG}
fi
<% end %>
print_success "Formatting done"
