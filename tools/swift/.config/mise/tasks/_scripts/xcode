#!/usr/bin/env bash
# Synced from bootstrap: tools/swift/.config/mise/tasks/_scripts/xcode. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="The Xcode and simulator lookup of the Xcode tasks"
#MISE hide=true

# The Xcode and simulator lookup of the Xcode tasks. Source it after helpers.
# Each function takes the name of the calling task first, for its messages.
#
# A repository can set each of these values in the [env] of
# .config/mise/conf.d/zz-repo/mise.<env>.toml. Without a value, require_xcode
# finds it:
#   XCODE_VERSION       the selected Xcode (xcodebuild -version)
#   SIMULATOR_PLATFORM  iOS
#   SIMULATOR_OS        the newest available iOS runtime
#   SIMULATOR_DEVICE    the available iPhone of that runtime with the highest
#                       model number and no other word in its name, for
#                       example "iPhone 17"

# Print the "<os><tab><device>" of the default simulator, or nothing.
_xcode_simulator() {
  xcrun simctl list devices available 2> /dev/null | awk '
    # Compare two dotted versions; true when a is newer than b.
    function newer(a, b,   x, y, n, i) {
      n = split(a, x, "."); split(b, y, ".")
      for (i = 1; i <= n || i in y; i++) {
        if (x[i] + 0 != y[i] + 0) return x[i] + 0 > y[i] + 0
      }
      return 0
    }
    /^-- / { os = ""; if ($2 == "iOS") os = $3; next }
    os == "" { next }
    {
      # "    iPhone 17 (<udid>) (Shutdown)", with " (<os>)" after the name in
      # an older runtime.
      name = $0
      sub(/^ +/, "", name); sub(/ +$/, "", name)
      sub(/ \([^()]*\) \([^()]*\)$/, "", name)
      sub(/ \([0-9.]+\)$/, "", name)
      if (name !~ /^iPhone [0-9]+$/) next
      model = substr(name, 8) + 0
      if (best_os == "" || newer(os, best_os)) { best_os = os; best = 0 }
      if (os == best_os && model > best) { best = model; device = name }
    }
    END { if (device != "") printf "%s\t%s\n", best_os, device }
  '
}

# Fail when no Xcode is selected, or when XCODE_VERSION is not the selected
# Xcode. Set and export XCODE_VERSION and the SIMULATOR_* values that the
# repository does not set.
require_xcode() {
  local task=$1 version found
  # Do not test for xcodebuild: each Mac has a /usr/bin/xcodebuild stub.
  if ! version=$(xcodebuild -version 2> /dev/null); then
    print_error "${task}: no Xcode is selected - xcodebuild -version failed"
    print_info "Install Xcode, then select it: sudo xcode-select -s /Applications/Xcode.app"
    exit 1
  fi
  version=$(printf '%s\n' "${version}" | awk 'NR == 1 { print $2 }')
  if [[ -n "${XCODE_VERSION:-}" && "${XCODE_VERSION}" != "${version}" ]]; then
    print_error "${task}: this repository needs Xcode ${XCODE_VERSION}, but Xcode ${version} is selected"
    print_info "Select Xcode ${XCODE_VERSION} with xcode-select -s, or set DEVELOPER_DIR to it"
    exit 1
  fi
  export XCODE_VERSION="${version}"
  export SIMULATOR_PLATFORM="${SIMULATOR_PLATFORM:-iOS}"
  if [[ "${SIMULATOR_PLATFORM}" != "iOS" || (-n "${SIMULATOR_OS:-}" && -n "${SIMULATOR_DEVICE:-}") ]]; then
    return 0
  fi
  found=$(_xcode_simulator) || found=''
  if [[ -z "${found}" ]]; then
    print_error "${task}: no available iPhone simulator found"
    print_info "Install an iOS runtime in Xcode, or set SIMULATOR_OS and SIMULATOR_DEVICE in the [env] of .config/mise/conf.d/zz-repo/mise.<env>.toml"
    exit 1
  fi
  export SIMULATOR_OS="${SIMULATOR_OS:-${found%%$'\t'*}}"
  export SIMULATOR_DEVICE="${SIMULATOR_DEVICE:-${found#*$'\t'}}"
}

# Print the one *.xcodeproj at the root of the repository. Use it as
# $(find_xcodeproj <task>): the answer goes to stdout, the messages to stderr.
find_xcodeproj() {
  local task=$1 projects=() project
  for project in *.xcodeproj; do
    [[ -d "${project}" ]] && projects+=("${project}")
  done
  if ((${#projects[@]} == 0)); then
    print_error "${task}: no *.xcodeproj at the root of the repository" >&2
    print_info "Make the project of the app in Xcode, save it at the root of the repository, and commit it" >&2
    exit 1
  fi
  if ((${#projects[@]} > 1)); then
    print_error "${task}: the root has more than one *.xcodeproj: ${projects[*]}" >&2
    print_info "Keep one project at the root" >&2
    exit 1
  fi
  printf '%s\n' "${projects[0]}"
}
