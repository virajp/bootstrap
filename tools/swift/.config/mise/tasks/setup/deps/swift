#!/usr/bin/env bash
# Synced from bootstrap: tools/swift/.config/mise/tasks/setup/deps/swift. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Resolve the SwiftPM and Xcode package dependencies from Package.resolved; --upgrade resolves them again to the newest allowed versions"
#MISE hide=true

#USAGE flag "--upgrade" help="update Package.resolved to the newest versions that the manifests allow"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the swift tool. It acts on the repository root only: the iOS
# part of a Flutter app belongs to setup:deps:flutter. Without Package.swift
# and without an *.xcodeproj, the task does not apply and prints nothing.
cd "${MISE_PROJECT_ROOT}"

HAS_PACKAGE=false
[[ -f Package.swift ]] && HAS_PACKAGE=true
PROJECTS=()
for p in *.xcodeproj; do
  [[ -d "${p}" ]] && PROJECTS+=("${p}")
done

[[ "${HAS_PACKAGE}" == "true" || ${#PROJECTS[@]} -gt 0 ]] || exit 0

if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_header "Upgrading Swift dependencies ..."
else
  print_header "Installing Swift dependencies ..."
fi

# On a host that is not macOS, the task skips, so setup on a Linux CI host
# continues.
HOST=$(uname -s) || HOST=''
if [[ "${HOST}" != "Darwin" ]]; then
  print_warn "Swift dependencies are macOS only, skipped"
  exit 0
fi

if [[ ${#PROJECTS[@]} -gt 1 ]]; then
  print_error "The root has more than one *.xcodeproj: ${PROJECTS[*]}. Keep one."
  exit 1
fi

# swift and xcodebuild come from the developer folder that xcode-select
# selects, not from mise. An *.xcodeproj needs a full Xcode: with only the
# Command Line Tools, xcodebuild fails. A SwiftPM-only root needs only swift,
# which the Command Line Tools supply.
if [[ ${#PROJECTS[@]} -gt 0 ]]; then
  if ! xcodebuild -version > /dev/null 2>&1; then
    print_error "Xcode is not selected. Run: sudo xcode-select -s /Applications/Xcode.app"
    exit 1
  fi
elif ! swift --version > /dev/null 2>&1; then
  print_error "swift is not available. Install the Command Line Tools: xcode-select --install"
  exit 1
fi

if [[ "${HAS_PACKAGE}" == "true" ]]; then
  if [[ "${usage_upgrade:-false}" == "true" ]]; then
    print_subheader "Updating the SwiftPM packages ..."
    swift package update
  else
    print_subheader "Resolving the SwiftPM packages ..."
    # Package.resolved decides the versions; a resolve never changes them.
    swift package resolve --force-resolved-versions
  fi
fi

if [[ ${#PROJECTS[@]} -eq 1 ]]; then
  PROJECT="${PROJECTS[0]}"
  RESOLVED="${PROJECT}/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
  if [[ "${usage_upgrade:-false}" == "true" ]]; then
    print_subheader "Updating the Xcode project packages ..."
    # Without Package.resolved, xcodebuild resolves every package again. If
    # the resolve fails, the trap puts the old file back.
    BACKUP=''
    if [[ -f "${RESOLVED}" ]]; then
      BACKUP=$(mktemp)
      cp "${RESOLVED}" "${BACKUP}"
      trap 'cp "${BACKUP}" "${RESOLVED}"; rm -f "${BACKUP}"' EXIT
      rm "${RESOLVED}"
    fi
    xcodebuild -resolvePackageDependencies -project "${PROJECT}" \
      -clonedSourcePackagesDirPath .build/SourcePackages
    if [[ -n "${BACKUP}" ]]; then
      trap - EXIT
      rm -f "${BACKUP}"
    fi
  else
    print_subheader "Resolving the Xcode project packages ..."
    xcodebuild -resolvePackageDependencies -project "${PROJECT}" \
      -clonedSourcePackagesDirPath .build/SourcePackages \
      -onlyUsePackageVersionsFromResolvedFile
  fi
fi
