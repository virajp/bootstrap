#!/usr/bin/env bash
# Synced from bootstrap: tools/swift/.config/mise/tasks/code/format/swift-format. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Check or format the Swift files with swift-format"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:format contract"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .swift files are used; the default is each .swift file that git does not ignore"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the swift tool. swift-format comes with the Swift toolchain of
# the host, not from mise. Without it or without a .swift file, the task does
# not apply and prints nothing.
swift format --version > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:format passes its files to each code:format:* task. Only the .swift
# files are for swift-format, and not the generated ones. swift-format does not
# read .gitignore, so without files the list comes from git.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ! ((${#FILES[@]})); then
  # A failed git stops the task, with the error of git.
  LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- '*.swift' | sort -u)
  while IFS= read -r file; do
    [[ -n "${file}" ]] && FILES+=("${file}")
  done <<< "${LIST}"
fi
TARGETS=()
for file in ${FILES[@]+"${FILES[@]}"}; do
  [[ "${file}" == *.swift && "${file}" != *.generated.swift && -f "${file}" ]] && TARGETS+=("${file}")
done
((${#TARGETS[@]})) || exit 0

print_header "Formatting the Swift files with swift-format ..."
# Without --fix, the check is the strict lint: format has no mode that only
# reports. It also reports the rules that format cannot fix.
if [[ "${usage_fix:-false}" == "true" ]]; then
  swift format format --in-place --parallel --configuration .config/swift-format.json "${TARGETS[@]}"
else
  swift format lint --strict --parallel --configuration .config/swift-format.json "${TARGETS[@]}"
fi
