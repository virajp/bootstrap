#!/usr/bin/env bash
# Synced from bootstrap: tools/swift/.config/mise/tasks/code/lint/swiftlint. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Lint the Swift files with SwiftLint"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:lint contract"
#USAGE flag "--fix" help="accepted for the code:lint contract; swift-format decides the layout"
#USAGE arg "[files]" var=#true help="the files to lint; only the .swift files are used; the default is each .swift file that git does not ignore"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the swift tool. Without SwiftLint (a host that is not macOS, or
# swift not in this environment) or without a .swift file, the task does not
# apply and prints nothing.
mise x -- which swiftlint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Only the .swift files
# are for SwiftLint. SwiftLint does not read .gitignore, so without files the
# list comes from git.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
TARGETS=()
if ((${#FILES[@]})); then
  for file in "${FILES[@]}"; do
    [[ "${file}" == *.swift && -f "${file}" ]] && TARGETS+=("${file}")
  done
else
  # A failed git stops the task, with the error of git.
  LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- '*.swift' | sort -u)
  while IFS= read -r file; do
    [[ -n "${file}" && -f "${file}" ]] && TARGETS+=("${file}")
  done <<< "${LIST}"
fi
((${#TARGETS[@]})) || exit 0

print_header "Linting the Swift files with SwiftLint ..."
# --force-exclude: a given file that .config/swiftlint.yml excludes stays
# excluded. --strict: a warning is a failure.
mise x -- swiftlint lint --strict --quiet --force-exclude --config .config/swiftlint.yml "${TARGETS[@]}"
