#!/usr/bin/env bash
# Synced from bootstrap: tools/android/.config/mise/tasks/setup/deps/android. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Install the Android SDK packages of the build: platform-tools, the platform, the emulator and its system image"
#MISE hide=true

#USAGE flag "--upgrade" help="accepted for the setup contract; the SDK packages have no lockfile, so an upgrade installs the same packages"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "${MISE_PROJECT_ROOT}"

# Shipped with the android tool. It acts on the Gradle build at the root only:
# the android/ folder of a Flutter app is for setup:deps:flutter. Without an
# executable ./gradlew and the Android Gradle plugin, the task does not apply
# and prints nothing.
[[ -x gradlew ]] || exit 0

# The detects read only the files that git tracks or does not ignore, so an
# ignored folder (.worktrees/, .claude/worktrees/, node_modules) is not read.
# The pathspecs give only the files that the detects read. The build/ and
# .gradle/ folders are not read. LEVEL_FILES has the order of the level
# detect: the build.gradle.kts and *.gradle files (Kotlin and Groovy DSL),
# then each file in build-logic/, then gradle/libs.versions.toml. Each part is
# sorted.
BUILD_FILES=()
LOGIC_FILES=()
CATALOG_FILES=()
KTS_FILES=()
while IFS= read -r -d '' file; do
  [[ -f "${file}" ]] || continue
  case "${file}" in
    build/* | */build/* | .gradle/* | */.gradle/*)
      continue
      ;;
    build-logic/*)
      LOGIC_FILES+=("${file}")
      ;;
    gradle/libs.versions.toml)
      CATALOG_FILES+=("${file}")
      ;;
    build.gradle.kts | */build.gradle.kts | *.gradle)
      BUILD_FILES+=("${file}")
      ;;
    *.gradle.kts)
      KTS_FILES+=("${file}")
      ;;
  esac
done < <(git ls-files -z --cached --others --exclude-standard -- \
  '*.gradle' '*.gradle.kts' 'build-logic/*' 'gradle/libs.versions.toml' 2> /dev/null | sort -z)
LEVEL_FILES=(${BUILD_FILES[@]+"${BUILD_FILES[@]}"} ${LOGIC_FILES[@]+"${LOGIC_FILES[@]}"}
  ${CATALOG_FILES[@]+"${CATALOG_FILES[@]}"})

# The Android Gradle plugin is in the files of the level detect, or in an
# other *.gradle.kts file, for example settings.gradle.kts.
AGP_FILES=(${LEVEL_FILES[@]+"${LEVEL_FILES[@]}"} ${KTS_FILES[@]+"${KTS_FILES[@]}"})
((${#AGP_FILES[@]})) || exit 0
grep -qsE 'com\.android\.(application|library)' "${AGP_FILES[@]}" || exit 0

# Prints "<level> <file>" for the first hit of <key> (compileSdk or targetSdk)
# in LEVEL_FILES. Only a literal level counts, for example `compileSdk = 36`,
# `compileSdkVersion(34)`, `compileSdk 35` or `compileSdkVersion 35` (Groovy
# DSL), or `compileSdk = "36"` in the version catalog. Prints nothing without
# a hit. A binary file, for example a jar in build-logic/, is not read.
detect_level() {
  local key="$1" pattern file hit
  pattern="(^|[^A-Za-z])${key}(Version)?[[:space:]]*[=(]?[[:space:]]*\"?[0-9]+(\.[0-9]+)?"
  for file in ${LEVEL_FILES[@]+"${LEVEL_FILES[@]}"}; do
    hit=$(grep -IhoE "${pattern}" "${file}" | head -n 1) || hit=''
    if [[ -n "${hit}" ]]; then
      echo "$(echo "${hit}" | grep -oE '[0-9]+(\.[0-9]+)?$') ${file}"
      return 0
    fi
  done
  return 0
}

# A level must be a number with an optional minor. The repository from API 37
# names each level with its minor, so a bare level of 37 or more becomes
# <level>.0. Prints the level, or fails.
normalize_level() {
  local name="$1" level="$2"
  if ! [[ "${level}" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    print_error "${name} '${level}' is not a level: it must match ^[0-9]+(\\.[0-9]+)?\$"
    return 1
  fi
  if [[ "${level}" =~ ^[0-9]+$ ]] && ((10#${level} >= 37)); then
    level="${level}.0"
  fi
  echo "${level}"
}

print_header "Installing the Android SDK packages ..."

# The android-sdk mise tool sets ANDROID_HOME, the SDK root of the android CLI.
# The installed check reads the packages there.
if [[ -z "${ANDROID_HOME:-}" ]]; then
  print_error "ANDROID_HOME is not set, so the task cannot find the SDK"
  print_info "The android-sdk mise tool sets it; do not unset it in the mise config"
  exit 1
fi

print_subheader "Detecting the SDK levels ..."
if [[ -n "${COMPILE_SDK:-}" ]]; then
  COMPILE_RAW="${COMPILE_SDK}"
  print_info "compileSdk ${COMPILE_RAW}, from the env value COMPILE_SDK"
else
  HIT=$(detect_level compileSdk)
  if [[ -z "${HIT}" ]]; then
    print_error "No compileSdk level found in the build.gradle.kts and *.gradle files, build-logic/ or gradle/libs.versions.toml"
    print_info "Set COMPILE_SDK in the [env] of .config/mise/conf.d/zz-repo/mise.<env>.toml"
    exit 1
  fi
  COMPILE_RAW="${HIT%% *}"
  print_info "compileSdk ${COMPILE_RAW}, from ${HIT#* }"
fi
COMPILE_LEVEL=$(normalize_level COMPILE_SDK "${COMPILE_RAW}")

ABI=x86_64
case "$(uname -m)" in
  arm64 | aarch64)
    ABI=arm64-v8a
    ;;
esac

# The android CLI names a package with "/", where sdkmanager uses ";". An id
# in either form is accepted.
if [[ -n "${EMULATOR_IMAGE:-}" ]]; then
  IMAGE="${EMULATOR_IMAGE//;//}"
  print_info "Emulator image ${IMAGE}, from the env value EMULATOR_IMAGE"
else
  HIT=$(detect_level targetSdk)
  if [[ -z "${HIT}" ]]; then
    print_error "No targetSdk level found in the build.gradle.kts and *.gradle files, build-logic/ or gradle/libs.versions.toml"
    print_info "Set EMULATOR_IMAGE in the [env] of .config/mise/conf.d/zz-repo/mise.<env>.toml"
    exit 1
  fi
  TARGET_RAW="${HIT%% *}"
  print_info "targetSdk ${TARGET_RAW}, from ${HIT#* }"
  TARGET_LEVEL=$(normalize_level targetSdk "${TARGET_RAW}")
  IMAGE="system-images/android-${TARGET_LEVEL}/google_apis"
fi
# The image id names the ABI of this host, unless it already ends with one.
case "${IMAGE}" in
  */arm64-v8a | */x86_64 | */x86 | */armeabi-v7a) ;;
  *)
    IMAGE="${IMAGE}/${ABI}"
    ;;
esac
print_info "ABI ${ABI}"

PLATFORM="platforms/android-${COMPILE_LEVEL}"

# An installed package has <id>/package.xml in the SDK, so this check needs
# no network. When every package is there, the task lists and installs
# nothing.
installed() { [[ -f "${ANDROID_HOME}/$1/package.xml" ]]; }
MISSING=()
for package in platform-tools "${PLATFORM}" emulator; do
  installed "${package}" || MISSING+=("${package}")
done

# From android-37.1, only the _ps16k variant (16 KB pages) of an image exists.
# An installed variant counts as the image, so the task needs no network list.
VARIANT="${IMAGE%/*}_ps16k/${IMAGE##*/}"
if ! installed "${IMAGE}" && installed "${VARIANT}"; then
  print_info "${IMAGE} is not installed; using the installed ${VARIANT}"
  IMAGE="${VARIANT}"
fi

# The list has the installed packages, then the available ones; the id is the
# first column. The emulator image is checked against it, unless the image is
# installed.
if ! installed "${IMAGE}"; then
  print_subheader "Listing the SDK packages ..."
  PACKAGES=$(mise x -- android sdk list --all | awk '{print $1}') || PACKAGES=''
  if [[ -z "${PACKAGES}" ]]; then
    print_error "The android CLI listed no SDK packages"
    exit 1
  fi
  has_package() { grep -qxF "$1" <<< "${PACKAGES}"; }

  # The variant replaces a missing image, and the task names the id it used.
  if ! has_package "${IMAGE}"; then
    if has_package "${VARIANT}"; then
      print_warn "The SDK has no package ${IMAGE}; using ${VARIANT}"
      IMAGE="${VARIANT}"
    else
      print_error "The SDK has neither ${IMAGE} nor ${VARIANT}"
      print_info "Set EMULATOR_IMAGE in the [env] of .config/mise/conf.d/zz-repo/mise.<env>.toml"
      exit 1
    fi
  fi
  installed "${IMAGE}" || MISSING+=("${IMAGE}")
fi

if ((${#MISSING[@]} == 0)); then
  print_success "platform-tools, ${PLATFORM}, emulator and ${IMAGE} are installed"
  exit 0
fi

print_subheader "Installing ${MISSING[*]} ..."
# cmdline-tools 23 has no license prompt: a package install accepts the SDK
# license and writes licenses/, which Gradle reads before it downloads the
# build tools and the NDK.
mise x -- android sdk install "${MISSING[@]}"

# An unknown id can install nothing, and the install can still exit 0. Each
# package that the task asked for must have its package.xml now.
NOT_INSTALLED=()
for package in "${MISSING[@]}"; do
  installed "${package}" || NOT_INSTALLED+=("${package}")
done
if ((${#NOT_INSTALLED[@]})); then
  for package in "${NOT_INSTALLED[@]}"; do
    print_error "The android CLI did not install ${package}"
  done
  exit 1
fi
print_success "Android SDK packages installed"
