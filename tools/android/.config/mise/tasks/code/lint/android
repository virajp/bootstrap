#!/usr/bin/env bash
# Synced from bootstrap: tools/android/.config/mise/tasks/code/lint/android. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Run Android lint on the Gradle modules of the given files"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="run lintFix, which applies the safe fixes"
#USAGE arg "[files]" var=#true help="the files to lint; only the Android sources and build files are used, and only their modules are linted; the default is every module"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

cd "${MISE_PROJECT_ROOT}"

# Shipped with the android tool. The Gradle root is the root of the
# repository, else the android/ folder of a Flutter app. Without a Gradle
# wrapper or the SDK platforms, the task does not apply and prints nothing.
if [[ -x gradlew ]]; then
  ROOT=.
elif [[ -x android/gradlew ]]; then
  ROOT=android
else
  exit 0
fi
[[ -n "${ANDROID_HOME:-}" && -d "${ANDROID_HOME}/platforms" ]] || exit 0

[[ "${usage_fix:-false}" == "true" ]] && TASK=lintFix || TASK=lint
INFO=()
[[ "${usage_debug:-false}" == "true" ]] && INFO=(--info)

# Prints the Gradle path of the module of a file (relative to the Gradle
# root), or "all" when the file is for the whole build: the root, gradle/,
# settings.gradle.kts, build-logic/ or buildSrc/. buildSrc/ is not a Gradle
# project, so :buildSrc:lint would fail. The module is the nearest folder with
# build.gradle.kts or build.gradle.
module_of() {
  local file="$1" dir
  case "${file}" in
    gradle/* | settings.gradle.kts | build-logic/* | buildSrc/*)
      echo all
      return 0
      ;;
  esac
  dir=$(dirname "${file}")
  while [[ "${dir}" != "." ]]; do
    if [[ -f "${ROOT}/${dir}/build.gradle.kts" || -f "${ROOT}/${dir}/build.gradle" ]]; then
      echo ":${dir//\//:}"
      return 0
    fi
    dir=$(dirname "${dir}")
  done
  echo all
}

# code:lint passes its files to each code:lint:* task. Only the Android
# sources and build files trigger the lint, and only the modules they are in.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
TASKS=()
if ((${#FILES[@]})); then
  MODULES=''
  for file in "${FILES[@]}"; do
    case "${file}" in
      *src/*.kt | *src/*.java | *src/*.xml | *.gradle.kts | *.pro | *libs.versions.toml | *lint.xml | *lint-baseline.xml) ;;
      *)
        continue
        ;;
    esac
    if [[ "${ROOT}" != "." ]]; then
      [[ "${file}" == "${ROOT}/"* ]] || continue
      file="${file#"${ROOT}/"}"
    fi
    MODULES="${MODULES}$(module_of "${file}")"$'\n'
  done
  [[ -n "${MODULES}" ]] || exit 0
  if grep -qx all <<< "${MODULES}"; then
    TASKS=("${TASK}")
  else
    while IFS= read -r module; do
      [[ -n "${module}" ]] && TASKS+=("${module}:${TASK}")
    done < <(sort -u <<< "${MODULES}")
  fi
else
  TASKS=("${TASK}")
fi

print_header "Linting the Android modules ..."
# A task name without a project path runs in every module.
(cd "${ROOT}" && ./gradlew ${INFO[@]+"${INFO[@]}"} "${TASKS[@]}")
