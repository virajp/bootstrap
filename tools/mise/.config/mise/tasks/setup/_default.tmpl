#!/usr/bin/env bash
# Synced from bootstrap: tools/mise/.config/mise/tasks/setup/_default.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Setup the project: install tools, dependencies and hooks; --upgrade also upgrades them"
#MISE hide=true

#USAGE flag "--upgrade" help="also upgrade tools, dependencies, plugins and hooks"
<% $last := math.Sub (len .members) 1 -%>
#USAGE flag "--all" help="Setup all: workspace<% range $i, $m := .members %><% if eq $i $last %> and <% else %>, <% end %><% $m %><% end %>"
<% range .members -%>
#USAGE flag "--<% . %>" help="Setup workspace & <% . %>"
<% end -%>
<% if .members %>
<% end -%>
<% range .members -%>
SETUP_<% . | strings.ReplaceAll "-" "_" | strings.ToUpper %>=$([[ "${usage_all:-false}" == "true" || "${usage_<% . | strings.ReplaceAll "-" "_" %>:-false}" == "true" ]] && echo true || echo false)
<% end %>
set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Without --upgrade every step only installs what the lockfiles and configs
# already pin. Unquoted on purpose where it is used: empty adds no argument.
[[ "${usage_upgrade:-false}" == "true" ]] && UPGRADE="--upgrade" || UPGRADE=""

mise run setup:mise ${UPGRADE}

for task in $(own_tasks setup:secrets); do
  mise run "${task}"
done

for task in $(own_tasks setup:deps); do
  mise run "${task}" ${UPGRADE}
done

# Optional, and only in the root repository.
if [[ -n "${UPGRADE}" ]] && has_own_task setup:external:update; then
  mise run setup:external:update
fi

# `setup:linter` (`linter --init`) is not run for now: it writes
# .vscode/settings.json, also in a submodule. Run it by hand when necessary.

# The plugins are in the global dprint config. The repository's
# dprint.jsonc only excludes paths, so it has nothing to update.
if [[ -n "${UPGRADE}" ]]; then
  mise run setup:dprint
fi

mise run setup:precommit ${UPGRADE}

# Only in the root repository. It updates the plugins, so only on request.
if [[ -n "${UPGRADE}" ]] && has_own_task setup:ai; then
  mise run setup:ai
fi

<% range .members -%>
<% $x := dict %><% if and (has $ "member") (has $.member .) %><% $x = index $.member . %><% end -%>
if [[ "${SETUP_<% . | strings.ReplaceAll "-" "_" | strings.ToUpper %>}" == "true" ]]; then
  print_header "Setting up <% index $x "label" | default . %> project ..."
  mise run --cd <% . %> setup ${UPGRADE}
fi

<% end -%>
line_sep1
print_success "Setup complete!"
