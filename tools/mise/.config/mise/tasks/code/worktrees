#!/usr/bin/env bash
# Synced from bootstrap: tools/mise/.config/mise/tasks/code/worktrees. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="List git worktrees across the root repo and every submodule, with ahead/behind counts, sync and state"
#MISE hide=false

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

ROOT="${MISE_PROJECT_ROOT}"
COMMON_DIR="$(git -C "${ROOT}" rev-parse --path-format=absolute --git-common-dir)"

# Default branch of a repo, read from origin/HEAD; falls back to develop.
default_branch() {
  local ref
  ref="$(git "$@" symbolic-ref -q refs/remotes/origin/HEAD 2> /dev/null || true)"
  if [[ -n "${ref}" ]]; then echo "${ref#refs/remotes/origin/}"; else echo "develop"; fi
}

# "↑<ahead> ↓<behind>" of a commit against a base ref; "-" when the base is missing.
ahead_behind() {
  local base="$1" head="$2" counts
  if [[ -z "${base}" ]] || ! git "${GIT[@]}" rev-parse --verify -q "${base}^{commit}" > /dev/null; then
    echo "-"
    return
  fi
  counts="$(git "${GIT[@]}" rev-list --left-right --count "${base}...${head}")"
  echo "↑$(echo "${counts}" | cut -f2) ↓$(echo "${counts}" | cut -f1)"
}

# Display width of a cell. The arrows are multibyte, and printf pads by bytes
# unless the locale is UTF-8, so measure an ASCII stand-in instead.
vwidth() {
  local s="${1//↑/x}"
  s="${s//↓/x}"
  s="${s//↕/x}"
  echo "${#s}"
}

# Emit a cell padded to a display width.
pad() {
  local s="$1" n
  n=$(($2 - $(vwidth "${s}")))
  printf '%s' "${s}"
  ((n > 0)) && printf '%*s' "${n}" ''
  return 0
}

# Path relative to the workspace root when it lives inside it, else absolute.
display_path() {
  local p="$1"
  if [[ "${p}" == "${ROOT}" ]]; then
    echo "."
  elif [[ "${p}" == "${ROOT}"/* ]]; then
    echo "${p#"${ROOT}"/}"
  else
    echo "${p}"
  fi
}

# Base branch of a row: main and develop compare with each other, any other
# branch with the default branch. Empty when the other core branch is missing.
row_base() {
  local other
  case "$1" in
    main)
      other="develop"
      ;;
    develop)
      other="main"
      ;;
    *)
      echo "$2"
      return
      ;;
  esac
  if git "${GIT[@]}" rev-parse --verify -q "refs/heads/${other}" > /dev/null; then
    echo "${other}"
  fi
}

# "in-sync" when the commit $2 contains the HEAD $1 of the main worktree, else "drifted".
sync_state() {
  if git "${GIT[@]}" merge-base --is-ancestor "$1" "$2" 2> /dev/null; then
    echo "in-sync"
  else
    echo "drifted"
  fi
}

# "clean", or "dirty" and the counts of the `git status -s` codes, for example
# "dirty  M2 ??1". "-" when the worktree folder is missing.
worktree_state() {
  local out codes c n counts=""
  out="$(git -C "$1" status --porcelain 2> /dev/null)" || {
    echo "-"
    return
  }
  if [[ -z "${out}" ]]; then
    echo "clean"
    return
  fi
  # One code for each line: the staged letter, else the unstaged letter.
  codes="$(printf '%s\n' "${out}" | awk '{
    x = substr($0, 1, 1); y = substr($0, 2, 1)
    if (x == "?") print "??"
    else if (x == "U" || y == "U" || x y == "AA" || x y == "DD") print "U"
    else if (x == " ") print y
    else print x
  }')"
  for c in U M T A D R C '??'; do
    n="$(printf '%s\n' "${codes}" | grep -cxF -- "${c}")" || n=0
    ((n > 0)) && counts="${counts} ${c}${n}"
  done
  echo "dirty ${counts}"
}

# Color of a cell: green for a good state, yellow for a warning, red for a problem.
cell_color() {
  case "$1" in
    in-sync | clean | *"↓0")
      echo "${COLOR_GREEN}"
      ;;
    drifted | *" U"[0-9]*)
      echo "${COLOR_RED}"
      ;;
    dirty* | *"↓"[0-9]*)
      echo "${COLOR_YELLOW}"
      ;;
    *)
      echo ""
      ;;
  esac
}

# Emit a cell padded to a display width, in its color when output is styled.
cpad() {
  local color
  color="$(cell_color "$1")"
  if [[ -n "${color}" ]] && style_enabled; then
    printf '%b%s%b' "${color}" "$(pad "$1" "$2")" "${STYLE_NORMAL}"
  else
    pad "$1" "$2"
  fi
}

# Print one repo's worktrees. $1 label, $2 pinned commit ("" for the root repo).
print_repo() {
  local label="$1" pinned="$2"
  local base branch head wt main_head="" rbase
  local -a branches=() heads=() vs_base=() vs_pinned=() syncs=() states=() paths=()
  local w_branch w_base w_pinned w_sync w_state

  base="$(default_branch "${GIT[@]}")"

  while IFS= read -r line; do
    case "${line}" in
      worktree\ *)
        wt="${line#worktree }"
        ;;
      HEAD\ *)
        head="${line#HEAD }"
        ;;
      branch\ *)
        branch="${line#branch refs/heads/}"
        ;;
      detached)
        branch="(detached)"
        ;;
      "")
        # The submodule main worktree is reported as its gitdir; show the checkout.
        if [[ -n "${MAIN_CHECKOUT:-}" && "${wt}" == "${COMMON_DIR}"/modules/* ]]; then
          wt="${MAIN_CHECKOUT}"
        fi
        # git lists the main worktree first.
        [[ -z "${main_head}" ]] && main_head="${head}"
        rbase="$(row_base "${branch}" "${base}")"
        branches+=("${branch}")
        heads+=("${head:0:7}")
        if [[ -n "${rbase}" ]]; then
          vs_base+=("${rbase} $(ahead_behind "${rbase}" "${head}")")
        else
          vs_base+=("-")
        fi
        vs_pinned+=("$(ahead_behind "${pinned}" "${head}")")
        syncs+=("$(sync_state "${main_head}" "${head}")")
        states+=("$(worktree_state "${wt}")")
        paths+=("$(display_path "${wt}")")
        branch="" head="" wt=""
        ;;
    esac
  done < <(git "${GIT[@]}" worktree list --porcelain)

  local i n
  local head_base="↕ BASE" head_pinned="↕ pinned"
  w_branch=$(vwidth "BRANCH")
  w_base=$(vwidth "${head_base}")
  w_pinned=$(vwidth "${head_pinned}")
  w_sync=$(vwidth "SYNC")
  w_state=$(vwidth "STATE")
  for ((i = 0; i < ${#branches[@]}; i++)); do
    n=$(vwidth "${branches[i]}")
    ((n > w_branch)) && w_branch=${n}
    n=$(vwidth "${vs_base[i]}")
    ((n > w_base)) && w_base=${n}
    n=$(vwidth "${vs_pinned[i]}")
    ((n > w_pinned)) && w_pinned=${n}
    n=$(vwidth "${syncs[i]}")
    ((n > w_sync)) && w_sync=${n}
    n=$(vwidth "${states[i]}")
    ((n > w_state)) && w_state=${n}
  done

  print_newline
  if [[ -n "${pinned}" ]]; then
    print_subheader "${label} — default ${base} · pinned by ${ROOT_LABEL}/${ROOT_BASE} at ${pinned:0:7}"
    print_yellow "  $(pad "BRANCH" "${w_branch}")  $(pad "COMMIT" 7)  $(pad "${head_base}" "${w_base}")  $(pad "${head_pinned}" "${w_pinned}")  $(pad "SYNC" "${w_sync}")  $(pad "STATE" "${w_state}")  PATH"
  else
    print_subheader "${label} — default ${base}"
    print_yellow "  $(pad "BRANCH" "${w_branch}")  $(pad "COMMIT" 7)  $(pad "${head_base}" "${w_base}")  $(pad "SYNC" "${w_sync}")  $(pad "STATE" "${w_state}")  PATH"
  fi

  for ((i = 0; i < ${#branches[@]}; i++)); do
    if [[ -n "${pinned}" ]]; then
      echo "  $(pad "${branches[i]}" "${w_branch}")  $(pad "${heads[i]}" 7)  $(cpad "${vs_base[i]}" "${w_base}")  $(cpad "${vs_pinned[i]}" "${w_pinned}")  $(cpad "${syncs[i]}" "${w_sync}")  $(cpad "${states[i]}" "${w_state}")  ${paths[i]}"
    else
      echo "  $(pad "${branches[i]}" "${w_branch}")  $(pad "${heads[i]}" 7)  $(cpad "${vs_base[i]}" "${w_base}")  $(cpad "${syncs[i]}" "${w_sync}")  $(cpad "${states[i]}" "${w_state}")  ${paths[i]}"
    fi
  done
}

print_header "Listing the worktrees ..."

ROOT_LABEL="$(basename -s .git "$(git -C "${ROOT}" config --get remote.origin.url 2> /dev/null || echo "${ROOT}")")"
GIT=(-C "${ROOT}")
ROOT_BASE="$(default_branch "${GIT[@]}")"
MAIN_CHECKOUT=""
print_repo "${ROOT_LABEL}" ""

while read -r _ path; do
  name="$(basename "${path}")"
  gitdir="${COMMON_DIR}/modules/${name}"
  if [[ ! -d "${gitdir}" ]]; then
    print_newline
    print_subheader "${name}"
    print_warn "  not initialised — run: mise run setup:worktree"
    continue
  fi
  GIT=(--git-dir "${gitdir}")
  MAIN_CHECKOUT="$(cd "${gitdir}" && cd "$(git --git-dir "${gitdir}" config core.worktree)" && pwd)"
  pinned="$(git -C "${ROOT}" ls-tree "${ROOT_BASE}" -- "${path}" | awk '{print $3}')"
  print_repo "${name}" "${pinned}"
done < <(git config -f "${ROOT}/.gitmodules" --get-regexp '^submodule\..*\.path$')
