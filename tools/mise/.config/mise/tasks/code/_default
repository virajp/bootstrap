#!/usr/bin/env zsh
# Synced from bootstrap: tools/mise/.config/mise/tasks/code/_default. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Format, lint, scan all code"
#MISE dir="."

#USAGE flag "--debug" help="emit debug logs"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

[[ "${usage_debug:-false}" == "true" ]] && FLAGS="--debug" || FLAGS=""

mise run code:format

mise run code:lint

mise run code:sec
