#!/usr/bin/env bash
# Synced from repo-config: tools/flutter/.config/mise/tasks/setup/deps/flutter. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Install the Dart and Flutter dependencies; --upgrade also upgrades them"
#MISE hide=true

#USAGE flag "--upgrade" help="also upgrade the dependencies, major versions included"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the flutter tool. Without a pubspec.yaml, this is not a Flutter
# project, so the task does not apply and prints nothing.
[[ -f "${MISE_PROJECT_ROOT}/pubspec.yaml" ]] || exit 0

cd "${MISE_PROJECT_ROOT}"
if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_header "Upgrading Flutter dependencies ..."
  mise x -- flutter pub upgrade --major-versions
else
  print_header "Installing Flutter dependencies ..."
  mise x -- flutter pub get
fi
