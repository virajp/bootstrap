#!/usr/bin/env bash
# Synced from repo-config: tools/flutter/.config/mise/tasks/setup/deps/flutter. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Install the Dart, Flutter, CocoaPods and Gradle dependencies, then report the outdated ones; --upgrade cleans and upgrades them"
#MISE hide=true

#USAGE flag "--upgrade" help="clean all caches and lockfiles, then upgrade the dependencies, major versions included"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the flutter tool. Without a pubspec.yaml, this is not a Flutter
# project, so the task does not apply and prints nothing.
[[ -f "${MISE_PROJECT_ROOT}/pubspec.yaml" ]] || exit 0

cd "${MISE_PROJECT_ROOT}"
HAS_PODS=false
[[ -f ios/Podfile ]] && HAS_PODS=true
HAS_GRADLE=false
[[ -x android/gradlew ]] && HAS_GRADLE=true

if [[ "${usage_upgrade:-false}" == "true" ]]; then
  print_header "Upgrading Flutter dependencies ..."

  # The clean comes first, so that the upgrade leaves no dangling dependency.
  # The lockfiles go too: the upgrade then resolves every version again.
  print_subheader "Cleaning the Flutter build and the Dart caches ..."
  mise x -- flutter clean
  rm -rf .dart_tool build pubspec.lock ~/.dartServer
  mise x -- dart pub cache clean --force

  if [[ "${HAS_PODS}" == "true" ]]; then
    print_subheader "Cleaning CocoaPods and Xcode ..."
    (cd ios && pod deintegrate && pod cache clean --all)
    rm -rf ios/Pods ios/Podfile.lock ios/.symlinks \
      ios/Flutter/Flutter.framework ios/Flutter/Flutter.podspec \
      ~/Library/Caches/CocoaPods ~/Library/Developer/Xcode/DerivedData
  fi

  if [[ "${HAS_GRADLE}" == "true" ]]; then
    print_subheader "Cleaning Gradle ..."
    (cd android && ./gradlew --stop) || true
    rm -rf android/.gradle ~/.gradle
  fi

  print_subheader "Upgrading the Dart and Flutter packages ..."
  mise x -- flutter pub upgrade --major-versions
  LOCKED_PUB=()
  LOCKED_POD=()
else
  print_header "Installing Flutter dependencies ..."
  # The lockfiles decide the versions; an install never changes them. A lockfile
  # that does not match its manifest fails the install.
  LOCKED_PUB=(--enforce-lockfile)
  LOCKED_POD=(--deployment)
fi

print_subheader "Configuring Flutter ..."
mise x -- flutter config --disable-analytics
mise x -- dart --disable-analytics
[[ -n "${ANDROID_HOME:-}" ]] && mise x -- flutter config --android-sdk "${ANDROID_HOME}"

print_subheader "Accepting the Android licenses ..."
yes | mise x -- flutter doctor --android-licenses > /dev/null || true

print_subheader "Installing the Dart and Flutter packages ..."
mise x -- flutter pub get ${LOCKED_PUB[@]+"${LOCKED_PUB[@]}"}

if [[ "${HAS_PODS}" == "true" ]]; then
  print_subheader "Installing CocoaPods ..."
  (cd ios && pod install ${LOCKED_POD[@]+"${LOCKED_POD[@]}"})
fi

if [[ "${HAS_GRADLE}" == "true" ]]; then
  print_subheader "Refreshing the Gradle dependencies ..."
  (cd android && ./gradlew dependencies --refresh-dependencies > /dev/null)
fi

# A report only: each command exits 1 when a dependency is outdated.
print_subheader "Checking for outdated Flutter packages ..."
mise x -- flutter pub outdated --no-transitive || true

if [[ "${HAS_PODS}" == "true" ]]; then
  print_subheader "Checking for outdated CocoaPods ..."
  (cd ios && pod outdated --ignore-prerelease) || true
fi

# dependencyUpdates comes from the ben-manes versions plugin. Without it, the
# Gradle task does not exist.
if [[ "${HAS_GRADLE}" == "true" ]] && grep -rqs 'com.github.ben-manes.versions' android/; then
  print_subheader "Checking for outdated Gradle dependencies ..."
  (cd android && ./gradlew dependencyUpdates) || true
fi
