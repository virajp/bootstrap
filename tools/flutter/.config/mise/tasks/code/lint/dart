#!/usr/bin/env bash
# Synced from repo-config: tools/flutter/.config/mise/tasks/code/lint/dart. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Analyze the Dart files"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="accepted for the code:lint contract; dart analyze only reports"
#USAGE arg "[files]" var=#true help="the files to analyze; only the .dart files are used; the default is the whole project"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the flutter tool. Without a pubspec.yaml, this is not a Dart
# project, so the task does not apply and prints nothing.
[[ -f "${MISE_PROJECT_ROOT}/pubspec.yaml" ]] || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Only the .dart files are
# for dart analyze. Given files without a .dart file: nothing to do.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
TARGETS=()
if ((${#FILES[@]})); then
  for file in "${FILES[@]}"; do
    [[ "${file}" == *.dart && -f "${file}" ]] && TARGETS+=("${file}")
  done
  ((${#TARGETS[@]})) || exit 0
fi

print_header "Analyzing the Dart files ..."
# An info is a failure too: the analysis_options.yaml of the project decides
# which lints are on.
mise x -- dart analyze --fatal-infos ${TARGETS[@]+"${TARGETS[@]}"}
