#!/usr/bin/env bash
# Synced from bootstrap: tools/flutter/.config/mise/tasks/code/format/dart. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Check or format the Dart files"
#MISE hide=true

#USAGE flag "--debug" help="accepted for the code:format contract"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .dart files are used; the default is lib/ and test/"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the flutter tool. Without a pubspec.yaml, this is not a Dart
# project. Without a pubspec.yaml or without a .dart file, the task does not
# apply and prints nothing.
[[ -f "${MISE_PROJECT_ROOT}/pubspec.yaml" ]] || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:format passes its files to each code:format:* task. Only the .dart
# files are for dart format. Given files without a .dart file: nothing to do.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
TARGETS=()
if ((${#FILES[@]})); then
  for file in "${FILES[@]}"; do
    [[ "${file}" == *.dart && -f "${file}" ]] && TARGETS+=("${file}")
  done
  ((${#TARGETS[@]})) || exit 0
else
  # Without a tracked or new .dart file, nothing to do. A failed git stops the
  # task, with the error of git.
  LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- '*.dart')
  [[ -n "${LIST}" ]] || exit 0
  for dir in lib test; do
    [[ -d "${dir}" ]] && TARGETS+=("${dir}")
  done
  ((${#TARGETS[@]})) || exit 0
fi

print_header "Formatting the Dart files ..."
if [[ "${usage_fix:-false}" == "true" ]]; then
  mise x -- dart format "${TARGETS[@]}"
else
  mise x -- dart format --output=none --set-exit-if-changed "${TARGETS[@]}"
fi
