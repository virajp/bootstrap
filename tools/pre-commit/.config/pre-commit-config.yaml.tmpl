---
# Synced from bootstrap: tools/pre-commit/.config/pre-commit-config.yaml.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
# The pre-commit config. repo_sync renders it from the `[[precommit]]` entries
# of the selected tools, then the entries of `.config/repo-sync/pre-commit.yaml`.
#
# pre-commit does not find a config under `.config/`. `setup:precommit` installs
# the hooks with the path, so `git commit` needs no flag. `pre-commit run` needs
# `--config .config/pre-commit-config.yaml`.

# 3.2.0 is the first version with the `pre-commit` and `pre-push` stage names.
minimum_pre_commit_version: "3.2.0"

# `commit-msg` is for the conventional-commits hook, `post-commit` and
# `post-merge` for graphify-refresh. A hook type that is not installed never
# runs.
default_install_hook_types:
  - pre-commit
  - commit-msg
  - post-commit
  - post-merge

default_stages: [ pre-commit ]

# Generated files. No hook may rewrite them.
exclude: ^graphify-out/|(^|/)\.config/mise/locks/

<%- /* A YAML value in the style dprint writes: quoted strings, `[ a, b ]` lists. */ -%>
<%- define "value" %><% if test.IsKind "slice" . %>[ <% range $i, $x := . %><% if $i %>, <% end %><% $x | strings.Quote %><% end %> ]<% else if test.IsKind "string" . %><% . | strings.Quote %><% else %><% . %><% end %><% end %>
repos:
<%- $order := coll.Slice "name" "description" "entry" "language" "args" "files" "exclude" "types" "types_or" "exclude_types" "pass_filenames" "always_run" "require_serial" "verbose" "stages" %>
<%- range .precommit %>
  - repo: <% .repo %>
<%- if has . "rev" %>
    rev: <% .rev %>
<%- end %>
    hooks:
<%- range $h := .hooks %>
      - id: <% $h.id %>
<%- range $k := $order %><% if has $h $k %>
        <% $k %>: <% template "value" (index $h $k) %>
<%- end %><% end %>
<%- range $k, $v := $h %><% if and (ne $k "id") (not (has $order $k)) %>
        <% $k %>: <% template "value" $v %>
<%- end %><% end %>
<%- end %>
<%- end %>
