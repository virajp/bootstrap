#!/usr/bin/env bash
# Synced from bootstrap: tools/kotlin/.config/mise/tasks/code/lint/detekt. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Lint the Kotlin files with detekt"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="accepted for the code:lint contract; ktlint decides the layout"
#USAGE arg "[files]" var=#true help="the files that start the lint; only the .kt and .kts files are used; detekt always lints each Kotlin file that git does not ignore"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the kotlin tool. Without detekt, the task does not apply and
# prints nothing.
mise x -- which detekt-cli > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:lint passes its files to each code:lint:* task. Given files without a
# Kotlin file: nothing to do. A detekt finding can be about more than one
# file, so detekt always gets each Kotlin file. detekt does not read
# .gitignore, so the list comes from git.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ((${#FILES[@]})); then
  KOTLIN=0
  for file in "${FILES[@]}"; do
    [[ "${file}" == *.kt || "${file}" == *.kts ]] && KOTLIN=1
  done
  ((KOTLIN)) || exit 0
fi
# A failed git stops the task, with the error of git.
LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- '*.kt' '*.kts' | sort -u)
TARGETS=()
while IFS= read -r file; do
  case "/${file}" in
    */generated/*) ;;
    *)
      [[ -n "${file}" && -f "${file}" ]] && TARGETS+=("${file}")
      ;;
  esac
done <<< "${LIST}"
((${#TARGETS[@]})) || exit 0

print_header "Linting the Kotlin files with detekt ..."

# --input takes one list: separated by commas in detekt 1.x, and by the path
# separator in 2.x. The argument file below separates on whitespace. Thus a
# path with the separator or with whitespace is skipped.
SEPARATOR=,
VERSION=$(mise x -- detekt-cli --version 2> /dev/null) || VERSION=''
[[ "${VERSION}" =~ ^[2-9] ]] && SEPARATOR=:
INPUT=''
for file in "${TARGETS[@]}"; do
  if [[ "${file}" == *"${SEPARATOR}"* || "${file}" =~ [[:space:]] ]]; then
    print_warn "detekt cannot read the path ${file}, skipped"
    continue
  fi
  INPUT="${INPUT:+${INPUT}${SEPARATOR}}${file}"
done
[[ -n "${INPUT}" ]] || exit 0

# An argument file, not the command line: Linux limits one argument to
# 128 KiB, and the --input list of a large tree can be longer.
ARGFILE=$(mktemp "${TMPDIR:-/tmp}/code-lint-detekt.XXXXXX")
trap 'rm -f "${ARGFILE}"' EXIT
{
  printf '%s\n' --input "${INPUT}" --config .config/detekt.yml --build-upon-default-config
  if [[ "${usage_debug:-false}" == "true" ]]; then
    printf '%s\n' --debug
  fi
} > "${ARGFILE}"
mise x -- detekt-cli "@${ARGFILE}"
