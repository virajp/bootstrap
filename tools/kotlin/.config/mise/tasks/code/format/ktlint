#!/usr/bin/env bash
# Synced from bootstrap: tools/kotlin/.config/mise/tasks/code/format/ktlint. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Check or format the Kotlin files with ktlint"
#MISE hide=true

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; only the .kt and .kts files are used; the default is each Kotlin file that git does not ignore"

set -euo pipefail
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the kotlin tool. Without ktlint or without a Kotlin file, the
# task does not apply and prints nothing.
mise x -- which ktlint > /dev/null 2>&1 || exit 0
cd "${MISE_PROJECT_ROOT}"

# code:format passes its files to each code:format:* task. Only the Kotlin
# files are for ktlint, and not the generated ones. Without files the list
# comes from git, so ktlint never reads an ignored folder.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ! ((${#FILES[@]})); then
  # A failed git stops the task, with the error of git.
  LIST=$(git -c core.quotePath=off ls-files --cached --others --exclude-standard -- '*.kt' '*.kts' | sort -u)
  while IFS= read -r file; do
    [[ -n "${file}" ]] && FILES+=("${file}")
  done <<< "${LIST}"
fi
TARGETS=()
for file in ${FILES[@]+"${FILES[@]}"}; do
  case "/${file}" in
    */generated/*) ;;
    *.kt | *.kts)
      [[ -f "${file}" ]] && TARGETS+=("${file}")
      ;;
  esac
done
((${#TARGETS[@]})) || exit 0

ARGS=(--relative --editorconfig=.config/ktlint.editorconfig)
[[ "${usage_debug:-false}" == "true" ]] && ARGS+=(--log-level=debug)
[[ "${usage_fix:-false}" == "true" ]] && ARGS+=(--format)

print_header "Formatting the Kotlin files with ktlint ..."
# Without --fix, the check is the lint of ktlint: it reports each file that
# --format changes, and each problem that --format cannot fix.
mise x -- ktlint "${ARGS[@]}" "${TARGETS[@]}"
