#!/usr/bin/env bash
# Synced from bootstrap: tools/kotlin/.config/mise/tasks/setup/deps/kotlin. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Resolve the Gradle dependencies and check that the committed lockfiles cover them; --upgrade writes new lockfiles"
#MISE hide=true

#USAGE flag "--upgrade" help="refresh the dependencies, write new lockfiles and report the outdated ones"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the kotlin tool. Without an executable ./gradlew at the root,
# there is no Gradle build here, so the task does not apply and prints nothing.
# The android/ build of a Flutter app belongs to setup:deps:flutter.
[[ -x "${MISE_PROJECT_ROOT}/gradlew" ]] || exit 0

cd "${MISE_PROJECT_ROOT}"
UPGRADE="${usage_upgrade:-false}"

if [[ "${UPGRADE}" == "true" ]]; then
  print_header "Upgrading the Gradle dependencies ..."
else
  print_header "Installing the Gradle dependencies ..."
fi

# Only the distribution is checked; the wrapper downloads it before any build.
# A present key is not enough: the value must be a SHA-256, 64 hex digits.
print_subheader "Checking the Gradle distribution checksum ..."
if ! grep -Eqs '^[[:space:]]*distributionSha256Sum[[:space:]]*[=:][[:space:]]*[0-9a-fA-F]{64}[[:space:]]*$' \
  gradle/wrapper/gradle-wrapper.properties; then
  print_error "gradle/wrapper/gradle-wrapper.properties sets no valid distributionSha256Sum."
  print_yellow "Set it to the 64-hex checksum that Gradle publishes for the distribution, then re-run."
  exit 1
fi
print_success "distributionSha256Sum is set."

# The lockfiles that git sees, relative to the root: tracked, and untracked
# but not ignored. Gradle writes gradle.lockfile, settings-gradle.lockfile and
# buildscript-gradle.lockfile; the pattern matches all of them in any folder.
lockfiles() {
  git ls-files --cached --others --exclude-standard -- '*gradle.lockfile'
}

# The temporary folder holds the init script and, in a normal run, a copy of
# each lockfile before the resolve. RESTORE stays true until the lockfiles are
# back, so an interrupted run leaves them as it found them.
TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-gradle.XXXXXX")
RESTORE=false

restore_lockfiles() {
  local file
  while IFS= read -r file; do
    [[ -n "${file}" ]] || continue
    if [[ -f "${TMP_DIR}/before/${file}" ]]; then
      cmp -s "${TMP_DIR}/before/${file}" "${file}" || cp "${TMP_DIR}/before/${file}" "${file}"
    elif [[ -f "${file}" ]]; then
      rm -f "${file}"
    fi
  done < "${TMP_DIR}/lockfiles"
}

cleanup() {
  if [[ "${RESTORE}" == "true" ]]; then
    # The lockfiles before the resolve, plus the ones that it created.
    lockfiles >> "${TMP_DIR}/lockfiles" 2> /dev/null || true
    restore_lockfiles
  fi
  rm -rf "${TMP_DIR}"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# Every resolvable configuration of every project, not the root's alone.
# Resolving fails on a mismatch with a lockfile.
INIT_SCRIPT="${TMP_DIR}/resolve-all.gradle"
printf '%s\n' \
  'allprojects { p ->' \
  '  p.tasks.register("bootstrapResolveAll") {' \
  '    notCompatibleWithConfigurationCache("resolves every configuration at execution time")' \
  '    def confs = p.configurations' \
  '    doLast { confs.matching { it.canBeResolved }.each { it.resolve() } }' \
  '  }' \
  '}' > "${INIT_SCRIPT}"

if [[ "${UPGRADE}" == "true" ]]; then
  print_subheader "Writing new lockfiles for every project ..."
  ./gradlew --init-script "${INIT_SCRIPT}" bootstrapResolveAll --write-locks --refresh-dependencies

  # dependencyUpdates comes from the ben-manes versions plugin. Only Gradle's
  # task-not-found error is a skip; any other failure is the build's.
  print_subheader "Checking for outdated Gradle dependencies ..."
  if ./gradlew dependencyUpdates 2>&1 | tee "${TMP_DIR}/outdated.log"; then
    print_success "Commit the new lockfiles."
    exit 0
  fi
  if grep -Eq "Task '(:)?dependencyUpdates' not found" "${TMP_DIR}/outdated.log"; then
    print_info "No dependencyUpdates task (the ben-manes plugin com.github.ben-manes.versions), so no report."
    print_success "Commit the new lockfiles."
    exit 0
  fi
  print_error "./gradlew dependencyUpdates failed; its output is above."
  exit 1
fi

# A normal run writes the locks of every configuration, then compares them
# with git. A module without a committed lockfile gets a new one, so the check
# does not depend on LockMode.STRICT in the build.
lockfiles > "${TMP_DIR}/lockfiles" || {
  print_error "The lock check needs a git repository at ${MISE_PROJECT_ROOT}."
  exit 1
}
while IFS= read -r file; do
  [[ -f "${file}" ]] || continue
  mkdir -p "${TMP_DIR}/before/$(dirname "${file}")"
  cp "${file}" "${TMP_DIR}/before/${file}"
done < "${TMP_DIR}/lockfiles"
RESTORE=true

print_subheader "Resolving every project against its lockfile ..."
./gradlew --init-script "${INIT_SCRIPT}" bootstrapResolveAll --write-locks

print_subheader "Checking the lockfiles against git ..."
# Modified or deleted against the index, and untracked.
CHANGED=$(git ls-files --modified --others --exclude-standard -- '*gradle.lockfile' | sort -u) || CHANGED=''

lockfiles >> "${TMP_DIR}/lockfiles"
restore_lockfiles
RESTORE=false

if [[ -n "${CHANGED}" ]]; then
  print_error "The resolve changed or created lockfiles that git does not have:"
  while IFS= read -r file; do
    print_error "  ${file}"
  done <<< "${CHANGED}"
  print_yellow "Run 'mise run setup:deps:kotlin --upgrade', then commit the lockfiles."
  exit 1
fi
print_success "The committed lockfiles cover every configuration."
