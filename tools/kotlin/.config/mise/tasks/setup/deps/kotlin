#!/usr/bin/env bash
# Synced from bootstrap: tools/kotlin/.config/mise/tasks/setup/deps/kotlin. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Resolve the Gradle dependencies and check that the lockfiles cover them; --upgrade writes new lockfiles"
#MISE hide=true

#USAGE flag "--upgrade" help="refresh the dependencies, write new lockfiles and report the outdated ones"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Shipped with the kotlin tool. Without an executable ./gradlew at the root,
# there is no Gradle build here, so the task does not apply and prints nothing.
# The android/ build of a Flutter app belongs to setup:deps:flutter.
[[ -x "${MISE_PROJECT_ROOT}/gradlew" ]] || exit 0

cd "${MISE_PROJECT_ROOT}"
UPGRADE="${usage_upgrade:-false}"

if [[ "${UPGRADE}" == "true" ]]; then
  print_header "Upgrading the Gradle dependencies ..."
else
  print_header "Installing the Gradle dependencies ..."
fi

# Only the distribution is checked; the wrapper downloads it before any build.
# A present key is not enough: the value must be a SHA-256, 64 hex digits.
print_subheader "Checking the Gradle distribution checksum ..."
if ! grep -Eqs '^[[:space:]]*distributionSha256Sum[[:space:]]*[=:][[:space:]]*[0-9a-fA-F]{64}[[:space:]]*$' \
  gradle/wrapper/gradle-wrapper.properties; then
  print_error "gradle/wrapper/gradle-wrapper.properties sets no valid distributionSha256Sum."
  print_info "Set it to the 64-hex checksum that Gradle publishes for the distribution, then re-run."
  exit 1
fi
print_success "distributionSha256Sum is set."

# The lockfiles on the disk below the root. Gradle writes
# gradle.lockfile, settings-gradle.lockfile and buildscript-gradle.lockfile;
# the pattern matches all of them in any folder. find does not use git, so the
# result is correct in a root that is not a git repository and for ignored
# lockfiles. It does not go into hidden folders (.git, .gradle, worktrees),
# build outputs or node_modules.
lockfiles() {
  find . \( -type d \( -name '.?*' -o -name build -o -name node_modules \) -prune \) \
    -o \( -type f -name '*gradle.lockfile' -print \)
}

# The temporary folder holds the init script and the dependencyUpdates log.
TMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/bootstrap-gradle.XXXXXX")
trap 'rm -rf "${TMP_DIR}"' EXIT
trap 'exit 130' INT TERM

# Every resolvable-only configuration of every project, not the root's alone.
# A configuration that is also consumable (legacy default, archives) is for
# other projects, so the task does not resolve it. The list is a copy, so a
# resolve that adds a configuration does not change the loop. A normal run
# sets LockMode.STRICT on each project when Gradle creates it, before its
# build script: a resolve fails on a mismatch with a lockfile, and on a locked
# configuration with no lock state. --upgrade does not set STRICT, so a new
# module gets its first lockfile there.
INIT_SCRIPT="${TMP_DIR}/resolve-all.gradle"
{
  printf '%s\n' 'allprojects { p ->'
  if [[ "${UPGRADE}" != "true" ]]; then
    printf '%s\n' '  p.dependencyLocking.lockMode.set(org.gradle.api.artifacts.dsl.LockMode.STRICT)'
  fi
  printf '%s\n' \
    '  p.tasks.register("bootstrapResolveAll") {' \
    '    notCompatibleWithConfigurationCache("resolves the configurations at execution time")' \
    '    def confs = p.configurations' \
    '    doLast { confs.matching { it.canBeResolved && !it.canBeConsumed }.toList().each { it.resolve() } }' \
    '  }' \
    '}'
} > "${INIT_SCRIPT}"

if [[ "${UPGRADE}" == "true" ]]; then
  print_subheader "Writing new lockfiles for every project ..."
  ./gradlew --init-script "${INIT_SCRIPT}" bootstrapResolveAll --write-locks --refresh-dependencies

  # Gradle writes a lockfile only for a project with dependencyLocking. The
  # last message tells whether there is anything to commit.
  LOCKS=$(lockfiles) || LOCKS=''
  UPDATED=$(git ls-files --modified --others --exclude-standard -- '*gradle.lockfile') || UPDATED=''
  upgrade_done() {
    if [[ -z "${LOCKS}" ]]; then
      print_warn "No project has dependencyLocking, so the resolve wrote no lockfile."
    elif [[ -n "${UPDATED}" ]]; then
      print_success "Commit the new lockfiles."
    else
      print_success "The lockfiles did not change."
    fi
  }

  # dependencyUpdates comes from the ben-manes versions plugin. Only Gradle's
  # task-not-found error is a skip; any other failure is the build's.
  print_subheader "Checking for outdated Gradle dependencies ..."
  if ./gradlew dependencyUpdates 2>&1 | tee "${TMP_DIR}/outdated.log"; then
    upgrade_done
    exit 0
  fi
  if grep -Eq "Task '(:)?dependencyUpdates' not found" "${TMP_DIR}/outdated.log"; then
    print_info "No dependencyUpdates task (the ben-manes plugin com.github.ben-manes.versions), so no report."
    upgrade_done
    exit 0
  fi
  print_error "./gradlew dependencyUpdates failed; its output is above."
  exit 1
fi

# A normal run resolves against the lockfiles on the disk and writes no file.
# Gradle pins each locked version, so a dynamic version stays at its locked
# version. A module without dependencyLocking has no lock state and is not
# checked.
print_subheader "Resolving every project against its lockfile ..."
if ! ./gradlew --init-script "${INIT_SCRIPT}" bootstrapResolveAll; then
  print_error "The resolve does not match the lockfiles; the Gradle output above names the project and the configuration."
  print_info "Run 'mise run setup:deps:kotlin --upgrade', then commit the lockfiles."
  exit 1
fi

LOCKS=$(lockfiles) || LOCKS=''
if [[ -z "${LOCKS}" ]]; then
  print_warn "No project has dependencyLocking, so there is no lockfile to check."
  exit 0
fi
print_success "The lockfiles cover each resolvable-only configuration of each project with dependencyLocking."
