# The ktlint defaults of this repository. The ktlint tasks pass this file with
# --editorconfig. An .editorconfig on the path of a source file wins over a
# value here, so keep the layout decisions in this file only.

[*.{kt,kts}]
ktlint_code_style = ktlint_official
indent_style = space
indent_size = 4
max_line_length = 120
insert_final_newline = true
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
