#!/usr/bin/env bash
# Synced from bootstrap: tools/doppler/.config/mise/tasks/setup/secrets/doppler. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Select the Doppler project and config of this repository"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# A repository without a doppler.yaml has no Doppler project to select.
[[ -f "${MISE_PROJECT_ROOT}/doppler.yaml" ]] || exit 0

print_header "Setting up the secrets with Doppler ..."

if ! mise x -- which doppler > /dev/null 2>&1; then
  print_warn "doppler is not on PATH — skipping secrets setup."
  print_yellow "Install the repo's pinned tools with 'mise install', then re-run this task."
  exit 0
fi

# `doppler login` opens a browser, so this task does not run it.
if ! mise x -- doppler me > /dev/null 2>&1; then
  print_warn "Not logged in to Doppler — skipping secrets setup."
  print_yellow "Run 'mise x -- doppler login', then re-run this task."
  exit 0
fi

# doppler reads ./doppler.yaml, so it runs from the repository root. Without
# prompts, it takes the project and config from that file.
cd "${MISE_PROJECT_ROOT}"
mise x -- doppler setup --no-interactive
