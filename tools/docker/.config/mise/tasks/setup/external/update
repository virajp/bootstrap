#!/usr/bin/env bash
#MISE description="Update the local services: stop, pull, start (at most once a week)"
#MISE hide=true

#USAGE flag "-f --force" help="update even if the last update was less than a week ago"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Local services are for development only.
if [[ "${MISE_ENV:-}" != "dev" ]]; then
  exit 0
fi

STAMP_FILE="${TMPDIR:-/tmp}/mise-external-update-${REPO_NAME:-repo}.stamp"
ONE_WEEK_SECONDS=$((7 * 24 * 60 * 60))

if [[ "${usage_force:-false}" == "true" ]]; then
  rm -f "${STAMP_FILE}"
elif [[ -f "${STAMP_FILE}" ]]; then
  ELAPSED=$(($(date +%s) - $(date -r "${STAMP_FILE}" +%s)))
  if [[ "${ELAPSED}" -lt "${ONE_WEEK_SECONDS}" ]]; then
    print_info "The last update was less than a week ago. Use --force to update now."
    exit 0
  fi
fi

mise run setup:external:stop
mise run setup:external:pull
mise run setup:external:start

touch "${STAMP_FILE}"
print_success "Local services updated"
