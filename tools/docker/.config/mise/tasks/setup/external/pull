#!/usr/bin/env bash
# Synced from bootstrap: tools/docker/.config/mise/tasks/setup/external/pull. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Build the local images and pull the other images"
#MISE hide=true
#MISE depends=["setup:external:check"]

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Local services are for development only.
if [[ "${MISE_ENV:-}" != "dev" ]]; then
  exit 0
fi

print_header "Getting the images of the local services ..."

print_subheader "Building the local images ..."
mise x -- docker compose --file "${MISE_PROJECT_ROOT}/.tools/docker-compose.yaml" build

print_subheader "Pulling the images ..."
mise x -- docker compose --file "${MISE_PROJECT_ROOT}/.tools/docker-compose.yaml" pull --ignore-buildable
