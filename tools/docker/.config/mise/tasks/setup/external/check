#!/usr/bin/env bash
# Synced from bootstrap: tools/docker/.config/mise/tasks/setup/external/check. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Make sure that the Docker server is reachable"
#MISE hide=true

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

if ! mise x -- which docker > /dev/null 2>&1; then
  print_error "The 'docker' command-line tool is not installed."
  exit 1
fi

if ! mise x -- docker info > /dev/null 2>&1; then
  print_error "Cannot connect to the Docker server."
  print_yellow "Start the Docker daemon, or correct DOCKER_HOST."
  exit 1
fi
