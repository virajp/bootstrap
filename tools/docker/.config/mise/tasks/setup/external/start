#!/usr/bin/env bash
# Synced from bootstrap: tools/docker/.config/mise/tasks/setup/external/start. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Start the local services"
#MISE depends=["setup:external:check"]

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

# Local services are for development only.
if [[ "${MISE_ENV:-}" != "dev" ]]; then
  exit 0
fi

print_header "Starting the local services ..."
mise x -- docker compose --file "${MISE_PROJECT_ROOT}/.tools/docker-compose.yaml" up --detach
