# Synced from bootstrap: tools/github/.github/ISSUE_TEMPLATE/config.yml.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
blank_issues_enabled: false
<% if has . "repo_url" -%>
contact_links:
  - name: Documentation
    url: <% .repo_url %>#readme
    about: What this repository ships, and how to use it — check here before
      filing a bug.
  - name: Report a vulnerability
    url: <% .repo_url %>/security/advisories/new
    about: Security reports go through the private advisory channel, never
      through an issue.
<% end -%>
