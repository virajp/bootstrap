#!/usr/bin/env bash
# Synced from bootstrap: tools/repo-sync/.config/mise/tasks/_scripts/repo-sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Forward to sync-engine/repo-sync of the clone"
#MISE hide=true

# An old `setup/configs/sync` task sources this file from the clone with
# `REPO_SYNC_CLONE`. This file forwards to `sync-engine/repo-sync` of the same
# clone. The cleanup plan removes it.

: "${BOOTSTRAP_CLONE:=${REPO_SYNC_CLONE:-}}"
if [[ -z $BOOTSTRAP_CLONE ]]; then
  printf '%s\n' 'repo-sync: no clone - run mise run setup:configs' >&2
  return 2
fi
export BOOTSTRAP_CLONE
# shellcheck source=/dev/null
source "${BOOTSTRAP_CLONE}/sync-engine/repo-sync"
