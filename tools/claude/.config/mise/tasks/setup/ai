#!/usr/bin/env bash
# Synced from repo-config: tools/claude/.config/mise/tasks/setup/ai. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Update the Claude Code marketplaces and plugins"
#MISE hide=true

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Updating the Claude Code plugins ..."

if ! mise x -- which claude > /dev/null 2>&1; then
  print_warn "claude is not on PATH — skipping AI setup."
  print_yellow "Install it from https://claude.com/code, then run this task again."
  exit 0
fi
print_wait "Updating the marketplaces ... "
mise x -- claude plugin marketplace update > /dev/null
print_success

# Every plugin installed on this machine, in every scope.
PLUGINS="$(mise x -- claude plugin list --json | mise x -- jq -r '.[] | "\(.id)|\(.scope)"')"
while IFS= read -r PLUGIN; do
  [[ -n "${PLUGIN}" ]] || continue
  print_wait "- ${PLUGIN%%|*} (${PLUGIN##*|}) ... "
  mise x -- claude plugin update --scope "${PLUGIN##*|}" "${PLUGIN%%|*}" > /dev/null
  print_success
done <<< "${PLUGINS}"

print_wait "Removing the plugins that nothing references ... "
mise x -- claude plugin autoremove --scope project --yes > /dev/null
print_success
