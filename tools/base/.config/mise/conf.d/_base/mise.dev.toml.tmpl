# Synced from repo-config: tools/base/.config/mise/conf.d/_base/mise.dev.toml.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

# Formatter
[tools.dprint]
version = "latest"

# Linter
[tools."npm:@askviraj/linter"]
version = "latest"

# Shell linter
[tools.shellcheck]
version = "latest"

# Template renderer for `setup:configs`. Declared here too, because `mise prune`
# keeps only the tools that a config file names, not a task header.
[tools.gomplate]
version = "latest"

# JSON and YAML queries
[tools.jq]
version = "latest"

[tools.yq]
version = "latest"

# `setup-all` and `setup-<submodule>` exist only in a repo with git submodules.
[shell_alias]
setup = "mise run setup"
<% $subs := coll.Slice %><% if has . "submodules" %><% $subs = .submodules %><% end -%>
<% if $subs -%>
setup-all = "mise run setup --all"
<% end -%>
<% range $subs -%>
"setup-<% . %>" = "mise run setup --<% . %>"
<% end -%>
