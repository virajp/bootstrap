#!/usr/bin/env bash
# Synced from repo-config: tools/base/.config/mise/tasks/code/merge/main. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Land develop on main — merge it, or open a pull request"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/merge"

# Release. Both branches are fixed: only `develop` reaches `main`, so there is
# nothing to name and nothing to get wrong. Run it from `develop` — the merge
# refuses from anywhere else, and says so before touching a branch.
#
# Under `MERGE_MODEL_MAIN = "pr"` the same pair becomes the request this opens:
# `develop` → `main`.

merge_to_destination_branch main develop
