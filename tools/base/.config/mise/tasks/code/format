#!/usr/bin/env bash
# Synced from repo-config: tools/base/.config/mise/tasks/code/format. Do not edit this file.
# The next sync replaces it, and a manual change is lost.
#MISE description="Check or format files"

#USAGE flag "--debug" help="emit debug logs"
#USAGE flag "--fix" help="apply fixes"
#USAGE arg "[files]" var=#true help="the files to format; the default is the whole tree"

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"

print_header "Formatting files ..."
[[ "${usage_debug:-false}" == "true" ]] && LOG_LEVEL="debug" || LOG_LEVEL="warn"
[[ "${usage_fix:-false}" == "true" ]] && CMD="fmt" || CMD="check"

# The pre-commit hook passes the staged files. A file that no plugin formats
# is not an error, so the hook passes for a commit of only such files.
FILES=()
[[ -n "${usage_files:-}" ]] && eval "FILES=(${usage_files})"
if ((${#FILES[@]})); then
  mise x -- dprint ${CMD} --allow-no-files --log-level ${LOG_LEVEL} "${FILES[@]}"
else
  mise x -- dprint ${CMD} --log-level ${LOG_LEVEL}
fi

print_success "Formatting done"
