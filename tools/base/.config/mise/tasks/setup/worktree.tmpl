#!/usr/bin/env bash
# Synced from repo-config: tools/base/.config/mise/tasks/setup/worktree.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Initialise a fresh git worktree: checkout submodules, copy local files, install tools, secrets and deps (lighter than setup)"
#MISE hide=false

set -e
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/checks"

# The same install steps as `setup`, without --upgrade and without the steps
# that configure the machine rather than the checkout: the linter init and
# `setup:ai`. The hooks stay: the root shares the main checkout's hooks, but a
# submodule checked out in a linked worktree gets a new git directory under
# `.git/worktrees/<name>/modules/`, with no hooks in it.

print_header "Checking out submodules ..."
git -C "${MISE_PROJECT_ROOT}" submodule update --init --recursive
<% if has . "worktree_files" %>
# The gitignored files a checkout needs but git never brings, copied from the
# main worktree. An existing file is never overwritten. In the main checkout
# itself there is nothing to copy from.
if is_git_worktree; then
  print_header "Copying local files from the main worktree ..."
  MAIN_WORKTREE_PATH=$(get_main_worktree_path)
  for file in<% range .worktree_files %> "<% . %>"<% end %>; do
    if [[ -e "${MISE_PROJECT_ROOT}/${file}" ]]; then
      print_info "${file}: already present"
    elif [[ -e "${MAIN_WORKTREE_PATH}/${file}" ]]; then
      mkdir -p "$(dirname "${MISE_PROJECT_ROOT}/${file}")"
      cp -R "${MAIN_WORKTREE_PATH}/${file}" "${MISE_PROJECT_ROOT}/${file}"
      print_success "${file}: copied"
    else
      print_warn "${file}: not in the main worktree"
    fi
  done
fi
<% end %>
mise run setup:mise

for task in $(own_tasks setup:secrets); do
  mise run "${task}"
done

for task in $(own_tasks setup:deps); do
  mise run "${task}"
done

if has_own_task setup:precommit; then
  mise run setup:precommit
fi

<% range .members -%>
<% $x := dict %><% if and (has $ "member") (has $.member .) %><% $x = index $.member . %><% end -%>
<% if has $x "worktree_install" -%>
print_header "Installing <% . %> dependencies ..."
mise x --cd "${MISE_PROJECT_ROOT}/<% . %>" -- <% $x.worktree_install %>
<% else -%>
if MISE_PROJECT_ROOT="${MISE_PROJECT_ROOT}/<% . %>" has_own_task setup:worktree; then
  print_header "Setting up the <% index $x "label" | default . %> worktree ..."
  mise run --cd "${MISE_PROJECT_ROOT}/<% . %>" setup:worktree
fi
<% end -%>

<% end -%>
print_header "Worktree ready!"
