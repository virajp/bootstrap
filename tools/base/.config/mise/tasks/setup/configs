#!/usr/bin/env bash

#MISE description="Sync the shared files of this repository's tools from repo-config"
#MISE tools.gomplate="latest"

#USAGE flag "--dry-run" help="show the changes without writing them"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"

# The tools come from `tools` in .config/repo-config.toml.
if [[ "${usage_dry_run:-false}" == "true" ]]; then
  repo_sync --dry-run
else
  repo_sync
fi
