#!/usr/bin/env bash
# Synced from repo-config: tools/base/.config/mise/tasks/setup/configs. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Sync the shared files of this repository's tools from repo-config"
#MISE tools.gomplate="latest"

#USAGE flag "--dry-run" help="show the changes without writing them"

set -euo pipefail
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
# shellcheck source=/dev/null
source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"

print_header "Syncing the shared files from repo-config ..."

# The tools come from `tools` in .config/repo-config.toml.
if [[ "${usage_dry_run:-false}" == "true" ]]; then
  repo_sync --dry-run
else
  repo_sync
fi
