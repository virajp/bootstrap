#!/usr/bin/env bash
# Synced from repo-config: tools/base/.config/mise/tasks/_scripts/repo-sync. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

#MISE description="Helper functions to sync shared files from the repo-config repo"
#MISE hide=true

# repo-sync — copy the shared files of the selected tools from the private
# `repo-config` repo into this repo. Meant to be *sourced* by a mise task, not
# executed:
#
#   source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/repo-sync"
#   repo_sync [--dry-run]
#
# The values file lists the tools: `tools = ["base", "node"]`. Each tool is a
# folder `tools/<tool>/` in `repo-config`, which holds its files at the path
# they get here, and a `tool.toml` manifest:
#
#   depends    = ["python"]     tools added with this one
#   root_only  = false          true: refused in a git submodule
#   extensions = ["a.b"]        VS Code extensions, for `.vscode/extensions.json`
#   seed       = ["bunfig.toml"] files written only when missing; the repo owns
#                               them after that
#   [seed_requires]             optional: a seed written only when this repo
#                               has the file, `"pnpm-workspace.yaml" = "package.json"`
#   [[precommit]]               `repos:` entries of `.config/pre-commit-config.yaml`
#
# One call clones the default branch once (shallow, over SSH) and syncs every
# file of every selected tool from that one clone.
#
# Core tools: a tool in `core_tools` of the values file ships its
# `conf.d/<topic>/mise.dev.toml` here as `mise.toml`, so mise loads it in every
# environment. Nothing is deleted: a repo that moves a tool in or out of
# `core_tools` deletes the old file itself.
#
# Templates: a file that ends in `.tmpl` is rendered with gomplate, formatted
# with this repo's dprint config when dprint is available, and written without
# the suffix. The context is the values file (`<% .repo_name %>`,
# `<% .member.<name>.label %>`) plus:
#   .submodules  the git submodules only, nested ones included
#   .members     the git members from `members()` in `helpers` (submodules,
#                else MEMBERS), then each `[member.<name>]` of the values file
#                that is not one of them — a folder of a monorepo, which must
#                exist
#   .tools       the selected tools, dependencies included
#   .extensions  the VS Code extensions of those tools, sorted, no duplicates
#   .precommit   the `[[precommit]]` entries of those tools, in tool order, then
#                the entries of this repo's `.config/repo-sync/pre-commit.yaml`
# The delimiters are `<% %>`, because `{{ }}` belongs to mise and `[[ ]]` to
# bash, and both must reach the output unchanged. gomplate reads the TOML too;
# the calling task provides it with `#MISE tools.gomplate="latest"`.
#
# Merge tasks: the branch model follows the branches that exist, here or on
# origin. With `main` and `develop`, the sync writes `code/merge/develop` and
# `code/merge/main`; with only one of them, `code/merge/_default`. It removes the
# merge tasks of the other model: they are not seeds, so the repo does not own
# them. With neither branch, the sync stops.
#
# .gitignore: the shared ignore set is written first, then the lines of this
# repo's `.config/repo-sync/gitignore`, if that file exists. A later line wins,
# so the repo can negate a shared pattern with `!`.
#
# Failure handling
#   * A file takes the mode of its source, also when it exists already. To
#     make a template executable, make its `.tmpl` executable.
#   * A destination is only replaced after a complete copy or render, so a
#     failure always leaves the existing file as it was.
#   * A bad file does not stop the others; a failed clone, an unknown tool or a
#     root-only tool in a submodule stops the whole run.
#
# Return codes
#   0  success (or nothing to change)
#   2  usage error, a values file without `tools`, a root-only tool in a
#      submodule, a repo with neither `main` nor `develop`, or a template that
#      cannot render
#   3  a tool that is not in repo-config (fix the values file)
#   5  the clone failed (network, SSH key or access to the repo), or
#      `pre-commit autoupdate` could not resolve the hook revisions
#   1  anything else (local filesystem errors, ...)
#
# Environment:
#   REPO_SYNC_URL     the repo to clone (default git@github.com:virajp/repo-config.git)
#   REPO_SYNC_VALUES  the values file
#                     (default $MISE_PROJECT_ROOT/.config/repo-config.toml)

_rs_log() { printf '%s\n' "repo-sync: $*" >&2; }

# Print the permission bits of <path>, for example 755.
_rs_mode() { stat -c %a -- "$1" 2> /dev/null || stat -f %Lp -- "$1"; }

# Show <path> relative to the current directory when it is under it.
_rs_path() { [[ $1 == "$PWD"/* ]] && printf '%s' "${1#"$PWD"/}" || printf '%s' "$1"; }

# Temp files and directories still on disk; removed if the task exits early.
_RS_TMPS=()
_rs_cleanup() {
  ((${#_RS_TMPS[@]})) && rm -rf -- "${_RS_TMPS[@]}"
  return 0
}
trap _rs_cleanup EXIT
trap '_rs_cleanup; exit 130' INT
trap '_rs_cleanup; exit 143' TERM

# Print the repo's member names, one per line: the git members first, then the
# `[member.<name>]` keys of <values> that are not git members, which must be
# folders in the repo. Returns 2 when a key is neither.
_rs_members() {
  local values=$1 name=$2 member keys seen=" "
  if ! declare -F members > /dev/null; then
    # shellcheck source=/dev/null
    source "${MISE_PROJECT_ROOT}/.config/mise/tasks/_scripts/helpers"
  fi
  while IFS= read -r member; do
    [[ -n $member ]] || continue
    printf '%s\n' "$member"
    seen+="$member "
  done < <(members)
  keys=$(mise x -- gomplate --left-delim '<%' --right-delim '%>' -c "v=${values}" \
  -i '<% if has .v "member" %><% range $k, $x := .v.member %><% $k %>
<% end %><% end %>') || return 2
  while IFS= read -r member; do
    [[ -n $member && $seen != *" $member "* ]] || continue
    if [[ ! -d ${MISE_PROJECT_ROOT}/${member} ]]; then
      _rs_log "$name: [member.${member}] in $(_rs_path "$values") is not a submodule or a folder of the repo"
      return 2
    fi
    printf '%s\n' "$member"
  done <<< "$keys"
}

# gomplate with the template delimiters this repo uses.
_rs_gomplate() { mise x -- gomplate --left-delim '<%' --right-delim '%>' "$@"; }

# Print the items of the list <key> in the TOML file <file>, one per line;
# nothing when the key is absent.
_rs_list() {
  local file=$1 key=$2
  _rs_gomplate -c "v=${file}" -i "<% if has .v \"${key}\" %><% range (index .v \"${key}\") %><% . %>
<% end %><% end %>"
}

# Print the manifest of <tool> in the clone <dir> as `<field> <value>` lines:
# `depends`, `extension`, `seed`, `seed_requires <seed> <file>`, and one
# `root_only true|false`.
_rs_manifest() {
  local dir=$1 tool=$2
  _rs_gomplate -c "t=${dir}/tools/${tool}/tool.toml" -i '<% range .t.depends %>depends <% . %>
<% end %><% range .t.extensions %>extension <% . %>
<% end %><% range .t.seed %>seed <% . %>
<% end %><% if has .t "seed_requires" %><% range $k, $v := .t.seed_requires %>seed_requires <% $k %> <% $v %>
<% end %><% end %>root_only <% .t.root_only %>
'
}

# Resolve the tools of <values> against the clone <dir>, dependencies
# included, into _RS_TOOLS (space separated, a dependency before the tool that
# needs it), _RS_EXTENSIONS (one per line, sorted, unique), _RS_SEEDS
# (` <tool>/<path> ` words) and _RS_SEED_REQUIRES (` <tool>/<path>=<file> `
# words). Returns 2 or 3, after a message, on any problem.
_rs_resolve() {
  local dir=$1 values=$2 requested tool field value pending in_submodule
  requested=$(_rs_list "$values" tools) || {
    _rs_log "cannot read $(_rs_path "$values")"
    return 2
  }
  if [[ -z ${requested//[$'\n ']/} ]]; then
    _rs_log "$(_rs_path "$values") lists no tools - add tools = [\"base\", ...]"
    return 2
  fi
  in_submodule=$(git -C "$MISE_PROJECT_ROOT" rev-parse --show-superproject-working-tree 2> /dev/null) || in_submodule=''

  _RS_TOOLS=' ' _RS_SEEDS=' ' _RS_SEED_REQUIRES=' ' _RS_EXTENSIONS=''
  # Depth-first, so each dependency lands before the tool that named it. A
  # stack of words rather than recursion: bash 3.2 has no local arrays worth
  # passing around, and the manifests are tiny.
  pending=$(printf '%s\n' "$requested" | tr '\n' ' ')
  local visiting=' '
  while [[ -n ${pending// /} ]]; do
    tool=${pending%% *}
    pending=${pending#* }
    [[ -n $tool && $_RS_TOOLS != *" $tool "* ]] || continue
    if [[ ! -f $dir/tools/$tool/tool.toml ]]; then
      _rs_log "tool '$tool' is not in repo-config"
      return 3
    fi
    local deps='' manifest
    manifest=$(_rs_manifest "$dir" "$tool") || {
      _rs_log "cannot read tools/$tool/tool.toml"
      return 2
    }
    while read -r field value; do
      [[ $field == depends && $_RS_TOOLS != *" $value "* ]] && deps+="$value "
    done <<< "$manifest"
    if [[ -n $deps && $visiting != *" $tool "* ]]; then
      # Come back to this tool after its dependencies.
      visiting+="$tool "
      pending="$deps$tool $pending"
      continue
    fi
    while read -r field value; do
      case $field in
        extension)
          _RS_EXTENSIONS+="$value"$'\n'
          ;;
        seed)
          _RS_SEEDS+="$tool/$value "
          ;;
        seed_requires)
          # `<seed> <file>`: neither path has a space.
          _RS_SEED_REQUIRES+="$tool/${value% *}=${value#* } "
          ;;
        root_only)
          if [[ $value == true && -n $in_submodule ]]; then
            _rs_log "tool '$tool' is for the root repository only - remove it from the tools of this submodule"
            return 2
          fi
          ;;
      esac
    done <<< "$manifest"
    _RS_TOOLS+="$tool "
  done
  _RS_EXTENSIONS=$(printf '%s' "$_RS_EXTENSIONS" | sort -u)
}

# A branch that exists here or on origin; the same test as `branch_exists` in
# `checks`, which a first sync does not have yet.
_rs_branch_exists() {
  git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$1" ||
    git -C "$MISE_PROJECT_ROOT" show-ref --verify --quiet "refs/remotes/origin/$1"
}

# Set _RS_SKIP to the ` base/<path> ` words of the merge tasks of the other
# branch model. Returns 2, after a message, when neither branch exists.
_rs_merge_model() {
  local tasks=base/.config/mise/tasks/code/merge
  local main=0 develop=0
  _rs_branch_exists main && main=1
  _rs_branch_exists develop && develop=1
  if ((main && develop)); then
    _RS_SKIP=" $tasks/_default "
  elif ((main || develop)); then
    _RS_SKIP=" $tasks/develop $tasks/main "
  else
    _rs_log "the repo has neither 'main' nor 'develop' - create one, then sync again"
    return 2
  fi
}

# Remove the file <path> of <tool> from this repo, if it exists.
_rs_remove() {
  local tool=$1 path=$2 dry_run=$3 dest show
  dest="${MISE_PROJECT_ROOT}/${path}"
  show=$(_rs_path "$dest")
  [[ -e $dest ]] || return 0
  if ((dry_run)); then
    _rs_log "would remove $show"
    return 0
  fi
  rm -f -- "$dest" || {
    _rs_log "cannot remove $show"
    return 1
  }
  _rs_log "removed    $show"
}

# Write the template context to <out>: the values of <values>, with
# `members`, `submodules`, `tools`, `extensions` and `precommit` merged in
# first, so a key of the same name in the values file cannot replace them.
# <dir> is the clone.
_rs_context() {
  local dir=$1 values=$2 out=$3 members tool
  members=$(_rs_members "$values" "template context") || return 2
  # The git submodules alone: `members` also has the folder members.
  local submodules=''
  if [[ -f ${MISE_PROJECT_ROOT}/.gitmodules ]]; then
    submodules=$(git -C "$MISE_PROJECT_ROOT" submodule --quiet foreach --recursive 'echo $displaypath' 2> /dev/null) || submodules=''
  fi
  # One context per tool manifest, `tool_<name>`, for the `[[precommit]]`
  # entries; `repo_precommit` for the repo's own entries.
  local args=(-c "v=${values}")
  for tool in $_RS_TOOLS; do
    args+=(-c "tool_${tool}=${dir}/tools/${tool}/tool.toml")
  done
  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/pre-commit.yaml"
  local has_own=''
  if [[ -f $own ]]; then
    args+=(-c "repo_precommit=${own}")
    has_own=1
  fi
  REPO_SYNC_OWN_PRECOMMIT=$has_own REPO_SYNC_MEMBERS=$members REPO_SYNC_SUBMODULES=$submodules REPO_SYNC_TOOLS=$(printf '%s\n' $_RS_TOOLS) REPO_SYNC_EXTENSIONS=$_RS_EXTENSIONS \
    _rs_gomplate "${args[@]}" -o "$out" \
    -i '<% $ctx := dict %><% range (coll.Slice "members" "submodules" "tools" "extensions") %><% $l := coll.Slice %><% range (env.Getenv (printf "REPO_SYNC_%s" (strings.ToUpper .)) | strings.Split "\n") %><% if . %><% $l = coll.Append . $l %><% end %><% end %><% $ctx = coll.Merge $ctx (dict . $l) %><% end %><% $pc := coll.Slice %><% range $ctx.tools %><% $t := index $ (printf "tool_%s" .) %><% if has $t "precommit" %><% range $t.precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% end %><% if env.Getenv "REPO_SYNC_OWN_PRECOMMIT" %><% range $.repo_precommit %><% $pc = coll.Append . $pc %><% end %><% end %><% $ctx = coll.Merge $ctx (dict "precommit" $pc) %><% coll.Merge $ctx .v | data.ToJSON %>' >&2
}

# Sync the file <path> of <tool> from the clone in <dir>. Leaves the
# destination untouched when the content is identical, when it is a seed that
# exists, when it is a seed whose `seed_requires` file is missing, or on any
# failure.
_rs_file() {
  local dir=$1 tool=$2 path=$3 dry_run=$4 core=$5 ctx=$6
  local src="${dir}/tools/${tool}/${path}" out=${path%.tmpl}
  local dest destdir tmp show rc=0
  # A core tool's dev-only mise config loads in every environment instead.
  if [[ $core == *" $tool "* && $out == .config/mise/conf.d/*/mise.dev.toml ]]; then
    out=${out%mise.dev.toml}mise.toml
  fi
  dest="${MISE_PROJECT_ROOT}/${out}"
  show=$(_rs_path "$dest")

  if [[ $_RS_SEEDS == *" $tool/$path "* && -e $dest ]]; then
    _rs_log "kept seed  $show"
    return 0
  fi
  # A seed with `seed_requires` is only for a repo that has the named file.
  local requires=${_RS_SEED_REQUIRES#* "$tool/$path="}
  if [[ $requires != "$_RS_SEED_REQUIRES" ]]; then
    requires=${requires%% *}
    if [[ ! -e ${MISE_PROJECT_ROOT}/${requires} ]]; then
      _rs_log "skip seed  $show (no $requires)"
      return 0
    fi
  fi

  if ((dry_run)); then
    destdir=${TMPDIR:-/tmp}
  else
    destdir=$(dirname -- "$dest")
    mkdir -p -- "$destdir" || {
      _rs_log "cannot create $(_rs_path "$destdir")"
      return 1
    }
  fi
  # Temp file in the destination directory so the final mv is atomic.
  tmp=$(mktemp "${destdir%/}/.repo-sync.XXXXXX") || {
    _rs_log "cannot create a temp file in $(_rs_path "$destdir")"
    return 1
  }
  _RS_TMPS+=("$tmp")

  if [[ $path == *.tmpl ]]; then
    if [[ -z $ctx ]]; then
      rc=2
    elif ! _rs_gomplate -c ".=${ctx}?type=application/json" -f "$src" -o "$tmp" >&2; then
      _rs_log "$tool/$path: gomplate failed to render the template"
      rc=2
    fi
  else
    cp -- "$src" "$tmp" || rc=1
  fi
  # The hook revisions: each one becomes the newest tag, chosen by
  # `pre-commit autoupdate` itself. The `rev` in a tool.toml is a real tag, so
  # an older repo-sync without this step still writes a config that runs. A later autoupdate in
  # this repo then picks the same tags, so it and the sync never undo each
  # other. It needs the network; on a failure the existing file stays.
  if ((rc == 0)) && [[ $out == .config/pre-commit-config.yaml ]]; then
    if ! mise x -- which pre-commit > /dev/null 2>&1; then
      _rs_log "$tool/$path: pre-commit is not available to resolve the hook revisions"
      rc=5
    elif ! (cd "$MISE_PROJECT_ROOT" && mise x -- pre-commit autoupdate --config "$tmp" > /dev/null 2>&1); then
      _rs_log "$tool/$path: pre-commit autoupdate failed - examine the network and the hook repositories"
      rc=5
    fi
  fi

  # A rendered template goes through this repo's formatter before the compare.
  # Otherwise the format hook changes the render, and the next sync writes it
  # back: a loop. A plain file needs no step, because dprint formats its
  # source in repo-config. Without dprint, or if dprint fails, the raw render
  # stays.
  if ((rc == 0)) && [[ $path == *.tmpl && -n $_RS_DPRINT ]]; then
    local fmt
    fmt=$(mktemp "${destdir%/}/.repo-sync.XXXXXX") || fmt=''
    if [[ -n $fmt ]]; then
      _RS_TMPS+=("$fmt")
      if (cd "$MISE_PROJECT_ROOT" && mise x -- dprint fmt --stdin "$out" < "$tmp" > "$fmt" 2> /dev/null); then
        mv -f -- "$fmt" "$tmp"
      else
        rm -f -- "$fmt"
      fi
    fi
  fi

  local own="${MISE_PROJECT_ROOT}/.config/repo-sync/gitignore"
  if ((rc == 0)) && [[ $path == .gitignore && -f $own ]]; then
    {
      printf '\n'
      cat -- "$own"
    } >> "$tmp" || rc=1
  fi
  if ((rc != 0)); then
    rm -f -- "$tmp"
    [[ -e $dest ]] && _rs_log "kept existing $show"
    return "$rc"
  fi

  # The file takes the mode of its source in repo-config, also when it exists:
  # a template task is executable because its `.tmpl` is. mktemp creates 0600.
  local mode
  mode=$(_rs_mode "$src")
  if [[ -f $dest ]] && cmp -s -- "$tmp" "$dest"; then
    rm -f -- "$tmp"
    if [[ $(_rs_mode "$dest") == "$mode" ]]; then
      _rs_log "unchanged  $show"
    elif ((dry_run)); then
      _rs_log "would chmod $mode $show"
    else
      chmod "$mode" "$dest" || {
        _rs_log "cannot chmod $show"
        return 1
      }
      _rs_log "chmod $mode  $show"
    fi
    return 0
  fi

  if ((dry_run)); then
    _rs_log "would update $show"
    if [[ -f $dest ]]; then
      diff -u --label "$show (current)" --label "$show (repo-config)" -- "$dest" "$tmp" >&2 || true
    fi
    rm -f -- "$tmp"
    return 0
  fi

  chmod "$mode" "$tmp"
  mv -f -- "$tmp" "$dest" || {
    rm -f -- "$tmp"
    _rs_log "cannot write $show"
    return 1
  }
  _rs_log "updated    $show"
}

# repo_sync [--dry-run]
#
# Clone repo-config once, resolve the tools of the values file, then sync
# every file of every tool. Returns the most severe failure code, or 0.
repo_sync() {
  local dry_run=0
  while (($#)); do
    case $1 in
      --dry-run)
        dry_run=1
        shift
        ;;
      *)
        _rs_log "usage: repo_sync [--dry-run]"
        return 2
        ;;
    esac
  done

  local values=${REPO_SYNC_VALUES:-${MISE_PROJECT_ROOT:-$PWD}/.config/repo-config.toml}
  if [[ ! -f $values ]]; then
    _rs_log "values file $(_rs_path "$values") not found - it lists the tools to sync"
    return 2
  fi
  if ! mise x -- which gomplate > /dev/null 2>&1; then
    _rs_log "gomplate is not available - add #MISE tools.gomplate=\"latest\" to the calling task"
    return 2
  fi

  local url=${REPO_SYNC_URL:-git@github.com:virajp/repo-config.git}
  local dir rev
  dir=$(mktemp -d "${TMPDIR:-/tmp}/repo-sync.XXXXXX") || {
    _rs_log "cannot create a temp directory"
    return 1
  }
  _RS_TMPS+=("$dir")
  # BatchMode and no terminal prompt: a missing key or no access fails here
  # instead of waiting for a password nobody will type.
  if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes" \
    git clone --quiet --depth 1 --single-branch -- "$url" "$dir" 2>&1 | sed 's/^/  /' >&2 ||
    [[ ! -d $dir/.git ]]; then
    _rs_log "cannot clone $url - nothing synced; existing files were left untouched"
    return 5
  fi
  rev=$(git -C "$dir" rev-parse --short HEAD)
  _rs_log "using repo-config at ${rev}"

  # The formatter for rendered templates; empty when dprint is not available.
  _RS_DPRINT=''
  mise x -- which dprint > /dev/null 2>&1 && _RS_DPRINT=1

  local rc=0
  _rs_resolve "$dir" "$values" || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }
  _rs_log "tools:${_RS_TOOLS% }"
  _rs_merge_model || {
    rc=$?
    rm -rf -- "$dir"
    return "$rc"
  }

  local core
  core=" $(_rs_list "$values" core_tools | tr '\n' ' ')"

  # The context is built once, and only when a template needs it. An empty
  # path tells `_rs_file` that it could not be built, so each template fails
  # and every plain file still syncs.
  local ctx=''
  if [[ -n $(find "$dir/tools" -name '*.tmpl' -type f -print -quit) ]]; then
    ctx=$(mktemp "${TMPDIR:-/tmp}/repo-sync-ctx.XXXXXX") || {
      rm -rf -- "$dir"
      return 1
    }
    _RS_TMPS+=("$ctx")
    _rs_context "$dir" "$values" "$ctx" || {
      _rs_log "cannot build the template context"
      ctx=''
    }
  fi

  local tool path worst=0 ok=0 failed=() total=0
  for tool in $_RS_TOOLS; do
    while IFS= read -r path; do
      [[ -n $path ]] || continue
      ((total += 1))
      rc=0
      if [[ $_RS_SKIP == *" $tool/$path "* ]]; then
        _rs_remove "$tool" "$path" "$dry_run" || rc=$?
      else
        _rs_file "$dir" "$tool" "$path" "$dry_run" "$core" "$ctx" || rc=$?
      fi
      if ((rc == 0)); then
        ((ok += 1))
      else
        failed+=("$tool/$path")
        ((rc > worst)) && worst=$rc
      fi
    done < <(cd "$dir/tools/$tool" && find . -type f ! -name tool.toml | sed 's#^\./##' | sort)
  done
  rm -rf -- "$dir"

  if ((${#failed[@]} == 0)); then
    _rs_log "done: $ok/$total files in sync"
    return 0
  fi
  _rs_log "FAILED: ${failed[*]}"
  _rs_log "$ok/$total files in sync; existing copies of the rest were left untouched"
  return "$worst"
}
