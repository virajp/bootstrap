# Synced from bootstrap: tools/base/.config/mise.toml.tmpl. Do not edit this file.
# The next sync replaces it, and a manual change is lost.

# The only mise file for every environment. The files in .config/mise/conf.d/
# are each for one environment (`MISE_ENV`).

[settings]
activate_aggressive = true
all_compile = false
env_shell_expand = true
gpg_verify = true
lockfile = false
minimum_release_age = "10h"
os = "macos"
raw = true
status.missing_tools = "always"
task.disable_spec_from_run_scripts = true
task.output = "interleave"
task.timings = true

# From .config/bootstrap.toml. The repository's own variables go in
# .config/mise/conf.d/_repo/mise.<env>.toml.
[env]
# Member projects within the repository
MEMBERS = "<% range $i, $m := .members %><% if $i %> <% end %><% $m %><% end %>"
# Merge model per destination: `direct` merges locally, `pr` opens a pull request
MERGE_MODEL_DEVELOP = "<% .merge_model_develop %>"
MERGE_MODEL_MAIN = "<% .merge_model_main %>"
# Repository name, used for identification within the toolchain
REPO_NAME = "<% .repo_name %>"
